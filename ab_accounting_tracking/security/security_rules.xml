<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="rule_ab_accounting_je_line_accountant" model="ir.rule">
            <field name="name">rule_ab_accounting_je_line_entry_allowed_accounts</field>
            <field name="model_id" ref="model_ab_accounting_tracking"/>
            <field name="groups" eval="[(4, ref('ab_accounting_tracking.group_accounting_tracking_user'))]"/>
            <field name="domain_force">
                [
                    '|', '|', '|',
                    ('write_uid', '=', user.id),
                    ('create_uid', '=', user.id),
                    ('create_uid', 'in', user.responsible_for_ids.ids),
                    ('write_uid', 'in', user.responsible_for_ids.ids),
                ]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <!--<field name="global" eval="1"/> -->
        </record>
        <record id="rule_ab_accounting_tracking_manager_ro" model="ir.rule">
            <field name="name">rule_ab_accounting_tracking_manager_ro</field>
            <field name="model_id" ref="model_ab_accounting_tracking"/>
            <field name="groups" eval="[(4, ref('ab_accounting_tracking.group_accounting_tracking_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>