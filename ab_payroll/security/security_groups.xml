<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cat_ab_payroll" model="ir.module.category">
        <field name="name">Payroll Category</field>
        <field name="sequence" eval="1"/>
    </record>
    <record id="privilege_ab_payroll" model="res.groups.privilege">
        <field name="name">Payroll sheets</field>
        <field name="category_id" ref="cat_ab_payroll"/>
        <field name="sequence" eval="25"/>
    </record>


    <record id="group_ab_payroll_sheet_specialist" model="res.groups">
        <field name="name">Payroll Specialist</field>
        <field name="privilege_id" ref="privilege_ab_payroll"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>


    <record id="group_ab_payroll_sheet_admin" model="res.groups">
        <field name="name">Payroll sheet admin</field>
        <field name="privilege_id" ref="privilege_ab_payroll"/>
        <field name="implied_ids" eval="[(4, ref('group_ab_payroll_sheet_specialist'))]"/>
    </record>
</odoo>
