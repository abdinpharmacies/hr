#. module: ab_sales_cash_accounting
#: code:addons/ab_sales_cash_accounting/models/cash_bridge.py:0
msgid "Close the shift before posting its accounting batch."
msgstr "أغلق الوردية قبل ترحيل دفعتها المحاسبية."

#. module: ab_sales_cash_accounting
#: code:addons/ab_sales_cash_accounting/models/cash_bridge.py:0
