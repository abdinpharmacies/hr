<odoo>
    <record id="replica_enrollment_form" model="ir.ui.view">
        <field name="name">Replica central enrollment</field>
        <field name="model">ab_replica_db</field>
        <field name="inherit_id" ref="ab_store.ab_replica_db_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside"/>
        </field>
        <field name="active" eval="False"/>
    </record>
    <record id="settings_form" model="ir.ui.view">
        <field name="name">Central synchronization settings</field><field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside"/>
        </field>
        <field name="active" eval="False"/>
    </record>
    <record id="sale_inventory_sync_form" model="ir.ui.view">
        <field name="name">Branch bill inventory synchronization</field>
        <field name="model">ab_sales_header</field>
        <field name="inherit_id" ref="ab_sales.ab_sales_header_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Inventory Synchronization" invisible="not inventory_sync_state">
                    <field name="inventory_sync_state"/>
                    <field name="central_bill_id" invisible="not central_bill_id"/>
                    <field name="inventory_sync_message" invisible="not inventory_sync_message"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
