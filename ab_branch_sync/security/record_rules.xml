<odoo>
    <record id="operation_store_rule" model="ir.rule">
        <field name="name">Synchronization store access</field>
        <field name="model_id" ref="model_ab_branch_sync_operation"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') or user.has_group('ab_sales.group_ab_sales_manager') else [('store_id', 'in', user.inventory_store_ids.ids)]</field>
    </record>
    <record id="cache_store_rule" model="ir.rule">
        <field name="name">Central stock cache store access</field>
        <field name="model_id" ref="ab_sales.model_ab_sales_inventory"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') or user.has_group('ab_sales.group_ab_sales_manager') else ['|', ('central_initialized', '=', False), ('store_id', 'in', user.inventory_store_ids.ids)]</field>
    </record>
</odoo>
