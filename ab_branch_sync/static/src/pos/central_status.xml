<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ab_branch_sync.CentralStatus">
        <button type="button" t-attf-class="ab_branch_sync_status badge rounded-pill border-0 #{color}"
                t-att-title="title" t-on-click.stop="synchronize" t-on-pointerdown.stop="() => {}"
                t-att-disabled="state.busy || !props.storeId || (props.requiresLogin &amp;&amp; !props.sessionToken)"
                aria-live="polite">
            <i t-att-class="state.busy ? 'fa fa-refresh fa-spin me-1' : 'fa fa-circle me-1'" aria-hidden="true"/>
            <t t-esc="label"/>
        </button>
    </t>
    <t t-name="ab_branch_sync.PosCentralStatus" t-inherit="ab_sales.PosAction" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('ab_pos_window_header')]/div[hasclass('ab_pos_window_controls')]" position="before">
            <BranchCentralStatus storeId="currentBill?.header?.store_id || state.abSalesHr?.selectedStoreId || 0"
                sessionToken="state.abSalesHr?.session?.token || ''" requiresLogin="!!state.abSalesHr"
                onSynced="() => this.abBranchSyncRefreshBalances()"/>
        </xpath>
    </t>
</templates>
