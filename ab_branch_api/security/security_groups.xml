<odoo>
    <record id="category_branch_api" model="ir.module.category">
        <field name="name">Branch API</field>
    </record>
    <record id="privilege_branch_api" model="res.groups.privilege">
        <field name="name">Branch API</field>
        <field name="category_id" ref="category_branch_api"/>
    </record>
    <record id="group_branch_api" model="res.groups">
        <field name="name">API User</field>
        <field name="api_key_duration">90</field>
        <field name="privilege_id" ref="privilege_branch_api"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
