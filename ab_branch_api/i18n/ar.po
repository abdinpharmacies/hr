#. module: ab_branch_api
#. odoo-python
#: code:addons/ab_branch_api/models/branch_api.py:0
#: code:addons/ab_branch_api/models/routing.py:0
msgid "Select a store or configure a default sales store for this operation."
msgstr "اختر مخزنًا أو اضبط مخزن مبيعات افتراضيًا لهذه العملية."

#. module: ab_branch_api
#. odoo-python
#: code:addons/ab_branch_api/models/branch_api.py:0
msgid "Store E-Plus serial must be a positive integer."
msgstr "يجب أن يكون الرقم التسلسلي للمخزن في إي بلس عددًا صحيحًا موجبًا."

#. module: ab_branch_api
#. odoo-python
#: code:addons/ab_branch_api/models/routing.py:0
msgid "The API SQL request belongs to another database or user."
msgstr ""
"طلب قاعدة البيانات لواجهة برمجة التطبيقات يخص قاعدة بيانات أو مستخدمًا آخر."

#. module: ab_branch_api
#. odoo-python
#: code:addons/ab_branch_api/models/routing.py:0
#: code:addons/ab_branch_api/models/sales_workflow.py:0
msgid "The SQL store does not match the authorized API store."
msgstr ""
"مخزن استعلام قاعدة البيانات لا يطابق المخزن المعتمد لطلب واجهة برمجة "
"التطبيقات."

#. module: ab_branch_api
#. odoo-python
#: code:addons/ab_branch_api/models/branch_api.py:0
msgid ""
"The return employee and employee cost center must be active on this branch."
msgstr "يجب أن يكون موظف المرتجع ومركز تكلفته نشطين في هذا الفرع."

#. module: ab_branch_api
#. odoo-python
#: code:addons/ab_branch_api/models/branch_api.py:0
msgid ""
"The return employee has no valid E-Plus mapping on this branch. Configure "
"the employee cost center E-Plus serial before retrying."
msgstr ""
"لا يوجد ربط صالح لموظف المرتجع مع إي بلس في هذا الفرع. اضبط الرقم التسلسلي "
"لإي بلس في مركز تكلفة الموظف قبل إعادة المحاولة."

#. module: ab_branch_api
#. odoo-python
#: code:addons/ab_branch_api/models/branch_api.py:0
msgid ""
"The return employee is missing or ambiguous on this branch. Check the "
"employee cost center code."
msgstr ""
"موظف المرتجع غير موجود أو يوجد أكثر من سجل مطابق له في هذا الفرع. تحقق من "
"كود مركز تكلفة الموظف."

#. module: ab_branch_api
#. odoo-python
#: code:addons/ab_branch_api/models/routing.py:0
msgid "The selected store E-Plus endpoint is unreachable."
msgstr "تعذر الوصول إلى خادم إي بلس للمخزن المحدد."

#. module: ab_branch_api
#. odoo-python
#: code:addons/ab_branch_api/models/routing.py:0
#: code:addons/ab_branch_api/models/sales_workflow.py:0
