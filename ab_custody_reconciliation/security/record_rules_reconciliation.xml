<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--        ### Concerned Department Rules ####### -->
        <record id="rule_ab_custody_reconciliation_line_user_can_approve" model="ir.rule">
            <field name="name">rule_ab_custody_reconciliation_line_user_can_approve</field>
            <field name="model_id" ref="model_ab_custody_reconciliation_line"/>
            <field name="groups" eval="[(4, ref('ab_custody_request.group_ab_custody_request_user'))]"/>
            <field name="domain_force">[
                ('can_approve', '=', True),
                ('status', '!=', 'entry'),
            ]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <!--<field name="global" eval="1"/> -->
        </record>

