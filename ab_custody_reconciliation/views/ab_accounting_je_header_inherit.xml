<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ab_accounting_je_header_view_inherit" model="ir.ui.view">
            <field name="name">ab_accounting_je_header</field>
            <field name="model">ab_accounting_je_header</field>
            <field name="inherit_id" ref="ab_accounting.ab_accounting_je_header_view_form"/>
            <field name="mode">extension</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='doctype_id']" position="after">
                    <field name="custody_header_ids"
                           domain="[('je_header_id','=',False)]"
                           widget="many2many_tags"/>
                    <field name="id" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>