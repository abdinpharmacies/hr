<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="cat_ab_product_price_editing" model="ir.module.category">
            <field name="name">Product Price Editing</field>
            <field name="sequence" eval="1"/>
        </record>
        <record id="privilege_cat_ab_product_price_editing" model="res.groups.privilege">
            <field name="name">Product Price Editing</field>
            <field name="category_id" ref="cat_ab_product_price_editing"/>
        </record>


        <record id="group_ab_product_price_editing_user" model="res.groups">
            <field name="name">Product Price Editing User</field>
            <field name="privilege_id" ref="privilege_cat_ab_product_price_editing"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_ab_product_price_editing_editor" model="res.groups">
            <field name="name">Product Price Editing Editor</field>
            <field name="privilege_id" ref="privilege_cat_ab_product_price_editing"/>
            <field name="implied_ids" eval="[(4, ref('group_ab_product_price_editing_user'))]"/>
        </record>

        <record id="group_ab_product_price_editing_viewer" model="res.groups">
            <field name="name">Product Price Editing Viewer</field>
            <field name="privilege_id" ref="privilege_cat_ab_product_price_editing"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


    </data>
</odoo>