<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_ab_test_sync" model="ir.module.category">
            <field name="name">AB Sync Test Mirrors</field>
            <field name="sequence">91</field>
        </record>

        <record id="privilege_ab_test_sync_access" model="res.groups.privilege">
            <field name="name">AB Sync Test Mirror Access</field>
            <field name="category_id" ref="module_category_ab_test_sync"/>
        </record>

        <record id="group_ab_test_sync_manager" model="res.groups">
            <field name="name">Sync Test Manager</field>
            <field name="privilege_id" ref="privilege_ab_test_sync_access"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_ab_test_sync_manager'))]"/>
        </record>
    </data>
</odoo>
