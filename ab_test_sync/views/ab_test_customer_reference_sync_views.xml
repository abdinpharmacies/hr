<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ab_test_customer_reference_sync_list" model="ir.ui.view">
            <field name="name">ab_test_customer_reference__sync.list</field>
            <field name="model">ab_test_customer_reference__sync</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="source_revision"/>
                    <field name="reference"/>
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="active"/>
                    <field name="synced_at"/>
                </list>
            </field>
        </record>
        <record id="view_ab_test_customer_reference_sync_form" model="ir.ui.view">
            <field name="name">ab_test_customer_reference__sync.form</field>
            <field name="model">ab_test_customer_reference__sync</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="db_serial"/>
                                <field name="rec_id"/>
                                <field name="source_revision"/>
                                <field name="event_uuid"/>
                                <field name="source_operation"/>
                                <field name="source_write_date"/>
                                <field name="synced_at"/>
                            </group>
                            <group>
                                <field name="reference"/>
                                <field name="name"/>
                                <field name="customer_id"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <field name="note"/>
                        <field name="payload_json" widget="ab_pretty_json"/>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_ab_test_customer_reference_sync" model="ir.actions.act_window">
            <field name="name">Synced Customer Reference Tests</field>
            <field name="res_model">ab_test_customer_reference__sync</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'active_test': False}</field>
        </record>

        <menuitem id="menu_ab_test_customer_reference_sync" name="Synced Customer References"
                  parent="menu_ab_test_sync_root" action="action_ab_test_customer_reference_sync" sequence="45"/>
    </data>
