        <record id="view_ab_test_header_sync_list" model="ir.ui.view">
            <field name="name">ab_test_header__sync.list</field>
            <field name="model">ab_test_header__sync</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="source_revision"/>
                    <field name="reference"/>
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="state" widget="badge"/>
                    <field name="priority"/>
                    <field name="line_count"/>
                    <field name="total_amount"/>
                    <field name="active"/>
                    <field name="synced_at"/>
                </list>
            </field>
        </record>
        <record id="view_ab_test_header_sync_form" model="ir.ui.view">
            <field name="name">ab_test_header__sync.form</field>
            <field name="model">ab_test_header__sync</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="db_serial"/>
                                <field name="rec_id"/>
                                <field name="source_revision"/>
                                <field name="event_uuid"/>
                                <field name="source_operation"/>
                                <field name="source_write_date"/>
                                <field name="synced_at"/>
                            </group>
                            <group>
                                <field name="reference"/>
                                <field name="name"/>
                                <field name="transaction_date"/>
                                <field name="category_id"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                                <field name="state"/>
                                <field name="priority"/>
                                <field name="line_count"/>
                                <field name="total_amount"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids" readonly="1">
                                    <list>
                                        <field name="rec_id"/>
                                        <field name="name"/>
                                        <field name="quantity"/>
                                        <field name="unit_price"/>
                                        <field name="subtotal"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Raw Payload">
                                <field name="payload_json"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
