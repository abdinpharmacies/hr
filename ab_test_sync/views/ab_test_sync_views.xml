<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ab_test_category_sync_list" model="ir.ui.view">
            <field name="name">ab_test_category__sync.list</field>
            <field name="model">ab_test_category__sync</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="source_revision"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="active"/>
                    <field name="synced_at"/>
                </list>
            </field>
        </record>
        <record id="view_ab_test_category_sync_form" model="ir.ui.view">
            <field name="name">ab_test_category__sync.form</field>
            <field name="model">ab_test_category__sync</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="db_serial"/>
                                <field name="rec_id"/>
                                <field name="source_revision"/>
                                <field name="event_uuid"/>
                            </group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="parent_id"/>
                                <field name="color"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <field name="description"/>
                        <field name="payload_json"/>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_ab_test_category_sync" model="ir.actions.act_window">
            <field name="name">Synced Test Categories</field>
            <field name="res_model">ab_test_category__sync</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_ab_test_tag_sync_list" model="ir.ui.view">
            <field name="name">ab_test_tag__sync.list</field>
            <field name="model">ab_test_tag__sync</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="source_revision"/>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="color"/>
                    <field name="active"/>
                    <field name="synced_at"/>
                </list>
            </field>
        </record>
        <record id="action_ab_test_tag_sync" model="ir.actions.act_window">
            <field name="name">Synced Test Tags</field>
            <field name="res_model">ab_test_tag__sync</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_ab_test_header_sync_list" model="ir.ui.view">
            <field name="name">ab_test_header__sync.list</field>
            <field name="model">ab_test_header__sync</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="source_revision"/>
                    <field name="reference"/>
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="state" widget="badge"/>
                    <field name="priority"/>
                    <field name="line_count"/>
                    <field name="total_amount"/>
                    <field name="active"/>
                    <field name="synced_at"/>
                </list>
            </field>
        </record>
        <record id="view_ab_test_header_sync_form" model="ir.ui.view">
            <field name="name">ab_test_header__sync.form</field>
            <field name="model">ab_test_header__sync</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="db_serial"/>
                                <field name="rec_id"/>
                                <field name="source_revision"/>
                                <field name="event_uuid"/>
                                <field name="source_operation"/>
                                <field name="source_write_date"/>
                                <field name="synced_at"/>
                            </group>
                            <group>
                                <field name="reference"/>
                                <field name="name"/>
                                <field name="transaction_date"/>
                                <field name="category_id"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                                <field name="state"/>
                                <field name="priority"/>
                                <field name="line_count"/>
                                <field name="total_amount"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids" readonly="1">
                                    <list>
                                        <field name="rec_id"/>
                                        <field name="name"/>
                                        <field name="quantity"/>
                                        <field name="unit_price"/>
                                        <field name="subtotal"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Raw Payload">
                                <field name="payload_json"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_ab_test_header_sync" model="ir.actions.act_window">
            <field name="name">Synced Test Headers</field>
            <field name="res_model">ab_test_header__sync</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_ab_test_line_sync_list" model="ir.ui.view">
            <field name="name">ab_test_line__sync.list</field>
            <field name="model">ab_test_line__sync</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="source_revision"/>
                    <field name="header_id"/>
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="category_id"/>
                    <field name="tag_ids" widget="many2many_tags"/>
                    <field name="quantity"/>
                    <field name="unit_price"/>
                    <field name="subtotal"/>
                    <field name="active"/>
                    <field name="synced_at"/>
                </list>
            </field>
        </record>
        <record id="action_ab_test_line_sync" model="ir.actions.act_window">
            <field name="name">Synced Test Lines</field>
            <field name="res_model">ab_test_line__sync</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_ab_test_sync_root" name="AB Sync Test Mirrors"
                  parent="base.menu_custom" sequence="71"
                  groups="group_ab_test_sync_manager"/>
        <menuitem id="menu_ab_test_header_sync" name="Synced Headers"
                  parent="menu_ab_test_sync_root" action="action_ab_test_header_sync" sequence="10"/>
        <menuitem id="menu_ab_test_line_sync" name="Synced Lines"
                  parent="menu_ab_test_sync_root" action="action_ab_test_line_sync" sequence="20"/>
        <menuitem id="menu_ab_test_category_sync" name="Synced Categories"
                  parent="menu_ab_test_sync_root" action="action_ab_test_category_sync" sequence="30"/>
        <menuitem id="menu_ab_test_tag_sync" name="Synced Tags"
                  parent="menu_ab_test_sync_root" action="action_ab_test_tag_sync" sequence="40"/>
    </data>
</odoo>
