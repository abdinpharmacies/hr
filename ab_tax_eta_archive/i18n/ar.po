msgid "Only one ETA file revision is allowed per day and category."
msgstr "يُسمح بإصدار واحد فقط من الملف الضريبي لكل يوم وتصنيف."

#. module: ab_tax_eta_archive
msgid "ETA invoice UUID must be unique per connection and direction."
