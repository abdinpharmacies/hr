<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="category_eta_archive" model="ir.module.category">
        <field name="name">ETA Archive</field>
    </record>
    <record id="privilege_eta_archive" model="res.groups.privilege">
        <field name="name">ETA Archive</field>
        <field name="category_id" ref="category_eta_archive"/>
    </record>
    <record id="group_eta_user" model="res.groups">
        <field name="name">ETA Reader</field>
        <field name="privilege_id" ref="privilege_eta_archive"/>
    </record>
    <record id="group_eta_manager" model="res.groups">
        <field name="name">ETA Manager</field>
        <field name="privilege_id" ref="privilege_eta_archive"/>
        <field name="implied_ids" eval="[(4, ref('group_eta_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('ab_tax_eta_archive.group_eta_manager'))]"/>
    </record>
</odoo>
