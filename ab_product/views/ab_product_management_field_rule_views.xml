<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_product_management_field_rule_view_list" model="ir.ui.view">
            <field name="name">ab_product_management_field_rule_view_list</field>
            <field name="model">ab_product_management_field_rule</field>
            <field name="arch" type="xml">
                <list string="Product Access Management">
                    <field name="group_id"/>
                    <field name="editable_fields"/>
                </list>
            </field>
        </record>

        <record id="ab_product_management_field_rule_view_form" model="ir.ui.view">
            <field name="name">ab_product_management_field_rule_view_form</field>
            <field name="model">ab_product_management_field_rule</field>
            <field name="arch" type="xml">
                <form string="Product Access Management">
                    <sheet>
                        <group>
                            <field name="group_id"/>
                            <field name="field_ids" widget="many2many_tags"/>
                            <field name="editable_fields" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ab_product_management_field_rule_view_search" model="ir.ui.view">
            <field name="name">ab_product_management_field_rule_view_search</field>
            <field name="model">ab_product_management_field_rule</field>
            <field name="arch" type="xml">
                <search string="Product Access Management">
                    <field name="group_id"/>
                    <field name="field_ids"/>
                </search>
            </field>
        </record>

        <record id="ab_product_management_field_rule_action" model="ir.actions.act_window">
            <field name="name">Product Access Management</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_product_management_field_rule</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_product_management_field_rule_view_search"/>
        </record>
    </data>
</odoo>
