<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_ab_product_management" model="ir.module.category">
            <field name="name">Product Management</field>
            <field name="sequence">30</field>
        </record>

        <record id="privilege_ab_product_management" model="res.groups.privilege">
            <field name="name">Product Management</field>
            <field name="category_id" ref="module_category_ab_product_management"/>
