        <record id="group_ab_product_price_manager" model="res.groups">
            <field name="name">Price Data Manager</field>
            <field name="privilege_id" ref="privilege_ab_product_management"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
