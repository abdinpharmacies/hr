<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <data>
        <record id="cron_ab_product_uom_category" model="ir.cron" forcecreate="True">
            <field name="name">cron_ab_product_uom_category</field>
            <field name="active">True</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=1, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>


            <field name="model_id" ref="model_ab_product"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_uom_category()</field>
        </record>
    </data>
</odoo>
