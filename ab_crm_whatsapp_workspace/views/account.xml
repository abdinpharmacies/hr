<odoo>
    <record id="view_account_whatsapp" model="ir.ui.view">
        <field name="name">messaging.account.whatsapp.workspace</field>
        <field name="model">ab_crm_messaging_account</field>
        <field name="inherit_id" ref="ab_crm_messaging.view_account_form"/>
        <field name="arch" type="xml">
            <field name="legacy_worker_disabled" position="after">
                <field name="whatsapp_migrated" invisible="provider != 'whatsapp'" readonly="whatsapp_migrated"/>
                <field name="whatsapp_webhook_enabled" invisible="provider != 'whatsapp'"/>
                <field name="whatsapp_extended_enabled" invisible="provider != 'whatsapp'"/>
                <field name="whatsapp_template_ids" widget="many2many_tags" readonly="1" invisible="provider != 'whatsapp'"/>
                <field name="whatsapp_business_account" invisible="provider != 'whatsapp'"/>
                <field name="whatsapp_templates_synced_at" invisible="provider != 'whatsapp'"/>
                <field name="whatsapp_templates_error" invisible="provider != 'whatsapp'"/>
                <button name="action_refresh_whatsapp_templates" type="object" string="Refresh WhatsApp Templates" invisible="not whatsapp_migrated" groups="base.group_system,ab_crm_core.group_manager"/>
                <button name="action_link_whatsapp_history_batch" type="object" string="Link WhatsApp History" invisible="not whatsapp_migrated"/>
            </field>
        </field>
    </record>
</odoo>
