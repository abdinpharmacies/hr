<odoo>
    <record id="rule_history_company" model="ir.rule">
        <field name="name">WhatsApp history: mapped company</field>
        <field name="model_id" ref="ab_whatsapp_api.model_ab_whatsapp_message"/>
        <field name="domain_force">[('crm_account_id.company_id', 'in', company_ids), ('crm_account_id.whatsapp_migrated', '=', True)]</field>
    </record>
    <record id="rule_history_branch" model="ir.rule">
        <field name="name">WhatsApp history: authorized branch</field>
        <field name="model_id" ref="ab_whatsapp_api.model_ab_whatsapp_message"/>
        <field name="domain_force">[] if user.has_group('base.group_system') or user.has_group('ab_crm_core.group_manager') else [('crm_account_id.branch_id.user_ids', 'in', [user.id])]</field>
    </record>
    <record id="rule_templates_staff" model="ir.rule">
        <field name="name">WhatsApp templates: authorized accounts</field>
        <field name="model_id" ref="ab_whatsapp_api.model_ab_whatsapp_template"/>
        <field name="domain_force">[] if user.has_group('base.group_system') else [('crm_account_ids', 'any', [('company_id', 'in', company_ids)] + ([] if user.has_group('ab_crm_core.group_manager') else [('branch_id.user_ids', 'in', [user.id])]))]</field>
    </record>
</odoo>
