<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ab_odoo_sync_upload_source_list" model="ir.ui.view">
        <field name="name">ab_odoo_sync_upload_source.list</field>
        <field name="model">ab_odoo_sync_upload_source</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_load_installed_models" type="object"
                            string="Load Installed Models" class="btn-secondary"
                            display="always"/>
                </header>
                <field name="model_name"/>
                <field name="aggregate_parent_field" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_ab_odoo_sync_upload_source_form" model="ir.ui.view">
        <field name="name">ab_odoo_sync_upload_source.form</field>
        <field name="model">ab_odoo_sync_upload_source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_load_installed_models" type="object"
                            string="Load Installed Models" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="model_name"/>
                        <field name="aggregate_parent_field"/>
                        <field name="active"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Stored fields are captured as a raw snapshot. The reporting server controls how each snapshot is mapped and applied.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ab_odoo_sync_upload_source" model="ir.actions.act_window">
        <field name="name">Branch Upload Sources</field>
        <field name="res_model">ab_odoo_sync_upload_source</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="view_ab_odoo_sync_outbox_list" model="ir.ui.view">
        <field name="name">ab_odoo_sync_outbox.list</field>
        <field name="model">ab_odoo_sync_outbox</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <header>
                    <button name="action_send_now" type="object" string="Send Now"
                            class="btn-primary" display="always"/>
                    <button name="action_retry" type="object" string="Retry Failed"
                            class="btn-secondary" display="always"/>
                    <button name="action_mark_not_sync" type="object" string="Mark Not Sync"
                            class="btn-secondary" display="always"/>
                </header>
                <field name="status" widget="badge"
                       decoration-warning="status == 'pending'"
                       decoration-success="status == 'sent'"
                       decoration-danger="status == 'failed'"
                       decoration-muted="status == 'not_sync'"/>
                <field name="db_serial"/>
                <field name="model_name"/>
                <field name="rec_id"/>
                <field name="source_revision"/>
                <field name="operation"/>
                <field name="source_write_date" optional="show"/>
                <field name="attempt_count" optional="show"/>
                <field name="last_error" optional="show"/>
                <field name="sent_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_ab_odoo_sync_outbox_form" model="ir.ui.view">
        <field name="name">ab_odoo_sync_outbox.form</field>
        <field name="model">ab_odoo_sync_outbox</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_send_now" type="object" string="Send Now"
                            class="btn-primary" invisible="status not in ('pending', 'failed')"/>
                    <button name="action_retry" type="object" string="Retry Failed"
                            invisible="status != 'failed'"/>
                    <button name="action_mark_not_sync" type="object" string="Mark Not Sync"
                            invisible="status not in ('pending', 'failed')"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="status" widget="badge"/>
                            <field name="event_uuid"/>
                            <field name="db_serial"/>
                            <field name="model_name"/>
                            <field name="rec_id"/>
                        </group>
                        <group>
                            <field name="source_revision"/>
                            <field name="operation"/>
                            <field name="source_write_date"/>
                            <field name="attempt_count"/>
                            <field name="sent_at"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="last_error"/>
                        <field name="payload_json" widget="ab_pretty_json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ab_odoo_sync_outbox_search" model="ir.ui.view">
        <field name="name">ab_odoo_sync_outbox.search</field>
        <field name="model">ab_odoo_sync_outbox</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_name"/>
                <field name="rec_id"/>
                <field name="event_uuid"/>
                <field name="status"/>
                <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                <filter name="sent" string="Sent" domain="[('status', '=', 'sent')]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <record id="action_ab_odoo_sync_outbox" model="ir.actions.act_window">
        <field name="name">Upload Outbox</field>
        <field name="res_model">ab_odoo_sync_outbox</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ab_odoo_sync_outbox_search"/>
    </record>

    <record id="action_ab_odoo_sync_test_upload_connection" model="ir.actions.server">
        <field name="name">Test Upload Connection</field>
        <field name="model_id" ref="ab_odoo_sync.model_ab_odoo_sync_service"/>
        <field name="state">code</field>
        <field name="code">action = model.action_test_upload_connection()</field>
    </record>

    <menuitem id="menu_ab_odoo_sync_upload_sources" name="Branch Upload Sources"
              parent="ab_odoo_sync.menu_ab_odoo_sync_root"
              action="action_ab_odoo_sync_upload_source" sequence="10"
              groups="base.group_system"/>
    <menuitem id="menu_ab_odoo_sync_outbox" name="Upload Outbox"
              parent="ab_odoo_sync.menu_ab_odoo_sync_root"
              action="action_ab_odoo_sync_outbox" sequence="20"
              groups="base.group_system"/>
    <menuitem id="menu_ab_odoo_sync_test_upload" name="Test Upload Connection"
              parent="ab_odoo_sync.menu_ab_odoo_sync_root"
              action="action_ab_odoo_sync_test_upload_connection" sequence="30"
              groups="base.group_system"/>
</odoo>
