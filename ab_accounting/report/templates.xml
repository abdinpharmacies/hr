<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="paperformat_accounting" model="report.paperformat">
        <field name="name">Accounting Landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
    </record>
    <record id="action_report_pdf" model="ir.actions.report">
        <field name="name">Accounting Report</field>
        <field name="model">ab_accounting_report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="paperformat_id" ref="paperformat_accounting"/>
        <field name="report_name">ab_accounting.financial_pdf</field>
    </record>
    <record id="action_report_xlsx" model="ir.actions.report">
        <field name="name">Accounting Report</field>
        <field name="model">ab_accounting_report</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">ab_accounting.financial_xlsx</field>
    </record>
    <template id="financial_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page ab_accounting_report">
                        <style>
.ab_accounting_report {font-family: Arial, sans-serif; font-size: 10pt; color: #172b4d;}
.ab_accounting_report h2 {font-size: 19pt; margin: 0 0 10px;}
.ab_accounting_report p {margin: 0 0 20px; color: #45546b;}
.ab_accounting_report table {width: 100%; border-collapse: collapse; table-layout: auto;}
.ab_accounting_report th {padding: 9px 7px; background: #eaf0f6; border-bottom: 2px solid #718096; text-align: left;}
.ab_accounting_report td {padding: 8px 7px; border-bottom: 1px solid #d8dee7; vertical-align: top;}
.ab_accounting_report tr {page-break-inside: avoid;}
.ab_accounting_report thead {display: table-header-group;}
</style>
                        <h2>Accounting Report</h2>
                        <p>
                            <span t-field="doc.company_id"/> / <span t-field="doc.branch_id"/> / <span t-field="doc.date_from"/> - <span t-field="doc.date_to"/>
                        </p>
                        <t t-set="result" t-value="doc.get_report_data()"/>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th t-foreach="result['columns']" t-as="label">
                                        <t t-esc="label"/>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="result['rows']" t-as="row">
                                    <td t-foreach="row" t-as="cell" t-att-style="'text-align: right; white-space: nowrap;' if isinstance(cell, (int, float)) else ''">
                                        <t t-if="isinstance(cell, (int, float))">
                                            <t t-esc="'%.2f' % cell"/>
                                        </t>
                                        <t t-else="">
                                            <t t-esc="cell"/>
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
