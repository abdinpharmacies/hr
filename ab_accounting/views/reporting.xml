<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_report_form" model="ir.ui.view">
        <field name="name">view_report_form</field>
        <field name="model">ab_accounting_report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="report_type"/>
                    <field name="company_id"/>
                    <field name="branch_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="account_ids" widget="many2many_tags"/>
                    <field name="partner_id"/>
                    <field name="costcenter_id"/>
                    <field name="opening_run_id" invisible="report_type != 'opening'"/>
                </group>
                <footer>
                    <button name="action_pdf" type="object" string="PDF"/>
                    <button name="action_xlsx" type="object" string="XLSX"/>
                    <button name="action_items" type="object" string="Posted Journal Items"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_report" model="ir.actions.act_window">
        <field name="name">Financial Reports</field>
        <field name="res_model">ab_accounting_report</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
