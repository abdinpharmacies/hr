<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_je_header_list" model="ir.ui.view">
        <field name="name">view_je_header_list</field>
        <field name="model">ab_accounting_je_header</field>
        <field name="arch" type="xml">
            <list>
                <field name="posting_number"/>
                <field name="accounting_date"/>
                <field name="company_id"/>
                <field name="branch_id"/>
                <field name="doctype_id"/>
                <field name="reference"/>
                <field name="state"/>
                <field name="total_debit_val"/>
                <field name="total_credit_val"/>
                <field name="total_net_val"/>
            </list>
        </field>
    </record>
    <record id="view_je_header_form" model="ir.ui.view">
        <field name="name">view_je_header_form</field>
        <field name="model">ab_accounting_je_header</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_post" type="object" string="Post" class="oe_highlight" invisible="state != 'draft'" groups="ab_accounting.group_ab_accounting_accountant,ab_accounting.group_ab_accounting_auto_je"/>
                    <button name="action_reverse_wizard" type="object" string="Reverse" invisible="state != 'posted' or source_model or event_type not in ('manual', 'opening') or reversal_of_id or reversal_ids" groups="ab_accounting.group_ab_accounting_accountant,ab_accounting.group_ab_accounting_auto_je"/>
                    <button name="action_confirm" type="object" string="Confirm Review" invisible="state != 'posted'" groups="ab_accounting.group_ab_accounting_reviewer"/>
                    <button name="action_freeze" type="object" string="Freeze" invisible="is_frozen" groups="ab_accounting.group_ab_accounting_reviewer"/>
                    <button name="action_unfreeze" type="object" string="Unfreeze" invisible="not is_frozen" groups="ab_accounting.group_ab_accounting_reviewer"/>
                    <button name="action_source" type="object" string="Source Document" invisible="not source_model"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_id" readonly="state == 'posted' or is_frozen"/>
                        <field name="branch_id" readonly="state == 'posted' or is_frozen" options="{'no_create': True}"/>
                        <field name="accounting_date" readonly="state == 'posted' or is_frozen"/>
                        <field name="doctype_id" readonly="state == 'posted' or is_frozen" domain="[('company_id', '=', company_id), ('active', '=', True)]"/>
                        <field name="account_id" readonly="state == 'posted' or is_frozen"/>
                        <field name="reference" readonly="state == 'posted' or is_frozen"/>
                        <field name="opening_run_id" readonly="state == 'posted' or is_frozen"/>
                    </group>
                    <field name="line_ids" nolabel="1" class="o_ab_responsive_x2many_table o_ab_accounting_line_table" readonly="state == 'posted' or is_frozen">
                        <list editable="bottom">
                            <field name="account_id" domain="[('company_id', '=', parent.company_id), ('is_final', '=', True)]"/>
                            <field name="partner_id"/>
                            <field name="costcenter_id"/>
                            <field name="explain"/>
                            <field name="doc_no"/>
                            <field name="due_date"/>
                            <field name="debit_val"/>
                            <field name="credit_val"/>
                        </list>
                    </field>
                    <group>
                        <field name="total_debit_val"/>
                        <field name="total_credit_val"/>
                        <field name="total_net_val"/>
                    </group>
                    <notebook>
                        <page string="Audit">
                            <group>
                                <field name="posting_number"/>
                                <field name="posted_by"/>
                                <field name="posted_at"/>
                                <field name="origin_database"/>
                                <field name="operation_identity"/>
                                <field name="request_fingerprint"/>
                                <field name="source_model" readonly="state == 'posted' or is_frozen"/>
                                <field name="source_res_id" readonly="state == 'posted' or is_frozen"/>
                                <field name="source_reference" readonly="state == 'posted' or is_frozen"/>
                                <field name="event_type" readonly="state == 'posted' or is_frozen"/>
                                <field name="original_event_reference" readonly="state == 'posted' or is_frozen"/>
                                <field name="reversal_of_id" readonly="1" options="{'no_create': True}"/>
                            </group>
                            <field name="reversal_ids" nolabel="1" class="o_ab_responsive_x2many_table o_ab_accounting_reversal_table" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="posting_number"/>
                                    <field name="accounting_date"/>
                                    <field name="branch_id"/>
                                    <field name="doctype_id"/>
                                    <field name="reference"/>
                                    <field name="reversal_reason"/>
                                    <field name="state"/>
                                    <field name="total_debit_val"/>
                                    <field name="total_credit_val"/>
                                    <field name="total_net_val"/>
                                </list>
                            </field>
                        </page>
                        <page string="Review">
                            <group>
                                <field name="is_frozen"/>
                                <field name="reviewed_by"/>
                                <field name="reviewed_at"/>
                                <field name="review_note"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_je_header_search" model="ir.ui.view">
        <field name="name">view_je_header_search</field>
        <field name="model">ab_accounting_je_header</field>
        <field name="arch" type="xml">
            <search>
                <field name="posting_number"/>
                <field name="reference"/>
                <field name="branch_id"/>
                <field name="accounting_date"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="posted" string="Posted" domain="[('state','=','posted')]"/>
                <filter name="branch" string="Branch" context="{'group_by':'branch_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_je_header" model="ir.actions.act_window">
        <field name="name">Journals</field>
        <field name="res_model">ab_accounting_je_header</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="view_je_line_list" model="ir.ui.view">
        <field name="name">view_je_line_list</field>
        <field name="model">ab_accounting_je_line</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="header_id"/>
                <field name="accounting_date"/>
                <field name="posting_number"/>
                <field name="branch_id"/>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="costcenter_id"/>
                <field name="explain"/>
                <field name="doc_no"/>
                <field name="due_date"/>
                <field name="debit_val"/>
                <field name="credit_val"/>
                <field name="net_val"/>
            </list>
        </field>
    </record>
    <record id="view_je_line_form" model="ir.ui.view">
        <field name="name">view_je_line_form</field>
        <field name="model">ab_accounting_je_line</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <field name="header_id"/>
                        <field name="accounting_date"/>
                        <field name="branch_id"/>
                        <field name="state"/>
                        <field name="account_id"/>
                        <field name="partner_id"/>
                        <field name="costcenter_id"/>
                        <field name="explain"/>
                        <field name="doc_no"/>
                        <field name="due_date"/>
                        <field name="debit_val"/>
                        <field name="credit_val"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_je_line_pivot" model="ir.ui.view">
        <field name="name">view_je_line_pivot</field>
        <field name="model">ab_accounting_je_line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="account_id" type="row"/>
                <field name="branch_id" type="col"/>
                <field name="debit_val" type="measure"/>
                <field name="credit_val" type="measure"/>
                <field name="net_val" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="view_je_line_search" model="ir.ui.view">
        <field name="name">view_je_line_search</field>
        <field name="model">ab_accounting_je_line</field>
        <field name="arch" type="xml">
            <search>
                <field name="account_id"/>
                <field name="partner_id"/>
                <field name="costcenter_id"/>
                <field name="branch_id"/>
                <field name="accounting_date"/>
                <field name="due_date"/>
                <filter name="posted" string="Posted" domain="[('state','=','posted')]"/>
                <filter name="account" string="Account" context="{'group_by':'account_id'}"/>
                <filter name="due" string="Due Date" context="{'group_by':'due_date'}"/>
            </search>
        </field>
    </record>
    <record id="action_je_line" model="ir.actions.act_window">
        <field name="name">Journal Items</field>
        <field name="res_model">ab_accounting_je_line</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('state', '=', 'posted')]</field>
    </record>
    <record id="view_reversal_form" model="ir.ui.view">
        <field name="name">view_reversal_form</field>
        <field name="model">ab_accounting_reversal</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="header_id"/>
                    <field name="accounting_date"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_reverse" type="object" string="Reverse" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
