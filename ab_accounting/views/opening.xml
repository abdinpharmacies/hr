<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_opening_run_list" model="ir.ui.view">
        <field name="name">view_opening_run_list</field>
        <field name="model">ab_accounting_opening_run</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="branch_id"/>
                <field name="accounting_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_opening_run_form" model="ir.ui.view">
        <field name="name">view_opening_run_form</field>
        <field name="model">ab_accounting_opening_run</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_close" type="object" string="Close Opening Run" invisible="state != 'open'" groups="ab_accounting.group_ab_accounting_manager"/>
                    <button name="action_journal" type="object" string="Opening Journals"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="branch_id"/>
                        <field name="company_id"/>
                        <field name="accounting_date"/>
                        <field name="closed_by"/>
                        <field name="closed_at"/>
                    </group>
                    <field name="expected_ids" readonly="state == 'closed'">
                        <list editable="bottom">
                            <field name="account_id"/>
                            <field name="partner_id"/>
                            <field name="costcenter_id"/>
                            <field name="expected_balance"/>
                            <field name="actual_balance"/>
                            <field name="difference"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_opening_run" model="ir.actions.act_window">
        <field name="name">Opening Runs</field>
        <field name="res_model">ab_accounting_opening_run</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
