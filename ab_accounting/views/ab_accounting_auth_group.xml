<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_accounting_auth_group_list" model="ir.ui.view">
            <field name="name">ab_accounting.ab_accounting_auth_group_list_view</field>
            <field name="model">ab_accounting_auth_group</field>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <tree string="Abdin User Authority">
                    <field name="name" readonly="True"/>
                    <field name="account_auth_ids"/>
                    <field name="doctype_ids" widget="many2many_tags"/>
                    <field name="allowed_field_ids"/>
                </tree>

            </field>
        </record>

        <!-- .....................FORM VIEW............................-->

        <record id="ab_accounting_auth_group_form" model="ir.ui.view">
            <field name="name">ab_accounting.ab_accounting_auth_group_form</field>
            <field name="mode">primary</field>
            <field name="model">ab_accounting_auth_group</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="......"/>
                            </h1>
                        </div>
                        <notebook>
                            <page string="Account Auth">
                                <div class="btn-group">
                                    <button name="btn_all_account_auth" string="All Auth" type="object"
                                            class="btn btn-info"/>
                                    <button name="remove_account_auth" string="Remove Auth" type="object"
                                            class="btn btn-danger"/>
                                </div>

                                <br/>

                                <field name="account_auth_ids" nolabel='1'>
                                    <tree string="Account auths" editable="bottom">
                                        <field name="account_id" width="120px"/>
                                        <field name="own_account" width="80px"/>
                                        <field name="allow_account" width="80px"/>
                                        <field name="always_show_account" width="80px"/>
                                        <field name="prevent_enquiry" width="80px"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Doc Type">
                                <div class="btn-group">
                                    <button name="btn_all_doc_auth" string="All Doc Auth" type="object"
                                            groups="base.group_system" class="btn btn-info"/>
                                    <button name="remove_doc_auth" string="Remove Doc Auth" type="object"
                                            groups="base.group_system" class="btn btn-danger"/>
                                </div>
                                <br/>
                                <field name="doctype_ids" nolabel='1' widget="many2many_tags"
                                       options="{'no_create': True, 'no_create_edit':True}"/>
                            </page>
                            <page string="Allowed Fields">
                                <div class="btn-group">
                                    <button name="btn_all_allowed_fields_auth" string="All Auth" type="object"
                                            groups="base.group_system" class="btn btn-info"/>
                                    <button name="remove_allowed_fields_auth" string="Remove Auth" type="object"
                                            groups="base.group_system" class="btn btn-danger"/>
                                </div>
                                <field name="allowed_field_ids" nolabel='1'>
                                    <tree string="Fields auths" editable="bottom">
                                        <field name="allowed_field_id" width="120px"/>
                                        <field name="allow_entry" width="80px"/>
                                        <field name="allow_review" width="80px"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Users">
                                <field name="user_ids" widget="many2many_tags"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ab_accounting_auth_group_action" model="ir.actions.act_window">
            <field name="name">User Authorities</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_accounting_auth_group</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="ab_accounting_auth_group_menu" name="Auth Groups" parent="ab_accounting.ab_user_auth_category"
                  action="ab_accounting_auth_group_action" sequence="1"/>


        <record id="res_users_view_inherit" model="ir.ui.view">
            <field name="name">res_users_view_inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="mode">extension</field>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='access_rights']" position="after">
                    <page string="Accounting Security Config">
                        <group>
                            <field name="accounting_auth_group_id" string="Group"/>
                            <field name="responsible_for_ids"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>


    </data>
</odoo>