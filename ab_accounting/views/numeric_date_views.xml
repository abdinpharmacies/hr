    <record id="ab_accounting_je_line_view_tree_numeric_dates" model="ir.ui.view">
        <field name="name">ab_accounting_je_line_view_tree.numeric.dates</field>
        <field name="model">ab_accounting_je_line</field>
        <field name="inherit_id" ref="ab_accounting.ab_accounting_je_line_view_tree"/>
