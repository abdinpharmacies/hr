<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_due_salaries_details_html">
        <t t-call="web.html_container">
            <div class="header"/>

            <div class="article">
                <div>
                    <table class="table abdin-table table-hover table-striped ">
                        <thead class="border border-dark text-center">
                            <tr>
                                <th class="text-info" style='border: 1px solid'>#</th>

                                <t t-foreach="headers" t-as="header">
                                    <th style='border: 1px solid'>
                                        <t t-esc="str(header)"/>
                                    </th>
                                </t>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-foreach="rows" t-as="row">
                                <tr>
                                    <td class="text-info border border-light">
                                        <t t-esc="1+row_index"/>
                                    </td>

                                    <t t-foreach="row" t-as="value">
                                        <td class="border border-dark text-right">
                                            <t t-esc="isinstance(value, float) and '{0:,.2f}'.format(value) or value"/>
                                        </td>
                                    </t>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>