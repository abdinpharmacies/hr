<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <data>
        <record model="ir.module.category" id="ab_accounting_category">
            <field name="name">Accounting</field>
            <field name="sequence">1</field>
        </record>

        <record id="ab_accounting_privilege" model="res.groups.privilege"><field name="name">Accounting</field><field name="category_id" ref="ab_accounting_category"/></record><record id="group_ab_accounting_accountant" model="res.groups">
            <field name="name">Accountant</field>
            <field name="privilege_id" ref="ab_accounting_privilege"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>

        <record id="group_ab_accounting_reviewer" model="res.groups">
            <field name="name">Reviewer</field>
            <field name="implied_ids" eval="[(4, ref('group_ab_accounting_accountant')),]"/>
            <field name="privilege_id" ref="ab_accounting_privilege"/>

        </record>

        <record id="group_ab_accounting_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="ab_accounting_privilege"/>
            <field name="implied_ids" eval="[(4, ref('group_ab_accounting_reviewer')),]"/>

        </record>

        <record id="group_ab_accounting_report" model="res.groups">
            <field name="name">Reports</field>
            <field name="privilege_id" ref="ab_accounting_privilege"/>
            <field name="implied_ids" eval="[(4, ref('group_ab_accounting_accountant')),]"/>

        </record>


        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_ab_accounting_manager')),]"/>
        </record>

        </data>
</odoo>
