<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="ab_accounting_category" model="ir.module.category">
        <field name="name">Accounting</field>
    </record>
    <record id="privilege_accountant" model="res.groups.privilege">
        <field name="name">Accountant</field>
        <field name="category_id" ref="ab_accounting_category"/>
    </record>
    <record id="group_ab_accounting_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="privilege_id" ref="privilege_accountant"/>
    </record>
    <record id="privilege_reviewer" model="res.groups.privilege">
        <field name="name">Reviewer</field>
        <field name="category_id" ref="ab_accounting_category"/>
    </record>
    <record id="group_ab_accounting_reviewer" model="res.groups">
        <field name="name">Reviewer</field>
        <field name="privilege_id" ref="privilege_reviewer"/>
        <field name="implied_ids" eval="[(4, ref('group_ab_accounting_accountant'))]"/>
    </record>
    <record id="privilege_report" model="res.groups.privilege">
        <field name="name">Reports</field>
        <field name="category_id" ref="ab_accounting_category"/>
    </record>
    <record id="group_ab_accounting_report" model="res.groups">
        <field name="name">Reports</field>
        <field name="privilege_id" ref="privilege_report"/>
    </record>
    <record id="privilege_auto_je" model="res.groups.privilege">
        <field name="name">Auto JE</field>
        <field name="category_id" ref="ab_accounting_category"/>
    </record>
    <record id="group_ab_accounting_auto_je" model="res.groups">
        <field name="name">Auto JE</field>
        <field name="privilege_id" ref="privilege_auto_je"/>
    </record>
    <record id="privilege_manager" model="res.groups.privilege">
        <field name="name">Manager</field>
        <field name="category_id" ref="ab_accounting_category"/>
    </record>
    <record id="group_ab_accounting_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_ab_accounting_reviewer')),(4, ref('group_ab_accounting_report'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ab_accounting_manager')), (4, ref('group_ab_accounting_auto_je'))]"/>
    </record>
</odoo>
