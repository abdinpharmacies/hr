<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!--        ################# Accountant RULES ##################################-->
        <record id="rule_ab_accounting_je_line_prevent_all" model="ir.rule">
            <field name="name">rule_ab_accounting_je_line_prevent_all</field>
            <field name="model_id" ref="model_ab_accounting_je_line"/>
            <field name="groups" eval="[(4, ref('ab_accounting.group_ab_accounting_accountant'))]"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_ab_accounting_je_line_accountant" model="ir.rule">
            <field name="name">rule_ab_accounting_je_line_entry_allowed_accounts</field>
            <field name="model_id" ref="model_ab_accounting_je_line"/>
            <field name="groups" eval="[(4, ref('ab_accounting.group_ab_accounting_accountant'))]"/>
            <field name="domain_force">
                [
                    '|', '|', '|',
                    ('create_uid', '=', False),
                    ('account_id.always_show_account', '=', True),
                    ('create_uid', '=', user.id),
                    ('create_uid', 'in', user.responsible_for_ids.ids),
                ]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <!--<field name="global" eval="1"/> -->
        </record>

        <record id="rule_ab_accounting_je_line_qry_prevent_all" model="ir.rule">
            <field name="name">rule_ab_accounting_je_line_qry_prevent_all</field>
            <field name="model_id" ref="model_ab_accounting_je_line_qry"/>
            <field name="groups" eval="[(4, ref('ab_accounting.group_ab_accounting_accountant'))]"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_ab_accounting_je_line_qry_accountant" model="ir.rule">
            <field name="name">rule_ab_accounting_je_line_qry_accountant</field>
            <field name="model_id" ref="model_ab_accounting_je_line_qry"/>
            <field name="groups" eval="[(4, ref('group_ab_accounting_accountant'))]"/>
            <!--            @formatter:off-->
            <field name="domain_force">[
                '|', '|', '|',
                    '&amp;',
                        ('account_id.prevent_enquiry', '=', False),
                        ('account_id.allow_account', '=', True),
                    ('account_id.always_show_account', '=', True),
                    ('create_uid', '=', user.id),
                    ('create_uid', 'in', user.responsible_for_ids.ids),
            ]</field>
            <!--            @formatter:on-->
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <!--<field name="global" eval="1"/> -->
        </record>


        <record id="rule_ab_accounting_je_header_prevent_all" model="ir.rule">
            <field name="name">rule_ab_accounting_je_header_prevent_all</field>
            <field name="model_id" ref="model_ab_accounting_je_header"/>
            <field name="groups" eval="[(4, ref('ab_accounting.group_ab_accounting_accountant'))]"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <!--<field name="global" eval="1"/> -->
        </record>

        <record id="rule_ab_accounting_je_header_accountant" model="ir.rule">
            <field name="name">rule_ab_accounting_je_header_accountant</field>
            <field name="model_id" ref="model_ab_accounting_je_header"/>
            <field name="groups" eval="[(4, ref('ab_accounting.group_ab_accounting_accountant'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <!--<field name="global" eval="1"/> -->
        </record>

        <record id="accountant_his_own_account_statement_reports" model="ir.rule">
            <field name="name">accountant_his_own_account_statement_reports</field>
            <field name="model_id" ref="model_ab_accounting_account_statement"/>
            <field name="domain_force">[('create_uid', '=', user.id), ]
            </field>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="groups" eval="[(4, ref('group_ab_accounting_accountant'))]"/>
        </record>


        <!--        ################# REVIEWER RULES ##################################-->

        <record id="rule_ab_accounting_je_line_reviewer" model="ir.rule">
            <field name="name">rule_ab_accounting_je_line_reviewer</field>
            <field name="model_id" ref="model_ab_accounting_je_line"/>
            <field name="groups" eval="[(4, ref('ab_accounting.group_ab_accounting_reviewer'))]"/>
            <field name="domain_force">[
                '|', '|', '|',
                ('create_uid', '=', False),
                ('account_id.always_show_account', '=', True),
                ('create_uid', '=', user.id),
                ('create_uid', 'in', user.responsible_for_ids.ids),
            ]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_ab_accounting_je_header_reviewer" model="ir.rule">
            <field name="name">rule_ab_accounting_je_header_reviewer</field>
            <field name="model_id" ref="model_ab_accounting_je_header"/>
            <field name="groups" eval="[(4, ref('ab_accounting.group_ab_accounting_reviewer'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!--        ################# MANAGER RULES ##################################-->
        <record id="manager_account_header" model="ir.rule">
            <field name="name">manager_account_header</field>
            <field name="model_id" ref="model_ab_accounting_je_header"/>
            <field name="domain_force">[
                (1, '=', 1),
            ]
            </field>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="groups" eval="[(4, ref('group_ab_accounting_manager'))]"/>
        </record>

        <record id="manager_journal_entries" model="ir.rule">
            <field name="name">manager_journal_entries</field>
            <field name="model_id" ref="model_ab_accounting_je_line"/>
            <field name="domain_force">[
                (1, '=', 1),
            ]
            </field>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="groups" eval="[(4, ref('group_ab_accounting_manager'))]"/>
        </record>

        <record id="manager_journal_entries_qry" model="ir.rule">
            <field name="name">manager_journal_entries_qry</field>
            <field name="model_id" ref="model_ab_accounting_je_line_qry"/>
            <field name="domain_force">[(1, '=', 1), ]
            </field>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="groups" eval="[(4, ref('group_ab_accounting_manager'))]"/>
        </record>

        <record id="rule_ab_accounting_je_line_report" model="ir.rule">
            <field name="name">rule_ab_accounting_je_line_report</field>
            <field name="model_id" ref="model_ab_accounting_je_line"/>
            <field name="groups" eval="[(4, ref('group_ab_accounting_report'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_ab_accounting_je_header_report" model="ir.rule">
            <field name="name">rule_ab_accounting_je_header_report</field>
            <field name="model_id" ref="model_ab_accounting_je_header"/>
            <field name="groups" eval="[(4, ref('group_ab_accounting_report'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

    </data>
</odoo>