<odoo>
    <template id="signup_whatsapp" inherit_id="ab_ecommerce_storefront.auth_signup" name="WhatsApp signup option" priority="230">
        <xpath expr="//button[@data-ab-auth-submit]" position="after">
            <button t-if="not token and ab_whatsapp_enabled" type="button" class="btn ab-auth-secondary d-none" data-ab-whatsapp-start="">Start WhatsApp verification</button>
        </xpath>
        <xpath expr="//p[@data-ab-phone-signup-notice]" position="replace">
            <p t-if="not token" class="small text-muted" data-ab-phone-signup-notice="">Verify your phone using Telegram or WhatsApp.</p>
        </xpath>
    </template>
    <template id="recovery_whatsapp" inherit_id="ab_ecommerce_storefront.auth_recovery" name="WhatsApp recovery option">
        <xpath expr="//fieldset" position="inside">
            <button t-if="'whatsapp' in available_channels" type="submit" formaction="/ab_storefront/auth/whatsapp/recover" class="btn ab-auth-secondary mt-2">Recover via WhatsApp</button>
        </xpath>
    </template>
    <template id="whatsapp_signup" name="WhatsApp phone verification">
        <t t-call="website.login_layout">
            <div class="ab-auth-form" data-ab-whatsapp-page="">
                <div class="ab-auth-form-head"><h2>WhatsApp phone verification</h2></div>
                <p dir="ltr" t-out="phone"/>
                <p t-if="error" class="ab-auth-alert ab-auth-alert-error" role="alert" t-out="error"/>
                <p t-if="active and not verified and delivery_state == 'wa_pending'" role="status">Your code is queued for delivery.</p>
                <p t-if="active and not verified and delivery_state in ('wa_leased', 'wa_dispatching')" role="status">Your code is being sent.</p>
                <p t-if="active and not verified and delivery_state in ('wa_accepted', 'wa_delivered', 'wa_read')" role="status">Enter the six-digit code sent to WhatsApp. It expires in five minutes.</p>
                <p t-if="active and not verified and delivery_state in ('failed', 'wa_unknown')" role="alert">Delivery could not be confirmed. Request a new code after the cooldown or choose Telegram.</p>
                <p t-if="not active and not error" role="alert">This verification request has expired. Start again.</p>
                <form t-if="active and not verified" method="post" action="/ab_storefront/auth/whatsapp">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="action" value="verify"/>
                    <div class="ab-auth-field"><label for="wa_code">Security code</label><div class="ab-auth-input"><input id="wa_code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required="required" dir="ltr"/></div></div>
                    <button type="submit" class="btn btn-primary ab-auth-primary">Verify code</button>
                </form>
                <form t-if="active and verified" method="post" action="/ab_storefront/auth/whatsapp">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="action" value="signup"/>
                    <p>Phone verified. Complete your password to create your account.</p>
                    <p t-out="name"/>
                    <t t-call="auth_signup.fields"><t t-set="only_passwords" t-value="True"/></t>
                    <button type="submit" class="btn btn-primary ab-auth-primary">Create account</button>
                </form>
                <form t-if="active and not verified" method="post" action="/ab_storefront/auth/whatsapp" class="mt-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="action" value="resend"/>
                    <button type="submit" class="btn ab-auth-secondary" t-att-disabled="'disabled' if retry_after else None" t-att-data-ab-wa-countdown="retry_after">Resend code <span t-if="retry_after" t-out="retry_after"/></button>
                </form>
                <a t-if="active" href="/ab_storefront/auth/whatsapp" class="btn ab-auth-secondary mt-2">Refresh delivery status</a>
                <form method="post" action="/ab_storefront/auth/whatsapp" class="mt-3">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="action" value="cancel"/>
                    <button type="submit" class="btn ab-auth-secondary">Cancel or choose Telegram</button>
                </form>
            </div>
        </t>
    </template>
    <template id="whatsapp_recovery" name="WhatsApp password recovery">
        <t t-call="website.login_layout">
            <div class="ab-auth-form">
                <div class="ab-auth-form-head"><h2>WhatsApp password recovery</h2></div>
                <p t-if="message" class="ab-auth-alert ab-auth-alert-success" role="status" t-out="message"/>
                <p t-if="error" class="ab-auth-alert ab-auth-alert-error" role="alert" t-out="error"/>
                <t t-if="step == 'otp'">
                    <form action="/ab_storefront/auth/whatsapp/recover" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" value="otp"/>
                        <div class="ab-auth-field"><label for="wa_recovery_code">Security code</label><div class="ab-auth-input"><input id="wa_recovery_code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required="required" dir="ltr"/></div></div>
                        <button type="submit" class="btn btn-primary ab-auth-primary">Verify code</button>
                    </form>
                    <form action="/ab_storefront/auth/whatsapp/recover" method="post" class="mt-3">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" value="resend"/>
                        <button type="submit" class="btn ab-auth-secondary">Resend code</button>
                    </form>
                </t>
                <form t-if="step == 'password'" action="/ab_storefront/auth/recover" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="action" value="password"/>
                    <t t-call="auth_signup.fields"><t t-set="only_passwords" t-value="True"/></t>
                    <button type="submit" class="btn btn-primary ab-auth-primary">Set new password</button>
                </form>
                <a href="/ab_storefront/auth/recover" class="btn ab-auth-secondary mt-3">Back to account recovery</a>
            </div>
        </t>
    </template>
</odoo>
