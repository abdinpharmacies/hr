<odoo>
    <record id="transport_list" model="ir.ui.view">
        <field name="name">WhatsApp authentication transports</field><field name="model">ab_storefront_whatsapp_transport</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="website_id"/><field name="company_id" groups="base.group_multi_company"/><field name="sender"/><field name="enabled"/></list></field>
    </record>
    <record id="transport_form" model="ir.ui.view">
        <field name="name">WhatsApp authentication transport</field><field name="model">ab_storefront_whatsapp_transport</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="source"/><field name="enabled"/><field name="website_id"/><field name="company_id" groups="base.group_multi_company"/><field name="service_user_id"/><field name="sender"/></group><group string="Approved authentication copy-code templates"><field name="template_en"/><field name="language_en"/><field name="template_ar"/><field name="language_ar"/></group></sheet></form></field>
    </record>
    <record id="transport_action" model="ir.actions.act_window"><field name="name">WhatsApp Authentication</field><field name="res_model">ab_storefront_whatsapp_transport</field><field name="view_mode">list,form</field></record>
    <menuitem id="transport_menu" name="WhatsApp Authentication" parent="base.menu_administration" action="transport_action" groups="base.group_system"/>
</odoo>
