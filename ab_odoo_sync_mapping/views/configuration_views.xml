<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_ab_odoo_sync_report_configuration" model="ir.actions.act_window">
        <field name="name">Report Sync Configuration</field>
        <field name="res_model">ab_odoo_sync_branch_registry</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                Register branches, rotate branch API keys, and approve branch hardware before accepting uploads.
            </p>
        </field>
    </record>

    <menuitem id="menu_ab_odoo_sync_report_configuration"
              name="Report Sync Configuration"
              parent="ab_odoo_sync.menu_ab_odoo_sync_root"
              action="action_ab_odoo_sync_report_configuration"
              sequence="90"
              groups="base.group_system"/>
</odoo>
