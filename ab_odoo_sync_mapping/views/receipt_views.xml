<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ab_odoo_sync_upload_receipt_list" model="ir.ui.view">
        <field name="name">ab_odoo_sync_upload_receipt.list</field>
        <field name="model">ab_odoo_sync_upload_receipt</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="branch_id"/>
                <field name="received_at"/>
                <field name="event_uuid"/>
                <field name="status" widget="badge"/>
                <field name="upload_record_id" optional="show"/>
                <field name="application_status" optional="show"/>
                <field name="processed_at" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_ab_odoo_sync_upload_receipt_form" model="ir.ui.view">
        <field name="name">ab_odoo_sync_upload_receipt.form</field>
        <field name="model">ab_odoo_sync_upload_receipt</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_retry_processing" type="object" string="Retry Processing" groups="base.group_system" invisible="status not in ('pending', 'failed', 'queued')"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="branch_id"/>
                        <field name="db_serial"/>
                        <field name="received_at"/>
                        <field name="processed_at"/>
                        <field name="event_uuid"/>
                        <field name="payload_hash"/>
                        <field name="upload_record_id"/>
                        <field name="application_status"/>
                    </group>
                    <group string="Processing Details"><field name="error_message" nolabel="1"/></group>
                    <group string="Original Uploaded Row"><field name="raw_row" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_ab_odoo_sync_upload_receipt" model="ir.actions.act_window">
        <field name="name">Upload Receipts</field>
        <field name="res_model">ab_odoo_sync_upload_receipt</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_ab_odoo_sync_upload_receipts" name="Upload Receipts" parent="ab_odoo_sync.menu_ab_odoo_sync_root"
              action="action_ab_odoo_sync_upload_receipt" sequence="15" groups="base.group_system"/>
</odoo>
