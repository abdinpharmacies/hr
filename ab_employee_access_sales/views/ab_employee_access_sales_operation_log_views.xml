<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ab_employee_access_sales_operation_log_list" model="ir.ui.view">
            <field name="name">ab_employee_access_sales_operation_log.list</field>
            <field name="model">ab_employee_access_sales_operation_log</field>
            <field name="arch" type="xml">
                <list create="0" delete="0">
                    <field name="operation_at"/>
                    <field name="employee_id"/>
                    <field name="profile_id" optional="hide"/>
                    <field name="store_id"/>
                    <field name="device_name" optional="show"/>
                    <field name="device_ip" optional="show"/>
                    <field name="operation_type"/>
                    <field name="operation_status"/>
                    <field name="manager_employee_id" optional="show"/>
                    <field name="header_id" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_ab_employee_access_sales_operation_log_form" model="ir.ui.view">
            <field name="name">ab_employee_access_sales_operation_log.form</field>
            <field name="model">ab_employee_access_sales_operation_log</field>
            <field name="arch" type="xml">
                <form create="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="operation_at"/>
                                <field name="operation_type"/>
                                <field name="operation_status"/>
                                <field name="employee_id"/>
                                <field name="profile_id"/>
                                <field name="manager_employee_id"/>
                            </group>
                            <group>
                                <field name="store_id"/>
                                <field name="service_user_id"/>
                                <field name="session_id"/>
                                <field name="header_id"/>
                            </group>
                        </group>
                        <group>
                            <field name="device_uid"/>
                            <field name="device_name"/>
                            <field name="device_ip"/>
                        </group>
                        <group>
                            <field name="details_json" widget="text"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_ab_employee_access_sales_operation_log_search" model="ir.ui.view">
            <field name="name">ab_employee_access_sales_operation_log.search</field>
            <field name="model">ab_employee_access_sales_operation_log</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <field name="store_id"/>
                    <field name="operation_type"/>
                    <field name="operation_status"/>
                    <filter name="today" string="Today" domain="[('operation_at', '&gt;=', context_today())]"/>
                </search>
            </field>
        </record>

        <record id="action_ab_employee_access_sales_operation_log" model="ir.actions.act_window">
            <field name="name">Operation Logs</field>
            <field name="res_model">ab_employee_access_sales_operation_log</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_ab_employee_access_sales_operation_log_search"/>
        </record>

        <menuitem
                id="menu_ab_employee_access_sales_operation_log"
                name="Operation Logs"
                parent="menu_ab_employee_access_sales_monitor"
                action="action_ab_employee_access_sales_operation_log"
                sequence="40"
        />
    </data>
</odoo>
