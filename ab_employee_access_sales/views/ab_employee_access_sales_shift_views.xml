<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ab_employee_access_sales_shift_list" model="ir.ui.view">
            <field name="name">ab_employee_access_sales_shift.list</field>
            <field name="model">ab_employee_access_sales_shift</field>
            <field name="arch" type="xml">
                <list>
                    <field name="start_at"/>
                    <field name="employee_id"/>
                    <field name="role_id" optional="show"/>
                    <field name="store_id"/>
                    <field name="service_user_id" optional="show"/>
                    <field name="device_name" optional="show"/>
                    <field name="state"/>
                    <field name="last_activity_at" optional="show"/>
                    <field name="end_at" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_ab_employee_access_sales_shift_form" model="ir.ui.view">
            <field name="name">ab_employee_access_sales_shift.form</field>
            <field name="model">ab_employee_access_sales_shift</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="role_id"/>
                                <field name="store_id"/>
                                <field name="service_user_id"/>
                            </group>
                            <group>
                                <field name="state"/>
                                <field name="device_uid"/>
                                <field name="device_name"/>
                                <field name="close_reason"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="start_at"/>
                                <field name="last_activity_at"/>
                                <field name="end_at"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Sessions">
                                <field name="session_ids" readonly="1">
                                    <list>
                                        <field name="login_at"/>
                                        <field name="state"/>
                                        <field name="device_name"/>
                                        <field name="unlock_count"/>
                                        <field name="logout_at" optional="show"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Operations">
                                <field name="operation_log_ids" readonly="1">
                                    <list create="0" delete="0">
                                        <field name="operation_at"/>
                                        <field name="operation_type"/>
                                        <field name="operation_status"/>
                                        <field name="manager_employee_id" optional="show"/>
                                        <field name="device_name" optional="show"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_ab_employee_access_sales_shift" model="ir.actions.act_window">
            <field name="name">POS Shifts</field>
            <field name="res_model">ab_employee_access_sales_shift</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
                id="menu_ab_employee_access_sales_shift"
                name="Shifts"
                parent="menu_ab_employee_access_sales_monitor"
                action="action_ab_employee_access_sales_shift"
                sequence="10"
                groups="base.group_no_one"
        />
    </data>
</odoo>
