<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ab_employee_access_sales_pos_session_list" model="ir.ui.view">
            <field name="name">ab_employee_access_sales_pos_session.list</field>
            <field name="model">ab_employee_access_sales_pos_session</field>
            <field name="arch" type="xml">
                <list>
                    <field name="login_at"/>
                    <field name="employee_id"/>
                    <field name="profile_id" optional="hide"/>
                    <field name="store_id"/>
                    <field name="service_user_id" optional="show"/>
                    <field name="device_name" optional="show"/>
                    <field name="device_ip" optional="show"/>
                    <field name="state"/>
                    <field name="last_activity_at" optional="show"/>
                    <field name="logout_at" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_ab_employee_access_sales_pos_session_form" model="ir.ui.view">
            <field name="name">ab_employee_access_sales_pos_session.form</field>
            <field name="model">ab_employee_access_sales_pos_session</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="profile_id"/>
                                <field name="role_id"/>
                                <field name="store_id"/>
                            </group>
                            <group>
                                <field name="service_user_id"/>
                                <field name="state"/>
                                <field name="device_uid"/>
                                <field name="device_name"/>
                                <field name="device_ip"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="session_token" password="True"/>
                                <field name="unlock_count"/>
                            </group>
                            <group>
                                <field name="login_at"/>
                                <field name="last_activity_at"/>
                                <field name="locked_at"/>
                                <field name="logout_at"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Operations">
                                <field name="operation_log_ids" readonly="1">
                                    <list create="0" delete="0">
                                        <field name="operation_at"/>
                                        <field name="operation_type"/>
                                        <field name="operation_status"/>
                                        <field name="manager_employee_id" optional="show"/>
                                        <field name="header_id" optional="show"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_ab_employee_access_sales_pos_session" model="ir.actions.act_window">
            <field name="name">POS Sessions</field>
            <field name="res_model">ab_employee_access_sales_pos_session</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
                id="menu_ab_employee_access_sales_pos_session"
                name="Sessions"
                parent="menu_ab_employee_access_sales_monitor"
                action="action_ab_employee_access_sales_pos_session"
                sequence="20"
        />
    </data>
</odoo>
