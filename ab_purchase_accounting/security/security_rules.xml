        <field name="name">Purchase Accounting Config Company Scope</field>
        <field name="model_id" ref="model_ab_purchase_accounting_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_purchase_accounting_receipt_account_company" model="ir.rule">
        <field name="name">Purchase Accounting Receipt Account Company Scope</field>
        <field name="model_id" ref="model_ab_purchase_accounting_receipt_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
