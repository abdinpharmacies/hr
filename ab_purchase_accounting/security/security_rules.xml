<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_purchase_accounting_review_company" model="ir.rule">
        <field name="name">Accounting Review Company Scope</field>
        <field name="model_id" ref="model_ab_purchase_accounting_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_purchase_accounting_review_branch" model="ir.rule">
        <field name="name">Accounting Review Branch Scope</field>
        <field name="model_id" ref="model_ab_purchase_accounting_review"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') or user.has_group('ab_accounting.group_ab_accounting_manager') or user.has_group('ab_purchase.group_ab_purchase_manager') else [('branch_id', 'in', user.inventory_store_ids.ids)]</field>
    </record>
    <record id="rule_purchase_accounting_config_company" model="ir.rule">
        <field name="name">Purchase Accounting Config Company Scope</field>
        <field name="model_id" ref="model_ab_purchase_accounting_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_purchase_accounting_receipt_account_company" model="ir.rule">
        <field name="name">Purchase Accounting Receipt Account Company Scope</field>
        <field name="model_id" ref="model_ab_purchase_accounting_receipt_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
