<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_accounting_config_list" model="ir.ui.view">
        <field name="name">view_purchase_accounting_config_list</field>
        <field name="model">ab_purchase_accounting_config</field>
        <field name="arch" type="xml">
            <list>
                <field name="company_id"/>
                <field name="branch_id"/>
                <field name="activation_date"/>
                <field name="processing_mode"/>
                <field name="purchase_doctype_id"/>
                <field name="return_doctype_id"/>
                <field name="posting_user_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_accounting_config_form" model="ir.ui.view">
        <field name="name">view_purchase_accounting_config_form</field>
        <field name="model">ab_purchase_accounting_config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="company_id"/>
                        <field name="branch_id"/>
                        <field name="active"/>
                        <field name="activation_date"/>
                        <field name="processing_mode"/>
                        <field name="posting_user_id"/>
                    </group>
                    <group string="Document Types">
                        <field name="purchase_doctype_id" domain="[]" required="processing_mode == 'journal'"/>
                        <field name="return_doctype_id" domain="[]" required="processing_mode == 'journal'"/>
                    </group>
                    <group string="Accounts">
                        <field name="inventory_account_id" domain="[('is_final', '=', True), ('active', '=', True)]" required="processing_mode == 'journal'"/>
                        <field name="tax_account_id" domain="[('is_final', '=', True), ('active', '=', True)]"/>
                        <field name="supplier_account_id" domain="[('is_final', '=', True), ('active', '=', True)]" required="processing_mode == 'journal'"/>
                    </group>
                    <separator string="Non-purchase Receipt Offsets"/>
                    <field name="receipt_account_ids" nolabel="1" class="o_ab_responsive_x2many_table o_ab_purchase_accounting_receipt_table">
                        <list editable="bottom">
                            <field name="receipt_type_id"/>
                            <field name="offset_account_id" domain="[('is_final', '=', True), ('active', '=', True)]"/>
                        </list>
                    </field>
                    <group string="Dimensions">
                        <field name="default_costcenter_id"/>
                        <field name="supplier_due_days"/>
                    </group>
                    <group>
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_purchase_accounting_config" model="ir.actions.act_window">
        <field name="name">Purchase Accounting</field>
        <field name="res_model">ab_purchase_accounting_config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_purchase_accounting_config"
              name="Purchase Accounting"
              parent="ab_accounting.accounting_menu"
              action="action_purchase_accounting_config"
              sequence="8"
              groups="ab_accounting.group_ab_accounting_manager"/>
        <record id="view_purchase_accounting_config_form_layout" model="ir.ui.view">
            <field name="name">view_purchase_accounting_config_form.layout</field>
            <field name="model">ab_purchase_accounting_config</field>
            <field name="inherit_id" ref="view_purchase_accounting_config_form"/>
            <field name="priority">90</field>
            <field name="arch" type="xml">
                <xpath expr="(//sheet/group[field[@name=&quot;company_id&quot;]])[not(@col=&quot;4&quot;)]" position="attributes">
                    <attribute name="col">4</attribute>
                </xpath>
                <xpath expr="(//sheet/group[field[@name=&quot;purchase_doctype_id&quot;]])[not(@col=&quot;4&quot;)]" position="attributes">
                    <attribute name="col">4</attribute>
                </xpath>
                <xpath expr="(//sheet/group[field[@name=&quot;inventory_account_id&quot;]])[not(@col=&quot;4&quot;)]" position="attributes">
                    <attribute name="col">4</attribute>
                </xpath>
                <xpath expr="(//sheet/group[field[@name=&quot;default_costcenter_id&quot;]])[not(@col=&quot;4&quot;)]" position="attributes">
                    <attribute name="col">4</attribute>
                </xpath>
                <xpath expr="(//field[@name=&quot;note&quot;])[not(@class=&quot;w-100&quot;)]" position="attributes">
                    <attribute name="colspan">2</attribute>
                    <attribute name="class">w-100</attribute>
                </xpath>
                <xpath expr="//form" position="attributes">
                    <attribute name="class" add="ab_purchase_accounting_config_view_layout" separator=" "/>
                </xpath>
                <xpath expr="//form" position="inside">
                    <style>
                            .ab_purchase_accounting_config_view_layout .o_notebook,
                            .ab_purchase_accounting_config_view_layout .o_notebook_content,
                            .ab_purchase_accounting_config_view_layout .tab-pane,
                            .ab_purchase_accounting_config_view_layout .o_field_widget.o_field_one2many,
                            .ab_purchase_accounting_config_view_layout .o_field_widget.o_field_many2many,
                            .ab_purchase_accounting_config_view_layout .o_field_x2many {
                                min-width: 0;
                                max-width: 100%;
                                overflow: visible !important;
                            }
                            .ab_purchase_accounting_config_view_layout .o_field_x2many .o_list_renderer.table-responsive {
                                width: 100%;
                                max-width: 100%;
                                margin-inline: 0 !important;
                                overflow-x: auto !important;
                                overflow-y: auto !important;
                            }
                        </style>
                </xpath>
            </field>
        </record>
</odoo>
