<odoo>
<record id="category_crm" model="ir.module.category"><field name="name">Customer Operations</field></record>
<record id="privilege_crm" model="res.groups.privilege"><field name="name">CRM and OMS</field><field name="category_id" ref="category_crm"/></record>
<record id="group_user" model="res.groups"><field name="name">Staff</field><field name="privilege_id" ref="privilege_crm"/></record>
<record id="group_manager" model="res.groups"><field name="name">Manager</field><field name="privilege_id" ref="privilege_crm"/><field name="implied_ids" eval="[(4, ref('group_user'))]"/></record>
<record id="base.group_system" model="res.groups"><field name="implied_ids" eval="[(4, ref('group_manager'))]"/></record>
<record id="group_service" model="res.groups"><field name="name">Integration Service Account</field></record></odoo>
