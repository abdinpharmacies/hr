<odoo>
    <record id="source_foundation_form" model="ir.ui.view">
        <field name="name">ab_product_source.foundation.form</field>
        <field name="model">ab_product_source</field>
        <field name="inherit_id" ref="ab_product_source_view_form"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="store_id"/>
                <field name="lot_id" domain="[('product_id', '=', product_id), ('store_id', '=', store_id)]"/>
                <field name="tax_policy_id"/>
                <field name="source_type"/>
                <field name="origin_model"/>
                <field name="origin_res_id"/>
                <field name="origin_database"/>
                <field name="parent_source_id"/>
                <field name="legacy_reference"/>
            </field>
        </field>
    </record>
    <record id="product_stock_configuration_form" model="ir.ui.view">
        <field name="name">ab_product.stock.configuration.form</field>
        <field name="model">ab_product</field>
        <field name="inherit_id" ref="ab_product.ab_product_view_form"/>
        <field name="arch" type="xml">
            <field name="default_price" position="after">
                <field name="no_expiry_allowed"/>
                <field name="allow_sell_fraction"/>
                <field name="stock_rounding"/>
                <field name="stock_uom_id"/>
            </field>
        </field>
    </record>
    <record id="store_company_form" model="ir.ui.view">
        <field name="name">ab_store.source.company.form</field>
        <field name="model">ab_store</field>
        <field name="inherit_id" ref="ab_store.store_view_form"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
            </field>
        </field>
    </record>
    <record id="source_user_stores_form" model="ir.ui.view">
        <field name="name">res.users.source.stores.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <field name="company_ids" position="after">
                <field name="source_store_ids" widget="many2many_tags" groups="base.group_system"/>
            </field>
        </field>
    </record>
    <record id="physical_lot_list" model="ir.ui.view">
        <field name="name">ab_product_lot.list</field>
        <field name="model">ab_product_lot</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="store_id"/>
                <field name="exp_date"/>
                <field name="no_expiry"/>
                <field name="lot_identity" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="physical_lot_form" model="ir.ui.view">
        <field name="name">ab_product_lot.form</field>
        <field name="model">ab_product_lot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="product_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="store_id"/>
                        <field name="exp_date"/>
                        <field name="no_expiry"/>
                        <field name="lot_identity"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="physical_lots_action" model="ir.actions.act_window">
        <field name="name">Physical Lots</field>
        <field name="res_model">ab_product_lot</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="price_history_list" model="ir.ui.view">
        <field name="name">ab_product_price_history.list</field>
        <field name="model">ab_product_price_history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="product_id"/>
                <field name="source_id"/>
                <field name="store_id"/>
                <field name="field_name"/>
                <field name="old_price"/>
                <field name="new_price"/>
                <field name="changed_by"/>
                <field name="changed_at"/>
            </list>
        </field>
    </record>
    <record id="price_history_action" model="ir.actions.act_window">
        <field name="name">Price Change History</field>
        <field name="res_model">ab_product_price_history</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="physical_lots_menu" name="Physical Lots" parent="menu_root" action="physical_lots_action" groups="group_source_user,base.group_system" sequence="70"/>
    <menuitem id="price_history_menu" name="Price Change History" parent="menu_root" action="price_history_action" groups="group_source_user,base.group_system" sequence="80"/>
</odoo>
