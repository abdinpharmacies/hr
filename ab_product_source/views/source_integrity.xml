<odoo>
    <record id="source_integrity_form" model="ir.ui.view">
        <field name="name">ab_product_source.integrity.form</field>
        <field name="model">ab_product_source</field>
        <field name="inherit_id" ref="ab_product_source_view_form"/>
        <field name="arch" type="xml">
            <field name="exp_date" position="after">
                <field name="no_expiry"/>
                <field name="source_identity"/>
            </field>
            <field name="exp_date" position="attributes">
                <attribute name="readonly">no_expiry</attribute>
            </field>
        </field>
    </record>
    <record id="source_integrity_list" model="ir.ui.view">
        <field name="name">ab_product_source.integrity.list</field>
        <field name="model">ab_product_source</field>
        <field name="inherit_id" ref="ab_product_source_view_tree"/>
        <field name="arch" type="xml">
            <field name="exp_date" position="after">
                <field name="no_expiry" optional="show"/>
                <field name="source_identity" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
