<odoo>
    <record id="rule_store_company" model="ir.rule">
        <field name="name">Branches: allowed companies</field>
        <field name="model_id" ref="ab_store.model_ab_store"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_source_company" model="ir.rule">
        <field name="name">Sources: allowed companies</field>
        <field name="model_id" ref="model_ab_product_source"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_source_branch" model="ir.rule">
        <field name="name">Sources: assigned branches or own drafts</field>
        <field name="model_id" ref="model_ab_product_source"/>
        <field name="domain_force">[(1, '=', 1)] if user._source_is_manager() else ['|', ('store_id', 'in', user._source_access_store_ids()), '&amp;', '&amp;', ('store_id', '=', False), ('origin_model', '=', False), ('create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_lot_company" model="ir.rule">
        <field name="name">Physical lots: allowed companies</field>
        <field name="model_id" ref="model_ab_product_lot"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_lot_branch" model="ir.rule">
        <field name="name">Physical lots: assigned branches</field>
        <field name="model_id" ref="model_ab_product_lot"/>
        <field name="domain_force">[(1, '=', 1)] if user._source_is_manager() else [('store_id', 'in', user._source_access_store_ids())]</field>
    </record>
    <record id="rule_history_company" model="ir.rule">
        <field name="name">Price history: allowed companies</field>
        <field name="model_id" ref="model_ab_product_price_history"/>
        <field name="domain_force">[('company_id', 'in', company_ids), '|', ('source_id', '=', False), ('source_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_history_branch" model="ir.rule">
        <field name="name">Price history: assigned branches</field>
        <field name="model_id" ref="model_ab_product_price_history"/>
        <field name="domain_force">[(1, '=', 1)] if user._source_is_manager() else ['|', ('source_id.store_id', 'in', user._source_access_store_ids()), '&amp;', '&amp;', ('source_id.store_id', '=', False), ('source_id.origin_model', '=', False), ('changed_by', '=', user.id)]</field>
    </record>
</odoo>
