<odoo>
    <record id="category_source" model="ir.module.category">
        <field name="name">Product Sources</field>
    </record>
    <record id="privilege_source" model="res.groups.privilege">
        <field name="name">Product Sources</field>
        <field name="category_id" ref="category_source"/>
    </record>
    <record id="group_source_user" model="res.groups">
        <field name="name">Product Source User</field>
        <field name="privilege_id" ref="privilege_source"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('ab_taxes.group_ab_taxes_user'))]"/>
    </record>
    <record id="group_source_manager" model="res.groups">
        <field name="name">Product Source Manager</field>
        <field name="privilege_id" ref="privilege_source"/>
        <field name="implied_ids" eval="[(4, ref('group_source_user'))]"/>
    </record>
</odoo>
