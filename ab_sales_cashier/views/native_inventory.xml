<odoo>
    <record id="native_cash_count_list" model="ir.ui.view">
        <field name="name">ab_sales_native_cash_close.list</field>
        <field name="model">ab_sales_native_cash_close</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="create_date"/>
                <field name="store_id"/>
                <field name="cashier_id"/>
                <field name="expected_amount"/>
                <field name="counted_amount"/>
                <field name="difference"/>
            </list>
        </field>
    </record>
    <record id="native_cash_count_action" model="ir.actions.act_window">
        <field name="name">Native Cash Counts</field>
        <field name="res_model">ab_sales_native_cash_close</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="native_cash_count_menu" name="Native Cash Counts" parent="ab_sales.ab_sales_reports_menu"
              action="native_cash_count_action" groups="ab_sales.group_ab_sales_cashier,ab_sales.group_ab_sales_manager"/>
    <record id="native_cash_count_form" model="ir.ui.view">
        <field name="name">ab_sales_cashier_close_wizard.native.inventory</field>
        <field name="model">ab_sales_cashier_close_wizard</field>
        <field name="inherit_id" ref="ab_sales_cashier_close_wizard_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="native_backend" invisible="1"/>
                <field name="native_cashier_pin" password="True" invisible="not native_backend or context.get('native_cashier_session_token')"/>
            </xpath>
        </field>
    </record>
</odoo>
