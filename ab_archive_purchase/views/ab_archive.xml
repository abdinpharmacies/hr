<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="ab_archive_form_view_inherit" model="ir.ui.view">
            <field name="name">ab_archive_form_view_inherit</field>
            <field name="model">ab_archive</field>
            <field name="inherit_id" ref="ab_archive.ab_archive_view_form"/>
            <field name="mode">extension</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="department_id"/>
                    <field name="notice_ids" widget="many2many_tags"/>
                </xpath>
                <xpath expr="//page[last()]" position="after">
                    <page string="Notice Lines">
                        <field name="notice_line_ids"/>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="ab_archive_search_view_inherit" model="ir.ui.view">
            <field name="name">ab_archive_search_view_inherit</field>
            <field name="model">ab_archive</field>
            <field name="inherit_id" ref="ab_archive.ab_archive_view_search"/>
            <field name="mode">extension</field>
            <field name="arch" type="xml">
                <xpath expr="//field[last()]" position="after">
                    <field name="notice_ids"/>
                </xpath>
            </field>
        </record>

        <menuitem id="ab_archive_menu"
                  name="Archive"
                  parent="ab_purchase.ab_purchase_notices_menu"
                  action="ab_archive.ab_archive_action"
                  sequence="100"/>

    </data>
</odoo>