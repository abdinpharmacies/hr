<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="rule_ab_archive_purchase_ro" model="ir.rule">
            <field name="name">rule_ab_archive_purchase_ro</field>
            <field name="model_id" ref="ab_archive.model_ab_archive"/>
            <field name="groups" eval="[(4, ref('group_ab_archive_purchase_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <!--<field name="global" eval="1"/> -->
        </record>

        <record id="rule_ab_archive_purchase_user_today_all" model="ir.rule">
            <field name="name">rule_ab_archive_purchase_user_today_all</field>
            <field name="model_id" ref="ab_archive.model_ab_archive"/>
            <field name="groups" eval="[(4, ref('group_ab_archive_purchase_user'))]"/>
            <field name="domain_force">[('is_today', '=', True)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <!--<field name="global" eval="1"/> -->
        </record>
    </data>
</odoo>