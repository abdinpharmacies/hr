<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_ab_test" model="ir.module.category">
            <field name="name">AB Sync Test</field>
            <field name="sequence">90</field>
        </record>

        <record id="privilege_ab_test_access" model="res.groups.privilege">
            <field name="name">AB Sync Test Access</field>
            <field name="category_id" ref="module_category_ab_test"/>
        </record>

        <record id="group_ab_test_user" model="res.groups">
            <field name="name">Test User</field>
            <field name="privilege_id" ref="privilege_ab_test_access"/>
        </record>

        <record id="group_ab_test_manager" model="res.groups">
            <field name="name">Test Manager</field>
            <field name="privilege_id" ref="privilege_ab_test_access"/>
            <field name="implied_ids" eval="[Command.link(ref('group_ab_test_user'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_ab_test_manager'))]"/>
        </record>
    </data>
</odoo>
