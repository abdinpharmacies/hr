            <field name="view_mode">list,form</field>
        </record>

        <record id="view_ab_test_header_list" model="ir.ui.view">
            <field name="name">ab_test_header.list</field>
            <field name="model">ab_test_header</field>
            <field name="arch" type="xml">
                <list>
                    <field name="reference"/>
                    <field name="name"/>
                    <field name="transaction_date"/>
                    <field name="category_id"/>
                    <field name="state" widget="badge"/>
                    <field name="priority"/>
                    <field name="line_count"/>
                    <field name="total_amount"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="view_ab_test_header_form" model="ir.ui.view">
            <field name="name">ab_test_header.form</field>
            <field name="model">ab_test_header</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>

                                <field name="header_rel_id"/>
                                <field name="name_computed_stored"/>
                                <field name="reference"/>
                                <field name="name"/>
                                <field name="transaction_date"/>
                                <field name="category_id"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="state"/>
                                <field name="priority"/>
                                <field name="line_count" readonly="1"/>
                                <field name="total_amount" readonly="1"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="category_id"/>
                                        <field name="tag_ids" widget="many2many_tags"/>
                                        <field name="quantity"/>
                                        <field name="unit_price"/>
                                        <field name="subtotal" readonly="1"/>
                                        <field name="planned_date"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Additional Data">
                                <field name="notes"/>
                                <field name="settings_json" widget="ab_pretty_json"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_ab_test_header" model="ir.actions.act_window">
            <field name="name">Test Headers</field>
