<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ab_test_category_list" model="ir.ui.view">
            <field name="name">ab_test_category.list</field>
            <field name="model">ab_test_category</field>
            <field name="arch" type="xml">
                <list>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="color"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="view_ab_test_category_form" model="ir.ui.view">
            <field name="name">ab_test_category.form</field>
            <field name="model">ab_test_category</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="name"/>
                                <field name="parent_id"/>
                            </group>
                            <group>
                                <field name="color"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <field name="description"/>
                        <field name="child_ids" readonly="1">
                            <list>
                                <field name="code"/>
                                <field name="name"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_ab_test_category" model="ir.actions.act_window">
            <field name="name">Test Categories</field>
            <field name="res_model">ab_test_category</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_ab_test_tag_list" model="ir.ui.view">
