<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ab_test_customer_reference_list" model="ir.ui.view">
            <field name="name">ab_test_customer_reference.list</field>
            <field name="model">ab_test_customer_reference</field>
            <field name="arch" type="xml">
                <list>
                    <field name="reference"/>
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="active"/>
                </list>
            </field>
        </record>
        <record id="view_ab_test_customer_reference_form" model="ir.ui.view">
            <field name="name">ab_test_customer_reference.form</field>
            <field name="model">ab_test_customer_reference</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="reference"/>
                                <field name="name"/>
                                <field name="customer_id"/>
                            </group>
                            <group>
                                <field name="active"/>
                            </group>
                        </group>
                        <field name="note"/>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_ab_test_customer_reference" model="ir.actions.act_window">
            <field name="name">Customer Reference Tests</field>
            <field name="res_model">ab_test_customer_reference</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_ab_test_customer_reference" name="Customer References"
                  parent="menu_ab_test_root" action="action_ab_test_customer_reference" sequence="45"/>
    </data>
</odoo>
