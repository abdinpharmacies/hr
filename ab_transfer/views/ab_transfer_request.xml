<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_transfer_request_view_search" model="ir.ui.view">
            <field name="name">ab_transfer_request_view_search</field>
            <field name="model">ab_transfer_request</field>
            <field name="arch" type="xml">
                <search string="Transfer Requests">
                    <field name="display_name"/>
                    <field name="from_store_id"/>
                    <field name="to_store_id"/>
                    <field name="user_id"/>
                    <field name="state"/>
                    <field name="execution_state"/>
                    <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="filter_confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                    <filter name="filter_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <filter name="filter_execution_pending" string="Pending Execution" domain="[('execution_state', '=', 'pending')]"/>
                    <filter name="filter_execution_done" string="Done Execution" domain="[('execution_state', '=', 'done')]"/>
                    <separator/>
                    <filter name="group_by_from_store" string="From Store" context="{'group_by': 'from_store_id'}"/>
                    <filter name="group_by_to_store" string="Destination Branch" context="{'group_by': 'to_store_id'}"/>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_execution_state" string="Execution State" context="{'group_by': 'execution_state'}"/>
                </search>
            </field>
        </record>

        <record id="ab_transfer_request_view_list" model="ir.ui.view">
            <field name="name">ab_transfer_request_view_list</field>
            <field name="model">ab_transfer_request</field>
            <field name="arch" type="xml">
                <list string="Transfer Requests">
                    <field name="display_name"/>
                    <field name="from_store_id"/>
                    <field name="to_store_id"/>
                    <field name="user_id"/>
                    <field name="state"/>
                    <field name="execution_state"/>
                    <field name="items_count"/>
                    <field name="total_requested_qty"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <record id="ab_transfer_request_view_form" model="ir.ui.view">
            <field name="name">ab_transfer_request_view_form</field>
            <field name="model">ab_transfer_request</field>
            <field name="arch" type="xml">
                <form string="Transfer Request">
                    <header>
                        <button name="action_confirm"
                                type="object"
                                string="Confirm"
                                class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_draft"
                                type="object"
                                string="Reset to Draft"
                                invisible="state == 'draft'"/>
                        <button name="action_cancel"
                                type="object"
                                string="Cancel"
                                invisible="state == 'cancelled'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="display_name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="from_store_id" readonly="state != 'draft'"/>
                                <field name="to_store_id" readonly="state != 'draft'" domain="[('allow_transfer', '=', True)]"/>
                                <field name="user_id" readonly="1"/>
                                <field name="notes" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="company_id" readonly="state != 'draft'"/>
                                <field name="execution_state" readonly="1"/>
                                <field name="items_count" readonly="1"/>
                                <field name="total_requested_qty" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids" readonly="state != 'draft'">
                                    <list editable="bottom">
                                        <field name="uom_category_id" column_invisible="1"/>
                                        <field name="product_id" domain="[('active', '=', True)]"/>
                                        <field name="requested_qty"/>
                                        <field name="uom_id" domain="[('category_id', '=', uom_category_id)]"/>
                                        <field name="notes"/>
                                    </list>
                                    <form string="Transfer Request Line">
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="request_id" readonly="1"/>
                                                    <field name="to_store_id" readonly="1"/>
                                                    <field name="product_id" readonly="parent.state != 'draft'" domain="[('active', '=', True)]"/>
                                                    <field name="requested_qty" readonly="parent.state != 'draft'"/>
                                                </group>
                                                <group>
                                                    <field name="uom_category_id" invisible="1"/>
                                                    <field name="uom_id" readonly="parent.state != 'draft'" domain="[('category_id', '=', uom_category_id)]"/>
                                                    <field name="user_id" readonly="1"/>
                                                    <field name="state" readonly="1"/>
                                                    <field name="notes" readonly="parent.state != 'draft'"/>
                                                </group>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ab_transfer_request_action" model="ir.actions.act_window">
            <field name="name">Transfer Request</field>
            <field name="res_model">ab_transfer_request</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_transfer_request_view_search"/>
        </record>

        <menuitem id="ab_transfer_request_parent_menu"
                  name="Transfer Request"
                  parent="menu_root"
                  sequence="15"
                  groups="base.group_system"/>

        <menuitem id="ab_transfer_request_menu"
                  name="Transfer Request"
                  parent="ab_transfer_request_parent_menu"
                  action="ab_transfer_request_action"
                  sequence="10"
                  groups="base.group_system"/>
    </data>
</odoo>
