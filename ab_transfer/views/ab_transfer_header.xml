<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_transfer_header_view_search" model="ir.ui.view">
            <field name="name">ab_transfer_header_view_search</field>
            <field name="model">ab_transfer_header</field>
            <field name="arch" type="xml">
                <search string="Transfers">
                    <field name="display_name"/>
                    <field name="from_store_id"/>
                    <field name="to_store_id"/>
                    <field name="user_id"/>
                    <field name="employee_delivery_id"/>
                    <field name="selection"/>
                    <filter name="filter_prepending" string="Prepending" domain="[('selection', '=', 'prepending')]"/>
                    <filter name="filter_pending" string="Pending" domain="[('selection', '=', 'pending')]"/>
                    <filter name="filter_saved" string="Saved" domain="[('selection', '=', 'saved')]"/>
                    <separator/>
                    <filter name="group_by_from_store" string="From Store" context="{'group_by': 'from_store_id'}"/>
                    <filter name="group_by_to_store" string="To Store" context="{'group_by': 'to_store_id'}"/>
                    <filter name="group_by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'selection'}"/>
                </search>
            </field>
        </record>

        <record id="ab_transfer_header_view_list" model="ir.ui.view">
            <field name="name">ab_transfer_header_view_list</field>
            <field name="model">ab_transfer_header</field>
            <field name="arch" type="xml">
                <list string="Transfers">
                    <field name="display_name"/>
                    <field name="from_store_id"/>
                    <field name="to_store_id"/>
                    <field name="user_id"/>
                    <field name="selection"/>
                    <field name="items_count"/>
                    <field name="total_sell_price"/>
                    <field name="total_cost"/>
                    <field name="is_submitted"/>
                    <field name="sent_at"/>
                    <field name="sent_at"/>
                    <field name="create_uid" optional="hide"/>
                    <field name="create_date" optional="hide"/>
                    <field name="write_uid" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="ab_transfer_header_view_form" model="ir.ui.view">
            <field name="name">ab_transfer_header_view_form</field>
            <field name="model">ab_transfer_header</field>
            <field name="arch" type="xml">
                <form string="Transfer">
                    <header>
                        <button name="action_submit"
                                type="object"
                                string="Submit"
                                class="btn-primary"
                                invisible="is_submitted"/>
                        <field name="selection" widget="statusbar" statusbar_visible="prepending,pending,saved"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="display_name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="from_store_id" readonly="is_submitted"/>
                                <field name="to_store_id" readonly="is_submitted"/>
                                <field name="user_id" readonly="1"/>
                                <field name="notes" readonly="is_submitted"/>
                            </group>
                            <group>
                                <field name="company_id" readonly="is_submitted"/>
                                <field name="items_count" readonly="1"/>
                                <field name="total_sell_price" readonly="1"/>
                                <field name="total_cost" readonly="1"/>
                                <field name="is_submitted" readonly="1"/>
                                <field name="sent_at" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids" readonly="is_submitted">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="class_id"/>
                                        <field name="qty"/>
                                        <field name="expiry_date"/>
                                        <field name="uom_id"/>
                                        <field name="sell_price" readonly="1"/>
                                        <field name="cost" readonly="1"/>
                                        <field name="purchase_price" readonly="1"/>
                                        <field name="tax_value" readonly="1"/>
                                    </list>
                                    <form string="Transfer Line">
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="header_id" readonly="1"/>
                                                    <field name="product_id" readonly="parent.is_submitted"/>
                                                    <field name="class_id" readonly="parent.is_submitted"/>
                                                    <field name="qty" readonly="parent.is_submitted"/>
                                                    <field name="expiry_date" readonly="parent.is_submitted"/>
                                                </group>
                                                <group>
                                                    <field name="uom_id" readonly="parent.is_submitted"/>
                                                    <field name="sell_price" readonly="1"/>
                                                    <field name="cost" readonly="1"/>
                                                    <field name="purchase_price" readonly="1"/>
                                                    <field name="tax_value" readonly="1"/>
                                                </group>
                                            </group>
                                            <group>
                                                <field name="inventory_table_html" widget="html" readonly="1"/>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="Errors">
                                <field name="error_message" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ab_transfer_header_action" model="ir.actions.act_window">
            <field name="name">Smart Transfer</field>
            <field name="res_model">ab_transfer_header</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_transfer_header_view_search"/>
        </record>

        <menuitem id="ab_transfer_header_menu"
                  name="Smart Transfer"
                  parent="ab_transfer_parent_menu"
                  action="ab_transfer_header_action"
                  sequence="10"
                  groups="base.group_system"/>
    </data>
</odoo>
