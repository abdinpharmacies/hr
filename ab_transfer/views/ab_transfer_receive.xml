<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_transfer_receive_header_view_search" model="ir.ui.view">
            <field name="name">ab_transfer_receive_header_view_search</field>
            <field name="model">ab_transfer_receive_header</field>
            <field name="arch" type="xml">
                <search string="Pending Transfer Receives">
                    <field name="transfer_serial"/>
                    <field name="from_store_name"/>
                    <field name="to_store_name"/>
                    <field name="employee_name"/>
                    <field name="notes"/>
                    <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                    <separator/>
                    <filter name="group_by_from_store" string="From Store" context="{'group_by': 'from_store_name'}"/>
                    <filter name="group_by_to_store" string="To Store" context="{'group_by': 'to_store_name'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>

        <record id="ab_transfer_receive_header_view_list" model="ir.ui.view">
            <field name="name">ab_transfer_receive_header_view_list</field>
            <field name="model">ab_transfer_receive_header</field>
            <field name="arch" type="xml">
                <list string="Pending Transfer Receives" create="0" edit="0" delete="0" duplicate="0">
                    <header>
                        <button name="action_sync_pending_receives"
                                type="object"
                                string="Sync"
                                class="btn-primary"
                                display="always"/>
                    </header>
                    <field name="transfer_serial"/>
                    <field name="from_store_name"/>
                    <field name="to_store_name"/>
                    <field name="items_count"/>
                    <field name="sec_insert_date"/>
                    <field name="employee_name"/>
                    <field name="notes"/>
                    <field name="total_sell_value"/>
                    <field name="total_cost_value"/>
                    <field name="destination_activated"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="ab_transfer_receive_header_view_form" model="ir.ui.view">
            <field name="name">ab_transfer_receive_header_view_form</field>
            <field name="model">ab_transfer_receive_header</field>
            <field name="arch" type="xml">
                <form string="Transfer Receive" create="0" edit="0" delete="0" duplicate="0">
                    <header>
                        <button name="action_post_receive"
                                type="object"
                                string="Receive"
                                class="btn-primary"
                                invisible="state != 'pending'"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,received"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="display_name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="transfer_serial" readonly="1"/>
                                <field name="from_store_sql_id" readonly="1"/>
                                <field name="to_store_sql_id" readonly="1"/>
                                <field name="from_store_name" readonly="1"/>
                                <field name="to_store_name" readonly="1"/>
                                <field name="state" readonly="1"/>
                            </group>
                            <group>
                                <field name="items_count" readonly="1"/>
                                <field name="sec_insert_date" readonly="1"/>
                                <field name="stnh_toh_id" readonly="1"/>
                                <field name="employee_name" readonly="1"/>
                                <field name="destination_activated" readonly="1"/>
                                <field name="received_at" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" readonly="1"/>
                        </group>
                        <group>
                            <group>
                                <field name="total_sell_value" readonly="1"/>
                            </group>
                            <group>
                                <field name="total_cost_value" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Items">
                                <field name="line_ids" readonly="1">
                                    <list create="0" edit="0" delete="0">
                                        <field name="product_sql_id"/>
                                        <field name="product_display_name"/>
                                        <field name="class_id"/>
                                        <field name="transferred_qty"/>
                                        <field name="pharm_price"/>
                                        <field name="received_qty"/>
                                        <field name="receive_qty"/>
                                    </list>
                                    <form string="Transfer Receive Item" create="0" edit="0" delete="0">
                                        <sheet>
                                            <group>
                                                <group>
                                                    <field name="transfer_serial" readonly="1"/>
                                                    <field name="product_sql_id" readonly="1"/>
                                                    <field name="product_id" readonly="1"/>
                                                    <field name="product_code" readonly="1"/>
                                                    <field name="product_name" readonly="1"/>
                                                    <field name="class_id" readonly="1"/>
                                                </group>
                                                <group>
                                                    <field name="transferred_qty" readonly="1"/>
                                                    <field name="pharm_price" readonly="1"/>
                                                    <field name="received_qty" readonly="1"/>
                                                    <field name="receive_qty" readonly="1"/>
                                                    <field name="from_store_name" readonly="1"/>
                                                    <field name="to_store_name" readonly="1"/>
                                                </group>
                                            </group>
                                        </sheet>
                                    </form>
                                </field>
                            </page>
                            <page string="Errors">
                                <field name="error_message" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ab_transfer_receive_header_action" model="ir.actions.act_window">
            <field name="name">Receive Transfer</field>
            <field name="res_model">ab_transfer_receive_header</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{'create': False, 'edit': False, 'delete': False, 'duplicate': False,
                                   'search_default_filter_pending':1}</field>
            <field name="search_view_id" ref="ab_transfer_receive_header_view_search"/>
        </record>

        <menuitem id="ab_transfer_receive_header_menu"
                  name="Receive Transfer"
                  parent="menu_root"
                  action="ab_transfer_receive_header_action"
                  sequence="40"
                  groups="base.group_system"/>
    </data>
</odoo>
