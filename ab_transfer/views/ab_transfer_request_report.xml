<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_transfer_request_report_view_search" model="ir.ui.view">
            <field name="name">ab_transfer_request_report_view_search</field>
            <field name="model">ab_transfer_request_report</field>
            <field name="arch" type="xml">
                <search string="Transfer Request Report">
                    <field name="request_id"/>
                    <field name="requesting_store_id"/>
                    <field name="product_id"/>
                    <field name="execution_status"/>
                    <field name="related_transfer_id"/>
                    <filter name="filter_pending" string="Pending Only" domain="[('execution_status', '=', 'pending')]"/>
                    <filter name="filter_partially_executed" string="Partially Executed" domain="[('execution_status', '=', 'partially_executed')]"/>
                    <filter name="filter_fully_executed" string="Fully Executed" domain="[('execution_status', '=', 'fully_executed')]"/>
                    <separator/>
                    <filter name="filter_request_date" date="request_date"/>
                    <separator/>
                    <group>
                        <filter name="group_by_requesting_store" string="Requesting Store" context="{'group_by': 'requesting_store_id'}"/>
                        <filter name="group_by_product" string="Product" context="{'group_by': 'product_id'}"/>
                        <filter name="group_by_request_date" string="Request Date" context="{'group_by': 'request_date:month'}"/>
                        <filter name="group_by_execution_status" string="Execution Status" context="{'group_by': 'execution_status'}"/>
                        <filter name="group_by_related_transfer" string="Related Transfer" context="{'group_by': 'related_transfer_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="ab_transfer_request_report_view_list" model="ir.ui.view">
            <field name="name">ab_transfer_request_report_view_list</field>
            <field name="model">ab_transfer_request_report</field>
            <field name="arch" type="xml">
                <list string="Transfer Request Report" create="0" edit="0" delete="0"
                      decoration-warning="execution_status == 'partially_executed'"
                      decoration-danger="execution_status == 'pending'"
                      decoration-success="execution_status == 'fully_executed'">
                    <field name="request_id"/>
                    <field name="request_date"/>
                    <field name="requesting_store_id"/>
                    <field name="product_id"/>
                    <field name="requested_qty" sum="Requested Quantity"/>
                    <field name="transferred_qty" sum="Transferred Quantity"/>
                    <field name="remaining_qty" sum="Remaining Quantity"/>
                    <field name="execution_status"/>
                    <field name="related_transfer_id"/>
                    <field name="transfer_date"/>
                    <field name="requested_by_id" optional="hide"/>
                    <field name="request_state" optional="hide"/>
                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="ab_transfer_request_report_view_pivot" model="ir.ui.view">
            <field name="name">ab_transfer_request_report_view_pivot</field>
            <field name="model">ab_transfer_request_report</field>
            <field name="arch" type="xml">
                <pivot string="Transfer Request Report" sample="1">
                    <field name="requesting_store_id" type="row"/>
                    <field name="product_id" type="row"/>
                    <field name="execution_status" type="col"/>
                    <field name="requested_qty" type="measure"/>
                    <field name="transferred_qty" type="measure"/>
                    <field name="remaining_qty" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="ab_transfer_request_report_view_graph" model="ir.ui.view">
            <field name="name">ab_transfer_request_report_view_graph</field>
            <field name="model">ab_transfer_request_report</field>
            <field name="arch" type="xml">
                <graph string="Transfer Request Report" type="bar" sample="1">
                    <field name="requesting_store_id"/>
                    <field name="requested_qty" type="measure"/>
                    <field name="transferred_qty" type="measure"/>
                    <field name="remaining_qty" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="ab_transfer_request_report_action" model="ir.actions.act_window">
            <field name="name">Transfer Request Report</field>
            <field name="res_model">ab_transfer_request_report</field>
            <field name="view_mode">list,pivot,graph</field>
            <field name="search_view_id" ref="ab_transfer_request_report_view_search"/>
        </record>

        <menuitem id="ab_transfer_request_report_menu"
                  name="Transfer Request Report"
                  parent="ab_transfer_request_parent_menu"
                  action="ab_transfer_request_report_action"
                  sequence="30"
                  groups="base.group_system"/>
    </data>
</odoo>
