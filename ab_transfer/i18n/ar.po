#. module: ab_transfer
#. odoo-python
#: code:addons/ab_transfer/models/ab_transfer_header.py:0
msgid "An EPlus transfer already references this Odoo transfer, but its lines differ. Inventory reconciliation is required before retrying."
msgstr "يوجد تحويل في إي بلس يشير بالفعل إلى تحويل أودو هذا، لكن سطوره مختلفة. يجب تسوية المخزون قبل إعادة المحاولة."

#. module: ab_transfer
#. odoo-python
#: code:addons/ab_transfer/models/ab_transfer_header.py:0
msgid "Failed to send the transfer to EPlus:\n%s"
msgstr "فشل إرسال التحويل إلى إي بلس:\n%s"

#. module: ab_transfer
#: model:ir.model.fields,field_description:ab_transfer.field_ab_transfer_header__eplus_serial
msgid "EPlus Serial"
msgstr "رقم إي بلس التسلسلي"

#. module: ab_transfer
#. odoo-python
#: code:addons/ab_transfer/models/ab_transfer_header.py:0
msgid "Multiple EPlus transfers already reference this Odoo transfer. Inventory reconciliation is required before retrying."
msgstr "توجد عدة تحويلات في إي بلس تشير إلى تحويل أودو هذا. يجب تسوية المخزون قبل إعادة المحاولة."

#. module: ab_transfer
#. odoo-python
#: code:addons/ab_transfer/models/ab_transfer_header.py:0
msgid "Replica DB serial must be configured before submitting a transfer."
msgstr "يجب ضبط الرقم التسلسلي لقاعدة البيانات الفرعية قبل إرسال التحويل."

#. module: ab_transfer
#. odoo-python
#: code:addons/ab_transfer/models/ab_transfer_header.py:0
msgid "The existing EPlus transfer has status %(status)s. Manual reconciliation is required."
msgstr "حالة تحويل إي بلس الموجود هي %(status)s. يلزم إجراء تسوية يدوية."

#. module: ab_transfer
#. odoo-python
#: code:addons/ab_transfer/models/ab_transfer_header.py:0
msgid "The transfer no longer exists."
msgstr "لم يعد التحويل موجودًا."

#. module: ab_transfer
#. odoo-python
#: code:addons/ab_transfer/models/ab_transfer_header.py:0
msgid "This transfer is already being processed. Please refresh and try again."
msgstr "تجري معالجة هذا التحويل بالفعل. يرجى تحديث الصفحة والمحاولة مرة أخرى."

#. module: ab_transfer
#. odoo-python
#: code:addons/ab_transfer/models/ab_transfer_header.py:0
msgid "This transfer was already sent to EPlus."
msgstr "تم إرسال هذا التحويل إلى إي بلس مسبقًا."

#. module: ab_transfer
#. odoo-python
#: code:addons/ab_transfer/models/ab_transfer_header.py:0
msgid "Transfer notes and the Odoo reference must not exceed 200 characters."
msgstr "يجب ألا تتجاوز ملاحظات التحويل ومرجع أودو 200 حرف."

#. module: ab_transfer
#. odoo-python
#: code:addons/ab_transfer/models/ab_transfer_header.py:0
msgid "empty"
msgstr "فارغة"
