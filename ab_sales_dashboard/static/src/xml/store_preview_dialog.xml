<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="ab_sales_dashboard.StorePreviewDialog">
    <Dialog size="'md'" header="true" title="" footer="true" contentClass="'spd-dialog'" onClose.bind="close">

        <t t-if="state.loading">
            <div class="spd-loading">
                <div class="spd-loading__spinner"/>
                <span class="spd-loading__text">Loading store details...</span>
            </div>
        </t>

        <t t-elif="state.error">
            <div class="spd-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <span t-esc="state.error"/>
            </div>
        </t>

        <t t-else="" t-if="store">
            <div class="spd-hero">
                <div class="spd-hero__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                </div>
                <div class="spd-hero__body">
                    <div class="spd-hero__top">
                        <h2 class="spd-hero__name" t-esc="store.name"/>
                        <div class="spd-hero__badges">
                            <span t-attf-class="spd-badge spd-badge--#{statusCssModifier}">
                                <span class="spd-badge__dot"/>
                                <span t-esc="statusLabel"/>
                            </span>
                            <span class="spd-badge spd-badge--type">
                                <span t-esc="storeTypeLabel"/>
                            </span>
                        </div>
                    </div>
                    <div class="spd-hero__code">
                        <span class="spd-hero__code-label">Code</span>
                        <span class="spd-hero__code-value" t-esc="store.code"/>
                    </div>
                </div>
            </div>

            <div class="spd-info-grid">
                <div class="spd-info-card">
                    <div class="spd-info-card__icon spd-info-card__icon--blue">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                    </div>
                    <div class="spd-info-card__body">
                        <div class="spd-info-card__label">Location</div>
                        <div class="spd-info-card__value" t-esc="locationLabel"/>
                    </div>
                </div>

                <div class="spd-info-card">
                    <div class="spd-info-card__icon spd-info-card__icon--emerald">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                    </div>
                    <div class="spd-info-card__body">
                        <div class="spd-info-card__label">Telephone</div>
                        <div class="spd-info-card__value" t-esc="telephoneLabel"/>
                    </div>
                </div>

                <div class="spd-info-card">
                    <div class="spd-info-card__icon spd-info-card__icon--violet">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                    </div>
                    <div class="spd-info-card__body">
                        <div class="spd-info-card__label">Parent Store</div>
                        <div class="spd-info-card__value" t-esc="parentStoreLabel"/>
                    </div>
                </div>

                <div class="spd-info-card">
                    <div class="spd-info-card__icon spd-info-card__icon--amber">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="1" x2="12" y2="23"/>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                        </svg>
                    </div>
                    <div class="spd-info-card__body">
                        <div class="spd-info-card__label">Max Transfer Value</div>
                        <div class="spd-info-card__value" t-esc="maxTransferLabel"/>
                    </div>
                </div>
            </div>

            <div class="spd-section" t-if="hasIps">
                <div class="spd-section__head">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
                        <rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
                        <line x1="6" y1="6" x2="6.01" y2="6"/>
                        <line x1="6" y1="18" x2="6.01" y2="18"/>
                    </svg>
                    <span>IP Addresses</span>
                </div>
                <div class="spd-ips">
                    <t t-foreach="store.store_ips" t-as="ip" t-key="ip_index">
                        <span class="spd-ip-chip">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="2" width="20" height="8" rx="2" ry="2"/>
                                <rect x="2" y="14" width="20" height="8" rx="2" ry="2"/>
                                <line x1="6" y1="6" x2="6.01" y2="6"/>
                                <line x1="6" y1="18" x2="6.01" y2="18"/>
                            </svg>
                            <span t-esc="ip"/>
                        </span>
                    </t>
                </div>
            </div>

            <div class="spd-section">
                <div class="spd-section__head">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                    <span>Capabilities</span>
                </div>
                <div class="spd-flags">
                    <t t-foreach="featureFlags" t-as="flag" t-key="flag.key">
                        <div t-attf-class="spd-flag #{flag.cssClass}">
                            <div class="spd-flag__indicator">
                                <svg t-if="store[flag.key]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                                <svg t-else="" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="18" y1="6" x2="6" y2="18"/>
                                    <line x1="6" y1="6" x2="18" y2="18"/>
                                </svg>
                            </div>
                            <span class="spd-flag__label" t-esc="flag.label"/>
                        </div>
                    </t>
                </div>
            </div>
        </t>

        <t t-set-slot="footer">
            <div class="spd-footer">
                <button class="spd-btn spd-btn--primary" t-on-click="close">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                    Close
                </button>
            </div>
        </t>

    </Dialog>
</t>

</templates>
