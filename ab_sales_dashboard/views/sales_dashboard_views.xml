<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_ab_sales_dashboard_snapshot_list" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_snapshot_list</field>
            <field name="model">ab_sales_dashboard_snapshot</field>
            <field name="arch" type="xml">
                <list string="Sales Dashboard Reports" class="ab_rl_list" multi_edit="0" sample="1">
                    <field name="name" string="Report" optional="show"/>
                    <field name="date_from" widget="date" string="From" optional="show"/>
                    <field name="date_to" widget="date" string="To" optional="show"/>
                    <field name="total_sales" widget="monetary" string="Total Sales" sum="Sum" optional="show"/>
                    <field name="invoice_count" string="Invoices" sum="Sum" optional="show"/>
                    <field name="total_units_sold" string="Units" optional="show"/>
                    <field name="store_filter_label" string="Branch" optional="show"/>
                    <field name="refresh_date" widget="datetime" string="Generated" optional="show"/>
                    <field name="archive_count" string="Archives" optional="show"/>
                    <field name="unique_products_sold" string="Products" optional="show"/>
                    <field name="stores_with_sales" string="Stores" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_snapshot_search" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_snapshot_search</field>
            <field name="model">ab_sales_dashboard_snapshot</field>
            <field name="arch" type="xml">
                <search string="Sales Dashboard Reports">
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="store_filter_label"/>
                    <filter name="archived" string="Archived" domain="[('archive_ids', '!=', False)]"/>
                </search>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_snapshot_form" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_snapshot_form</field>
            <field name="model">ab_sales_dashboard_snapshot</field>
            <field name="arch" type="xml">
                <form string="Sales Dashboard Report" create="0" edit="0">
                    <header>
                        <button name="action_refresh" type="object" string="Refresh Report" class="btn-secondary"/>
                        <button name="action_archive_report" type="object" string="Archive Report" class="btn-secondary" groups="ab_sales_dashboard.group_ab_sales_dashboard_manager"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_archives"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-archive"
                                    invisible="archive_count == 0"
                                    groups="ab_sales_dashboard.group_ab_sales_dashboard_manager">
                                <field name="archive_count" widget="statinfo" string="Archives"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="refresh_date"/>
                                <field name="store_filter_label"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="store_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <group string="Executive Summary">
                            <field name="total_sales" class="ab-rp-kpi-primary"/>
                            <field name="avg_daily_sales"/>
                            <field name="invoice_count" class="ab-rp-kpi-primary"/>
                            <field name="total_units_sold" class="ab-rp-kpi-primary"/>
                            <field name="prev_avg_daily_sales"/>
                            <field name="avg_daily_growth_pct"/>
                            <field name="bearing_pct"/>
                            <field name="unique_products_sold" class="ab-rp-kpi-primary"/>
                            <field name="total_product_sales"/>
                            <field name="avg_products_per_invoice"/>
                            <field name="stores_with_sales"/>
                            <field name="avg_products_sold_per_store"/>
                        </group>
                        <notebook>
                            <page string="Collection">
                                <field name="collection_line_ids">
                                    <list>
                                        <field name="category" widget="selection_badge"/>
                                        <field name="invoice_count"/>
                                        <field name="total_sales"/>
                                        <field name="pct_of_total" widget="pct_bar"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Users">
                                <field name="user_line_ids">
                                    <list>
                                        <field name="employee_name"/>
                                        <field name="invoice_count"/>
                                        <field name="total_sales"/>
                                        <field name="pct_of_total" widget="pct_bar"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Items">
                                <field name="item_line_ids">
                                    <list>
                                        <field name="eplus_item_code"/>
                                        <field name="item_name"/>
                                        <field name="sale_times"/>
                                        <field name="sold_qty"/>
                                        <field name="total_sales"/>
                                        <field name="current_balance"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Invoices">
                                <field name="invoice_line_ids">
                                    <list>
                                        <field name="invoice_no"/>
                                        <field name="invoice_date"/>
                                        <field name="customer_name"/>
                                        <field name="invoice_total"/>
                                        <field name="item_count"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_report_archive_list" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_report_archive_list</field>
            <field name="model">ab_sales_dashboard_report_archive</field>
            <field name="arch" type="xml">
                <list string="Archived Sales Reports" create="0" edit="0" delete="0">
                    <field name="archive_number"/>
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="store_filter_label"/>
                    <field name="archived_at"/>
                    <field name="archived_by"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_report_archive_form" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_report_archive_form</field>
            <field name="model">ab_sales_dashboard_report_archive</field>
            <field name="arch" type="xml">
                <form string="Archived Sales Report" create="0" edit="0" delete="0">
                    <header>
                        <button name="action_cancel" type="object" string="Cancel Archive" class="btn-secondary" invisible="state == 'cancelled'"/>
                        <field name="state" widget="statusbar" statusbar_visible="archived,cancelled"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="archive_number"/>
                                <field name="name"/>
                                <field name="snapshot_id"/>
                                <field name="archived_at"/>
                                <field name="archived_by"/>
                            </group>
                            <group>
                                <field name="date_from"/>
                                <field name="date_to"/>
                                <field name="store_filter_label"/>
                                <field name="store_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <group string="Integrity">
                            <field name="payload_hash"/>
                            <field name="payload_size_bytes"/>
                            <field name="source_snapshot_write_date"/>
                            <field name="payload_json" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_report_archive_search" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_report_archive_search</field>
            <field name="model">ab_sales_dashboard_report_archive</field>
            <field name="arch" type="xml">
                <search string="Archived Sales Reports">
                    <field name="archive_number"/>
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="store_filter_label"/>
                    <filter name="archived" string="Archived" domain="[('state', '=', 'archived')]"/>
                    <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <filter name="group_archived_by" string="Archived By" domain="[]" context="{'group_by': 'archived_by'}"/>
                    <filter name="group_state" string="State" domain="[]" context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_daily_store_fact_list" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_daily_store_fact_list</field>
            <field name="model">ab_sales_dashboard_daily_store_fact</field>
            <field name="arch" type="xml">
                <list string="Daily Store Facts" create="0" edit="0" delete="0">
                    <field name="report_date"/>
                    <field name="store_id"/>
                    <field name="store_eplus_id"/>
                    <field name="total_sales"/>
                    <field name="invoice_count"/>
                    <field name="medicine_sales"/>
                    <field name="non_medicine_sales"/>
                    <field name="customer_bearing_amount"/>
                    <field name="company_part_amount"/>
                    <field name="contract_net_amount"/>
                </list>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_daily_collection_fact_list" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_daily_collection_fact_list</field>
            <field name="model">ab_sales_dashboard_daily_collection_fact</field>
            <field name="arch" type="xml">
                <list string="Daily Collection Facts" create="0" edit="0" delete="0">
                    <field name="report_date"/>
                    <field name="store_id"/>
                    <field name="store_eplus_id"/>
                    <field name="category"/>
                    <field name="invoice_count"/>
                    <field name="total_sales"/>
                </list>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_daily_user_fact_list" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_daily_user_fact_list</field>
            <field name="model">ab_sales_dashboard_daily_user_fact</field>
            <field name="arch" type="xml">
                <list string="Daily User Facts" create="0" edit="0" delete="0">
                    <field name="report_date"/>
                    <field name="store_id"/>
                    <field name="store_eplus_id"/>
                    <field name="employee_eplus_id"/>
                    <field name="employee_name"/>
                    <field name="invoice_count"/>
                    <field name="total_sales"/>
                    <field name="synced_at"/>
                </list>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_daily_user_fact_pivot" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_daily_user_fact_pivot</field>
            <field name="model">ab_sales_dashboard_daily_user_fact</field>
            <field name="arch" type="xml">
                <pivot string="Daily User Facts">
                    <field name="employee_name" type="row"/>
                    <field name="store_id" type="col"/>
                    <field name="invoice_count" type="measure"/>
                    <field name="total_sales" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_daily_item_fact_list" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_daily_item_fact_list</field>
            <field name="model">ab_sales_dashboard_daily_item_fact</field>
            <field name="arch" type="xml">
                <list string="Daily Item Facts" create="0" edit="0" delete="0">
                    <field name="report_date"/>
                    <field name="store_id"/>
                    <field name="store_eplus_id"/>
                    <field name="item_eplus_id"/>
                    <field name="item_code"/>
                    <field name="product_id"/>
                    <field name="item_name"/>
                    <field name="item_type"/>
                    <field name="sold_qty"/>
                    <field name="sales_amount"/>
                    <field name="invoice_count"/>
                    <field name="sale_times"/>
                </list>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_daily_item_fact_pivot" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_daily_item_fact_pivot</field>
            <field name="model">ab_sales_dashboard_daily_item_fact</field>
            <field name="arch" type="xml">
                <pivot string="Daily Item Facts">
                    <field name="item_name" type="row"/>
                    <field name="store_id" type="col"/>
                    <field name="sold_qty" type="measure"/>
                    <field name="sales_amount" type="measure"/>
                    <field name="invoice_count" type="measure"/>
                    <field name="sale_times" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_daily_item_fact_graph" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_daily_item_fact_graph</field>
            <field name="model">ab_sales_dashboard_daily_item_fact</field>
            <field name="arch" type="xml">
                <graph string="Daily Item Facts" type="bar">
                    <field name="report_date" type="row"/>
                    <field name="sales_amount" type="measure"/>
                    <field name="sold_qty" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_product_sales_report_list" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_product_sales_report_list</field>
            <field name="model">ab_sales_dashboard_product_sales_report</field>
            <field name="arch" type="xml">
                <list string="Product Intelligence" class="psi-list" create="0" edit="0" delete="0">
                    <field name="product_name" widget="list.ps_identity" optional="show"/>
                    <field name="item_type" widget="list.ps_type" optional="show"/>
                    <field name="total_sales" widget="list.ps_revenue" sum="Total" optional="show"/>
                    <field name="units_sold" widget="list.ps_metric" sum="Sum" optional="show"/>
                    <field name="invoice_count" widget="list.ps_metric" sum="Sum" optional="show"/>
                    <field name="branches_sold_in" widget="list.ps_metric" optional="show"/>
                    <field name="sale_times" widget="list.ps_metric" optional="show"/>
                    <field name="average_selling_price" widget="list.ps_avg_price" optional="show"/>
                    <field name="report_date" widget="list.ps_date" optional="show"/>
                    <field name="item_code" widget="list.ps_sku" optional="hide"/>
                    <field name="store_id" widget="list.ps_store" optional="hide"/>
                    <field name="product_id" optional="hide"/>
                    <field name="item_eplus_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_product_sales_report_pivot" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_product_sales_report_pivot</field>
            <field name="model">ab_sales_dashboard_product_sales_report</field>
            <field name="arch" type="xml">
                <pivot string="Product Sales Report">
                    <field name="report_date" interval="month" type="col"/>
                    <field name="item_type" type="row"/>
                    <field name="units_sold" type="measure"/>
                    <field name="total_sales" type="measure"/>
                    <field name="invoice_count" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_product_sales_report_graph" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_product_sales_report_graph</field>
            <field name="model">ab_sales_dashboard_product_sales_report</field>
            <field name="arch" type="xml">
                <graph string="Product Sales Report" type="bar">
                    <field name="report_date" interval="month" type="row"/>
                    <field name="total_sales" type="measure"/>
                    <field name="units_sold" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_product_sales_report_search" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_product_sales_report_search</field>
            <field name="model">ab_sales_dashboard_product_sales_report</field>
            <field name="arch" type="xml">
                <search string="Product Sales Report">
                    <field name="report_date"/>
                    <field name="store_id"/>
                    <field name="product_id"/>
                    <field name="item_eplus_id"/>
                    <field name="item_code"/>
                    <field name="item_type"/>
                    <filter name="medicine" string="Medicine" domain="[('item_type', '=', 'medicine')]"/>
                    <filter name="non_medicine" string="Non-Medicine" domain="[('item_type', '=', 'non_medicine')]"/>
                    <filter name="positive_sales" string="Has Sales" domain="[('total_sales', '&gt;', 0)]"/>
                    <filter name="positive_qty" string="Has Quantity" domain="[('units_sold', '&gt;', 0)]"/>
                    <filter name="group_product" string="Product" domain="[]" context="{'group_by': 'product_id'}"/>
                    <filter name="group_store" string="Store" domain="[]" context="{'group_by': 'store_id'}"/>
                    <filter name="group_item_type" string="Medicine Split" domain="[]" context="{'group_by': 'item_type'}"/>
                </search>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_reconciliation_job_list" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_reconciliation_job_list</field>
            <field name="model">ab_sales_dashboard_reconciliation_job</field>
            <field name="arch" type="xml">
                <list string="Reconciliation Jobs" class="ab-recon-list" decoration-danger="state == 'failed'" decoration-warning="state == 'partial'" decoration-success="state == 'done'" decoration-info="state == 'running'" decoration-muted="state == 'cancelled'">
                    <field name="display_name" string="Job" widget="list.rcon_job" optional="show"/>
                    <field name="state" widget="list.rcon_state" optional="show"/>
                    <field name="store_filter_key" string="Branch Scope" widget="list.rcon_scope" optional="show"/>
                    <field name="date_from" string="Date Range" widget="list.rcon_date_range" optional="show"/>
                    <field name="date_to" optional="hide"/>
                    <field name="total_branch_days" widget="list.rcon_metric" sum="Total"/>
                    <field name="missing_branch_days" widget="list.rcon_metric" sum="Total"/>
                    <field name="processed_branch_days" widget="list.rcon_metric" sum="Total"/>
                    <field name="failed_branch_days" widget="list.rcon_metric" sum="Total"/>
                    <field name="chunk_count" widget="list.rcon_chunks" sum="Total"/>
                    <field name="completed_chunk_count" optional="hide" sum="Total"/>
                    <field name="failed_chunk_count" widget="list.rcon_metric" optional="hide" sum="Total"/>
                    <field name="started_at"/>
                    <field name="completed_at"/>
                    <field name="created_by" widget="list.rcon_creator" optional="show"/>
                </list>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_reconciliation_job_form" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_reconciliation_job_form</field>
            <field name="model">ab_sales_dashboard_reconciliation_job</field>
            <field name="arch" type="xml">
                <form string="Reconciliation Job" class="ab-recon-form">
                    <header>
                        <button name="action_analyze_coverage" type="object" string="Analyze Coverage" class="btn-primary" display="always" invisible="state == 'running'"/>
                        <button name="action_start_reconciliation" type="object" string="Start Reconciliation" class="btn-primary" display="always" invisible="state not in ('ready', 'partial', 'failed')"/>
                        <button name="action_retry_failed_chunks" type="object" string="Retry Failed" class="btn-secondary" display="always" invisible="state not in ('partial', 'failed')"/>
                        <button name="action_cancel" type="object" string="Cancel" class="btn-danger" display="always" invisible="state in ('done', 'cancelled')"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,analyzing,ready,running,partial,done,failed,cancelled"/>
                    </header>
                    <sheet>
                        <div class="rcon-form-header">
                            <div class="rcon-form-header__row">
                                <div class="rcon-form-header__title-wrap">
	                                    <field name="display_name" readonly="1" nolabel="1" class="rcon-form-header__title-field"/>
                                </div>
                                <div class="rcon-form-header__meta">
                                    <span class="rcon-form-header__meta-pill">
                                        <i class="fa fa-user-circle" title="Created by"/> <field name="created_by" readonly="1" nolabel="1"/>
                                    </span>
                                    <span class="rcon-form-header__meta-pill">
                                        <i class="fa fa-calendar" title="Date from"/> <field name="date_from" readonly="1" nolabel="1"/>
                                        <span class="rcon-separator"><i class="fa fa-arrow-right" title="to"/></span>
                                        <field name="date_to" readonly="1" nolabel="1"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="rcon-metrics-row">
                            <div class="rcon-metric">
                                <div class="rcon-metric__icon rcon-metric__icon--blue"><i class="fa fa-calendar-check-o" title="Processed"/></div>
                                <div class="rcon-metric__body">
                                    <div class="rcon-metric__label">Total Days</div>
                                    <div class="rcon-metric__value"><field name="total_branch_days" readonly="1" nolabel="1"/></div>
                                </div>
                            </div>
                            <div class="rcon-metric">
                                <div class="rcon-metric__icon rcon-metric__icon--emerald"><i class="fa fa-check-circle" title="Completed"/></div>
                                <div class="rcon-metric__body">
                                    <div class="rcon-metric__label">Covered</div>
                                    <div class="rcon-metric__value"><field name="covered_branch_days" readonly="1" nolabel="1"/></div>
                                </div>
                            </div>
                            <div class="rcon-metric">
                                <div class="rcon-metric__icon rcon-metric__icon--amber"><i class="fa fa-exclamation-triangle" title="Last processed"/></div>
                                <div class="rcon-metric__body">
                                    <div class="rcon-metric__label">Missing</div>
                                    <div class="rcon-metric__value"><field name="missing_branch_days" readonly="1" nolabel="1"/></div>
                                </div>
                            </div>
                            <div class="rcon-metric">
                                <div class="rcon-metric__icon rcon-metric__icon--cyan"><i class="fa fa-cogs" title="Processing"/></div>
                                <div class="rcon-metric__body">
                                    <div class="rcon-metric__label">Processed</div>
                                    <div class="rcon-metric__value"><field name="processed_branch_days" readonly="1" nolabel="1"/></div>
                                </div>
                            </div>
                            <div class="rcon-metric">
                                <div class="rcon-metric__icon rcon-metric__icon--rose"><i class="fa fa-times-circle" title="Errors"/></div>
                                <div class="rcon-metric__body">
                                    <div class="rcon-metric__label">Failed</div>
                                    <div class="rcon-metric__value"><field name="failed_branch_days" readonly="1" nolabel="1"/></div>
                                </div>
                            </div>
                            <div class="rcon-metric">
                                <div class="rcon-metric__icon rcon-metric__icon--violet"><i class="fa fa-puzzle-piece" title="Chunks"/></div>
                                <div class="rcon-metric__body">
                                    <div class="rcon-metric__label">Chunks</div>
                                    <div class="rcon-metric__value"><field name="chunk_count" readonly="1" nolabel="1"/> / <field name="completed_chunk_count" readonly="1" nolabel="1"/></div>
                                </div>
                            </div>
                        </div>
                        <div class="rcon-progress-section" invisible="state not in ('running', 'partial', 'done', 'failed')">
                            <div class="rcon-progress-section__title">Coverage Progress</div>
                            <div class="rcon-progress-stats">
                                <span>Processed:</span>
                                <span class="rcon-progress-stats__pct"><field name="processed_branch_days" readonly="1" nolabel="1"/></span>
                                <span>of</span>
                                <span class="rcon-progress-stats__pct"><field name="missing_branch_days" readonly="1" nolabel="1"/></span>
                                <span>missing days</span>
                            </div>
                        </div>
                        <div class="rcon-error-panel" invisible="not last_error">
                            <div class="rcon-error-panel__title">Last Error</div>
                            <div class="rcon-error-panel__message"><field name="last_error" readonly="1" nolabel="1"/></div>
                        </div>
                        <div class="rcon-detail-card">
                            <div class="rcon-detail-card__header">
                                <span class="rcon-detail-card__icon"><i class="fa fa-clock-o" title="Schedule"/></span>
                                <span class="rcon-detail-card__title">Schedule &amp; Timing</span>
                            </div>
                            <div class="rcon-detail-card__grid">
                                <div class="rcon-detail-card__field">
                                    <span class="rcon-detail-card__label">Date From</span>
                                    <span class="rcon-detail-card__value"><field name="date_from" readonly="state != 'draft'" nolabel="1"/></span>
                                </div>
                                <div class="rcon-detail-card__field">
                                    <span class="rcon-detail-card__label">Date To</span>
                                    <span class="rcon-detail-card__value"><field name="date_to" readonly="state != 'draft'" nolabel="1"/></span>
                                </div>
                                <div class="rcon-detail-card__field" invisible="state == 'draft'">
                                    <span class="rcon-detail-card__label">Started At</span>
                                    <span class="rcon-detail-card__value"><field name="started_at" readonly="1" nolabel="1"/></span>
                                </div>
                                <div class="rcon-detail-card__field" invisible="state == 'draft'">
                                    <span class="rcon-detail-card__label">Completed At</span>
                                    <span class="rcon-detail-card__value"><field name="completed_at" readonly="1" nolabel="1"/></span>
                                </div>
                                <div class="rcon-detail-card__field" invisible="state == 'draft'">
                                    <span class="rcon-detail-card__label">Last Processed</span>
                                    <span class="rcon-detail-card__value"><field name="last_processed_date" readonly="1" nolabel="1"/></span>
                                </div>
                            </div>
                        </div>
                        <div class="rcon-detail-card" invisible="state not in ('running', 'partial', 'done', 'failed')">
                            <div class="rcon-detail-card__header">
                                <span class="rcon-detail-card__icon"><i class="fa fa-building-o" title="Branch scope"/></span>
                                <label for="store_filter_label" string="Branch Scope" class="rcon-detail-card__title"/>
                                <span class="rcon-detail-card__count">
                                    <field name="store_count" readonly="1" nolabel="1"/>
                                    <span>Branches</span>
                                </span>
                            </div>
                            <div class="rcon-branch-scope">
                                <field name="store_ids" invisible="1"/>
                                <field name="store_filter_label" readonly="1" nolabel="1" class="rcon-branch-scope__list"/>
                            </div>
                            <div class="rcon-detail-card__field">
                                <span class="rcon-detail-card__label">Filter Key</span>
                                <span class="rcon-detail-card__value rcon-detail-card__value--mono"><field name="store_filter_key" readonly="1" nolabel="1"/></span>
                            </div>
                        </div>
                        <notebook>
                            <page string="Chunks">
                                <field name="chunk_ids" readonly="1">
                                    <list string="Chunks" create="0" edit="0" delete="0" decoration-danger="state == 'failed'" decoration-success="state == 'done'" decoration-info="state == 'running'">
                                        <field name="sequence"/>
                                        <field name="date_from"/>
                                        <field name="date_to"/>
                                        <field name="store_filter_key"/>
                                        <field name="branch_day_count"/>
                                        <field name="state"/>
                                        <field name="attempt_count"/>
                                        <field name="source_duration_ms"/>
                                        <field name="persistence_duration_ms"/>
                                        <field name="error_message"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_reconciliation_job_search" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_reconciliation_job_search</field>
            <field name="model">ab_sales_dashboard_reconciliation_job</field>
            <field name="arch" type="xml">
                <search string="Reconciliation Jobs">
                    <field name="name"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="store_filter_key"/>
                    <filter name="ready" string="Ready" domain="[('state', '=', 'ready')]"/>
                    <filter name="running" string="Running" domain="[('state', '=', 'running')]"/>
                    <filter name="partial" string="Partial" domain="[('state', '=', 'partial')]"/>
                    <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                    <filter name="group_state" string="State" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_created_by" string="Created By" domain="[]" context="{'group_by': 'created_by'}"/>
                </search>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_report_telemetry_list" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_report_telemetry_list</field>
            <field name="model">ab_sales_dashboard_report_telemetry</field>
            <field name="arch" type="xml">
                <list string="Reporting Analytics" class="ab_activity_list" create="0" edit="0" delete="0">
                    <field name="event_type" widget="list.activity_event_type" optional="show"/>
                    <field name="coverage_state" widget="list.activity_status" optional="show"/>
                    <field name="duration_ms" widget="list.activity_performance" optional="show"/>
                    <field name="report_mode" widget="list.activity_report_mode" optional="show"/>
                    <field name="store_scope_bucket" widget="list.activity_scope" optional="show"/>
                    <field name="range_bucket" widget="list.activity_range" optional="show"/>
                    <field name="result_size_bytes" widget="list.activity_result_size" optional="show"/>
                    <field name="snapshot_used" string="Sources" widget="list.activity_sources" optional="show"/>
                    <field name="unsupported_user_section" string="Warnings" widget="list.activity_warnings" optional="show"/>
                    <field name="event_date" widget="list.activity_time" optional="show"/>
                    <field name="create_uid" string="Created By" optional="show"/>
                    <field name="requested_days" widget="list.activity_metric" optional="hide"/>
                    <field name="selected_store_count" widget="list.activity_metric" optional="hide"/>
                    <field name="created_at" string="Created At" widget="list.activity_time" optional="hide"/>
                    <field name="daily_fact_used" optional="hide"/>
                    <field name="item_fact_used" optional="hide"/>
                    <field name="archive_used" optional="hide"/>
                    <field name="product_report_used" optional="hide"/>
                    <field name="unsupported_item_section" optional="hide"/>
                    <field name="unsupported_customer_section" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_report_telemetry_pivot" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_report_telemetry_pivot</field>
            <field name="model">ab_sales_dashboard_report_telemetry</field>
            <field name="arch" type="xml">
                <pivot string="Reporting Analytics">
                    <field name="event_date" type="row" interval="month"/>
                    <field name="event_type" type="col"/>
                    <field name="operation_count" type="measure"/>
                    <field name="duration_ms" type="measure"/>
                    <field name="maximum_duration_ms" type="measure"/>
                    <field name="result_size_bytes" type="measure"/>
                    <field name="requested_days" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_report_telemetry_graph" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_report_telemetry_graph</field>
            <field name="model">ab_sales_dashboard_report_telemetry</field>
            <field name="arch" type="xml">
                <graph string="Reporting Analytics" type="bar">
                    <field name="event_date" interval="day"/>
                    <field name="event_type"/>
                    <field name="operation_count" type="measure"/>
                </graph>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_report_telemetry_search" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_report_telemetry_search</field>
            <field name="model">ab_sales_dashboard_report_telemetry</field>
            <field name="arch" type="xml">
                <search string="Reporting Analytics">
                    <field name="event_date"/>
                    <field name="event_type"/>
                    <field name="report_mode"/>
                    <field name="range_bucket"/>
                    <field name="store_scope_bucket"/>
                    <field name="coverage_state"/>
                    <filter name="unsupported_employee" string="Employee Unsupported" domain="[('unsupported_user_section', '=', True)]"/>
                    <filter name="unsupported_product" string="Product Unsupported" domain="[('unsupported_item_section', '=', True)]"/>
                    <filter name="unsupported_customer" string="Customer Unsupported" domain="[('unsupported_customer_section', '=', True)]"/>
                    <filter name="group_event_date" string="Event Date" domain="[]" context="{'group_by': 'event_date'}"/>
                    <filter name="group_event_type" string="Event Type" domain="[]" context="{'group_by': 'event_type'}"/>
                    <filter name="group_report_mode" string="Report Mode" domain="[]" context="{'group_by': 'report_mode'}"/>
                    <filter name="group_range_bucket" string="Range Bucket" domain="[]" context="{'group_by': 'range_bucket'}"/>
                    <filter name="group_store_scope" string="Store Scope" domain="[]" context="{'group_by': 'store_scope_bucket'}"/>
                    <filter name="group_coverage" string="Coverage State" domain="[]" context="{'group_by': 'coverage_state'}"/>
                </search>
            </field>
        </record>

        <record id="view_ab_sales_dashboard_fact_decision_form" model="ir.ui.view">
            <field name="name">ab_sales_dashboard_fact_decision_form</field>
            <field name="model">ab_sales_dashboard_fact_decision</field>
            <field name="arch" type="xml">
                <form string="Fact-Grain Decision" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <field name="measurement_period"/>
                            <field name="long_range_report_count"/>
                        </group>
                        <group string="Employee Reporting">
                            <field name="employee_unsupported_count"/>
                            <field name="employee_gap_percentage"/>
                        </group>
                        <group string="Customer Reporting">
                            <field name="customer_unsupported_count"/>
                            <field name="customer_gap_percentage"/>
                        </group>
                        <group string="Product Reporting">
                            <field name="product_unsupported_count"/>
                            <field name="product_gap_percentage"/>
                            <field name="item_coverage_complete_percentage"/>
                        </group>
                        <group string="Performance">
                            <field name="average_duration_ms"/>
                            <field name="average_result_size_bytes"/>
                        </group>
                        <group string="Recommendation">
                            <field name="recommendation_code"/>
                            <field name="recommendation_reason" nolabel="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
