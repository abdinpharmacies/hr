<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ab_accounting_future_deposit_view_tree" model="ir.ui.view">
            <field name="name">ab_accounting_future_deposit_view_tree</field>
            <field name="model">ab_accounting_future</field>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <list string="ab_accounting_future_deposit_view_tree" multi_edit="1"
                      decoration-info="je_created">
                    <field name="je_created" invisible="1"/>
                    <field name="debit_val" optional="show" string="Deposit Value"/>
                    <field name="store_id" optional="show"/>
                    <field name="due_date" optional="show"/>
                    <field name="costcenter_id" optional="show"/>
                    <field name="doc_no" optional="show"/>
                    <field name="explain" optional="show"/>
                    <field name="account_id" optional="show" string="Debit Account"/>
                    <field name="sett_account_id" optional="show" string="Credit Account"/>
                    <field name="create_uid" optional="hide"/>
                    <field name="create_date" optional="hide"/>
                    <field name="write_uid" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                    <field name="je_created" invisible="1"/>
                    <button name="btn_create_je" type="object"
                            string="Create JE" class="btn-primary"
                            confirm="Are you sure?"

                     invisible="je_created == True"/>
                </list>
            </field>
        </record>
        <record id="ab_accounting_future_payment_view_tree" model="ir.ui.view">
            <field name="name">ab_accounting_future_payment_view_tree</field>
            <field name="mode">primary</field>
            <field name="model">ab_accounting_future</field>
            <field name="arch" type="xml">
                <list string="ab_accounting_future_payment_view_tree" multi_edit="1"
                      decoration-info="je_created">
                    <field name="je_created" invisible="1"/>
                    <field name="credit_val" optional="show" string="Payment Value"/>
                    <field name="store_id" optional="show"/>
                    <field name="due_date" optional="show"/>
                    <field name="costcenter_id" optional="show"/>
                    <field name="doc_no" optional="show"/>
                    <field name="explain" optional="show"/>
                    <field name="account_id" optional="show" string="Credit account"/>
                    <field name="sett_account_id" optional="show" string="Debit account"/>
                    <field name="create_uid" optional="hide"/>
                    <field name="create_date" optional="hide"/>
                    <field name="write_uid" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                    <field name="je_created" invisible="1"/>
                    <button name="btn_create_je" type="object"
                            string="Create JE" class="btn-primary"
                            confirm="Are you sure?"

                     invisible="je_created == True"/>
                </list>
            </field>
        </record>

        <record id="ab_accounting_future_deposit_view_form" model="ir.ui.view">
            <field name="name">ab_accounting_future_deposit_view_form</field>
            <field name="mode">primary</field>
            <field name="model">ab_accounting_future</field>
            <field name="arch" type="xml">
                <form string="ab_accounting_future_deposit_view_form">
                    <sheet>
                        <field name="je_created" invisible="1"/>
                        <widget name="web_ribbon" title="JE Created" bg_color="bg-info"
                                invisible="je_created == False"/>
                        <group string="Deposit To Account (Debit)">
                            <field name="debit_val" string="Deposit Value" class="wider-label"/>
                            <field name="account_id" string="Deposit Account" placeholder="Example: Supplier Account, Cash Account, Bank Account, Custody Account, ..."/>
                            <field name="costcenter_id" placeholder="Example: Choose Supplier for Supplier Account, Choose Custody Responsible for Custody Account."/>
                        </group>

                        <group string="From (Credit)">
                            <field name="sett_account_id" string="From Account (Credit)" class="wider-label" placeholder="Example: Income Account."/>
                            <field name="sett_costcenter_id"/>
                        </group>
                        <group string="Other Data">
                            <field name="store_id" class="wider-label"/>
                            <field name="due_date"/>
                            <field name="doc_no"/>
                            <field name="explain"/>
                            <field name="user_id" force_save="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_accounting_future_payment_view_form" model="ir.ui.view">
            <field name="name">ab_accounting_future_payment_view_form</field>
            <field name="model">ab_accounting_future</field>
            <field name="arch" type="xml">
                <form string="ab_accounting_future_payment_view_form">
                    <sheet>
                        <field name="je_created" invisible="1"/>
                        <widget name="web_ribbon" title="JE Created" bg_color="bg-info"
                                invisible="je_created == False"/>
                        <group string="Payment From Account (Credit)">
                            <field name="credit_val" string="Payment Value" class="wider-label"/>
                            <field name="account_id" string="Account" placeholder="Example: Supplier Account, Cash Account, Bank Account, Custody Account, ..."/>
                            <field name="costcenter_id" placeholder="Example: Choose Supplier for Supplier Account, Choose Custody Responsible for Custody Account."/>
                        </group>

                        <group string="To Account (Debit)">
                            <field name="sett_account_id" string="To Account (Debit)" class="wider-label" placeholder="Example: Expense Account."/>
                            <field name="sett_costcenter_id" class="wider-label"/>
                        </group>

                        <group string="Other Data">
                            <field name="store_id" class="wider-label"/>
                            <field name="due_date"/>
                            <field name="doc_no"/>
                            <field name="explain"/>
                            <field name="user_id" force_save="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ab_accounting_future_view_search" model="ir.ui.view">
            <field name="name">ab_accounting_future_view_search</field>
            <field name="model">ab_accounting_future</field>
            <field name="arch" type="xml">
                <search string="ab_accounting_future_search">
                    <field name="credit_val"/>
                    <field name="debit_val"/>
                    <field name="store_id"/>
                    <field name="due_date"/>
                    <field name="costcenter_id"/>
                    <field name="doc_no"/>
                    <field name="explain"/>
                    <field name="account_id"/>
                    <field name="sett_account_id"/>
                </search>
            </field>
        </record>
        <record id="ab_accounting_future_view_pivot" model="ir.ui.view">
            <field name="name">ab_accounting_future_view_pivot</field>
            <field name="model">ab_accounting_future</field>
            <field name="arch" type="xml">
                <pivot string="ab_accounting_future_pivot">
                </pivot>
            </field>
        </record>

        <record id="ab_accounting_future_deposit_action" model="ir.actions.act_window">
            <field name="name">Deposit Order</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_accounting_future</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('ab_accounting_future_deposit_view_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('ab_accounting_future_deposit_view_form')})]"/>
            <field name="domain">[('order_type', '=', 'deposit')]</field>
        </record>

        <record id="ab_accounting_future_payment_action" model="ir.actions.act_window">
            <field name="name">Payment Order</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_accounting_future</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('ab_accounting_future_payment_view_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('ab_accounting_future_payment_view_form')})]"/>
            <field name="context">{'default_order_type': 'payment'}</field>
            <field name="domain">[('order_type', '=', 'payment')]</field>
        </record>


        <menuitem id="ab_accounting_future_menu_deposit"
                  name="Deposit Order"
                  parent="ab_accounting_future_sub_menu"
                  action="ab_accounting_future_deposit_action"
                  sequence="10"/>

        <menuitem id="ab_accounting_future_menu_payment"
                  name="Payment Order"
                  parent="ab_accounting_future_sub_menu"
                  action="ab_accounting_future_payment_action"
                  sequence="20"/>
        <!-- ################################################################ -->
        <record id="ab_accounting_future_all_orders_view_tree" model="ir.ui.view">
            <field name="name">ab_accounting_future_all_orders_view_tree</field>
            <field name="model">ab_accounting_future</field>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <list string="ab_accounting_future_all_orders_view_tree" multi_edit="1"
                      decoration-info="je_created">
                    <field name="je_created" invisible="1"/>
                    <field name="debit_val" optional="show" string="Debit Value"/>
                    <field name="account_id" optional="show" string="Debit Account"/>
                    <field name="costcenter_id" optional="show"/>

                    <field name="credit_val" optional="show" string="Credit Value"/>
                    <field name="sett_account_id" optional="show" string="Credit Account"/>
                    <field name="sett_costcenter_id" optional="show" string="Credit Costcenter"/>

                    <field name="store_id" optional="show"/>
                    <field name="due_date" optional="show"/>
                    <field name="doc_no" optional="show"/>
                    <field name="explain" optional="show"/>
                    <field name="create_uid" optional="hide"/>
                    <field name="create_date" optional="hide"/>
                    <field name="write_uid" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                    <field name="je_created" invisible="1"/>
                    <button name="btn_create_je" type="object"
                            string="Create JE" class="btn-primary"
                            confirm="Are you sure?"

                     invisible="je_created == True"/>
                </list>
            </field>
        </record>

        <record id="ab_accounting_future_all_orders_view_form" model="ir.ui.view">
            <field name="name">ab_accounting_future_all_orders_view_form</field>
            <field name="mode">primary</field>
            <field name="model">ab_accounting_future</field>
            <field name="arch" type="xml">
                <form string="ab_accounting_future_all_orders_view_form">
                    <sheet>
                        <field name="je_created" invisible="1"/>
                        <widget name="web_ribbon" title="JE Created" bg_color="bg-info"
                                invisible="je_created == False"/>
                        <group string="Debit Account">
                            <field name="debit_val" string="Debit Value" class="wider-label"/>
                            <field name="account_id" string="Debit Account" placeholder="Example: Supplier Account, Cash Account, Bank Account, Custody Account, ..."/>
                            <field name="costcenter_id" string="Example: Choose Supplier for Supplier Account, Choose Custody Responsible for Custody Account."/>
                        </group>

                        <group string="Credit Account">
                            <field name="sett_account_id" string="Credit Account" class="wider-label"/>
                            <field name="sett_costcenter_id"/>
                        </group>
                        <group string="Other Data">
                            <field name="store_id" class="wider-label"/>
                            <field name="due_date"/>
                            <field name="doc_no"/>
                            <field name="explain"/>
                            <field name="user_id" force_save="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="ab_accounting_future_all_orders_action" model="ir.actions.act_window">
            <field name="name">All Orders</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_accounting_future</field>
            <field name="view_mode">list,form,pivot</field>
            <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'list', 'view_id': ref('ab_accounting_future_all_orders_view_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('ab_accounting_future_all_orders_view_form')})]"/>
            <field name="context">{}</field>
            <field name="domain">[]</field>
        </record>


        <menuitem id="ab_accounting_future_all_orders_menu"
                  name="All Orders"
                  parent="ab_accounting_future_sub_menu"
                  action="ab_accounting_future_all_orders_action"
                  sequence="50"/>

    </data>
</odoo>