<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="privilege_ab_accounting_ab_accounting_category" model="res.groups.privilege">
            <field name="name">ab_accounting_category</field>
            <field name="category_id" ref="ab_accounting.ab_accounting_category"/>
        </record>
<record id="group_je_future_user" model="res.groups">
            <field name="name">group_je_future_user</field>
            <field name="privilege_id" ref="privilege_ab_accounting_ab_accounting_category"/>
        </record>

        <record id="ab_accounting.group_ab_accounting_accountant" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_je_future_user'))]"/>
        </record>
    </data>
</odoo>
