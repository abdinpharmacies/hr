<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_sales_line_view_tree_inherit_doctor" model="ir.ui.view">
            <field name="name">ab_sales_line_view_tree_inherit_doctor</field>
            <field name="model">ab_sales_line</field>
            <field name="inherit_id" ref="ab_sales.ab_sales_line_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list//field[@name='product_id']" position="after">
                    <field name="is_doctor_prescription_product" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

