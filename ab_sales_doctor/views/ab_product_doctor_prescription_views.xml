<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_product_doctor_prescription_view_list" model="ir.ui.view">
            <field name="name">ab_product_doctor_prescription_view_list</field>
            <field name="model">ab_product_doctor_prescription</field>
            <field name="arch" type="xml">
                <list>
                    <field name="doctor_id"/>
                    <field name="product_id"/>
                    <field name="product_code"/>
                    <field name="uom_id"/>
                    <field name="qty"/>
                    <field name="sell_price"/>
                    <field name="last_sales_header_id"/>
                    <field name="note"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="ab_product_doctor_prescription_view_form" model="ir.ui.view">
            <field name="name">ab_product_doctor_prescription_view_form</field>
            <field name="model">ab_product_doctor_prescription</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="doctor_id"/>
                                <field name="product_id"/>
                                <field name="product_code" readonly="1"/>
                                <field name="uom_id"/>
                            </group>
                            <group>
                                <field name="qty"/>
                                <field name="sell_price"/>
                                <field name="last_sales_header_id" readonly="1"/>
                                <field name="last_sales_line_id" readonly="1"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ab_product_doctor_prescription_view_search" model="ir.ui.view">
            <field name="name">ab_product_doctor_prescription_view_search</field>
            <field name="model">ab_product_doctor_prescription</field>
            <field name="arch" type="xml">
                <search>
                    <field name="doctor_id"/>
                    <field name="product_id"/>
                    <field name="product_code"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                    <group>
                        <filter name="group_doctor" string="Doctor" context="{'group_by': 'doctor_id'}"/>
                        <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="ab_product_doctor_prescription_action" model="ir.actions.act_window">
            <field name="name">Doctor Prescription Products</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_product_doctor_prescription</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>

