<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_doctor_view_list" model="ir.ui.view">
            <field name="name">ab_doctor_view_list</field>
            <field name="model">ab_doctor</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="phone"/>
                    <field name="specialty"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="ab_doctor_view_form" model="ir.ui.view">
            <field name="name">ab_doctor_view_form</field>
            <field name="model">ab_doctor</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                            </group>
                            <group>
                                <field name="phone"/>
                                <field name="specialty"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Prescription Products">
                                <field name="prescription_product_ids">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="product_code" readonly="1"/>
                                        <field name="uom_id"/>
                                        <field name="qty"/>
                                        <field name="sell_price"/>
                                        <field name="last_sales_header_id" readonly="1"/>
                                        <field name="note"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ab_doctor_view_search" model="ir.ui.view">
            <field name="name">ab_doctor_view_search</field>
            <field name="model">ab_doctor</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="phone"/>
                    <field name="specialty"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="ab_doctor_action" model="ir.actions.act_window">
            <field name="name">Doctors</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_doctor</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
