<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ab_sales_doctor.PosActionDoctorInherit"
       t-inherit="ab_sales.PosAction"
       t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o_ab_sales_pos_customer_group')]" position="before">
            <div class="o_ab_sales_pos_top_group o_ab_sales_pos_doctor_group ab_pos_topbar_group_doctor">
                <div class="o_ab_sales_pos_field_row ab_pos_doctor_prescription_row">
                    <div class="form-check form-switch m-0 ab_pos_doctor_prescription_toggle">
                        <input class="form-check-input ab_pos_doctor_prescription_toggle_input"
                               type="checkbox"
                               id="ab_sales_doctor_prescription_toggle"
                               t-att-checked="currentBill.header.is_doctor_prescription"
                               t-on-change="onDoctorPrescriptionToggle"/>
                        <label class="form-check-label small ab_pos_doctor_prescription_toggle_label"
                               for="ab_sales_doctor_prescription_toggle">
                            Prescription
                        </label>
                    </div>
                    <t t-if="currentBill.header.is_doctor_prescription">
                        <ABMany2one
                                relation="'ab_doctor'"
                                value="doctorValue()"
                                update="onDoctorM2OUpdate"
                                placeholder="doctorPlaceholder()"
                                domain="() => [['active', '=', true]]"
                                canCreate="false"
                                canCreateEdit="false"
                                canQuickCreate="false"
                                canOpen="false"
                                canWrite="true"
                                string="_t('Doctor')"
                        />
                        <button class="btn btn-outline-primary btn-sm ab_pos_doctor_btn_add"
                                type="button"
                                t-on-click="openDoctorCreateDialog">
                            Add
                        </button>
                    </t>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[contains(@class, 'o_ab_sales_pos_product_hint')]" position="inside">
            <t t-if="currentBill.header.is_doctor_prescription and currentBill.header.doctor_id">
                <span class="badge text-bg-success ab_pos_product_hint_badge_doctor">Doctor Products</span>
            </t>
        </xpath>

        <xpath expr="//div[contains(@class, 'o_ab_sales_pos_lines_table')]//th[contains(@class, 'ab_pos_lines_head_actions')]" position="before">
            <th class="ab_pos_lines_head_doctor_prescription" title="Doctor Prescription">
                Rx
            </th>
        </xpath>

        <xpath expr="//div[contains(@class, 'o_ab_sales_pos_lines_table')]//td[contains(@class, 'ab_pos_line_cell_actions')]" position="before">
            <td class="ab_pos_line_cell_doctor_prescription text-center">
                <input class="form-check-input ab_pos_line_doctor_prescription_input"
                       type="checkbox"
                       t-att-checked="line.is_doctor_prescription_product"
                       t-att-disabled="!currentBill.header.is_doctor_prescription"
                       t-on-change="(ev) => onLineDoctorPrescriptionChange(line, ev)"/>
            </td>
        </xpath>
    </t>

    <t t-name="ab_sales_doctor.ProductCardInherit"
       t-inherit="ab_sales.ProductCard"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-if='p.is_pinned']" position="before">
            <t t-if="p.is_doctor_prescription_product">
                <span class="badge text-bg-success">Doctor</span>
            </t>
        </xpath>
    </t>

    <t t-name="ab_sales_doctor.DoctorCreateDialog">
        <Dialog title="_t('Add Doctor to Main')">
            <div class="ab_sales_doctor_create_dialog">
                <div class="row g-2">
                    <div class="col-12">
                        <label class="form-label" t-esc="_t('Name')"/>
                        <input class="form-control"
                               t-att-value="state.name"
                               required="required"
                               t-on-input="(ev) => updateField('name', ev)"/>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">
                            <t t-esc="_t('Code')"/>
                            <span class="text-danger">*</span>
                        </label>
                        <input class="form-control"
                               t-att-value="state.code"
                               required="required"
                               t-on-input="(ev) => updateField('code', ev)"/>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" t-esc="_t('Phone')"/>
                        <input class="form-control"
                               t-att-value="state.phone"
                               t-on-input="(ev) => updateField('phone', ev)"/>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">
                            <t t-esc="_t('Specialty')"/>
                            <span class="text-danger">*</span>
                        </label>
                        <input class="form-control"
                               t-att-value="state.specialty"
                               required="required"
                               t-on-input="(ev) => updateField('specialty', ev)"/>
                    </div>
                </div>
                <t t-if="state.message">
                    <div class="text-danger small mt-2" t-esc="state.message"/>
                </t>
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <button class="btn btn-outline-secondary"
                            type="button"
                            t-on-click="props.close"
                            t-att-disabled="state.submitting">
                        Cancel
                    </button>
                    <button class="btn btn-primary"
                            type="button"
                            t-on-click="submit"
                            t-att-disabled="state.submitting">
                        <t t-if="state.submitting">Adding...</t>
                        <t t-else="">Add</t>
                    </button>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
