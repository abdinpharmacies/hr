<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--User Groups, Access Rights and Security Mechanism in Detail-->
    <!-- https://www.youtube.com/watch?v=mzg3EGD_6Gw&list=PLqRRLx0cl0hoJhjFWkFYowveq2Zn55dhM&index=53  -->
    <record model="ir.module.category" id="module_category_ab_fixed_asset">
        <field name="name">Abdin Fa</field>
        <field name="description">Category For ab_fixed_asset</field>
        <field name="sequence">47</field>
    </record>
        <record id="privilege_module_category_ab_fixed_asset" model="res.groups.privilege">
            <field name="name">Abdin Fa</field>
            <field name="category_id" ref="module_category_ab_fixed_asset"/>
        </record>


    <record id="group_ab_fixed_asset_user" model="res.groups">
        <field name="name">ab_fixed_asset User</field>
        <field name="privilege_id" ref="privilege_module_category_ab_fixed_asset"/>
    </record>

    <record id="group_ab_fixed_asset_manager" model="res.groups">
        <field name="name">ab_fixed_asset Manager</field>
        <field name="privilege_id" ref="privilege_module_category_ab_fixed_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_ab_fixed_asset_user'))]"/>
    </record>

    <record id="group_ab_fixed_asset_admin" model="res.groups">
        <field name="name">ab_fixed_asset Administrator</field>
        <field name="privilege_id" ref="privilege_module_category_ab_fixed_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_ab_fixed_asset_manager'))]"/>
    </record>

    <record id="group_ab_fixed_asset_accountant" model="res.groups">
        <field name="name">group_ab_fixed_asset_accountant</field>
        <field name="privilege_id" ref="privilege_module_category_ab_fixed_asset"/>
        <field name="implied_ids" eval="[(4, ref('ab_accounting.group_ab_accounting_accountant'))]"/>
    </record>


    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('ab_fixed_asset.group_ab_fixed_asset_admin'))]"/>
    </record>

</odoo>
