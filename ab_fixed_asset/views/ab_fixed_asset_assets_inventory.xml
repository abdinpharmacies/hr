<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="ab_fixed_asset_assets_inventory_list">
            <field name="name">Abdin assets_inventory list</field>
            <field name="model">ab_fixed_asset_assets_inventory</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id" class="text-muted"/>
                    <field name="final_level"/>
                    <field name="current_store_id"/>
                    <field name="inventory_line_ids" widget="many2many_tags"/>
                    <field name="asset_total_value" optional="show" sum="Total Value"/>
                    <field name="total_depr" optional="show" sum="Total Depr."/>
                    <field name="current_value_after_depr" optional="show" sum="Total After Depr."/>
                    <field name="useful_life" optional="show"/>
                    <field name="depreciation_rate" optional="show"/>
                    <field name="asset_has_accounting_value" optional="show"/>
                    <field name="je_count" optional="show"/>
                    <field name="last_depreciation_date" optional="show"/>
                    <field name="inventory_standards_ids" widget="many2many_tags" optional="hide"/>
                    <field name="asset_status"/>
                    <field name="description"/>
                    <field name="manual_value" optional="show"/>
                    <field name="costcenter_id" optional="hide"/>
                    <field name="asset_source" optional="hide"/>
                    <field name="is_company_ownership" optional="show"/>
                    <field name="old_id_to_move_img" optional="hide"/>
                    <field name="create_uid" optional="hide"/>
                    <field name="create_date" optional="hide"/>
                    <field name="write_uid" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                    <button name="btn_depreciate" type="object"
                            groups="ab_fixed_asset.group_ab_fixed_asset_user"
                            string="Depreciate" class="btn-primary"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="ab_fixed_asset_assets_inventory_search">
            <field name="name">Abdin search</field>
            <field name="model">ab_fixed_asset_assets_inventory</field>
            <field name="arch" type="xml">
                <search>
                    <field name="id" string="Asset ID"/>
                    <field name="current_store_id"/>
                    <field name="final_level"/>
                    <field name="asset_status"/>
                    <field name="quantity"/>
                    <field name="manual_value"/>
                    <field name="useful_life"/>
                    <field name="depreciation_rate"/>
                    <field name="description"/>
                    <filter name="filter_with_accounting_value" string="With Accounting Value"
                            domain="[('asset_has_accounting_value','=',True)]"/>
                    <separator/>
                    <filter name="filter_without_accounting_value" string="Without Accounting Value"
                            domain="[('asset_has_accounting_value','=',False)]"/>
                    <separator/>
                    <filter name="filter_with_je" string="With JE"
                            domain="[('je_count','!=',0)]"/>
                    <separator/>
                    <filter name="filter_without_je" string="Without JE"
                            domain="[('je_count','=',0)]"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="ab_fixed_asset_assets_inventory_form">
            <field name="name">Abdin form</field>
            <field name="model">ab_fixed_asset_assets_inventory</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <field name="asset_status" invisible="1"/>
                        <widget name="web_ribbon" title="Active" bg_color="bg-success"
                                invisible="asset_status != 'active'"/>

                        <widget name="web_ribbon" title="New" bg_color="bg-primary"
                                invisible="asset_status != 'new'"/>

                        <widget name="web_ribbon" title="Scrapped" bg_color="bg-warning"
                                invisible="asset_status != 'scrapped'"/>

                        <widget name="web_ribbon" title="Disposed" bg_color="bg-danger"
                                invisible="asset_status != 'disposed'"/>

                        <widget name="web_ribbon" title="Unknown" bg_color="bg-secondary" class="text-danger"
                                invisible="asset_status != 'unknown'"/>

                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                                invisible="active == True"/>

                        <div class="oe_title text-center">
                            <h1>
                                <span>Serial: --- </span>
                                <field nolabel="1" name="id" class="text-muted"/>
                                <span> ---</span>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="active" invisible="1"/>
                                <field name="current_store_id" required="1"/>
                                <field name="final_level"/>
                                <field name="asset_source" required="1"/>
                                <field name="asset_type" required="1"/>
                                <field name="costcenter_id"/>
                                <field name="is_company_ownership"/>
                                <field name="manual_value"/>
                                <field name="scrapping_value" readonly="1"/>
                                <field name="useful_life" required="1"/>
                                <field name="depreciation_rate" options="{'editable':true}" widget="progressbar"/>
                                <field name="description" required="1"/>
                            </group>
                            <group>
                                <field name="image"
                                       widget="image"
                                       options='{"size": [300, 300]}'
                                       class="oe_avatar"/>
                            </group>
                        </group>

                        <div class="row text-center">
                            <div class="card border-info col-sm-12 col-md-10 col-lg-8 col-xl-6 mx-auto">
                                <div class="card-header h4 text-white bg-info">Asset Computations</div>
                                <div class="card-body">
                                    <div class="card-title h6 row">
                                        <div class="col-4 p-0"><label for="asset_total_value"/></div>
                                        <div class="col-4 p-0"><label for="total_depr"/></div>
                                        <div class="col-4 p-0"><label for="current_value_after_depr"/></div>
                                    </div>
                                    <hr/>
                                    <div class="card-text row h6 ">
                                        <div class="col-4 text-info"><field name="asset_total_value"/></div>
                                        <div class="col-4 text-warning"><field name="total_depr"/></div>
                                        <div class="col-4"><field
                                                decoration-success="current_value_after_depr &gt; 0"
                                                decoration-danger="current_value_after_depr &lt; 0"
                                                name="current_value_after_depr"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <notebook>
                            <field name="je_count" invisible="1"/>
                            <page string="JE Lines"
                                  invisible="je_count == 0">
                                <button name="btn_depreciate" type="object" string="Depreciate" class="btn-primary"/>
                                <group>
                                    <field name="je_line_ids" nolabel="1"/>
                                </group>
                            </page>
                            <page string="Inventory Lines">
                                <field name="inventory_line_ids">
                                    <list editable="bottom">
                                        <field name="name" required="1"/>
                                        <field name="qty"/>
                                        <field name="price"/>
                                        <field name="total_price" sum="Total Value"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Standards">
                                <field name="inventory_standards_ids">
                                    <list editable="top">
                                        <field name="standard_id"/>
                                        <field name="measure_unit" optional="show"/>
                                        <field name="example" optional="hide"/>
                                        <field name="standard_value"/>
                                    </list>
                                </field>
                            </page>

                        </notebook>
                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="ab_fixed_asset_assets_inventory_view_pivot" model="ir.ui.view">
            <field name="name">ab_fixed_asset_assets_inventory_view_pivot</field>
            <field name="model">ab_fixed_asset_assets_inventory</field>
            <field name="arch" type="xml">
                <pivot string="ab_fixed_asset_assets_inventory_pivot">
                </pivot>
            </field>
        </record>


        <record id="ab_fixed_asset_assets_inventory_action" model="ir.actions.act_window">
            <field name="name">Ab fixed asset assets inventory</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_fixed_asset_assets_inventory</field>
            <field name="view_mode">list,form,pivot</field>
        </record>

        <menuitem id="ab_fixed_asset.assets_inventory_menu"
                  name="Assets Inventory"
                  parent="asset_inventory_sub_menu"
                  action="ab_fixed_asset_assets_inventory_action"
                  sequence="100"/>

    </data>
</odoo>