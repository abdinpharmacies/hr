<odoo>
    <data>
        <!--##################################################################-->
        <record model="ir.ui.view" id="ab_fixed_asset_second_level_list">
            <field name="name">Abdin second_level list</field>
            <field name="model">ab_fixed_asset_second_level</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="first_level"/>
                </list>
            </field>
        </record>

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="ab_fixed_asset_second_level_act">
            <field name="name">Abdin second_level window</field>
            <field name="res_model">ab_fixed_asset_second_level</field>
            <field name="view_mode">list,form</field>
        </record>
        <!--##################################################################-->
        <record model="ir.ui.view" id="ab_fixed_asset_first_level_list">
            <field name="name">Abdin first_level list</field>
            <field name="model">ab_fixed_asset_first_level</field>
            <field name="arch" type="xml">
                <list multi_edit="1">
                    <field name="name"/>
                    <field name="account_id"/>
                </list>
            </field>
        </record>

        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="ab_fixed_asset_first_level_act">
            <field name="name">Abdin first_level window</field>
            <field name="res_model">ab_fixed_asset_first_level</field>
            <field name="view_mode">list,form</field>
        </record>
        <!--##################################################################-->
        <record model="ir.ui.view" id="ab_fixed_asset_standards_list">
            <field name="name">Abdin standards list</field>
            <field name="model">ab_fixed_asset_standards</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="name"/>
                    <field name="measure_unit"/>
                    <field name="example"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>
        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="ab_fixed_asset_standards_act">
            <field name="name">Abdin standards window</field>
            <field name="res_model">ab_fixed_asset_standards</field>
            <field name="view_mode">list,form</field>
        </record>

        <!--##################################################################-->
        <record model="ir.ui.view" id="ab_fixed_asset_final_level_list">
            <field name="name">Abdin final_level list</field>
            <field name="model">ab_fixed_asset_final_level</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="second_level"/>
                    <field name="first_level"/>
                    <field name="standards_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="ab_fixed_asset_final_level_form">
            <field name="name">Abdin final_level form</field>
            <field name="model">ab_fixed_asset_final_level</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="second_level"/>
                            <field name="first_level"/>
                        </group>
                        <notebook>
                            <page string="Standards">
                                <field name="standards_ids">
                                    <list editable="top">
                                        <field name="name"/>
                                        <field name="measure_unit"/>
                                        <field name="example"/>
                                    </list>
                                </field>

                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="ab_fixed_asset_final_level_search">
            <field name="name">Abdin search</field>
            <field name="model">ab_fixed_asset_final_level</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>


        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="ab_fixed_asset_final_level_act">
            <field name="name">Abdin final_level window</field>
            <field name="res_model">ab_fixed_asset_final_level</field>
            <field name="view_mode">list,form</field>
        </record>

        <!--        ######################################################################-->


        <menuitem name="Standards" id="ab_fixed_asset_standards" parent="config_sub_menu"
                  action="ab_fixed_asset_standards_act" sequence="50"/>

        <menuitem name="First Level" id="ab_fixed_asset_first_level" parent="asset_levels_sub_menu"
                  action="ab_fixed_asset_first_level_act" sequence="20"/>


        <menuitem name="Second Level" id="ab_fixed_asset_second_level" parent="asset_levels_sub_menu"
                  action="ab_fixed_asset_second_level_act" sequence="30"/>

        <menuitem name="Final Level" id="ab_fixed_asset_final_level" parent="asset_levels_sub_menu"
                  action="ab_fixed_asset_final_level_act" sequence="40"/>


    </data>
</odoo>
