<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_fixed_asset_move_wizard_view_tree" model="ir.ui.view">
            <field name="name">ab_fixed_asset_move_wizard_view_tree</field>
            <field name="model">ab_fixed_asset_move_wizard</field>
            <field name="arch" type="xml">
                <list string="ab_fixed_asset_move_wizard_tree"
                      decoration-success="is_submitted"
                      decoration-danger="is_confirmed"
                >
                    <field name="move_type" optional="show"/>
                    <field name="src_fixed_asset_ids" optional="show" widget="many2many_tags"/>
                    <field name="dest_fixed_asset_id" optional="show"/>
                    <field name="dest_store_id" optional="show"/>
                    <field name="is_submitted" optional="show"/>
                    <field name="is_confirmed" optional="show"/>
                    <field name="create_uid" optional="show"/>
                    <field name="create_date" optional="show"/>
                    <field name="write_uid" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="ab_fixed_asset_move_wizard_view_form" model="ir.ui.view">
            <field name="name">ab_fixed_asset_move_wizard_view_form</field>
            <field name="model">ab_fixed_asset_move_wizard</field>
            <field name="arch" type="xml">
                <form string="ab_fixed_asset_move_wizard_form">
                    <header>
                        <button name="btn_submit" type="object"
                                string="Submit" class="btn-primary"
                                groups="ab_fixed_asset.group_ab_fixed_asset_manager"
                        />
                        <button name="btn_confirm" type="object"
                                string="Confirm" class="btn-info"
                                groups="ab_fixed_asset.group_ab_fixed_asset_accountant"
                        />
                    </header>
                    <sheet>
                        <field name="is_submitted" invisible="1"/>
                        <field name="is_confirmed" invisible="1"/>
                        <field name="src_inventory_line_ids" invisible="1"/>
                        <widget name="web_ribbon" title="Submitted" bg_color="bg-success"
                                invisible="is_submitted == False"/>
                        <widget name="web_ribbon" title="Confirmed" bg_color="bg-info"
                                invisible="is_confirmed == False"/>
                        <group>
                            <field name="move_type"
                                   readonly="is_submitted == True"/>
                            <field name="src_fixed_asset_ids" widget="many2many_tags"
                                   readonly="is_submitted == True"/>
                            <field name="dest_fixed_asset_id"
                                   invisible="move_type not in ['partially_transfer', 'partially_depr']" required="move_type in ['partially_transfer', 'partially_depr']" readonly="is_submitted == True"/>
                            <field name="dest_store_id"
                                   invisible="move_type in ['partially_transfer', 'partially_depr', 'change_useful_life', 'change_basic_data', 'asset_loss', False]" required="move_type not in ['partially_transfer', 'partially_depr', 'change_useful_life', 'change_basic_data', 'asset_loss', False]" readonly="is_submitted == True"/>
                            <field name="scrapping_value"
                                   invisible="move_type != 'scrapping'" required="move_type == 'scrapping'" readonly="is_submitted == True"/>
                            <field name="extra_useful_life"
                                   invisible="move_type != 'change_useful_life'" required="move_type == 'change_useful_life'" readonly="is_submitted == True"/>
                            <field name="new_description"
                                   invisible="move_type != 'change_basic_data'" readonly="is_submitted == True"/>
                            <field name="new_image"
                                   widget="image" options='{"size": [300, 300]}' class="oe_avatar"
                                   invisible="move_type != 'change_basic_data'" readonly="is_submitted == True"/>
                            <field name="remove_costcenter"
                                   invisible="move_type != 'change_basic_data'" readonly="is_submitted == True"/>
                            <field name="new_costcenter_id"
                                   force_save="1"
                                   invisible="move_type != 'change_basic_data'" readonly="(is_submitted == True or remove_costcenter == True)"/>
                        </group>

                        <div class="row border border-info" invisible="move_type not in ['partially_transfer', 'partially_depr']" readonly="is_submitted == True">
                            <div class="col-6">
                                <div class="row pt-3">
                                    <div class="col-12">
                                        <label for="src_inventory_line_transfer_ids" style="font-weight: bold"/>
                                    </div>
                                    <div class="col-12">
                                        <field name="src_inventory_line_transfer_ids">
                                            <list editable="bottom">
                                                <field name="line_id"
                                                       domain="[('id','in',parent.src_inventory_line_ids)]"/>
                                                <field name="price"/>
                                                <field name="transfer_qty"/>
                                            </list>
                                        </field>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="row pt-3">
                                    <div class="col-4">
                                        <label for="je_src_credit_value" style="font-weight: bold"/>
                                    </div>
                                    <div class="col-8">
                                        <field name="je_src_credit_value"
                                               invisible="move_type not in ['partially_transfer', 'partially_depr']" required="move_type in ['partially_transfer', 'partially_depr']" readonly="is_submitted == True"/>

                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4">
                                        <label for="je_dst_debit_value" style="font-weight: bold"/>
                                    </div>
                                    <div class="col-8">
                                        <field name="je_dst_debit_value"
                                               invisible="move_type not in ['partially_transfer', 'partially_depr']" required="move_type in ['partially_transfer', 'partially_depr']" readonly="is_submitted == True"/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-4">
                                        <label for="partially_explain" style="font-weight: bold"/>
                                    </div>
                                    <div class="col-8">
                                        <div class="abdin-textbox-container">
                                            <field name="partially_explain"
                                                   class="abdin-textbox"
                                                   invisible="move_type not in ['partially_transfer', 'partially_depr']" required="move_type in ['partially_transfer', 'partially_depr']" readonly="is_submitted == True"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <notebook>
                            <page string="Source Inventory Lines"
                                  invisible="move_type not in ['partially_transfer', 'partially_depr']">
                                <field name="src_inventory_line_ids" options="{'no_create': True}">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="name"/>
                                        <field name="qty"/>
                                        <field name="price"/>
                                        <field name="total_price"/>
                                    </list>
                                </field>
                                <button name="btn_add_src_asset_inventory_line" type="object"
                                        string="Add Source Inventory Line" class="btn-primary"/>
                            </page>
                            <page string="Destination Inventory Lines"
                                  invisible="move_type not in ['partially_transfer', 'partially_depr']">
                                <field name="dst_inventory_line_ids" widget="one2many" options="{'no_create': True}">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="name"/>
                                        <field name="qty"/>
                                        <field name="price"/>
                                        <field name="total_price"/>
                                    </list>
                                </field>
                                <button name="btn_add_dst_asset_inventory_line" type="object" string="Add Dest Inventory Line" class="btn-primary"/>
                            </page>
                            <page string="From Asset(s)">
                                <field name="src_fixed_asset_ro_ids">
                                    <list>
                                        <field name="id" optional="show"/>
                                        <field name="current_store_id" optional="show"/>
                                        <field name="asset_total_value" optional="show"/>
                                        <field name="useful_life" optional="show"/>
                                        <field name="total_depr" optional="show"/>
                                        <field name="current_value_after_depr" optional="show"/>
                                        <field name="description" optional="show"/>
                                        <field name="scrapping_value" optional="show"/>
                                        <field name="inventory_line_ids" widget="many2many_tags" optional="show"/>
                                    </list>
                                </field>
                            </page>
                            <page string="To Asset" invisible="dest_fixed_asset_id == False">
                                <group>
                                    <field name="dest_asset_useful_life" class="wider-label"/>
                                    <field name="dest_asset_total_value"/>
                                    <field name="dest_asset_total_depr"/>
                                    <field name="dest_asset_after_depr"/>
                                </group>
                                <field name="dest_fixed_asset_line_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="qty"/>
                                        <field name="price"/>
                                        <field name="total_price"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="message_ids"/>
                    </div>

                </form>
            </field>
        </record>
        <record id="ab_fixed_asset_move_wizard_view_search" model="ir.ui.view">
            <field name="name">ab_fixed_asset_move_wizard_view_search</field>
            <field name="model">ab_fixed_asset_move_wizard</field>
            <field name="arch" type="xml">
                <search string="ab_fixed_asset_move_wizard_search">
                    <field name="move_type"/>
                    <field name="src_fixed_asset_ids"/>
                    <field name="dest_fixed_asset_id"/>
                    <field name="dest_store_id"/>
                    <field name="is_submitted"/>
                    <field name="is_confirmed"/>
                    <field name="create_uid"/>
                    <field name="create_date"/>
                    <field name="write_uid"/>
                    <field name="write_date"/>
                </search>
            </field>
        </record>
        <record id="ab_fixed_asset_move_wizard_view_pivot" model="ir.ui.view">
            <field name="name">ab_fixed_asset_move_wizard_view_pivot</field>
            <field name="model">ab_fixed_asset_move_wizard</field>
            <field name="arch" type="xml">
                <pivot string="ab_fixed_asset_move_wizard_pivot">
                </pivot>
            </field>
        </record>


        <record id="ab_fixed_asset_move_wizard_action" model="ir.actions.act_window">
            <field name="name">Ab fixed asset move wizard</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_fixed_asset_move_wizard</field>
            <field name="view_mode">list,form,pivot</field>
        </record>

        <menuitem id="ab_fixed_asset_move_wizard_menu"
                  name="Movement Wizard"
                  parent="asset_movement_sub_menu"
                  action="ab_fixed_asset_move_wizard_action"
                  sequence="100"/>

    </data>
</odoo>