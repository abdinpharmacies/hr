<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_accounting_je_header_view_inherit" model="ir.ui.view">
            <field name="name">ab_accounting_je_header</field>
            <field name="model">ab_accounting_je_header</field>
            <field name="inherit_id" ref="ab_accounting.ab_accounting_je_header_view_form"/>
            <field name="mode">extension</field>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="after">
                    <field name="has_fixed_asset_je" invisible="1" nolabel="1" groups="base.group_user"/>
                </xpath>
            </field>
        </record>

        <record id="ab_accounting_je_line_view_inherit" model="ir.ui.view">
            <field name="name">ab_accounting_je_line</field>
            <field name="model">ab_accounting_je_line</field>
            <field name="inherit_id" ref="ab_accounting.ab_accounting_je_line_view_tree_one2many"/>
            <field name="mode">extension</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='account_id']" position="after">
                    <field name="has_fixed_asset_je" invisible="1"/>

                    <field name="fixed_asset_id"

                     column_invisible="parent.has_fixed_asset_je == False" invisible="has_fixed_asset_je == False"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>