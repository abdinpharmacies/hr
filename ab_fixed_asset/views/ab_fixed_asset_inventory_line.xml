<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ab_fixed_asset_inventory_line_view_tree" model="ir.ui.view">
            <field name="name">ab_fixed_asset_inventory_line_view_tree</field>
            <field name="model">ab_fixed_asset_inventory_line</field>
            <field name="arch" type="xml">
                <list string="ab_fixed_asset_inventory_line_tree" multi_edit="1">
                    <field name="name" optional="show"/>
                    <field name="qty" optional="show"/>
                    <field name="price" optional="show"/>
                    <field name="total_price" optional="show"/>
                    <field name="fixed_asset_header_id" optional="show"/>
                </list>
            </field>
        </record>

        <record id="ab_fixed_asset_inventory_line_view_form" model="ir.ui.view">
            <field name="name">ab_fixed_asset_inventory_line_view_form</field>
            <field name="model">ab_fixed_asset_inventory_line</field>
            <field name="arch" type="xml">
                <form string="ab_fixed_asset_inventory_line_form">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="qty"/>
                            <field name="price"/>
                            <field name="total_price"/>
                            <field name="fixed_asset_header_id" readonly="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_save" string="Save and Close" type="object" class="btn btn-primary"/>
                        <button string="Cancel" type="object" special="cancel"
                                class="btn btn-outline-danger pull-right"/>
                    </footer>

                </form>
            </field>
        </record>
        <record id="ab_fixed_asset_inventory_line_view_search" model="ir.ui.view">
            <field name="name">ab_fixed_asset_inventory_line_view_search</field>
            <field name="model">ab_fixed_asset_inventory_line</field>
            <field name="arch" type="xml">
                <search string="ab_fixed_asset_inventory_line_search">
                    <field name="name"/>
                    <field name="qty"/>
                    <field name="price"/>
                    <field name="total_price"/>
                    <field name="fixed_asset_header_id"/>
                </search>
            </field>
        </record>
        <record id="ab_fixed_asset_inventory_line_view_pivot" model="ir.ui.view">
            <field name="name">ab_fixed_asset_inventory_line_view_pivot</field>
            <field name="model">ab_fixed_asset_inventory_line</field>
            <field name="arch" type="xml">
                <pivot string="ab_fixed_asset_inventory_line_pivot">
                </pivot>
            </field>
        </record>


        <record id="ab_fixed_asset_inventory_line_action" model="ir.actions.act_window">
            <field name="name">Ab fixed asset inventory line</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_fixed_asset_inventory_line</field>
            <field name="view_mode">list,form,pivot</field>
        </record>

        <menuitem id="ab_fixed_asset_inventory_line_menu"
                  name="Inventory Lines"
                  parent="config_sub_menu"
                  action="ab_fixed_asset_inventory_line_action"
                  sequence="900"/>


    </data>
</odoo>