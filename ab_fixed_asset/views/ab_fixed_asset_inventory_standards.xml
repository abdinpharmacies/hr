<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_fixed_asset_inventory_standards_view_tree" model="ir.ui.view">
            <field name="name">ab_fixed_asset_inventory_standards_view_tree</field>
            <field name="model">ab_fixed_asset_inventory_standards</field>
            <field name="arch" type="xml">
                <list string="ab_fixed_asset_inventory_standards_tree">
                    <field name="id" optional="show"/>
                    <field name="asset_id" optional="show"/>
                    <field name="standard_id" optional="show"/>
                    <field name="measure_unit" optional="show"/>
                    <field name="example" optional="show"/>
                    <field name="standard_value" optional="show"/>
                </list>
            </field>
        </record>

        <record id="ab_fixed_asset_inventory_standards_view_form" model="ir.ui.view">
            <field name="name">ab_fixed_asset_inventory_standards_view_form</field>
            <field name="model">ab_fixed_asset_inventory_standards</field>
            <field name="arch" type="xml">
                <form string="ab_fixed_asset_inventory_standards_form">
                    <sheet>
                        <group>
                            <field name="id"/>
                            <field name="asset_id"/>
                            <field name="standard_id"/>
                            <field name="measure_unit"/>
                            <field name="example"/>
                            <field name="standard_value"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_fixed_asset_inventory_standards_view_search" model="ir.ui.view">
            <field name="name">ab_fixed_asset_inventory_standards_view_search</field>
            <field name="model">ab_fixed_asset_inventory_standards</field>
            <field name="arch" type="xml">
                <search string="ab_fixed_asset_inventory_standards_search">
                    <field name="id"/>
                    <field name="asset_id"/>
                    <field name="standard_id"/>
                    <field name="measure_unit"/>
                    <field name="example"/>
                    <field name="standard_value"/>
                </search>
            </field>
        </record>
        <record id="ab_fixed_asset_inventory_standards_view_pivot" model="ir.ui.view">
            <field name="name">ab_fixed_asset_inventory_standards_view_pivot</field>
            <field name="model">ab_fixed_asset_inventory_standards</field>
            <field name="arch" type="xml">
                <pivot string="ab_fixed_asset_inventory_standards_pivot">
                </pivot>
            </field>
        </record>


        <record id="ab_fixed_asset_inventory_standards_action" model="ir.actions.act_window">
            <field name="name">Asset Inventory Standards</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_fixed_asset_inventory_standards</field>
            <field name="view_mode">list,form,pivot</field>
        </record>

        <menuitem id="ab_fixed_asset_inventory_standards_menu"
                  name="Assets Inventory Standards"
                  parent="config_sub_menu"
                  action="ab_fixed_asset_inventory_standards_action"
                  sequence="500"/>

    </data>
</odoo>