<odoo>
<record id="rule_bot_company" model="ir.rule"><field name="name">Telegram bot: allowed companies</field><field name="model_id" ref="model_ab_telegram_bot"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_bot_assigned" model="ir.rule"><field name="name">Telegram bot: assigned bots</field><field name="model_id" ref="model_ab_telegram_bot"/><field name="groups" eval="[(4, ref('group_viewer'))]"/><field name="domain_force">[('operator_ids', 'in', [user.id])]</field></record>
<record id="rule_bot_admin" model="ir.rule"><field name="name">Telegram bot: administrators</field><field name="model_id" ref="model_ab_telegram_bot"/><field name="groups" eval="[(4, ref('group_administrator'))]"/><field name="domain_force">[(1, '=', 1)]</field></record>
