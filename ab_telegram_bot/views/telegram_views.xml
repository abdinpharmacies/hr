<odoo>
<record id="view_bot_list" model="ir.ui.view"><field name="name">ab_telegram_bot_list</field><field name="model">ab_telegram_bot</field><field name="arch" type="xml"><list ><field name="name"/><field name="username"/><field name="bot_id"/><field name="active"/><field name="company_id"/></list></field></record>
<record id="view_bot_form" model="ir.ui.view"><field name="name">ab_telegram_bot_form</field><field name="model">ab_telegram_bot</field><field name="arch" type="xml"><form ><header><button name="action_check_connection" type="object" string="Check Connection" groups="ab_telegram_bot.group_administrator" class="btn-primary"/></header><sheet><group><field name="name"/><field name="active"/><field name="company_id"/><field name="token" password="True" groups="ab_telegram_bot.group_administrator"/><field name="operator_ids" widget="many2many_tags"/><field name="bot_id"/><field name="username"/><field name="checked_at"/><field name="connection_note"/></group></sheet></form></field></record>
<record id="view_client_list" model="ir.ui.view"><field name="name">ab_telegram_bot_client_list</field><field name="model">ab_telegram_bot_client</field><field name="arch" type="xml"><list ><field name="client_id"/><field name="client_name"/><field name="username"/><field name="started_bot_ids" widget="many2many_tags"/></list></field></record>
<record id="view_client_form" model="ir.ui.view"><field name="name">ab_telegram_bot_client_form</field><field name="model">ab_telegram_bot_client</field><field name="arch" type="xml"><form ><sheet><group><field name="client_id"/><field name="client_name"/><field name="username"/><field name="private_chat_id"/><field name="company_id"/><field name="active"/><field name="started_bot_ids" widget="many2many_tags"/></group><p>Started Bots records private /start commands received through Fetch Updates or entered manually. Observed Bots also includes bots that saw this client in a group.</p></sheet></form></field></record>
<record id="view_group_list" model="ir.ui.view"><field name="name">ab_telegram_bot_group_list</field><field name="model">ab_telegram_bot_group</field><field name="arch" type="xml"><list ><field name="name"/><field name="chat_id"/><field name="chat_type"/><field name="bot_ids" widget="many2many_tags"/></list></field></record>
<record id="view_group_form" model="ir.ui.view"><field name="name">ab_telegram_bot_group_form</field><field name="model">ab_telegram_bot_group</field><field name="arch" type="xml"><form ><header><button name="action_validate_group" string="Validate Group" type="object" groups="ab_telegram_bot.group_operator"/></header><sheet><group><field name="name"/><field name="chat_id"/><field name="chat_type"/><field name="bot_ids" widget="many2many_tags"/><field name="company_id"/><field name="active"/><field name="checked_at"/><field name="validation_note"/></group><p>Register known chats manually or discover them through Fetch Updates. Validate Group checks current membership for the selected bots.</p></sheet></form></field></record>
<record id="view_subscription_list" model="ir.ui.view"><field name="name">ab_telegram_bot_module_subscription_list</field><field name="model">ab_telegram_bot_module_subscription</field><field name="arch" type="xml"><list ><field name="module_id"/><field name="bot_id"/><field name="default_group_id"/><field name="default_group_chat_id"/><field name="enabled"/></list></field></record>
<record id="view_subscription_form" model="ir.ui.view"><field name="name">ab_telegram_bot_module_subscription_form</field><field name="model">ab_telegram_bot_module_subscription</field><field name="arch" type="xml"><form ><header><button name="action_send_test" string="Send Test Message" type="object" groups="ab_telegram_bot.group_operator" confirm="Send a test message to the configured Telegram destination?"/></header><sheet><group><field name="module_id"/><field name="bot_id"/><field name="default_group_id"/><field name="default_group_chat_id"/><field name="topic_id"/><field name="language"/><field name="enabled"/><field name="active"/><field name="company_id"/></group><p>An explicit chat ID overrides the selected group. Sending a test message contacts Telegram.</p></sheet></form></field></record>
<record id="view_message_list" model="ir.ui.view"><field name="name">ab_telegram_bot_message_list</field><field name="model">ab_telegram_bot_message</field><field name="arch" type="xml"><list create="0" delete="0"><field name="create_date"/><field name="bot_id"/><field name="chat_id"/><field name="method"/><field name="state"/><field name="attempts"/><field name="sent_at"/></list></field></record>
<record id="view_message_form" model="ir.ui.view"><field name="name">ab_telegram_bot_message_form</field><field name="model">ab_telegram_bot_message</field><field name="arch" type="xml"><form create="0" delete="0"><header><button name="action_retry" string="Retry Delivery" type="object" groups="ab_telegram_bot.group_operator" invisible="state not in ('failed', 'unknown', 'sending')" confirm="For uncertain deliveries, check Telegram first. Retrying may send a duplicate message."/><button name="action_cancel" string="Cancel Delivery" type="object" groups="ab_telegram_bot.group_operator" invisible="state not in ('queued', 'failed', 'unknown')"/></header><sheet><group><field name="bot_id"/><field name="chat_id"/><field name="method"/><field name="state"/><field name="company_id"/><field name="attempts"/><field name="sent_at"/><field name="retry_at"/><field name="telegram_message_ids"/><field name="queue_job_id" groups="queue_job.group_queue_job_manager"/><field name="source_model"/><field name="source_id"/></group><field name="error"/><group string="Message Content"><field name="payload"/><field name="attachment_ids" widget="many2many_binary" readonly="1"/></group></sheet></form></field></record>
<menuitem id="menu_telegram_root" name="Telegram Bots" sequence="85" groups="group_viewer" web_icon="ab_telegram_bot,static/description/icon.png"/>
<record id="action_bot" model="ir.actions.act_window"><field name="name">Bots</field><field name="res_model">ab_telegram_bot</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_bot" name="Bots" parent="menu_telegram_root" action="action_bot" sequence="0"/>
<record id="action_client" model="ir.actions.act_window"><field name="name">Clients</field><field name="res_model">ab_telegram_bot_client</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_client" name="Clients" parent="menu_telegram_root" action="action_client" sequence="10"/>
<record id="action_group" model="ir.actions.act_window"><field name="name">Groups</field><field name="res_model">ab_telegram_bot_group</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_group" name="Groups" parent="menu_telegram_root" action="action_group" sequence="20"/>
<record id="action_subscription" model="ir.actions.act_window"><field name="name">Module Subscriptions</field><field name="res_model">ab_telegram_bot_module_subscription</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_subscription" name="Module Subscriptions" parent="menu_telegram_root" action="action_subscription" sequence="30"/>
<record id="action_message" model="ir.actions.act_window"><field name="name">Message History</field><field name="res_model">ab_telegram_bot_message</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_message" name="Message History" parent="menu_telegram_root" action="action_message" sequence="40"/>
</odoo>
