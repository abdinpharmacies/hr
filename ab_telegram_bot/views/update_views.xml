<odoo>
    <record id="view_bot_updates" model="ir.ui.view">
        <field name="name">ab_telegram_bot_updates_form</field><field name="model">ab_telegram_bot</field><field name="inherit_id" ref="view_bot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside"><button name="action_fetch_updates" string="Fetch Updates" type="object" groups="ab_telegram_bot.group_operator" invisible="not active" class="btn-primary"/></xpath>
            <xpath expr="//sheet/group" position="before"><div class="oe_button_box" name="button_box"><button name="action_open_updates" type="object" class="oe_stat_button" icon="fa-inbox"><field name="update_count" widget="statinfo"/></button></div></xpath>
            <xpath expr="//sheet" position="inside"><group string="Manual Update Fetching"><field name="next_update_offset"/><field name="last_fetch_at"/><field name="last_fetch_note"/></group><p>Each click receives up to 100 pending updates. Telegram retains pending updates for at most 24 hours. This is not chat history; another polling application may consume the updates first.</p></xpath>
        </field>
    </record>
    <record id="view_client_observed" model="ir.ui.view"><field name="name">ab_telegram_bot_client_observed</field><field name="model">ab_telegram_bot_client</field><field name="inherit_id" ref="view_client_form"/><field name="arch" type="xml"><field name="started_bot_ids" position="after"><field name="observed_bot_ids" widget="many2many_tags"/></field></field></record>
    <record id="view_group_observed" model="ir.ui.view"><field name="name">ab_telegram_bot_group_observed</field><field name="model">ab_telegram_bot_group</field><field name="inherit_id" ref="view_group_form"/><field name="arch" type="xml"><field name="bot_ids" position="after"><field name="observed_bot_ids" widget="many2many_tags"/></field></field></record>
    <record id="view_update_list" model="ir.ui.view">
        <field name="name">ab_telegram_bot_update_list</field><field name="model">ab_telegram_bot_update</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0" decoration-danger="state == 'failed'"><field name="received_at"/><field name="bot_id"/><field name="update_id"/><field name="update_type"/><field name="group_id"/><field name="client_id"/><field name="text" optional="show"/><field name="state"/></list></field>
    </record>
    <record id="view_update_form" model="ir.ui.view">
        <field name="name">ab_telegram_bot_update_form</field><field name="model">ab_telegram_bot_update</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_retry_processing" string="Retry Processing" type="object" groups="ab_telegram_bot.group_operator" invisible="state != 'failed'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="bot_id"/><field name="company_id"/><field name="update_id"/><field name="update_type"/><field name="received_at"/><field name="event_at"/></group><group><field name="chat_id"/><field name="sender_id"/><field name="message_id"/><field name="client_id"/><field name="group_id"/></group></group><group string="Message Content"><field name="text"/><field name="error"/></group><group string="Raw Update"><field name="raw_update" nolabel="1"/></group></sheet></form></field>
    </record>
    <record id="view_update_search" model="ir.ui.view">
        <field name="name">ab_telegram_bot_update_search</field><field name="model">ab_telegram_bot_update</field>
        <field name="arch" type="xml"><search><field name="bot_id"/><field name="update_type"/><field name="group_id"/><field name="client_id"/><field name="chat_id"/><field name="text"/><filter name="received" string="Received" domain="[('state', '=', 'received')]"/><filter name="processed" string="Processed" domain="[('state', '=', 'processed')]"/><filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/><filter name="ignored" string="Ignored" domain="[('state', '=', 'ignored')]"/><group><filter name="by_bot" string="Bot" context="{'group_by': 'bot_id'}"/><filter name="by_type" string="Update Type" context="{'group_by': 'update_type'}"/><filter name="by_group" string="Group" context="{'group_by': 'group_id'}"/><filter name="by_state" string="Status" context="{'group_by': 'state'}"/></group></search></field>
    </record>
    <record id="action_update" model="ir.actions.act_window"><field name="name">Incoming Updates</field><field name="res_model">ab_telegram_bot_update</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_update" name="Incoming Updates" parent="menu_telegram_root" action="action_update" sequence="50"/>
</odoo>
