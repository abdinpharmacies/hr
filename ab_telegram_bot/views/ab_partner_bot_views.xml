<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_ab_partner_bot_list" model="ir.ui.view">
            <field name="name">ab.partner.bot.list</field>
            <field name="model">ab_partner_bot</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="costcenter_id"/>
                    <field name="chat_id"/>
                    <field name="telegram_username"/>
                    <field name="telegram_user_id" optional="hide"/>
                    <field name="linked_at"/>
                    <field name="active"/>
                    <field name="employee_id" optional="hide"/>
                    <field name="employee_ref_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_ab_partner_bot_form" model="ir.ui.view">
            <field name="name">ab.partner.bot.form</field>
            <field name="model">ab_partner_bot</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="costcenter_id"/>
                                <field name="chat_id"/>
                                <field name="telegram_username"/>
                                <field name="telegram_user_id"/>
                            </group>
                            <group>
                                <field name="linked_at"/>
                                <field name="active"/>
                                <field name="employee_id"/>
                                <field name="employee_ref_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_ab_partner_bot_search" model="ir.ui.view">
            <field name="name">ab.partner.bot.search</field>
            <field name="model">ab_partner_bot</field>
            <field name="arch" type="xml">
                <search>
                    <field name="costcenter_id"/>
                    <field name="chat_id"/>
                    <field name="telegram_username"/>
                    <field name="telegram_user_id"/>
                    <filter name="active_accounts" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="inactive_accounts" string="Inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="action_ab_partner_bot" model="ir.actions.act_window">
            <field name="name">Telegram Accounts</field>
            <field name="res_model">ab_partner_bot</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_ab_partner_bot_search"/>
            <field name="context">{'active_test': False}</field>
        </record>

        <menuitem
            id="menu_ab_telegram_bot_root"
            name="Telegram Bot"
            web_icon="ab_telegram_bot,static/description/icon.png"
            groups="base.group_system"
            sequence="90"
        />

        <menuitem
            id="menu_ab_partner_bot"
            name="Telegram Accounts"
            parent="menu_ab_telegram_bot_root"
            action="action_ab_partner_bot"
            sequence="10"
            groups="base.group_system"
        />
    </data>
</odoo>
