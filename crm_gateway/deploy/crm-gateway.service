[Unit]
Description=CRM provider webhook gateway
After=network-online.target

[Service]
Type=simple
User=crm-gateway
WorkingDirectory=/srv/crm_gateway
Environment=CRM_GATEWAY_CONFIG=/etc/crm_gateway/config.json
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/crm_gateway/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8091 --workers 1 --limit-concurrency 32
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
CPUQuota=50%
TasksMax=64

[Install]
WantedBy=multi-user.target
