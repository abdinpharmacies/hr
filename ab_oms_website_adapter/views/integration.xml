<odoo>
  <record id="view_website_oms" model="ir.ui.view">
    <field name="name">website.oms.configuration</field><field name="model">website</field>
    <field name="inherit_id" ref="website.view_website_form"/>
    <field name="arch" type="xml">
    <xpath expr="//sheet" position="inside"><group string="OMS Coordination" groups="base.group_system"><field name="oms_enabled"/><field name="oms_cutoff"/><field name="oms_source"/></group></xpath></field>
  </record>
  <record id="view_order_oms" model="ir.ui.view">
    <field name="name">sale.order.oms.coordination</field><field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
    <xpath expr="//notebook" position="inside"><page string="OMS Coordination" invisible="not oms_request_reference"><group><field name="oms_request_reference"/><field name="oms_reference"/><field name="oms_status"/><field name="oms_cancellation_requested"/><field name="oms_revision"/><field name="oms_status_revision"/></group></page></xpath></field>
  </record>
<template id="portal_oms_status" inherit_id="sale.sale_order_portal_content"><xpath expr="//div[@id='introduction']" position="after"><section t-if="sale_order.oms_request_reference" class="ab_oms_website_status alert alert-info"><strong>Order coordination:</strong> <span t-field="sale_order.oms_status"/><div t-if="sale_order.oms_cancellation_requested">Cancellation requested; awaiting branch confirmation.</div></section></xpath></template></odoo>
