<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_sales_prevent_res_config_settings_view_form" model="ir.ui.view">
            <field name="name">ab.sales.prevent.res.config.settings.form</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='user_default_rights']" position="before">
                    <block title="Abdin Sales Prevention" id="ab_sales_prevent_settings">
                        <setting string="Prevent Sales Operations"
                                 help="Hide sales menus and block sales operations on this database.">
                            <field name="ab_sales_prevent_enabled"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
