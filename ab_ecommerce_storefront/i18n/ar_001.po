msgid ""
"Only Sales Administrators or Call Center users handling website orders can "
"mark orders as delivered."
msgstr ""
"يمكن لمسؤولي المبيعات أو مستخدمي مركز الاتصال المسؤولين عن طلبات الموقع فقط "
"تحديد الطلبات كمسلّمة."

#. module: ab_ecommerce_storefront
#: model_terms:ir.ui.view,arch_db:ab_ecommerce_storefront.cart_hold_notice
msgid ""
"<span data-ab-cart-hold-active=\"\">Note: These items have been reserved, and the quantity will be available in the store again after</span>\n"
"                <strong class=\"o_force_ltr\" dir=\"ltr\" data-ab-cart-hold-countdown=\"\"/>\n"
"                <span class=\"d-none\" data-ab-cart-hold-expired=\"\">Your website hold has expired. Items remain in your cart and availability will be checked again at checkout.</span>"
msgstr ""
"<span data-ab-cart-hold-active=\"\">ملحوظة: تم حجز هذه الأصناف وسوف تظهر الكمية في المتجر مرة أخرى بعد</span>\n"
"                <strong class=\"o_force_ltr\" dir=\"ltr\" data-ab-cart-hold-countdown=\"\"/>\n"
"                <span class=\"d-none\" data-ab-cart-hold-expired=\"\">انتهت مهلة الحجز على الموقع. تظل الأصناف في سلتك وسيتم التحقق من توافرها مرة أخرى عند إتمام الطلب.</span>"

