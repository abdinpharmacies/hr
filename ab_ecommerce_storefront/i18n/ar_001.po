msgid "Has Storefront Image"
msgstr "له صورة في المتجر"

#. module: ab_ecommerce_storefront
#: model_terms:ir.ui.view,arch_db:ab_ecommerce_storefront.layout
msgid "A moment of care"
msgstr "لحظة ونكون معك"

#. module: ab_ecommerce_storefront
#: model_terms:ir.ui.view,arch_db:ab_ecommerce_storefront.layout
msgid "Loading your next page…"
msgstr "جارٍ تحميل الصفحة التالية…"

#. module: ab_ecommerce_storefront
#: model_terms:ir.ui.view,arch_db:ab_ecommerce_storefront.layout
msgid "Hide loading screen"
msgstr "إخفاء شاشة التحميل"

#. module: ab_ecommerce_storefront
#. odoo-javascript
#: code:addons/ab_ecommerce_storefront/static/src/js/logo_motion.js:0
msgid "This is taking a little longer than usual."
msgstr "التحميل يستغرق وقتًا أطول من المعتاد."

#. module: ab_ecommerce_storefront
#: model_terms:ir.ui.view,arch_db:ab_ecommerce_storefront.layout
msgid "Your health matters"
msgstr "صحتك تهمنا"

#. module: ab_ecommerce_storefront
#: model_terms:ir.ui.view,arch_db:ab_ecommerce_storefront.layout
msgid ""
"When washing your hands, rub with soap for at least 20 seconds, then rinse "
"and dry."
msgstr ""
"عند غسل يديك، افركهما بالصابون لمدة 20 ثانية على الأقل، ثم اشطفهما وجففهما."

#. module: ab_ecommerce_storefront
#: model_terms:ir.ui.view,arch_db:ab_ecommerce_storefront.layout
msgid "Source: CDC"
msgstr "المصدر: مراكز مكافحة الأمراض والوقاية منها (CDC)"

#. module: ab_ecommerce_storefront
#: model_terms:ir.ui.view,arch_db:ab_ecommerce_storefront.layout
msgid ""
"Clean your teeth twice daily for around two minutes, using toothpaste that "
"contains fluoride."
