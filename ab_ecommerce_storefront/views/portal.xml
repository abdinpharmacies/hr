<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_account_dashboard" name="Abdin Account Dashboard" inherit_id="portal.portal_my_home" priority="300">
        <xpath expr="//t[@t-set='my_details']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_portal_my_home')]" position="replace">
            <t t-set="account_user" t-value="request.env.user"/>
            <t t-set="partner" t-value="account_partner if account_partner else account_user.partner_id"/>
            <section class="ab-account-dashboard" data-ab-account-dashboard="">
                <div class="ab-account-shell">
                    <aside class="ab-account-nav" aria-label="تنقل الحساب">
                        <a href="/my/home" class="ab-account-nav-link is-active">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11.5 12 5l8 6.5V20a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1Z"/></svg>
                            <span>حسابي</span>
                        </a>
                        <a href="/shop/wishlist" class="ab-account-nav-link">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 7.8c0 5.1-8.5 10.2-8.5 10.2S3.5 12.9 3.5 7.8A4.3 4.3 0 0 1 12 6.6a4.3 4.3 0 0 1 8.5 1.2Z"/></svg>
                            <span>المفضلة</span>
                        </a>
                        <a href="/my/addresses" class="ab-account-nav-link">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-5.2 7-11a7 7 0 0 0-14 0c0 5.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                            <span>عناويني</span>
                        </a>
                        <a href="/my/orders" class="ab-account-nav-link">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7.5 12 4l6 3.5v9L12 20l-6-3.5Z"/><path d="M6 7.5 12 11l6-3.5M12 11v9"/></svg>
                            <span>طلباتي</span>
                        </a>
                        <a href="/my/invoices?filterby=invoices" class="ab-account-nav-link">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10a2 2 0 0 1 2 2v16l-3-2-2 2-2-2-2 2-2-2-3 2V5a2 2 0 0 1 2-2Z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>
                            <span>فواتيري</span>
                        </a>
                        <a href="/web/session/logout?redirect=/" class="ab-account-nav-link ab-account-nav-logout">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4M15 7l5 5-5 5M20 12H9"/></svg>
                            <span>تسجيل الخروج</span>
                        </a>
                    </aside>

                    <div class="ab-account-main">
                        <div class="ab-account-hero-scope"
                             data-ab-avatar-scope="profile"
                             t-att-data-ab-avatar-current="account_avatar"
                             data-ab-avatar-update-url="/ab_storefront/avatar/update">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" data-ab-avatar-csrf=""/>
                            <section class="ab-account-hero">
                                <button type="button" class="ab-account-hero-avatar" data-ab-avatar-open="" aria-label="تغيير الأفاتار">
                                    <span class="ab-account-avatar-edit" aria-hidden="true">
                                        <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
                                    </span>
                                    <t t-set="avatar_value" t-value="account_avatar"/>
                                    <t t-set="avatar_size" t-value="'xl'"/>
                                    <t t-set="avatar_alt" t-value="'أفاتار حسابك'"/>
                                    <t t-set="avatar_partner" t-value="partner"/>
                                    <t t-call="ab_ecommerce_storefront.avatar_image"/>
                                </button>
                                <div class="ab-account-hero-copy">
                                    <span>أهلًا بك من جديد</span>
                                    <h1 t-out="partner.name or account_user.name"/>
                                    <p t-out="account_phone"/>
                                    <strong>حسابك في صيدليات عابدين</strong>
                                </div>
                                <button type="button" class="btn ab-account-hero-button" data-ab-avatar-open="">تغيير الأفاتار</button>
                                <small data-ab-avatar-status="" aria-live="polite"/>
                            </section>
                            <t t-set="avatar_current" t-value="account_avatar"/>
                            <t t-call="ab_ecommerce_storefront.avatar_picker"/>
                        </div>

                        <section class="ab-account-panel ab-account-profile-panel ab-account-profile-primary">
                            <div class="ab-account-section-head">
                                <div>
                                    <span>حسابك</span>
                                    <h2>بياناتك الشخصية</h2>
                                </div>
                                <a href="/my/account" class="btn ab-account-panel-link ab-account-edit-icon"
                                   aria-label="تعديل البيانات"
                                   title="تعديل البيانات">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
                                </a>
                            </div>
                            <div t-att-class="'ab-account-completion is-complete' if profile_completion == 100 else 'ab-account-completion'"
                                 t-att-style="profile_completion_style"
                                 t-att-data-ab-profile-completion="profile_completion"
                                 t-att-data-ab-avatar-complete="'1' if avatar_complete else '0'">
                                <div class="ab-account-completion-copy">
                                    <strong><t t-out="profile_completion"/>% مكتمل</strong>
                                    <small>أكمل بياناتك لتجربة تسوق أسرع</small>
                                </div>
                                <span class="ab-account-completion-track"><span/></span>
                            </div>
                            <div class="ab-account-profile-sections">
                                <section class="ab-account-profile-block">
                                    <dl class="ab-account-info-list">
                                        <div>
                                            <dt>الاسم</dt>
                                            <dd t-out="partner.name or account_user.name"/>
                                        </div>
                                        <div>
                                            <dt>رقم الهاتف</dt>
                                            <dd dir="ltr" t-out="account_phone"/>
                                        </div>
                                        <div>
                                            <dt>كلمة المرور</dt>
                                            <dd class="ab-account-password-value">
                                                <span class="ab-account-password-mask">••••••••</span>
                                                <a href="/my/security" class="ab-account-inline-link">تغيير كلمة المرور وإعدادات الدخول</a>
                                            </dd>
                                        </div>
                                    </dl>
                                </section>
                                <section class="ab-account-profile-block" aria-labelledby="abAccountAddressesTitle">
                                    <div class="ab-account-subsection-head">
                                        <div>
                                            <span>إدارة العناوين</span>
                                            <h3 id="abAccountAddressesTitle">العناوين</h3>
                                        </div>
                                    </div>
                                    <div t-if="saved_addresses or has_address" class="ab-account-addresses ab-account-addresses-compact">
                                        <article t-if="has_address" class="ab-account-address-card">
                                            <div class="ab-account-address-card-head">
                                                <span>العنوان الأساسي</span>
                                                <a t-attf-href="/my/address?partner_id=#{partner.id}&amp;address_type=billing&amp;callback=/my/home"
                                                   class="ab-account-address-edit" aria-label="تعديل العنوان الأساسي" title="تعديل العنوان">
                                                    <i class="fa fa-fw fa-pencil" aria-hidden="true"></i>
                                                </a>
                                            </div>
                                            <strong t-out="partner.city or partner.country_id.name or 'عنوان الحساب'"/>
                                            <p>
                                                <t t-if="partner.street" t-out="partner.street"/>
                                                <t t-if="partner.street2">، <t t-out="partner.street2"/></t>
                                                <t t-if="partner.city">، <t t-out="partner.city"/></t>
                                            </p>
                                        </article>
                                        <article t-foreach="saved_addresses[:2]" t-as="address" class="ab-account-address-card">
                                            <div class="ab-account-address-card-head">
                                                <span t-out="address.name or 'عنوان محفوظ'"/>
                                                <a t-attf-href="/my/address?partner_id=#{address.id}&amp;address_type=delivery&amp;callback=/my/home"
                                                   class="ab-account-address-edit" aria-label="تعديل العنوان" title="تعديل العنوان">
                                                    <i class="fa fa-fw fa-pencil" aria-hidden="true"></i>
                                                </a>
                                            </div>
                                            <strong t-out="address.city or address.country_id.name or 'عنوان التوصيل'"/>
                                            <p>
                                                <t t-if="address.street" t-out="address.street"/>
                                                <t t-if="address.street2">، <t t-out="address.street2"/></t>
                                                <t t-if="address.city">، <t t-out="address.city"/></t>
                                            </p>
                                        </article>
                                    </div>
                                    <div t-else="" class="ab-account-empty-state ab-account-empty-state-compact ab-account-address-empty">
                                        <span><svg viewBox="0 0 24 24"><path d="M12 21s7-5.2 7-11a7 7 0 0 0-14 0c0 5.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
                                        <strong>أضف عنوانك لتسهيل طلباتك القادمة</strong>
                                        <p>احفظ عنوانك مرة واحدة لإتمام الشراء بشكل أسرع.</p>
                                        <a href="/my/address?address_type=delivery&amp;callback=/my/home" class="btn btn-primary">إضافة عنوان</a>
                                    </div>
                                </section>
                            </div>
                        </section>

                        <section class="ab-account-panel ab-account-wishlist-panel">
                            <div class="ab-account-section-head">
                                <div>
                                    <span>اختياراتك</span>
                                    <h2>المفضلة</h2>
                                </div>
                                <a href="/shop/wishlist" class="btn ab-account-panel-link">فتح المفضلة</a>
                            </div>
                            <p>
                                <t t-if="wishlist_count">لديك <strong t-out="wishlist_count"/> منتجات محفوظة في المفضلة.</t>
                                <t t-else="">لم تضف منتجات إلى المفضلة بعد.</t>
                            </p>
                        </section>

                        <section class="ab-account-panel">
                            <div class="ab-account-section-head">
                                <div>
                                    <span>نشاطك</span>
                                    <h2>أحدث الطلبات</h2>
                                </div>
                                <a href="/my/orders" class="btn ab-account-panel-link">عرض كل الطلبات</a>
                            </div>
                            <div t-if="recent_orders" class="ab-account-orders">
                                <a t-foreach="recent_orders" t-as="order" t-att-href="order.get_portal_url()" class="ab-account-order-card">
                                    <div>
                                        <strong>طلب <t t-out="order.name"/></strong>
                                        <span class="ab-account-status-pill">قيد المتابعة</span>
                                    </div>
                                    <small><span t-field="order.date_order"/></small>
                                    <p><span t-field="order.amount_total" t-options="{'widget': 'monetary', 'display_currency': order.currency_id}"/></p>
                                </a>
                            </div>
                            <div t-else="" class="ab-account-empty-state">
                                <span><svg viewBox="0 0 24 24"><path d="M6 7.5 12 4l6 3.5v9L12 20l-6-3.5Z"/><path d="M6 7.5 12 11l6-3.5M12 11v9"/></svg></span>
                                <strong>لم تقم بأي طلبات بعد</strong>
                                <p>ابدأ التسوق وستظهر طلباتك الأخيرة هنا.</p>
                                <a href="/shop" class="btn btn-primary">ابدأ التسوق</a>
                            </div>
                        </section>

                        <section class="ab-account-quick-grid" aria-label="اختصارات الحساب">
                            <a href="/my/orders" class="ab-account-action-card" style="--ab-account-card-index: 1">
                                <span class="ab-account-action-icon"><svg viewBox="0 0 24 24"><path d="M6 7.5 12 4l6 3.5v9L12 20l-6-3.5Z"/><path d="M6 7.5 12 11l6-3.5M12 11v9"/></svg></span>
                                <strong>طلباتك</strong>
                                <small>قم بمتابعة أو عرض أو دفع قيمة طلباتك</small>
                                <span class="ab-account-action-arrow"><svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg></span>
                            </a>
                            <a href="/my/invoices?filterby=invoices" class="ab-account-action-card" style="--ab-account-card-index: 2">
                                <span class="ab-account-action-icon"><svg viewBox="0 0 24 24"><path d="M7 3h10a2 2 0 0 1 2 2v16l-3-2-2 2-2-2-2 2-2-2-3 2V5a2 2 0 0 1 2-2Z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg></span>
                                <strong>فواتيرك</strong>
                                <small>قم بمتابعة أو تنزيل أو دفع قيمة فواتيرك</small>
                                <span class="ab-account-action-arrow"><svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg></span>
                            </a>
                            <a href="/my/addresses" class="ab-account-action-card" style="--ab-account-card-index: 3">
                                <span class="ab-account-action-icon"><svg viewBox="0 0 24 24"><path d="M12 21s7-5.2 7-11a7 7 0 0 0-14 0c0 5.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
                                <strong>العناوين</strong>
                                <small>قم بإضافة أو إزالة أو تعديل عناوينك</small>
                                <span class="ab-account-action-arrow"><svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg></span>
                            </a>
                            <a href="/my/security" class="ab-account-action-card" style="--ab-account-card-index: 4">
                                <span class="ab-account-action-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-3.6 8-10V5l-8-3-8 3v7c0 6.4 8 10 8 10Z"/><path d="m9 12 2 2 4-5"/></svg></span>
                                <strong>الاتصال والأمن</strong>
                                <small>قم بتهيئة معايير اتصالك</small>
                                <span class="ab-account-action-arrow"><svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg></span>
                            </a>
                        </section>

                    </div>
                </div>
            </section>
        </xpath>
    </template>

    <template id="portal_my_details_avatar" name="Abdin Portal Avatar" inherit_id="portal.portal_my_details" priority="120">
        <xpath expr="//div[hasclass('o_customer_address_fill')]" position="before">
            <section class="ab-account-avatar-card"
                     data-ab-avatar-scope="profile"
                     t-att-data-ab-avatar-current="user_id.partner_id.ab_storefront_avatar"
                     data-ab-avatar-update-url="/ab_storefront/avatar/update">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" data-ab-avatar-csrf=""/>
                <div class="ab-account-avatar-visual">
                    <t t-set="avatar_value" t-value="user_id.partner_id.ab_storefront_avatar"/>
                    <t t-set="avatar_size" t-value="'xl'"/>
                    <t t-set="avatar_alt" t-value="'أفاتار حسابك'"/>
                    <t t-call="ab_ecommerce_storefront.avatar_image"/>
                </div>
                <div class="ab-account-avatar-copy">
                    <span>صورتك الشخصية</span>
                    <h2 t-out="user_id.name"/>
                    <p>
                        <t t-out="user_id.partner_id.phone or user_id.login"/>
                    </p>
                    <button type="button" class="btn ab-account-avatar-button" data-ab-avatar-open="">
                        تغيير الأفاتار
                    </button>
                    <small data-ab-avatar-status="" aria-live="polite"/>
                </div>
                <t t-set="avatar_current" t-value="user_id.partner_id.ab_storefront_avatar"/>
                <t t-call="ab_ecommerce_storefront.avatar_picker"/>
            </section>
        </xpath>
    </template>

    <template id="portal_side_content_avatar" name="Abdin Portal Sidebar Avatar" inherit_id="portal.side_content" priority="120">
        <xpath expr="//img[contains(@class, 'rounded')][1]" position="replace">
            <t t-set="avatar_value" t-value="user_id.partner_id.ab_storefront_avatar"/>
            <t t-set="avatar_size" t-value="'md'"/>
            <t t-set="avatar_alt" t-value="'أفاتار حسابك'"/>
            <t t-call="ab_ecommerce_storefront.avatar_image"/>
        </xpath>
    </template>
</odoo>
