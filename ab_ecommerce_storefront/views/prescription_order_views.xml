<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ab_prescription_order_list" model="ir.ui.view">
        <field name="name">ab.prescription.order.list</field>
        <field name="model">ab.prescription.order</field>
        <field name="arch" type="xml">
            <list string="Prescription Orders" create="0" delete="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="state" widget="badge"/>
                <field name="sale_order_id"/>
                <field name="create_date"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ab_prescription_order_search" model="ir.ui.view">
        <field name="name">ab.prescription.order.search</field>
        <field name="model">ab.prescription.order</field>
        <field name="arch" type="xml">
            <search string="Prescription Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="sale_order_id"/>
                <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="waiting_call_center" string="Waiting for Call Center" domain="[('state', '=', 'waiting_call_center')]"/>
                <filter name="active_requests" string="Active Requests" domain="[('state', 'not in', ('delivered', 'cancelled', 'rejected'))]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_create_date" string="Creation Date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_ab_prescription_order_form" model="ir.ui.view">
        <field name="name">ab.prescription.order.form</field>
        <field name="model">ab.prescription.order</field>
        <field name="arch" type="xml">
            <form string="Prescription Order" create="0" delete="0">
                <header>
                    <button name="action_under_review" type="object" string="Start Review" class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_waiting_call_center" type="object" string="Send to Call Center" class="btn-primary" invisible="state not in ('new', 'under_review')"/>
                    <button name="action_confirmed" type="object" string="Confirm" class="btn-primary" invisible="state not in ('waiting_call_center', 'under_review')"/>
                    <button name="action_preparing" type="object" string="Start Preparing" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_out_for_delivery" type="object" string="Out for Delivery" class="btn-primary" invisible="state != 'preparing'"/>
                    <button name="action_delivered" type="object" string="Delivered" class="btn-primary" invisible="state != 'out_for_delivery'"/>
                    <button name="action_cancelled" type="object" string="Cancel" invisible="state in ('delivered', 'cancelled', 'rejected')"/>
                    <button name="action_rejected" type="object" string="Reject" invisible="state in ('delivered', 'cancelled', 'rejected')"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,under_review,waiting_call_center,confirmed,preparing,out_for_delivery,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="sale_order_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Status">
                            <field name="state_label"/>
                            <field name="state_description"/>
                            <field name="prescription_filename"/>
                            <field name="prescription_mimetype"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prescription">
                            <group>
                                <field name="prescription_image" widget="image" readonly="1"/>
                                <field name="customer_note" readonly="1" placeholder="Customer instructions are shown here."/>
                            </group>
                        </page>
                        <page string="Internal Notes">
                            <field name="internal_note" placeholder="Add internal staff notes. These notes are not shown to the customer."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ab_prescription_order" model="ir.actions.act_window">
        <field name="name">Prescription Orders</field>
        <field name="res_model">ab.prescription.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ab_prescription_order_search"/>
        <field name="context">{'search_default_active_requests': 1}</field>
    </record>

    <menuitem id="menu_ab_prescription_order_root"
              name="Prescription Orders"
              sequence="65"
              groups="base.group_user"/>
    <menuitem id="menu_ab_prescription_order_requests"
              name="Requests"
              parent="menu_ab_prescription_order_root"
              action="action_ab_prescription_order"
              sequence="10"
              groups="base.group_user"/>
</odoo>
