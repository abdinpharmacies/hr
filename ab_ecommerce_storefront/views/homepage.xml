<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="home_product_card" name="Abdin Home Product Card">
        <t t-set="ab_card_variants" t-value="ab_catalog['variants']"/>
        <t t-set="ab_card_prices" t-value="ab_catalog['prices']"/>
        <t t-set="ab_card_wishlist_product_ids" t-value="ab_catalog['wishlist_product_ids']"/>
        <t t-set="ab_card_is_wishlisted_override" t-value="ab_card_variants.get(product.id) and ab_card_variants[product.id].id in ab_card_wishlist_product_ids"/>
        <t t-call="ab_ecommerce_storefront.product_card"/>
    </template>

    <template id="product_card" name="Abdin Storefront Product Card">
        <t t-set="ab_card_variant" t-value="ab_card_variants.get(product.id)"/>
        <t t-set="ab_card_price" t-value="ab_card_prices.get(product.id, {})"/>
        <t t-set="ab_card_is_wishlisted" t-value="ab_card_is_wishlisted_override"/>
        <t t-set="ab_card_is_sold_out" t-value="ab_card_variant and ab_card_variant._is_sold_out()"/>
        <t t-set="ab_card_data" t-value="product._ab_storefront_card_data(ab_card_price)"/>
        <t t-set="ab_card_options" t-value="ab_card_data['purchase_options']"/>
        <t t-set="ab_card_default_option" t-value="ab_card_options[0]"/>
        <t t-set="ab_card_discount"
           t-value="ab_card_price.get('base_price', 0) and max(0, round((ab_card_price.get('base_price', 0) - ab_card_price.get('price_reduce', 0)) * 100 / ab_card_price.get('base_price', 0))) or 0"/>
        <t t-set="ab_card_requires_configuration"
           t-value="product.type == 'combo' or product.has_configurable_attributes or product.product_variant_count &gt; 1 or product.optional_product_ids"/>
        <t t-set="ab_card_can_quick_add"
           t-value="ab_card_variant and product._website_show_quick_add() and not ab_card_requires_configuration and not ab_card_is_sold_out and not website.prevent_zero_price_sale"/>
        <form t-attf-class="oe_product_cart ab-storefront-product-card d-flex flex-column #{ab_card_can_quick_add and 'ab-storefront-product-card-available' or ''} #{ab_card_is_sold_out and 'ab-storefront-product-card-unavailable' or ''} #{ab_card_requires_configuration and 'ab-storefront-product-card-configurable' or ''}"
              role="article"
              t-att-aria-label="product.name">
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
            <input t-if="ab_card_variant" type="hidden" name="product_id" t-att-value="ab_card_variant.id"/>
            <input type="hidden" name="product_template_id" t-att-value="product.id"/>
            <input type="hidden" name="product_type" t-att-value="product.type"/>
            <input type="hidden" name="uom_id" t-att-value="ab_card_default_option['uom_id']"/>

            <div class="ab-storefront-product-media">
                <a t-att-href="product._get_product_url()" t-att-title="product.name">
                    <img t-att-src="website.image_url(product, 'image_512')"
                         t-att-alt="product.name"
                         width="420"
                         height="420"
                         loading="lazy"/>
                </a>
                <button t-if="ab_card_variant"
                        type="button"
                        t-attf-class="ab-storefront-wishlist o_add_wishlist btn #{ab_card_is_wishlisted and 'o_in_wishlist'}"
                        t-att-data-product-template-id="product.id"
                        t-att-data-product-product-id="ab_card_variant.id"
                        data-action="o_wishlist"
                        t-att-title="ab_card_is_wishlisted and 'Remove from wishlist' or 'Add to wishlist'"
                        t-att-aria-label="ab_card_is_wishlisted and 'Remove from wishlist' or 'Add to wishlist'"
                        t-att-aria-pressed="ab_card_is_wishlisted and 'true' or 'false'">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20.8 4.7a5.5 5.5 0 0 0-7.8 0L12 5.8l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.4 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/>
                    </svg>
                </button>
                <span t-if="ab_card_is_sold_out" class="ab-storefront-stock-badge">Out of stock</span>
                <span t-elif="ab_card_price.get('base_price', 0) &gt; ab_card_price.get('price_reduce', 0)"
                      class="ab-storefront-offer-badge">
                    <t t-if="ab_card_discount">-<t t-out="ab_card_discount"/>%</t>
                    <t t-else="">Offer</t>
                </span>
            </div>

            <div class="ab-storefront-product-body d-flex flex-column flex-grow-1">
                <p t-if="product.public_categ_ids" class="ab-storefront-product-category mb-1">
                    <span t-field="product.public_categ_ids[0].name"/>
                </p>
                <h3 class="ab-storefront-product-name">
                    <a t-att-href="product._get_product_url()" class="text-decoration-none">
                        <span t-field="product.name"/>
                    </a>
                </h3>
                <div t-if="ab_card_data['pack_units']" class="ab-storefront-pack-info" aria-label="Pack information">
                    <span t-foreach="ab_card_data['pack_units']" t-as="ab_pack_unit">
                        <b t-out="ab_pack_unit['count']"/>
                        <t t-call="ab_ecommerce_storefront.product_unit_label">
                            <t t-set="ab_unit_code" t-value="ab_pack_unit['normalized_name']"/>
                            <t t-set="ab_unit_fallback" t-value="ab_pack_unit['label']"/>
                        </t>
                    </span>
                </div>
                <fieldset t-if="len(ab_card_options) &gt; 1" class="ab-storefront-unit-picker">
                    <legend>Purchase unit</legend>
                    <div class="ab-storefront-unit-options">
                        <button t-foreach="ab_card_options" t-as="ab_option"
                                type="button"
                                t-attf-class="ab-storefront-unit-option #{ab_option_index == 0 and 'is-selected' or ''}"
                                t-att-data-unit-key="ab_option['key']"
                                t-att-data-uom-id="ab_option['uom_id']"
                                t-att-aria-pressed="ab_option_index == 0 and 'true' or 'false'">
                            <t t-call="ab_ecommerce_storefront.product_unit_label">
                                <t t-set="ab_unit_code" t-value="ab_option['unit_code']"/>
                                <t t-set="ab_unit_fallback" t-value="ab_option['label']"/>
                            </t>
                        </button>
                    </div>
                </fieldset>
                <div class="ab-storefront-product-purchase mt-auto">
                    <div class="ab-storefront-product-price" aria-label="Price information">
                        <div t-foreach="ab_card_options" t-as="ab_option"
                             t-attf-class="ab-storefront-unit-price #{ab_option_index == 0 and 'is-selected' or ''}"
                             t-att-data-unit-price="ab_option['key']">
                            <span t-if="ab_option['price_reduce'] or not website.prevent_zero_price_sale"
                                  class="ab-storefront-sale-price"
                                  t-out="ab_option['price_reduce']"
                                  t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                            <del t-if="ab_option['base_price'] &gt; ab_option['price_reduce']"
                                 class="ab-storefront-base-price"
                                 t-out="ab_option['base_price']"
                                 t-options="{'widget': 'monetary', 'display_currency': website.currency_id}"/>
                        </div>
                    </div>
                    <div t-if="ab_card_can_quick_add" class="ab-storefront-card-quantity" aria-label="Quantity">
                        <button type="button" data-ab-card-quantity="decrease" aria-label="Decrease quantity">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/></svg>
                        </button>
                        <input type="number" name="add_qty" value="1" min="1" step="1" inputmode="numeric" aria-label="Quantity"/>
                        <button type="button" data-ab-card-quantity="increase" aria-label="Increase quantity">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                        </button>
                    </div>
                </div>
                <div class="ab-storefront-product-actions mt-3">
                    <button t-if="ab_card_can_quick_add"
                            type="button"
                            class="ab-storefront-card-add btn btn-primary w-100"
                            data-show-quantity="false"
                            aria-label="Buy now"
                            title="Buy now">
                        <span class="ab-storefront-card-add-text" data-ab-card-add-label="" title="Buy now" aria-hidden="true"/>
                        <span class="ab-storefront-card-add-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M3 4h2l2.3 10.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.6L21 7H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
                        </span>
                    </button>
                    <button t-elif="ab_card_is_sold_out"
                            type="button"
                            class="ab-storefront-card-state btn btn-outline-secondary w-100"
                            disabled="disabled"
                            aria-disabled="true">
                        Out of stock
                    </button>
                    <a t-elif="ab_card_requires_configuration"
                       t-att-href="product._get_product_url()"
                       class="ab-storefront-card-configure btn btn-outline-primary w-100">
                        Choose options
                    </a>
                    <a t-else=""
                       t-att-href="product._get_product_url()"
                       class="ab-storefront-card-view btn btn-outline-primary w-100">
                        View product
                    </a>
                </div>
            </div>
        </form>
    </template>

    <template id="product_unit_label" name="Abdin Storefront Product Unit Label">
        <t t-if="ab_unit_code == 'AMPOULE'">Ampoule</t>
        <t t-elif="ab_unit_code == 'BOTTLE'">Bottle</t>
        <t t-elif="ab_unit_code == 'BOX'">Box</t>
        <t t-elif="ab_unit_code in ('CAP', 'CAPSULE')">Capsule</t>
        <t t-elif="ab_unit_code == 'JAR'">Jar</t>
        <t t-elif="ab_unit_code == 'PACK'">Pack</t>
        <t t-elif="ab_unit_code in ('PCS', 'PIECE', 'UNIT')">Piece</t>
        <t t-elif="ab_unit_code == 'SACHET'">Sachet</t>
        <t t-elif="ab_unit_code == 'STRIP'">Strip</t>
        <t t-elif="ab_unit_code in ('SUPP', 'SUPPOSITORY')">Suppository</t>
        <t t-elif="ab_unit_code in ('TAB', 'TABLET')">Tablet</t>
        <t t-elif="ab_unit_code == 'TUBE'">Tube</t>
        <t t-elif="ab_unit_code == 'VIAL'">Vial</t>
        <t t-else="" t-out="ab_unit_fallback"/>
    </template>

    <template id="homepage" name="Abdin eCommerce Homepage" inherit_id="website.homepage" priority="100">
        <xpath expr="//div[@id='wrap']" position="replace">
            <t t-set="ab_catalog" t-value="website._ab_storefront_home_catalog(product_limit=4, category_limit=8)"/>
            <t t-set="ab_carousel_slides" t-value="website._ab_storefront_carousel_slides()"/>
            <div id="wrap" class="oe_structure ab-storefront-home">
                <section t-if="ab_carousel_slides" class="s_carousel_wrapper p-0 ab-storefront-hero-slider"
                         data-vxml="001"
                         data-vcss="001"
                         data-snippet="s_carousel"
                         data-name="Abdin Banner Slider">
                    <div id="abStorefrontHeroCarousel"
                         class="s_carousel s_carousel_default carousel slide"
                         data-bs-ride="carousel"
                         data-bs-interval="6500"
                         data-bs-pause="hover"
                         data-bs-touch="false">
                        <div t-if="len(ab_carousel_slides) &gt; 1" class="carousel-indicators o_not_editable" contenteditable="false">
                            <button t-foreach="ab_carousel_slides" t-as="ab_slide"
                                    type="button"
                                    data-bs-target="#abStorefrontHeroCarousel"
                                    t-attf-data-bs-slide-to="#{ab_slide_index}"
                                    t-att-class="ab_slide_index == 0 and 'active' or None"
                                    t-att-aria-current="ab_slide_index == 0 and 'true' or None"
                                    t-att-aria-label="'Slide %s' % (ab_slide_index + 1)"/>
                        </div>

                        <div class="carousel-inner">
                            <div t-foreach="ab_carousel_slides" t-as="ab_slide"
                                 t-attf-class="carousel-item #{ab_slide_index == 0 and 'active' or ''} ab-storefront-banner"
                                 t-att-data-name="ab_slide.name">
                                <a t-if="ab_slide.show_cta and ab_slide.cta_style == 'link' and ab_slide.cta_url"
                                   class="ab-storefront-banner-link"
                                   t-att-href="ab_slide.cta_url"
                                   draggable="false"
                                   t-att-aria-label="ab_slide.cta_text or ab_slide.title or ab_slide.name">
                                    <img class="ab-storefront-banner-art"
                                         t-att-src="'/web/image/ab_website_carousel_slide/%s/image_1920' % ab_slide.id"
                                         t-att-alt="ab_slide.title or ab_slide.name"
                                         t-att-loading="ab_slide_index == 0 and 'eager' or 'lazy'"/>
                                </a>
                                <img t-else=""
                                     class="ab-storefront-banner-art"
                                     t-att-src="'/web/image/ab_website_carousel_slide/%s/image_1920' % ab_slide.id"
                                     t-att-alt="ab_slide.title or ab_slide.name"
                                     t-att-loading="ab_slide_index == 0 and 'eager' or 'lazy'"/>
                                <div t-if="ab_slide.title or ab_slide.subtitle"
                                     class="ab-storefront-banner-shade"/>
                                <div t-if="ab_slide.title or ab_slide.subtitle"
                                     class="ab-storefront-banner-layout">
                                    <div class="container">
                                        <div class="ab-storefront-banner-content">
                                            <h1 t-if="ab_slide.title" t-out="ab_slide.title"/>
                                            <p t-if="ab_slide.subtitle" t-out="ab_slide.subtitle"/>
                                        </div>
                                    </div>
                                </div>
                                <div t-if="ab_slide.show_cta and ab_slide.cta_url and ((ab_slide.cta_style == 'text' and ab_slide.cta_text) or (ab_slide.cta_style == 'image' and ab_slide.cta_image_512))"
                                     class="ab-storefront-banner-cta-layer o_not_editable"
                                     dir="ltr"
                                     t-att-data-ab-position-x="ab_slide.cta_position_x"
                                     t-att-data-ab-position-y="ab_slide.cta_position_y"
                                     t-att-style="'left:' + str(ab_slide.cta_position_x) + '%; right:auto; top:' + str(ab_slide.cta_position_y) + '%; --ab-carousel-cta-x:' + str(ab_slide.cta_position_x) + '%; --ab-carousel-cta-y:' + str(ab_slide.cta_position_y) + '%; --ab-carousel-cta-width:' + str(ab_slide.cta_width) + 'px;'"
                                     contenteditable="false">
                                    <a t-if="ab_slide.cta_style == 'text'"
                                       class="btn btn-light ab-storefront-banner-text-cta"
                                       dir="auto"
                                       t-att-href="ab_slide.cta_url"
                                       t-out="ab_slide.cta_text"/>
                                    <a t-if="ab_slide.cta_style == 'image'"
                                       class="ab-storefront-banner-image-cta"
                                       t-att-href="ab_slide.cta_url"
                                       t-att-aria-label="ab_slide.cta_text or ab_slide.title or ab_slide.name">
                                        <img t-att-src="'/web/image/ab_website_carousel_slide/%s/cta_image_512' % ab_slide.id"
                                             t-att-alt="ab_slide.cta_text or ab_slide.title or ab_slide.name"
                                             loading="lazy"/>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <button t-if="len(ab_carousel_slides) &gt; 1"
                                class="carousel-control-prev o_not_editable"
                                type="button"
                                data-bs-target="#abStorefrontHeroCarousel"
                                data-bs-slide="prev"
                                contenteditable="false"
                                aria-label="Previous slide">
                            <span class="carousel-control-prev-icon" aria-hidden="true"/>
                        </button>
                        <button t-if="len(ab_carousel_slides) &gt; 1"
                                class="carousel-control-next o_not_editable"
                                type="button"
                                data-bs-target="#abStorefrontHeroCarousel"
                                data-bs-slide="next"
                                contenteditable="false"
                                aria-label="Next slide">
                            <span class="carousel-control-next-icon" aria-hidden="true"/>
                        </button>
                    </div>
                </section>

                <section class="ab-storefront-service-strip" data-name="Service Benefits">
                    <div class="container">
                        <div class="row g-0">
                            <div class="col-6 col-lg-3">
                                <div class="ab-storefront-service-item">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5.5 5.4v5.3c0 4.1 2.6 7.8 6.5 9.3 3.9-1.5 6.5-5.2 6.5-9.3V5.4L12 3Zm0 2.2 4.5 1.7v3.8c0 3-1.7 5.7-4.5 7.1-2.8-1.4-4.5-4.1-4.5-7.1V6.9L12 5.2Z"/><path d="m10.9 13.7-2.2-2.2 1.2-1.2 1 1 3.3-3.3 1.2 1.2-4.5 4.5Z"/></svg>
                                    <span><strong>رعاية صيدلية موثوقة</strong><small>من صيدليات عابدين</small></span>
                                </div>
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="ab-storefront-service-item">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h12v9h1.3l1.1-3H21v3h1v2h-2.1a3 3 0 0 1-5.8 0H9.9a3 3 0 0 1-5.8 0H3V5Zm2 2v7h9V7H5Zm12.7 6.9H19v-.9h-.2l-.7 1.9h-.4v-1ZM7 16a1 1 0 1 0 0 2 1 1 0 0 0 0-2Zm10 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2Z"/></svg>
                                    <span><strong>توصيل سريع</strong><small>طلب مريح حتى بابك</small></span>
                                </div>
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="ab-storefront-service-item">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 10V8a6 6 0 1 1 12 0v2h1.5v10h-15V10H6Zm2 0h8V8a4 4 0 0 0-8 0v2Zm-1.5 2v6h11v-6h-11Zm6.5 2v2h-2v-2h2Z"/></svg>
                                    <span><strong>دفع آمن</strong><small>تجربة شراء محمية</small></span>
                                </div>
                            </div>
                            <div class="col-6 col-lg-3">
                                <div class="ab-storefront-service-item">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a8 8 0 0 0-8 8v3a3 3 0 0 0 3 3h1v-6H6a6 6 0 1 1 12 0h-2v6h1.6c-.5 1.2-1.7 2-3.1 2H13v2h1.5A5.5 5.5 0 0 0 20 15.5V11a8 8 0 0 0-8-8Zm-6 10h1v2H6v-2Zm11 0h1v2h-1v-2Z"/></svg>
                                    <span><strong>دعم العملاء</strong><small>الخط الساخن 19036</small></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <section t-if="ab_catalog['categories']" class="ab-storefront-section ab-storefront-categories py-5" data-name="Shop Categories">
                    <div class="container">
                        <div class="ab-storefront-section-heading d-flex align-items-end justify-content-between gap-3 mb-4">
                            <div>
                                <span class="ab-storefront-kicker">Categories</span>
                                <h2 class="mb-0">تسوق حسب القسم</h2>
                            </div>
                            <a href="/shop" class="ab-storefront-view-all text-decoration-none">كل الأقسام</a>
                        </div>
                        <div class="ab-storefront-category-grid">
                            <a t-foreach="ab_catalog['categories']"
                               t-as="ab_category"
                               t-att-href="'/shop/category/%s' % request.env['ir.http']._slug(ab_category)"
                               t-attf-class="ab-storefront-category-card ab-storefront-category-card-#{ab_category_index + 1} ab-storefront-category-tone-#{ab_category_index % 4} text-decoration-none">
                                <t t-set="ab_category_product" t-value="ab_catalog['category_products'].get(ab_category.id)"/>
                                <div class="ab-storefront-category-image">
                                    <img t-if="ab_category.cover_image or ab_category.image_512"
                                         t-att-src="website.image_url(ab_category, ab_category.cover_image and 'cover_image' or 'image_1024')"
                                         t-att-alt="website._ab_storefront_category_label(ab_category)"
                                         width="720"
                                         height="480"
                                         loading="lazy"/>
                                    <img t-elif="ab_category_product"
                                         t-att-src="website.image_url(ab_category_product, 'image_1024')"
                                         t-att-alt="website._ab_storefront_category_label(ab_category)"
                                         width="720"
                                         height="480"
                                         loading="lazy"/>
                                    <div t-else="" class="ab-storefront-category-fallback" aria-hidden="true">
                                        <t t-call="ab_ecommerce_storefront.category_icon"/>
                                    </div>
                                </div>
                                <div class="ab-storefront-category-overlay"/>
                                <div class="ab-storefront-category-content">
                                    <strong t-out="website._ab_storefront_category_label(ab_category)"/>
                                    <div class="ab-storefront-category-action">Explore</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </section>

                <section t-if="ab_catalog['best_sellers']" class="ab-storefront-section ab-storefront-best-sellers py-5" data-name="Best Sellers">
                    <div class="container">
                        <div class="ab-storefront-section-heading d-flex align-items-end justify-content-between gap-3 mb-4">
                            <div>
                                <span class="ab-storefront-kicker">Best Sellers</span>
                                <h2 class="mb-0">الأكثر مبيعًا</h2>
                            </div>
                            <a href="/shop" class="ab-storefront-view-all ab-storefront-view-all-button text-decoration-none">كل المنتجات</a>
                        </div>
                        <div class="row g-3 g-lg-4">
                            <div t-foreach="ab_catalog['best_sellers']" t-as="product" class="col-6 col-md-4 col-lg-3">
                                <t t-call="ab_ecommerce_storefront.home_product_card"/>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="ab-storefront-promo py-5" data-name="Promotions">
                    <div class="container">
                        <div class="row g-3 g-lg-4">
                            <div class="col-12 col-lg-6">
                                <a href="/shop" class="ab-storefront-promo-card ab-storefront-promo-primary text-decoration-none">
                                    <span class="ab-storefront-promo-icon">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v10H7.8L4 18.8V5Zm2 2v7l1-1h11V7H6Zm3 2h6v2H9V9Zm0 3h4v2H9v-2Z"/></svg>
                                    </span>
                                    <span>
                                        <small>Pharmacy Care</small>
                                        <strong>رعاية صيدلية موثوقة تصل إلى بابك</strong>
                                        <span>تسوق الآن</span>
                                    </span>
                                </a>
                            </div>
