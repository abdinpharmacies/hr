<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="auth_svg_icon" name="Abdin Auth SVG Icon">
        <svg t-if="icon == 'phone'" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M22 16.92v2.1a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 3.3 2 2 0 0 1 4.11 1h2.1a2 2 0 0 1 2 1.72c.13.96.35 1.9.66 2.8a2 2 0 0 1-.45 2.11L7.55 8.5a16 16 0 0 0 6 6l.87-.87a2 2 0 0 1 2.11-.45c.9.31 1.84.53 2.8.66A2 2 0 0 1 22 16.92Z"/>
        </svg>
        <svg t-elif="icon == 'lock'" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="4" y="10" width="16" height="11" rx="2"/>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
        </svg>
        <svg t-elif="icon == 'user'" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20 21a8 8 0 0 0-16 0"/>
            <circle cx="12" cy="7" r="4"/>
        </svg>
        <svg t-elif="icon == 'eye'" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/>
            <circle cx="12" cy="12" r="3"/>
        </svg>
        <svg t-elif="icon == 'check'" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20 6 9 17l-5-5"/>
        </svg>
        <svg t-elif="icon == 'circle'" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="7"/>
        </svg>
        <svg t-elif="icon == 'spark'" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 2 9.4 8.8 3 11.5l6.4 2.7L12 21l2.6-6.8 6.4-2.7-6.4-2.7L12 2Z"/>
        </svg>
        <svg t-elif="icon == 'arrow'" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M19 12H5"/>
            <path d="m12 19-7-7 7-7"/>
        </svg>
        <svg t-else="" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20 6 9 17l-5-5"/>
        </svg>
    </template>

    <template id="auth_layout" name="Abdin Pharmacy Auth Layout" inherit_id="website.login_layout" priority="200">
        <xpath expr="//div[hasclass('oe_website_login_container')]" position="replace">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <div class="ab-auth-page" dir="rtl">
                <header class="ab-auth-header">
                    <a href="/" class="ab-auth-brand ab-storefront-brand-logo" aria-label="Abdin Pharmacies">
                        <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}" alt="Abdin Pharmacies"/>
                    </a>
                    <a href="/shop" class="ab-auth-store-link">
                        <span>Shop now</span>
                        <t t-set="icon" t-value="'arrow'"/>
                        <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                    </a>
                </header>
                <main class="ab-auth-main">
                    <section class="ab-auth-visual" aria-label="Abdin Pharmacies">
                        <span class="ab-auth-kicker">Abdin Pharmacies</span>
                        <h1>Trusted pharmacy care, delivered to your door</h1>
                        <p>Sign in to track your orders, save favorite products, and continue shopping easily.</p>
                        <div class="ab-auth-trust-grid" aria-hidden="true">
                            <span>Genuine products</span>
                            <span>Secure payment</span>
                            <span>19036 support</span>
                        </div>
                    </section>
                    <section class="ab-auth-card" aria-label="Sign in to Abdin Pharmacies">
                        <t t-out="0"/>
                    </section>
                </main>
                <footer class="ab-auth-footer">
                    <strong>Abdin Pharmacies</strong>
                    <span>Thoughtful healthcare, every day.</span>
                    <a href="tel:19036">Hotline 19036</a>
                </footer>
            </div>
        </xpath>
    </template>

    <template id="auth_login" name="Abdin Phone Login" inherit_id="web.login" priority="220">
        <xpath expr="//owl-component[@name='web.user_switch']" position="replace"/>
        <xpath expr="//form[@t-attf-action='/web/login']" position="replace">
            <t t-set="backend_login" t-value="redirect and (redirect.startswith('/odoo') or redirect.startswith('/web'))"/>
            <form class="oe_login_form ab-auth-form" role="form" t-attf-action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash" data-captcha="login" data-ab-auth-form="login">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="ab-auth-form-head">
                    <span class="ab-auth-form-mark">Your Abdin Pharmacies account</span>
                    <h2>Sign in</h2>
                    <p>Sign in to your account to continue</p>
                </div>
                <div class="ab-auth-field field-login">
                    <label for="login">Phone number</label>
                    <div class="ab-auth-input">
                        <t t-set="icon" t-value="'phone'"/>
                        <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                        <input t-att-type="'text' if backend_login else 'tel'" t-att-inputmode="'text' if backend_login else 'tel'" placeholder="01XXXXXXXXX" name="login" t-att-value="login" id="login" required="required" autocapitalize="off" autocomplete="username" t-att-data-ab-phone-input="None if backend_login else ''"/>
                    </div>
                    <p t-if="not backend_login" class="ab-auth-field-message" data-ab-phone-message="" aria-live="polite"/>
                </div>
                <div class="ab-auth-field field-password o_caps_lock_warning">
                    <div class="ab-auth-label-row">
                        <label for="password">Password</label>
                        <a t-if="reset_password_enabled" t-attf-href="/web/reset_password?{{ keep_query() }}" data-ab-auth-nav="reset" tabindex="-1">Forgot password?</a>
                    </div>
                    <div class="ab-auth-input">
                        <t t-set="icon" t-value="'lock'"/>
                        <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                        <input type="password" placeholder="Password" name="password" id="password" required="required" autocomplete="current-password" t-att-autofocus="'autofocus' if login else None" maxlength="4096"/>
                        <button type="button" class="ab-auth-password-toggle o_show_password" aria-label="Show password">
                            <t t-set="icon" t-value="'eye'"/>
                            <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                        </button>
                    </div>
                </div>
                <p class="ab-auth-alert ab-auth-alert-error" t-if="error" role="alert">
                    Phone number or password is incorrect.
                </p>
                <p class="ab-auth-alert ab-auth-alert-success" t-if="message" role="status">
                    <t t-esc="message"/>
                </p>
                <div class="oe_login_buttons ab-auth-actions">
                    <button type="submit" class="btn btn-primary ab-auth-primary" data-ab-auth-submit="" data-loading-text="Signing in...">Sign in</button>
                    <div class="ab-auth-divider"><span>or</span></div>
                    <p>Do not have an account?</p>
                    <a t-if="signup_enabled" class="btn ab-auth-secondary" t-attf-href="/web/signup?{{ keep_query() }}" data-ab-auth-nav="signup" onmousedown="event.preventDefault()">Create account</a>
                    <t t-if="debug">
                        <button type="submit" name="redirect" value="/web/become" class="btn btn-link btn-sm">Log in as superuser</button>
                    </t>
                    <t t-call="web.login_oauth"/>
                </div>
                <input type="hidden" name="type" value="password"/>
                <input type="hidden" name="redirect" t-att-value="redirect"/>
            </form>
        </xpath>
    </template>

    <template id="auth_signup_fields" name="Abdin Password Fields" inherit_id="auth_signup.fields" priority="220">
        <xpath expr="//div[hasclass('field-password')]" position="replace">
            <div class="ab-auth-field field-password o_caps_lock_warning">
                <label for="password">Password</label>
                <div class="ab-auth-input">
                    <t t-set="icon" t-value="'lock'"/>
                    <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                    <input type="password" name="password" id="password" required="required" t-att-autofocus="'autofocus' if autofocus else None" placeholder="Password" autocomplete="new-password"/>
                    <button type="button" class="ab-auth-password-toggle o_show_password" aria-label="Show password">
                        <t t-set="icon" t-value="'eye'"/>
                        <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                    </button>
                </div>
                <section class="ab-auth-password-strength"
                         data-ab-password-strength=""
                         aria-live="polite"
                         aria-label="Password strength">
                    <p class="ab-auth-password-empty" data-ab-password-empty="">Create a strong password to protect your account</p>
                    <div class="ab-auth-password-live" data-ab-password-live="">
                        <div class="ab-auth-strength-head">
                            <span>Password strength</span>
                            <strong data-ab-password-label="">Very weak</strong>
                        </div>
                        <div class="ab-auth-strength-meter" aria-hidden="true">
                            <span data-ab-password-segment="1"/>
                            <span data-ab-password-segment="2"/>
                            <span data-ab-password-segment="3"/>
                            <span data-ab-password-segment="4"/>
                            <span data-ab-password-segment="5"/>
                        </div>
                        <ul class="ab-auth-password-rules">
                            <li data-ab-password-rule="length">
                                <span class="ab-auth-rule-icon">
                                    <t t-set="icon" t-value="'circle'"/>
                                    <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                                </span>
                                <span>At least 8 characters</span>
                            </li>
                            <li data-ab-password-rule="upper">
                                <span class="ab-auth-rule-icon">
                                    <t t-set="icon" t-value="'circle'"/>
                                    <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                                </span>
                                <span>Uppercase letter</span>
                            </li>
                            <li data-ab-password-rule="lower">
                                <span class="ab-auth-rule-icon">
                                    <t t-set="icon" t-value="'circle'"/>
                                    <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                                </span>
                                <span>Lowercase letter</span>
                            </li>
                            <li data-ab-password-rule="number">
                                <span class="ab-auth-rule-icon">
                                    <t t-set="icon" t-value="'circle'"/>
                                    <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                                </span>
                                <span>At least one number</span>
                            </li>
                            <li data-ab-password-rule="special">
                                <span class="ab-auth-rule-icon">
                                    <t t-set="icon" t-value="'circle'"/>
                                    <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                                </span>
                                <span>At least one special symbol</span>
                            </li>
                        </ul>
                        <div class="ab-auth-password-suggestion" data-ab-password-suggestion-wrap="">
                            <span class="ab-auth-suggestion-icon">
                                <t t-set="icon" t-value="'spark'"/>
                                <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                            </span>
                            <div class="ab-auth-suggestion-copy">
                                <small>Suggested strong password</small>
                                <code data-ab-password-suggestion="">--</code>
                            </div>
                            <div class="ab-auth-suggestion-actions">
                                <button type="button" class="btn ab-auth-suggestion-refresh" data-ab-password-generate="">Suggest another</button>
                                <button type="button" class="btn ab-auth-suggestion-use" data-ab-password-use="">Use it</button>
                            </div>
                        </div>
                        <p class="ab-auth-password-hint" data-ab-password-hint="">Use a mix of letters, numbers, and symbols</p>
                    </div>
                </section>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('field-confirm_password')]" position="replace">
            <div class="ab-auth-field field-confirm_password">
                <label for="confirm_password">Confirm password</label>
                <div class="ab-auth-input">
                    <t t-set="icon" t-value="'lock'"/>
                    <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                    <input type="password" name="confirm_password" id="confirm_password" required="required" placeholder="Confirm password" autocomplete="new-password"/>
                    <button type="button" class="ab-auth-password-toggle o_show_password" aria-label="Show password">
                        <t t-set="icon" t-value="'eye'"/>
                        <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                    </button>
                </div>
                <p class="ab-auth-confirm-message" data-ab-confirm-message="" aria-live="polite"/>
            </div>
        </xpath>
    </template>

    <template id="auth_signup" name="Abdin Phone Signup" inherit_id="auth_signup.signup" priority="220">
        <xpath expr="//form[hasclass('oe_signup_form')]" position="replace">
            <form class="oe_signup_form ab-auth-form" role="form" method="post" enctype="multipart/form-data" t-if="not message" data-captcha="signup" data-ab-auth-form="signup">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="ab-auth-form-head">
                    <span class="ab-auth-form-mark">Start an easier experience</span>
                    <h2>Create account</h2>
                    <p>Create your account for an easier and faster shopping experience</p>
                </div>
                <div class="ab-auth-field field-name">
                    <label for="name">Name</label>
                    <div class="ab-auth-input">
                        <t t-set="icon" t-value="'user'"/>
                        <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                        <input type="text" name="name" t-att-value="name" id="name" placeholder="Enter your name" autofocus="autofocus" required="required" autocomplete="name"/>
                    </div>
                </div>
                <div class="ab-auth-field field-login">
                    <label for="phone">Phone number</label>
                    <div class="ab-auth-input">
                        <t t-set="icon" t-value="'phone'"/>
                        <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                        <input type="tel" inputmode="tel" name="phone" t-att-value="phone or login" id="phone" required="required" autocapitalize="off" autocomplete="tel" placeholder="01XXXXXXXXX" data-ab-phone-input=""/>
                        <input type="hidden" name="login" t-att-value="phone or login"/>
                    </div>
                    <p class="ab-auth-field-message" data-ab-phone-message="" aria-live="polite"/>
                </div>
                <t t-call="auth_signup.fields"/>
                <section class="ab-auth-avatar-choice"
                         data-ab-avatar-scope="signup"
                         data-ab-avatar-current="avatar_none">
                    <input type="hidden" name="ab_storefront_avatar" value="avatar_none" data-ab-avatar-input=""/>
                    <input type="hidden" name="ab_storefront_avatar_completed" value="0" data-ab-avatar-completed-input=""/>
                    <input type="file"
                           name="ab_storefront_avatar_upload"
                           accept="image/png,image/jpeg,image/webp"
                           class="d-none"
                           data-ab-avatar-form-upload=""/>
                    <div class="ab-auth-avatar-preview">
                        <t t-set="avatar_value" t-value="'avatar_none'"/>
                        <t t-set="avatar_size" t-value="'xl'"/>
                        <t t-set="avatar_alt" t-value="'Selected account avatar'"/>
                        <t t-call="ab_ecommerce_storefront.avatar_image"/>
                    </div>
                    <div class="ab-auth-avatar-copy">
                        <strong>Your profile photo</strong>
                        <span>Choose your avatar</span>
                    </div>
                    <button type="button" class="btn ab-auth-avatar-button" data-ab-avatar-open="">
                        Choose avatar
                    </button>
                    <t t-set="avatar_current" t-value="'avatar_none'"/>
                    <t t-call="ab_ecommerce_storefront.avatar_picker"/>
                </section>
                <p class="ab-auth-alert ab-auth-alert-error" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>
                <input type="hidden" name="redirect" t-att-value="redirect"/>
                <input type="hidden" name="token" t-att-value="token"/>
                <div class="oe_login_buttons ab-auth-actions">
                    <button type="submit" class="btn btn-primary ab-auth-primary" data-ab-auth-submit="" data-loading-text="Creating account...">Create account</button>
                    <p>Already have an account?</p>
                    <a t-attf-href="/web/login?{{ keep_query() }}" class="btn ab-auth-secondary" role="button" data-ab-auth-nav="login">Sign in</a>
                    <t t-call="web.login_oauth"/>
                </div>
            </form>
        </xpath>
    </template>

    <template id="auth_reset_password" name="Abdin Phone Reset Password" inherit_id="auth_signup.reset_password" priority="220">
        <xpath expr="//div[hasclass('oe_login_form')]" position="replace">
            <div t-if="message" class="ab-auth-form">
                <div class="ab-auth-form-head">
                    <span class="ab-auth-form-mark">Account recovery</span>
                    <h2>Check your messages</h2>
                </div>
                <p class="ab-auth-alert ab-auth-alert-success" role="status">
                    <t t-esc="message"/>
                </p>
                <a href="/web/login" class="btn ab-auth-secondary" role="button" data-ab-auth-nav="login">Back to sign in</a>
            </div>
        </xpath>
        <xpath expr="//form[hasclass('oe_reset_password_form')]" position="replace">
            <form class="oe_reset_password_form ab-auth-form" role="form" method="post" t-if="not message" data-captcha="password_reset" data-ab-auth-form="reset">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="ab-auth-form-head">
                    <span class="ab-auth-form-mark">Account recovery</span>
                    <h2>Forgot password?</h2>
                    <p>Enter your phone number to recover access to your account</p>
                </div>
                <t t-if="token and not invalid_token">
                    <t t-call="auth_signup.fields">
                        <t t-set="autofocus" t-value="1"/>
                    </t>
                </t>
                <t t-if="not token">
                    <div class="ab-auth-field field-login">
                        <label for="login">Phone number</label>
                        <div class="ab-auth-input">
                            <t t-set="icon" t-value="'phone'"/>
                            <t t-call="ab_ecommerce_storefront.auth_svg_icon"/>
                            <input type="tel" inputmode="tel" name="login" t-att-value="login" id="login" autofocus="autofocus" required="required" autocapitalize="off" autocomplete="username" placeholder="01XXXXXXXXX" data-ab-phone-input=""/>
                        </div>
                        <p class="ab-auth-field-message" data-ab-phone-message="" aria-live="polite"/>
                    </div>
                </t>
                <p class="ab-auth-alert ab-auth-alert-error" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>
                <input type="hidden" name="redirect" t-att-value="redirect"/>
                <input type="hidden" name="token" t-att-value="token"/>
                <div class="oe_login_buttons ab-auth-actions">
                    <button type="submit" class="btn btn-primary ab-auth-primary" data-ab-auth-submit="" data-loading-text="Continuing...">Continue</button>
                    <a t-if="not token" t-attf-href="/web/login?{{ keep_query() }}" class="btn ab-auth-secondary" data-ab-auth-nav="login">Back to sign in</a>
                    <a t-if="invalid_token" href="/web/login" class="btn ab-auth-secondary" data-ab-auth-nav="login">Back to sign in</a>
                    <t t-call="web.login_oauth"/>
                </div>
            </form>
        </xpath>
    </template>
</odoo>
