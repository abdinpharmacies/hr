<odoo>
    <record id="view_staff_user_wizard_form" model="ir.ui.view">
        <field name="name">ab.ecommerce.staff.user.wizard.form</field>
        <field name="model">ab_ecommerce_staff_user_wizard</field>
        <field name="arch" type="xml">
            <form string="Add Staff User">
                <group>
                    <field name="account_id" invisible="1"/>
                    <field name="name"/>
                    <field name="login"/>
                    <field name="email"/>
                    <field name="active"/>
                    <field name="access_role"/>
                </group>
                <group>
                    <field name="new_password" password="True"/>
                    <field name="confirm_password" password="True"/>
                </group>
                <footer>
                    <button name="action_save_user" type="object" string="Save Staff User" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_staff_user_wizard" model="ir.actions.act_window">
        <field name="name">Add Staff User</field>
        <field name="res_model">ab_ecommerce_staff_user_wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_staff_accounts_list" model="ir.ui.view">
        <field name="name">ab.ecommerce.staff.accounts.list</field>
        <field name="model">ab_ecommerce_staff_account</field>
        <field name="arch" type="xml">
            <list string="Staff Users" create="0" edit="0" delete="0" duplicate="0">
                <header>
                    <button name="%(action_staff_user_wizard)d" type="action" string="New" class="btn-primary" display="always"/>
                </header>
                <field name="name"/>
                <field name="login"/>
                <field name="email" optional="hide"/>
                <field name="access_role" widget="badge"/>
                <field name="user_active" widget="boolean_toggle" readonly="1"/>
                <button name="action_edit_user" type="object" string="Edit" icon="fa-pencil"/>
                <button name="action_send_password_link" type="object" string="Send Password Link" icon="fa-envelope"/>
            </list>
        </field>
    </record>
    <record id="view_staff_accounts_form" model="ir.ui.view">
        <field name="name">ab.ecommerce.staff.accounts.form</field>
        <field name="model">ab_ecommerce_staff_account</field>
        <field name="arch" type="xml">
            <form string="Staff User" create="0" edit="0" delete="0" duplicate="0">
                <header>
                    <button name="action_edit_user" type="object" string="Edit Staff User" class="btn-primary"/>
                    <button name="action_send_password_link" type="object" string="Send Password Link" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="login"/>
                        <field name="email"/>
                        <field name="access_role"/>
                        <field name="user_active"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_staff_accounts_search" model="ir.ui.view">
        <field name="name">ab.ecommerce.staff.accounts.search</field>
        <field name="model">ab_ecommerce_staff_account</field>
        <field name="arch" type="xml">
            <search string="Staff Users">
                <field name="name"/>
                <field name="login"/>
                <field name="email"/>
                <filter name="inactive" string="Inactive Users" domain="[('user_active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_staff_accounts" model="ir.actions.act_window">
        <field name="name">Staff Users</field>
        <field name="res_model">ab_ecommerce_staff_account</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_staff_accounts_list"/>
        <field name="search_view_id" ref="view_staff_accounts_search"/>
    </record>
    <menuitem id="menu_staff_user_wizard" name="Add Staff User" parent="website.menu_site" action="action_staff_accounts" sequence="90" groups="website.group_website_designer"/>
</odoo>
