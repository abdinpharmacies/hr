<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="product_all_products_breadcrumb" inherit_id="website_sale.all_products_link_name">
        <xpath expr="//span" position="replace">
            <span>All products</span>
        </xpath>
    </template>

    <template id="product" name="Abdin eCommerce Product" inherit_id="website_sale.product" priority="90">
        <xpath expr="//t[@t-call='website_sale.product_terms_and_conditions']" position="attributes">
            <attribute name="t-call">ab_ecommerce_storefront.product_policy_links</attribute>
        </xpath>
        <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="class" add="ab-storefront-product-page" separator=" "/>
        </xpath>
        <xpath expr="//section[@id='product_detail']" position="attributes">
            <attribute name="class" add="ab-storefront-product-detail" separator=" "/>
            <attribute name="t-att-data-ab-history-product-id">product.id</attribute>
        </xpath>
        <xpath expr="//div[@id='o_wsale_product_details_content']" position="attributes">
            <attribute name="class" add="ab-storefront-product-content" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('o_wsale_product_details_content_section_cta')]" position="after">
            <div class="ab-storefront-product-promises mb-4">
                <div>
                    <i class="fa fa-check-circle" aria-hidden="true"/>
                    <span><strong>With you for better health</strong><small>All your essentials from Abdin Pharmacies</small></span>
                </div>
                <div>
                    <i class="fa fa-truck" aria-hidden="true"/>
                    <span><strong>Easy delivery</strong><small>Order online</small></span>
                </div>
                <div>
                    <i class="fa fa-headphones" aria-hidden="true"/>
                    <span><strong>Need assistance?</strong><small>Call 19036</small></span>
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@id='product_full_description']" position="attributes">
            <attribute name="class" add="ab-storefront-product-description container" separator=" "/>
        </xpath>
        <xpath expr="//section[@id='product_detail']" position="after">
            <t t-set="ab_related_products" t-value="product._get_website_alternative_product()[:4]"/>
            <t t-set="ab_bought_with_products" t-value="product._get_website_accessory_product()[:4].product_tmpl_id"/>
            <t t-set="ab_recommendation_category_ids" t-value="product.public_categ_ids.ids"/>
            <t t-set="ab_recommendation_excluded_ids" t-value="(product | ab_related_products | ab_bought_with_products).ids"/>
            <t t-set="ab_related_fallback_count" t-value="4 - len(ab_related_products)"/>
            <t t-if="ab_related_fallback_count &gt; 0"
               t-set="ab_related_products"
               t-value="ab_related_products | request.env['product.template'].with_context(bin_size=True).search([('sale_ok', '=', True), ('is_published', '=', True), ('id', 'not in', ab_recommendation_excluded_ids)] + (ab_recommendation_category_ids and [('public_categ_ids', 'in', ab_recommendation_category_ids)] or []), order='website_sequence, id DESC', limit=ab_related_fallback_count)"/>
            <t t-set="ab_recommendation_excluded_ids" t-value="(product | ab_related_products | ab_bought_with_products).ids"/>
            <t t-set="ab_bought_with_fallback_count" t-value="4 - len(ab_bought_with_products)"/>
            <t t-if="ab_bought_with_fallback_count &gt; 0"
               t-set="ab_bought_with_products"
               t-value="ab_bought_with_products | request.env['product.template'].with_context(bin_size=True).search([('sale_ok', '=', True), ('is_published', '=', True), ('id', 'not in', ab_recommendation_excluded_ids)] + (ab_recommendation_category_ids and [('public_categ_ids', 'in', ab_recommendation_category_ids)] or []), order='website_sequence, id DESC', limit=ab_bought_with_fallback_count)"/>
            <t t-if="ab_related_products or ab_bought_with_products">
                <t t-set="ab_recommendation_prices" t-value="(ab_related_products | ab_bought_with_products)._get_sales_prices(website)"/>
                <t t-set="ab_recommendation_wishlist_product_ids"
                   t-value="request.env['product.wishlist'].current().product_id.ids"/>
                <section t-if="ab_related_products"
                         class="ab-storefront-product-recommendations ab-storefront-related-products">
                    <div class="container">
                        <div class="ab-storefront-recommendation-heading">
                            <span class="ab-storefront-kicker">More products</span>
                            <h2>Related products</h2>
                            <p>Browse more products.</p>
                        </div>
                        <div class="ab-storefront-recommendation-grid">
                            <t t-foreach="ab_related_products" t-as="ab_recommendation_product">
                                <t t-set="ab_recommendation_variant" t-value="False"/>
                                <t t-call="ab_ecommerce_storefront.product_recommendation_card"/>
                            </t>
                        </div>
                    </div>
                </section>
                <section t-if="ab_bought_with_products"
                         class="ab-storefront-product-recommendations ab-storefront-bought-with-products">
                    <div class="container">
                        <div class="ab-storefront-recommendation-heading">
                            <span class="ab-storefront-kicker">Add to your order</span>
                            <h2>You may also need</h2>
                            <p>Browse products you can add to your order.</p>
                        </div>
                        <div class="ab-storefront-recommendation-grid">
                            <t t-foreach="ab_bought_with_products" t-as="ab_recommendation_product">
                                <t t-set="ab_recommendation_variant" t-value="False"/>
                                <t t-call="ab_ecommerce_storefront.product_recommendation_card"/>
                            </t>
                        </div>
                    </div>
                </section>
            </t>
            <t t-set="ab_history_limit" t-value="10"/>
            <t t-set="ab_history_exclude_current" t-value="product.id"/>
            <t t-call="ab_ecommerce_storefront.browsing_history_rail"/>
        </xpath>
    </template>

    <template id="product_recommendation_card" name="Abdin Product Recommendation Card">
        <t t-set="product" t-value="ab_recommendation_product"/>
        <t t-set="ab_recommendation_variant_id"
           t-value="ab_recommendation_variant and ab_recommendation_variant.id or product._get_first_possible_variant_id()"/>
        <t t-set="ab_card_variants"
           t-value="{product.id: ab_recommendation_variant_id and request.env['product.product'].sudo().browse(ab_recommendation_variant_id)}"/>
        <t t-set="ab_card_prices" t-value="ab_recommendation_prices"/>
        <t t-set="ab_card_offer_product_ids" t-value="[]"/>
        <t t-set="ab_card_wishlist_product_ids" t-value="ab_recommendation_wishlist_product_ids"/>
        <t t-set="ab_card_is_wishlisted_override" t-value="ab_card_variants.get(product.id) and ab_card_variants[product.id].id in ab_card_wishlist_product_ids"/>
        <t t-set="ab_card_history_actions" t-value="False"/>
        <t t-call="ab_ecommerce_storefront.product_card"/>
    </template>

    <template id="disable_native_alternative_products"
              name="Use Abdin Related Products UI"
              inherit_id="website_sale.alternative_products"
              priority="110">
        <xpath expr="//div[@id='oe_structure_website_sale_recommended_products']" position="replace"/>
    </template>

    <template id="product_title" name="Abdin Product Title" inherit_id="website_sale.product_title" priority="90">
        <xpath expr="//h1" position="attributes">
            <attribute name="class" add="ab-storefront-product-title" separator=" "/>
        </xpath>
    </template>

    <template id="product_price" name="Abdin Product Price" inherit_id="website_sale.product_price" priority="90">
        <xpath expr="//div[@name='product_price']" position="attributes">
            <attribute name="class" add="ab-storefront-product-price" separator=" "/>
        </xpath>
        <xpath expr="//div[@name='product_price_container']" position="after">
            <t t-set="ab_product_offer" t-value="website._ab_storefront_offer_details(product).get(product.id, {})"/>
            <div t-if="ab_product_offer.get('free_qty')" class="ab-storefront-product-bundle-offer my-3">
                <i class="fa fa-gift ab-storefront-product-offer-icon" aria-hidden="true"/>
                <strong class="ab-storefront-product-offer-equation" dir="ltr">
                    <t t-out="ab_product_offer['buy_qty']"/> + <t t-out="ab_product_offer['free_qty']"/> <span>free</span>
                </strong>
                <small class="d-block mt-2">Free items are added to your cart automatically.</small>
            </div>
        </xpath>
    </template>

    <template id="product_cta" name="Abdin Product Call To Action" inherit_id="website_sale.cta_wrapper" priority="90">
        <xpath expr="//div[@id='o_wsale_cta_wrapper']" position="attributes">
            <attribute name="class" add="ab-storefront-product-cta" separator=" "/>
        </xpath>
        <xpath expr="//a[@id='add_to_cart']" position="attributes">
            <attribute name="class" add="btn-lg" separator=" "/>
        </xpath>
    </template>

    <template id="product_image_fallback" name="Abdin Product Image Fallback" inherit_id="website_sale.shop_product_image" priority="95">
        <xpath expr="//span[@name='o_img_with_max_suggested_width']" position="replace">
            <span
                t-if="(product_image._name == 'product.image' and product_image.image_1920) or (product_image._name != 'product.image' and product_image._ab_storefront_has_real_image())"
                t-field="product_image.image_1920"
                name="o_img_with_max_suggested_width"
                class="o_product_detail_img_wrapper d-flex align-items-start justify-content-center h-100 w-100 oe_unmovable"
                t-options="{
                    'widget': 'image',
                    'preview_image': 'image_1024',
                    'class': 'oe_unmovable product_detail_img h-100 w-100',
                    'alt-field': 'name',
                    'zoom': product_image.can_image_1024_be_zoomed and 'image_1920',
                }"
            />
            <span
                t-else=""
                name="o_img_with_max_suggested_width"
                class="o_product_detail_img_wrapper ab-storefront-product-detail-fallback d-flex align-items-center justify-content-center h-100 w-100 oe_unmovable"
            >
                <img src="/ab_website_sale_product/static/src/img/placeholders/product_placeholder.jpeg"
                     class="oe_unmovable product_detail_img"
                     t-att-alt="product_image.name or product.name"/>
            </span>
        </xpath>
        <xpath expr="//div[@t-field='product_image.image_1920']" position="replace">
            <div
                t-if="(product_image._name == 'product.image' and product_image.image_1920) or (product_image._name != 'product.image' and product_image._ab_storefront_has_real_image())"
                t-field="product_image.image_1920"
                t-att-class="image_classes + ' o_product_detail_img_wrapper oe_unmovable'"
                t-attf-style="{{
                    image_natural_index and ('--o-wsale-grid-product-img-natural-order: ' + str(image_natural_index)) or false
                }}"
                t-options="{
                    'widget': 'image',
                    'preview_image': 'image_1024',
                    'class': 'oe_unmovable product_detail_img w-100 h-100',
                    'alt-field': 'name',
                    'zoom': product_image.can_image_1024_be_zoomed and 'image_1920',
                }"
            />
            <div
                t-else=""
                t-att-class="image_classes + ' o_product_detail_img_wrapper ab-storefront-product-detail-fallback oe_unmovable'"
                t-attf-style="{{
                    image_natural_index and ('--o-wsale-grid-product-img-natural-order: ' + str(image_natural_index)) or false
                }}"
            >
                <img src="/ab_website_sale_product/static/src/img/placeholders/product_placeholder.jpeg"
                     class="oe_unmovable product_detail_img w-100 h-100"
                     t-att-alt="product_image.name or product.name"/>
            </div>
        </xpath>
    </template>
</odoo>
