<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="storefront_category_image_list" model="ir.ui.view">
        <field name="name">product.public.category.storefront.images.list</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_tree_view"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="string">Category Images</attribute>
                <attribute name="create">false</attribute>
                <attribute name="delete">false</attribute>
            </xpath>
            <xpath expr="//field[@name='display_name']" position="before">
                <field name="ab_storefront_section_image" widget="image" options="{'size': [96, 64]}"/>
            </xpath>
        </field>
    </record>

    <record id="storefront_category_image_form" model="ir.ui.view">
        <field name="name">product.public.category.storefront.images.form</field>
        <field name="model">product.public.category</field>
        <field name="inherit_id" ref="website_sale.product_public_category_form_view"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">Category Images</attribute>
                <attribute name="create">false</attribute>
                <attribute name="delete">false</attribute>
                <attribute name="duplicate">false</attribute>
            </xpath>
            <xpath expr="//sheet" position="replace">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="website_id" readonly="1" groups="website.group_multi_website"/>
                        <field name="sequence"/>
                    </group>
                    <group string="Section Image">
                        <div class="text-muted" colspan="2">Upload a cover image for this category in the homepage Shop by Category section.</div>
                        <field name="ab_storefront_section_image" widget="image" options="{'size': [600, 400]}" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </xpath>
        </field>
    </record>

    <record id="storefront_category_image_action" model="ir.actions.act_window">
        <field name="name">Category Images</field>
        <field name="res_model">product.public.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('parent_id', '=', False), ('has_published_products', '=', True)]</field>
        <field name="view_ids" eval="[
            Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('storefront_category_image_list')}),
            Command.create({'view_mode': 'form', 'view_id': ref('storefront_category_image_form')}),
        ]"/>
    </record>

    <menuitem id="menu_storefront_category_images" name="Category Images"
              parent="menu_abdin_management_style_ads" action="storefront_category_image_action"
              sequence="15" groups="website.group_website_designer,ab_ecommerce_storefront.group_call_center"/>
</odoo>
