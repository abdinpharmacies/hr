<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="offer_sheet_form" model="ir.ui.view">
        <field name="name">ab_storefront_offer_sheet.form</field>
        <field name="model">ab_storefront_offer_sheet</field>
        <field name="arch" type="xml">
            <form string="Add Offers from a Spreadsheet">
                <group>
                    <field name="filename" invisible="1"/>
                    <field name="workbook" filename="filename" readonly="line_ids" options="{'accepted_file_extensions': '.xlsx'}"/>
                </group>
                <p invisible="not line_ids">Ready offers will be applied. Other offers are saved as drafts for individual review.</p>
                <p invisible="not line_ids">Applying publishes eligible products on this website. If any product lacks stock or the group quantity cannot be met, the whole offer goes to review, including previously imported offers.</p>
                <notebook invisible="not line_ids">
                <page string="Offers">
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0" open_form_view="1" limit="40">
                        <field name="available" column_invisible="True"/>
                        <field name="name"/>
                        <field name="offer"/>
                        <field name="period"/>
                        <field name="matched"/>
                        <field name="result"/>
                        <field name="overlap" optional="hide"/>
                        <field name="priority" readonly="not available"/>
                    </list>
                    <form>
                        <group>
                            <field name="source"/><field name="name"/><field name="description"/>
                            <field name="offer"/><field name="period"/><field name="result"/>
                            <field name="available" invisible="1"/>
                            <field name="priority" readonly="not available"/>
                            <field name="overlap"/><field name="details"/>
                        </group>
                    </form>
                </field>
                </page>
                <page string="Store Brands">
                    <group><field name="include_brands"/></group>
                    <p>Link the brands listed below even when their offers are awaiting review. Each code has a verified product name and an empty storefront brand.</p>
                    <field name="brand_summary" nolabel="1"/>
                </page>
                </notebook>
                <footer>
                    <button string="Preview Offers" class="btn-primary" disabled="disabled" invisible="workbook or line_ids"/>
                    <button name="action_preview" type="object" string="Preview Offers" class="btn-primary" invisible="not workbook or line_ids"/>
                    <button name="action_apply" type="object" string="Import and Apply Ready Offers and Leave the Rest for Review" class="btn-primary" invisible="not line_ids"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_offer_sheet" model="ir.actions.act_window">
        <field name="name">Add Offers from a Spreadsheet</field>
        <field name="res_model">ab_storefront_offer_sheet</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="group_ids" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
    </record>
    <record id="offer_draft_list" model="ir.ui.view">
        <field name="name">ab_storefront_offer_draft.list</field>
        <field name="model">ab_storefront_offer_draft</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" default_order="id">
                <field name="name"/><field name="source"/><field name="display_reason"/>
                <field name="date_from"/><field name="date_to"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="offer_draft_form" model="ir.ui.view">
        <field name="name">ab_storefront_offer_draft.form</field>
        <field name="model">ab_storefront_offer_draft</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" duplicate="0">
                <header>
                    <button name="action_prepare_storefront_offer" type="object" string="Publish Draft as Storefront Offer" class="btn-primary"
                            groups="sales_team.group_sale_manager" invisible="state != 'draft' or stock_review"/>
                    <button name="action_apply" type="object" string="Recheck Stock and Restore Offer" class="btn-primary"
                            groups="sales_team.group_sale_manager" invisible="state != 'draft' or not stock_review"/>
                    <button name="action_set_aside" type="object" string="Set Aside"
                            groups="sales_team.group_sale_manager" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group><field name="name" readonly="state != 'draft' or stock_review"/><field name="website_id"/>
                        <field name="company_id" invisible="1"/><field name="source"/>
                        <field name="display_reason"/><field name="review_explanation"/><field name="original_terms"/><field name="details"/>
                        <field name="manual_only" invisible="1"/><field name="stock_review" invisible="1"/>
                        <field name="storefront_offer_id" invisible="not storefront_offer_id" readonly="1"/>
                        <field name="program_id" groups="sales_team.group_sale_manager" invisible="not program_id"/>
                    </group>
                    <group>
                        <group><field readonly="state != 'draft' or stock_review" name="date_from"/><field readonly="state != 'draft' or stock_review" name="date_to"/><field readonly="state != 'draft' or stock_review" name="priority"/></group>
                        <group><field readonly="state != 'draft' or stock_review" name="group_qty"/><field readonly="state != 'draft' or stock_review" name="discount_qty"/><field readonly="state != 'draft' or stock_review" name="rate"/><field readonly="state != 'draft' or stock_review" name="fixed_price"/></group>
                        <field readonly="state != 'draft' or stock_review" name="product_ids" widget="many2many_tags" options="{'no_create': True}"
                               domain="[('active', '=', True), ('sale_ok', '=', True), ('website_id', 'in', [False, website_id]), ('company_id', 'in', [False, company_id])]"/>
                        <field readonly="state != 'draft'" name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="storefront_offer_publish_form" model="ir.ui.view">
        <field name="name">ab_storefront_offer.publish.form</field>
        <field name="model">ab_storefront_offer</field>
        <field name="inherit_id" ref="storefront_offer_form"/>
        <field name="mode">primary</field>
        <field name="priority">80</field>
        <field name="arch" type="xml">
            <field name="offer_type" position="after">
                <field name="sheet_rate" widget="ab_offer_term_choices" string="Value for all offer products"
                       invisible="offer_type != 'sheet' or not context.get('ab_draft_term_choices')"/>
            </field>
            <field name="website_id" position="attributes"><attribute name="readonly">1</attribute></field>
            <field name="use_odoo_promotion" position="attributes"><attribute name="invisible">1</attribute></field>
            <xpath expr="//form/sheet" position="after">
                <footer>
                    <button special="save" string="Publish Offer" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </xpath>
        </field>
    </record>
    <record id="offer_draft_search" model="ir.ui.view">
        <field name="name">ab_storefront_offer_draft.search</field>
        <field name="model">ab_storefront_offer_draft</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="source"/><field name="display_reason" operator="ilike"/>
                <filter name="pending" string="Awaiting Review" domain="[('state', '=', 'draft')]"/>
                <group><filter name="group_review_reason" string="Reason for Review" context="{'group_by': 'display_reason'}"/></group>
            </search>
        </field>
    </record>
    <record id="action_offer_drafts" model="ir.actions.act_window">
        <field name="name">Offer Drafts</field>
        <field name="res_model">ab_storefront_offer_draft</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="group_ids" eval="[Command.link(ref('group_offer_draft_reviewer')), Command.link(ref('sales_team.group_sale_manager'))]"/>
    </record>
    <menuitem id="menu_offer_drafts" name="Offer Drafts" parent="menu_abdin_management_offers"
              action="action_offer_drafts" sequence="20" groups="group_offer_draft_reviewer,sales_team.group_sale_manager"/>
    <record id="discount_program_sheet_list" model="ir.ui.view">
        <field name="name">loyalty.program.discount.sheet.list</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_tree"/>
        <field name="mode">primary</field>
        <field name="priority">80</field>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='sequence']" position="before">
                <header>
                    <button type="action" name="%(action_offer_sheet)d" string="Add Offers from a Spreadsheet"
                        display="always" groups="sales_team.group_sale_manager"/>
                    <button type="action" name="%(action_offer_drafts)d" string="Offer Drafts" display="always" groups="sales_team.group_sale_manager"/>
                </header>
            </xpath>
        </field>
    </record>
    <record id="loyalty.action_loyalty_program_tree_discount_loyalty" model="ir.actions.act_window.view">
        <field name="view_id" ref="discount_program_sheet_list"/>
    </record>
    <record id="loyalty_program_sheet_settings" model="ir.ui.view">
        <field name="name">loyalty.program.sheet.settings</field>
        <field name="model">loyalty.program</field>
        <field name="inherit_id" ref="loyalty.loyalty_program_view_form"/>
        <field name="arch" type="xml">
            <field name="program_type" position="after">
                <field name="ab_sheet_key" invisible="1"/>
                <field name="ab_sheet_priority" invisible="not ab_sheet_key" groups="sales_team.group_sale_manager"/>
                <field name="ab_sheet_fixed_price" readonly="1" invisible="not ab_sheet_key or not ab_sheet_fixed_price"/>
            </field>
            <xpath expr="//sheet/notebook" position="before">
                <group string="Carousel Banner" groups="sales_team.group_sale_manager,base.group_system">
                    <group>
                        <field name="website_id" invisible="1"/>
                        <field name="ab_carousel_slide_id" options="{'no_create': True}"
                               domain="[('active', '=', True), ('website_id', 'in', [False, website_id])] if website_id else [('active', '=', True), '|', ('website_id', '=', False), ('website_id.company_id', 'in', [company_id] if company_id else context.get('allowed_company_ids', []))]"/>
                        <div class="text-muted" colspan="2">Choose the homepage carousel image associated with this offer.</div>
                    </group>
                    <group>
                        <field name="ab_carousel_image_1920" widget="image" nolabel="1" invisible="not ab_carousel_slide_id"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <record id="action_new_storefront_offer" model="ir.actions.act_window">
        <field name="name">New Storefront Offer</field>
        <field name="res_model">ab_storefront_offer</field>
        <field name="view_mode">form</field>
    </record>
    <record id="offer_overview_list" model="ir.ui.view">
        <field name="name">ab_storefront_offer_overview.list</field>
        <field name="model">ab_storefront_offer_overview</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" action="action_open_offer" type="object">
                <header>
                    <button name="%(action_new_storefront_offer)d" type="action" string="New Storefront Offer" display="always"
                            groups="sales_team.group_sale_manager,base.group_system,website.group_website_designer,ab_ecommerce_storefront.group_call_center"/>
                    <button name="%(action_offer_sheet)d" type="action" string="Add Offers from a Spreadsheet" display="always"
                            groups="sales_team.group_sale_manager"/>
                    <button name="%(action_offer_drafts)d" type="action" string="Offer Drafts" display="always"
                            groups="sales_team.group_sale_manager,ab_ecommerce_storefront.group_offer_draft_reviewer"/>
                </header>
                <field name="name"/>
                <field name="source"/>
                <field name="state" widget="badge"/>
                <field name="website_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </list>
        </field>
    </record>
    <record id="action_offer_overview" model="ir.actions.act_window">
        <field name="name">Storefront Offers</field>
        <field name="res_model">ab_storefront_offer_overview</field>
        <field name="view_mode">list</field>
    </record>
    <record id="menu_storefront_offers" model="ir.ui.menu">
        <field name="action" ref="action_offer_overview"/>
        <field name="group_ids" eval="[(4, ref('group_offer_draft_reviewer'))]"/>
    </record>
</odoo>
