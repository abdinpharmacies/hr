<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_abdin_management_root"
              name="Abdin Management"
              parent="website.menu_website_configuration"
              sequence="10"/>

    <record id="website_sale.menu_orders" model="ir.ui.menu">
        <field name="parent_id" ref="menu_abdin_management_root"/>
        <field name="sequence">10</field>
        <field name="group_ids" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <menuitem id="menu_abdin_management_contact"
              name="Contact Us"
              parent="menu_abdin_management_root"
              groups="website.group_website_designer"
              sequence="20"/>

    <record id="contact_message_menu" model="ir.ui.menu">
        <field name="parent_id" ref="menu_abdin_management_contact"/>
        <field name="sequence">10</field>
    </record>

    <record id="business_partnership_menu" model="ir.ui.menu">
        <field name="parent_id" ref="menu_abdin_management_contact"/>
        <field name="sequence">20</field>
    </record>

    <record id="contact_us_menu" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

    <menuitem id="menu_abdin_management_style_ads"
              name="Style / Ads"
              parent="menu_abdin_management_root"
              groups="website.group_website_designer"
              sequence="30"/>

    <record id="ab_website_admin_content.menu_website_homepage_carousel" model="ir.ui.menu">
        <field name="parent_id" ref="menu_abdin_management_style_ads"/>
        <field name="sequence">10</field>
    </record>

    <record id="website_sale.product_catalog_product_ribbons" model="ir.ui.menu">
        <field name="parent_id" ref="menu_abdin_management_style_ads"/>
        <field name="sequence">20</field>
    </record>

    <menuitem id="menu_abdin_management_products"
              name="Products"
              parent="menu_abdin_management_root"
              groups="sales_team.group_sale_salesman"
              sequence="40"/>

    <record id="ab_website_sale_product.menu_catalog_abdin_products" model="ir.ui.menu">
        <field name="parent_id" ref="menu_abdin_management_products"/>
        <field name="sequence">10</field>
        <field name="group_ids" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="ab_website_sale_product.menu_catalog_eplus_stock" model="ir.ui.menu">
        <field name="parent_id" ref="menu_abdin_management_products"/>
        <field name="sequence">20</field>
        <field name="group_ids" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="ab_website_sale_product.menu_catalog_eplus_inventory_sync_jobs" model="ir.ui.menu">
        <field name="parent_id" ref="menu_abdin_management_products"/>
        <field name="sequence">30</field>
        <field name="group_ids" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="ab_website_sale_product.menu_catalog_eplus_branch_stock" model="ir.ui.menu">
        <field name="parent_id" ref="menu_abdin_management_products"/>
        <field name="sequence">40</field>
        <field name="group_ids" eval="[Command.link(ref('sales_team.group_sale_salesman'))]"/>
    </record>
</odoo>
