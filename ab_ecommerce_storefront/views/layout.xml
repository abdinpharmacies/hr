<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="layout" name="Abdin eCommerce Layout" inherit_id="website.layout" priority="120">
        <xpath expr="//body" position="attributes">
            <attribute name="class" add="ab-storefront" separator=" "/>
        </xpath>

        <xpath expr="//body" position="inside">
            <aside t-if="not no_footer"
                   class="ab-storefront-support-widget"
                   data-ab-support-widget=""
                   aria-label="Customer support">
                <div id="abStorefrontSupportMenu"
                     class="ab-storefront-support-menu"
                     data-ab-support-menu=""
                     role="menu">
                    <div class="ab-storefront-support-menu-head">
                        <strong>Contact us</strong>
                        <button type="button"
                                class="ab-storefront-support-close btn"
                                data-ab-support-close=""
                                aria-label="Close customer support">
                            <i class="fa fa-times" aria-hidden="true"/>
                        </button>
                    </div>
                    <a href="https://wa.me/201030578926"
                       class="ab-storefront-support-item ab-storefront-support-item--whatsapp"
                       target="_blank"
                       rel="noopener"
                       role="menuitem"
                       aria-label="Open WhatsApp support">
                        <span class="ab-storefront-support-item-icon">
                            <i class="fa fa-whatsapp" aria-hidden="true"/>
                        </span>
                        <span>
                            <strong>WhatsApp</strong>
                            <small class="o_force_ltr">01030578926</small>
                        </span>
                    </a>
                    <a href="http://m.me/AbdinPharmaciesOfficial"
                       class="ab-storefront-support-item ab-storefront-support-item--messenger"
                       target="_blank"
                       rel="noopener"
                       role="menuitem"
                       aria-label="Open Messenger support">
                        <span class="ab-storefront-support-item-icon">
                            <i class="fa fa-comments" aria-hidden="true"/>
                        </span>
                        <span>
                            <strong>Messenger</strong>
                            <small>Abdin Pharmacies</small>
                        </span>
                    </a>
                    <a href="tel:19036"
                       class="ab-storefront-support-item ab-storefront-support-item--hotline"
                       role="menuitem"
                       aria-label="Call hotline 19036">
                        <span class="ab-storefront-support-item-icon">
                            <i class="fa fa-phone" aria-hidden="true"/>
                        </span>
                        <span>
                            <strong>Hotline</strong>
                            <small class="o_force_ltr">19036</small>
                        </span>
                    </a>
                </div>
                <button type="button"
                        class="ab-storefront-support-toggle btn"
                        data-ab-support-toggle=""
                        aria-label="Open customer support"
                        aria-controls="abStorefrontSupportMenu"
                        aria-expanded="false">
                    <span class="ab-storefront-support-toggle-icon ab-storefront-support-toggle-icon--chat">
                        <i class="fa fa-comments" aria-hidden="true"/>
                    </span>
                    <span class="ab-storefront-support-toggle-icon ab-storefront-support-toggle-icon--close">
                        <i class="fa fa-times" aria-hidden="true"/>
                    </span>
                </button>
            </aside>
        </xpath>

        <xpath expr="//header[@id='top']" position="replace">
            <header t-if="not no_header" id="top" data-anchor="true" class="ab-storefront-header">
                <t t-set="ab_header_categories" t-value="website._ab_storefront_categories(limit=7)"/>
                <t t-set="ab_header_category_menu" t-value="website._ab_storefront_header_category_menu()"/>
                <t t-set="ab_header_need_menu" t-value="website._ab_storefront_header_need_menu()"/>
                <t t-set="ab_header_nav_labels" t-value="website._ab_storefront_header_nav_labels()"/>
                <t t-set="ab_current_path" t-value="request.httprequest.path.rstrip('/') or '/'"/>
                <t t-set="ab_offers_href" t-value="'/#ab-storefront-offers'"/>
                <t t-set="ab_prescription_href" t-value="'/prescription-order'"/>
                <t t-set="ab_offers_badge" t-value="False"/>
                <t t-set="ab_location_partner" t-value="False if request.env.user._is_public() else request.env.user.partner_id"/>
                <t t-set="ab_location_saved_addresses" t-value="ab_location_partner and ab_location_partner.child_ids.filtered(lambda address: address.type in ('delivery', 'other') and (address.city or address.state_id or address.country_id or address.street))[:1]"/>
                <t t-set="ab_location_address" t-value="ab_location_saved_addresses and ab_location_saved_addresses[0] or ab_location_partner"/>
                <t t-set="ab_location_name" t-value="ab_location_address and (ab_location_address.city or ab_location_address.state_id.name or ab_location_address.country_id.name or ab_location_address.street) or ''"/>
                <t t-set="ab_location_label" t-value="website._ab_storefront_location_label(ab_location_name)"/>

                <div class="ab-storefront-announcement">
                    <div class="container d-flex align-items-center justify-content-between gap-3 py-2">
                        <span class="ab-storefront-trust-line d-flex align-items-center gap-2">
                            <i class="fa fa-shield" aria-hidden="true"/>
                            <span>Trusted pharmacy care, delivered to your door</span>
                        </span>
                        <div class="ab-storefront-utility-actions d-none d-md-flex align-items-center gap-4">
                            <a href="tel:19036" class="text-reset text-decoration-none">
                                <i class="fa fa-phone me-1" aria-hidden="true"/>
                                Hotline <span class="o_force_ltr">19036</span>
                            </a>
                            <a href="/contactus" class="text-reset text-decoration-none">Contact us</a>
                        </div>
                    </div>
                </div>

                <div class="ab-storefront-sticky-sentinel" aria-hidden="true" data-ab-sticky-shop-sentinel=""/>
                <div class="ab-storefront-sticky-shop" data-ab-sticky-shop="">
                <nav class="ab-storefront-main-nav navbar navbar-expand-lg">
                    <div class="container ab-storefront-main-shell flex-wrap gap-3 py-3">
                        <a href="/" class="ab-storefront-brand navbar-brand d-flex align-items-center gap-2 me-auto" aria-label="Abdin Pharmacies home">
                            <span class="ab-storefront-brand-logo" data-ab-brand-logo-motion="true">
                                <img t-att-src="website.image_url(website, 'logo')"
                                     alt="Abdin Pharmacies"
                                     width="176"
                                     height="58"
                                     loading="eager"/>
                            </span>
                            <span class="ab-storefront-brand-fallback">
                                <strong>Abdin</strong>
                                <small>Pharmacies</small>
                            </span>
                        </a>

                        <div class="ab-storefront-search-wrap ab-storefront-desktop-search d-none d-lg-flex order-lg-1">
                            <t t-call="website.website_search_box_input">
                                <t t-set="search_type" t-value="'products'"/>
                                <t t-set="action" t-value="'/shop'"/>
                                <t t-set="limit" t-value="8"/>
                                <t t-set="display_image" t-value="'true'"/>
                                <t t-set="display_description" t-value="'true'"/>
                                <t t-set="display_extra_link" t-value="'true'"/>
                                <t t-set="display_detail" t-value="'true'"/>
                                <t t-set="placeholder">What are you looking for?</t>
                                <t t-set="default_style" t-value="True"/>
                                <t t-set="_form_classes" t-value="'ab-storefront-search'"/>
                                <t t-set="_input_classes" t-value="'form-control'"/>
                                <t t-set="_submit_classes" t-value="'btn btn-primary'"/>
                            </t>
                            <div class="ab-storefront-location"
                                 data-ab-current-location="true"
                                 t-att-data-ab-location-default="ab_location_name">
                                <button class="ab-storefront-location-trigger btn"
                                        type="button"
                                        t-att-aria-label="ab_location_label"
                                        t-att-title="ab_location_label">
                                    <i class="fa fa-map-marker" aria-hidden="true"/>
                                    <span class="ab-storefront-location-label" data-ab-location-label="" t-out="ab_location_label"/>
                                </button>
                                <span class="visually-hidden" aria-live="polite" data-ab-location-status=""/>
                            </div>
                        </div>

                        <ul class="ab-storefront-actions navbar-nav flex-row align-items-center order-lg-2">
                            <t t-call="website_sale_wishlist.header_wishlist_link">
                                <t t-set="_icon" t-value="True"/>
                                <t t-set="_link_class" t-value="'ab-storefront-action ab-storefront-wishlist-action btn position-relative'"/>
                                <t t-set="_badge_class" t-value="'position-absolute top-0 end-0 rounded-pill'"/>
                            </t>
                            <li t-if="request.env.user._is_public()" class="nav-item">
                                <a t-att-href="'/web/login?redirect=%s' % request.httprequest.path"
                                   class="ab-storefront-action ab-storefront-login-action btn"
                                   t-att-aria-label="ab_header_nav_labels['signin']"
                                   t-att-title="ab_header_nav_labels['signin']">
                                    <i class="fa fa-user" aria-hidden="true"/>
                                    <span t-out="ab_header_nav_labels['signin']"/>
                                </a>
                            </li>
                            <t t-call="website_sale.header_cart_link">
                                <t t-set="_icon" t-value="True"/>
                                <t t-set="_link_class" t-value="'ab-storefront-action ab-storefront-cart-action btn position-relative'"/>
                                <t t-set="_badge_class" t-value="'position-absolute top-0 end-0 rounded-pill'"/>
                            </t>
                            <li t-if="not request.env.user._is_public()" class="nav-item">
                                <a href="/my/home"
                                   class="ab-storefront-action btn"
                                   aria-label="My account"
                                   title="My account">
                                    <t t-set="avatar_value" t-value="request.env.user.partner_id.ab_storefront_avatar"/>
                                    <t t-set="avatar_size" t-value="'sm'"/>
                                    <t t-set="avatar_alt" t-value="'Your account avatar'"/>
                                    <t t-call="ab_ecommerce_storefront.avatar_image"/>
                                </a>
                            </li>
                            <t t-call="website.placeholder_header_language_selector">
                                <t t-set="_item_class" t-value="'nav-item d-none d-md-block ab-storefront-language-item'"/>
                                <t t-set="_btn_class" t-value="'ab-storefront-language btn'"/>
                                <t t-set="_dropdown_menu_class" t-value="'dropdown-menu-end'"/>
                            </t>
                            <li class="nav-item d-lg-none">
                                <button class="ab-storefront-action ab-storefront-mobile-menu-btn btn"
                                        type="button"
                                        data-bs-toggle="offcanvas"
                                        data-bs-target="#abStorefrontMobileNav"
                                        aria-controls="abStorefrontMobileNav"
                                        aria-label="Open navigation">
                                    <i class="fa fa-bars" aria-hidden="true"/>
                                </button>
                            </li>
                        </ul>

                        <div class="ab-storefront-search-wrap ab-storefront-mobile-search-row d-lg-none w-100 order-2">
                            <t t-call="website.website_search_box_input">
                                <t t-set="search_type" t-value="'products'"/>
                                <t t-set="action" t-value="'/shop'"/>
                                <t t-set="limit" t-value="8"/>
                                <t t-set="display_image" t-value="'true'"/>
                                <t t-set="display_description" t-value="'false'"/>
                                <t t-set="display_extra_link" t-value="'true'"/>
                                <t t-set="display_detail" t-value="'true'"/>
                                <t t-set="placeholder">What are you looking for?</t>
                                <t t-set="default_style" t-value="True"/>
                                <t t-set="_form_classes" t-value="'ab-storefront-search'"/>
                                <t t-set="_input_classes" t-value="'form-control'"/>
                                <t t-set="_submit_classes" t-value="'btn btn-primary'"/>
                            </t>
                            <div class="ab-storefront-location"
                                 data-ab-current-location="true"
                                 t-att-data-ab-location-default="ab_location_name">
                                <button class="ab-storefront-location-trigger btn"
                                        type="button"
                                        t-att-aria-label="ab_location_label"
                                        t-att-title="ab_location_label">
                                    <i class="fa fa-map-marker" aria-hidden="true"/>
                                    <span class="ab-storefront-location-label" data-ab-location-label="" t-out="ab_location_label"/>
                                </button>
                                <span class="visually-hidden" aria-live="polite" data-ab-location-status=""/>
                            </div>
                        </div>
                    </div>
                </nav>

                <div class="d-none" aria-hidden="true" data-ab-search-typewriter-config="">
                    <span data-ab-search-typewriter-label="">Search products</span>
                    <span data-ab-search-typewriter-prefix="">Search for</span>
                    <span data-ab-search-typewriter-phrase="">Panadol</span>
                    <span data-ab-search-typewriter-phrase="">sunscreen</span>
                    <span data-ab-search-typewriter-phrase="">vitamin C</span>
                    <span data-ab-search-typewriter-phrase="">a blood pressure monitor</span>
                    <span data-ab-search-typewriter-phrase="">hair shampoo</span>
                    <span data-ab-search-typewriter-phrase="">baby diapers</span>
                    <span data-ab-search-typewriter-phrase="">skin care</span>
                </div>

                <div class="ab-storefront-location-picker"
                     id="abStorefrontLocationPicker"
                     aria-hidden="true"
                     data-ab-location-picker="">
                    <div class="ab-storefront-location-picker-backdrop"
                         data-ab-location-picker-close=""/>
                    <section class="ab-storefront-location-picker-shell"
                             role="dialog"
                             aria-modal="true"
                             aria-labelledby="abStorefrontLocationPickerTitle">
                        <header class="ab-storefront-location-picker-header">
                            <button class="ab-storefront-location-picker-close"
                                    type="button"
                                    aria-label="Close location picker"
                                    data-ab-location-picker-close="">
                                <i class="fa fa-times" aria-hidden="true"/>
                            </button>
                            <h2 id="abStorefrontLocationPickerTitle">Location</h2>
                        </header>

                        <div class="ab-storefront-location-picker-body">
                            <div class="ab-storefront-location-search">
                                <i class="fa fa-search" aria-hidden="true"/>
                                <input type="search"
                                       placeholder="Search for an area, city, or governorate"
                                       aria-label="Search for an area, city, or governorate"
                                       data-ab-location-search=""/>
                            </div>

                            <button class="ab-storefront-location-country is-selected"
                                    type="button"
                                    data-ab-location-region="Egypt">
                                Egypt
                            </button>

                            <button class="ab-storefront-location-auto"
                                    type="button"
                                    data-ab-location-auto="">
                                <i class="fa fa-location-arrow" aria-hidden="true"/>
                                <span>Use my current location</span>
                            </button>

                            <button class="ab-storefront-location-add"
                                    type="button"
                                    data-ab-location-add="">
                                <span>Add new address</span>
                                <i class="fa fa-plus" aria-hidden="true"/>
                            </button>

                            <section class="ab-storefront-location-section d-none"
                                     data-ab-location-recent-section="">
                                <h3>
                                    <i class="fa fa-history" aria-hidden="true"/>
                                    Recent locations
                                </h3>
                                <div class="ab-storefront-location-recent"
                                     data-ab-location-recent-list=""/>
                            </section>

                            <section class="ab-storefront-location-section">
                                <h3>Popular areas</h3>
                                <div class="ab-storefront-location-regions"
                                     data-ab-location-regions="">
                                    <button type="button" data-ab-location-region="Cairo">Cairo</button>
                                    <button type="button" data-ab-location-region="Giza">Giza</button>
                                    <button type="button" data-ab-location-region="Alexandria">Alexandria</button>
                                    <button type="button" data-ab-location-region="Qalyubia">Qalyubia</button>
                                    <button type="button" data-ab-location-region="Sharqia">Sharqia</button>
                                    <button type="button" data-ab-location-region="Dakahlia">Dakahlia</button>
                                    <button type="button" data-ab-location-region="Sohag">Sohag</button>
                                    <button type="button" data-ab-location-region="Assiut">Assiut</button>
                                </div>
                            </section>

                            <section class="ab-storefront-location-section">
                                <label class="ab-storefront-location-detail-label"
                                       for="abStorefrontLocationDetail">Detailed address</label>
                                <textarea id="abStorefrontLocationDetail"
                                          rows="3"
                                          placeholder="Write the street, building number, floor, or nearest landmark"
                                          data-ab-location-detail=""></textarea>
                            </section>

                            <div class="ab-storefront-location-empty" data-ab-location-empty="">
                                <span class="ab-storefront-location-empty-icon">
                                    <i class="fa fa-map-marker" aria-hidden="true"/>
                                </span>
                                <strong>No saved addresses</strong>
                                <p>Add your address to complete orders easily or use your current location.</p>
                            </div>
                        </div>

                        <footer class="ab-storefront-location-picker-footer">
                            <div>
                                <span>Choose area</span>
                                <strong data-ab-location-selected="">Egypt</strong>
                            </div>
                            <button class="ab-storefront-location-submit"
                                    type="button"
                                    data-ab-location-submit="">
                                Select Egypt
                            </button>
                        </footer>
                    </section>
                </div>

                <div class="ab-storefront-category-nav navbar navbar-expand-lg d-none d-lg-block">
                    <nav class="container ab-storefront-primary-nav" t-att-aria-label="ab_header_nav_labels['store']">
                        <a href="/"
                           t-attf-class="ab-storefront-home-link nav-link d-inline-flex align-items-center gap-1 text-nowrap #{'active' if ab_current_path in ['/', '/ar'] else ''}">
                            <i class="fa fa-home" aria-hidden="true"/>
                            <span t-out="ab_header_nav_labels['home']"/>
                        </a>
                        <a t-att-href="ab_offers_href"
                           class="ab-storefront-offers-link nav-link d-inline-flex align-items-center gap-1 text-nowrap"
                           t-att-aria-label="ab_header_nav_labels['offers_aria']">
                            <i class="fa fa-tag" aria-hidden="true"/>
                            <span t-out="ab_header_nav_labels['offers']"/>
                            <span t-if="ab_offers_badge" class="ab-storefront-offers-badge" t-out="ab_offers_badge"/>
                        </a>
                        <div class="dropdown ab-storefront-category-dropdown ab-storefront-category-dropdown--category">
                            <button class="ab-storefront-categories-toggle btn dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-display="static"
                                    data-bs-offset="0,0"
                                aria-expanded="false">
                                <i class="fa fa-th-large me-2" aria-hidden="true"/>
                                <span t-out="ab_header_nav_labels['category']"/>
                            </button>
                            <div class="dropdown-menu ab-storefront-category-menu">
                                <a t-foreach="ab_header_category_menu"
                                   t-as="ab_menu_item"
                                   t-att-href="ab_menu_item['href']"
                                   class="dropdown-item ab-storefront-category-menu-link">
                                    <span t-attf-class="ab-storefront-category-icon ab-storefront-category-icon-#{ab_menu_item['tone']}"
                                          aria-hidden="true">
                                        <i t-attf-class="fa #{ab_menu_item['icon']}"/>
                                    </span>
                                    <span t-out="ab_menu_item['label']"/>
                                </a>
                            </div>
                        </div>
                        <div class="dropdown ab-storefront-category-dropdown ab-storefront-category-dropdown--need">
                            <button class="ab-storefront-categories-toggle btn dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    data-bs-display="static"
                                    data-bs-offset="0,0"
                                aria-expanded="false">
                                <i class="fa fa-heartbeat me-2" aria-hidden="true"/>
                                <span t-out="ab_header_nav_labels['need']"/>
                            </button>
                            <div class="dropdown-menu ab-storefront-category-menu">
                                <a t-foreach="ab_header_need_menu"
                                   t-as="ab_menu_item"
                                   t-att-href="ab_menu_item['href']"
                                   class="dropdown-item ab-storefront-category-menu-link">
                                    <span t-attf-class="ab-storefront-category-icon ab-storefront-category-icon-#{ab_menu_item['tone']}"
                                          aria-hidden="true">
                                        <i t-attf-class="fa #{ab_menu_item['icon']}"/>
                                    </span>
                                    <span t-out="ab_menu_item['label']"/>
                                </a>
                            </div>
                        </div>
                        <a t-att-href="ab_prescription_href"
                           class="ab-storefront-prescription-link text-decoration-none text-nowrap">
                            <i class="fa fa-file-text-o" aria-hidden="true"/>
                            <span t-out="ab_header_nav_labels['prescription']"/>
                        </a>
                    </nav>
                </div>
                </div>

                <div class="offcanvas offcanvas-end ab-storefront-mobile-nav"
                     tabindex="-1"
                     id="abStorefrontMobileNav"
                     aria-labelledby="abStorefrontMobileNavLabel">
                    <div class="offcanvas-header">
                        <h2 class="offcanvas-title h5 mb-0" id="abStorefrontMobileNavLabel">Abdin Pharmacies</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"/>
                    </div>
                    <div class="offcanvas-body">
                        <a href="/"
                           t-attf-class="ab-storefront-mobile-secondary-link #{'active' if ab_current_path in ['/', '/ar'] else ''}"
                           t-att-aria-label="ab_header_nav_labels['home']">
                            <i class="fa fa-home" aria-hidden="true"/>
                            <span t-out="ab_header_nav_labels['home']"/>
                        </a>
                        <a t-att-href="ab_offers_href"
                           class="ab-storefront-mobile-offers-link"
                           t-att-aria-label="ab_header_nav_labels['offers_aria']">
                            <i class="fa fa-tag" aria-hidden="true"/>
                            <span t-out="ab_header_nav_labels['offers']"/>
                            <span t-if="ab_offers_badge" class="ab-storefront-offers-badge" t-out="ab_offers_badge"/>
                        </a>
                        <a t-att-href="ab_prescription_href" class="ab-storefront-mobile-primary-link">
                            <i class="fa fa-file-text-o" aria-hidden="true"/>
                            <span t-out="ab_header_nav_labels['prescription']"/>
                        </a>
                        <a t-if="not request.env.user._is_public()"
                           href="/my/home"
                           class="ab-storefront-mobile-secondary-link">
                            <t t-set="avatar_value" t-value="request.env.user.partner_id.ab_storefront_avatar"/>
                            <t t-set="avatar_size" t-value="'xs'"/>
                            <t t-set="avatar_alt" t-value="'Your account avatar'"/>
                            <t t-call="ab_ecommerce_storefront.avatar_image"/>
                            <span t-out="ab_header_nav_labels['account']"/>
                        </a>
                        <a t-if="request.env.user._is_public()"
                           t-att-href="'/web/login?redirect=%s' % request.httprequest.path"
                           class="ab-storefront-mobile-secondary-link">
                            <i class="fa fa-user" aria-hidden="true"/>
                            <span t-out="ab_header_nav_labels['signin']"/>
                        </a>
                        <a href="/shop/wishlist" class="ab-storefront-mobile-secondary-link">
                            <i class="fa fa-heart-o" aria-hidden="true"/>
                            <span t-out="ab_header_nav_labels['wishlist']"/>
                        </a>
                        <div class="ab-storefront-location ab-storefront-location--mobile-menu"
                             data-ab-current-location="true"
                             t-att-data-ab-location-default="ab_location_name">
                            <button class="ab-storefront-mobile-secondary-link ab-storefront-location-trigger"
                                    type="button"
                                    t-att-aria-label="ab_location_label"
                                    t-att-title="ab_location_label">
                                <i class="fa fa-map-marker" aria-hidden="true"/>
                                <span class="ab-storefront-location-label" data-ab-location-label="" t-out="ab_location_label"/>
                            </button>
                            <span class="visually-hidden" aria-live="polite" data-ab-location-status=""/>
                        </div>
                        <ul class="ab-storefront-mobile-language list-unstyled mb-3">
                            <t t-call="website.placeholder_header_language_selector">
                                <t t-set="_item_class" t-value="'ab-storefront-mobile-language-item'"/>
                                <t t-set="_btn_class" t-value="'ab-storefront-mobile-secondary-link'"/>
                                <t t-set="_dropdown_menu_class" t-value="'dropdown-menu-end'"/>
                            </t>
                        </ul>
                        <p class="ab-storefront-mobile-heading" t-out="ab_header_nav_labels['category']"/>
                        <nav class="nav flex-column mb-4">
                            <a t-foreach="ab_header_category_menu"
                               t-as="ab_menu_item"
                               t-att-href="ab_menu_item['href']"
                               class="nav-link ab-storefront-mobile-category-link">
                                <span t-attf-class="ab-storefront-category-icon ab-storefront-category-icon-#{ab_menu_item['tone']}"
                                      aria-hidden="true">
                                    <i t-attf-class="fa #{ab_menu_item['icon']}"/>
                                </span>
                                <span t-out="ab_menu_item['label']"/>
                            </a>
                        </nav>
                        <p class="ab-storefront-mobile-heading" t-out="ab_header_nav_labels['need']"/>
                        <nav class="nav flex-column mb-4">
                            <a t-foreach="ab_header_need_menu"
                               t-as="ab_menu_item"
                               t-att-href="ab_menu_item['href']"
                               class="nav-link ab-storefront-mobile-category-link">
                                <span t-attf-class="ab-storefront-category-icon ab-storefront-category-icon-#{ab_menu_item['tone']}"
                                      aria-hidden="true">
                                    <i t-attf-class="fa #{ab_menu_item['icon']}"/>
                                </span>
                                <span t-out="ab_menu_item['label']"/>
                            </a>
                        </nav>
                        <div class="ab-storefront-mobile-contact mt-4">
                            <a href="tel:19036" class="btn btn-primary w-100">
                                Call hotline <span class="o_force_ltr">19036</span>
                            </a>
                        </div>
                    </div>
                </div>
            </header>
        </xpath>

        <xpath expr="//footer[@id='bottom']" position="replace">
            <footer t-if="not no_footer" id="bottom" data-anchor="true" class="ab-storefront-footer o_footer">
                <t t-set="ab_footer_categories" t-value="website._ab_storefront_categories(limit=5)"/>
                <div id="footer" class="container py-5">
                    <div class="row g-4 g-lg-5">
                        <div class="col-12 col-lg-4">
                            <a href="/" class="ab-storefront-footer-brand d-inline-flex align-items-center gap-3 text-decoration-none">
                                <img t-att-src="website.image_url(website, 'logo')"
                                     alt="Abdin Pharmacies"
                                     width="170"
                                     height="56"
                                     loading="lazy"/>
                            </a>
                            <p class="mt-3 mb-4">
                                Trusted pharmacy care and healthcare essentials from Abdin Pharmacies, delivered with confidence across Egypt.
                            </p>
                            <div class="d-flex flex-wrap gap-2">
                                <a href="/website/social/facebook" class="ab-storefront-social" target="_blank" aria-label="Facebook">
                                    <i class="fa fa-facebook" aria-hidden="true"/>
                                </a>
                                <a href="/website/social/instagram" class="ab-storefront-social" target="_blank" aria-label="Instagram">
                                    <i class="fa fa-instagram" aria-hidden="true"/>
                                </a>
                                <a href="/website/social/linkedin" class="ab-storefront-social" target="_blank" aria-label="LinkedIn">
                                    <i class="fa fa-linkedin" aria-hidden="true"/>
                                </a>
                            </div>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <h2 class="h6">Shop</h2>
                            <ul class="list-unstyled">
                                <li><a href="/shop">All products</a></li>
                                <li t-foreach="ab_footer_categories" t-as="ab_category">
                                    <a t-att-href="'/shop/category/%s' % request.env['ir.http']._slug(ab_category)">
                                        <span t-out="website._ab_storefront_category_label(ab_category)"/>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="col-6 col-md-4 col-lg-2">
                            <h2 class="h6">Customer care</h2>
                            <ul class="list-unstyled">
                                <li><a href="/my/home">My account</a></li>
                                <li><a href="/my/orders">My orders</a></li>
                                <li><a href="/shop/wishlist">Wishlist</a></li>
                                <li><a href="/contactus">Contact us</a></li>
                                <li><a href="/privacy-policy">Privacy policy</a></li>
                            </ul>
                        </div>
                        <div class="col-12 col-md-4 col-lg-4">
                            <h2 class="h6">We are here to help</h2>
                            <a href="tel:19036" class="ab-storefront-hotline text-decoration-none">
                                <span class="ab-storefront-hotline-icon"><i class="fa fa-phone" aria-hidden="true"/></span>
                                <span>
                                    <small>Call our hotline</small>
                                    <strong class="o_force_ltr">19036</strong>
                                </span>
                            </a>
                            <p t-if="res_company.email" class="mt-3 mb-0">
                                <i class="fa fa-envelope-o me-2" aria-hidden="true"/>
                                <a t-att-href="'mailto:%s' % res_company.email" t-out="res_company.email"/>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="ab-storefront-copyright">
                    <div class="container d-flex flex-column flex-md-row justify-content-between gap-2 py-3">
                        <span>Copyright © Abdin Pharmacies</span>
                        <span>Healthcare with care, every day.</span>
                    </div>
                </div>
            </footer>
        </xpath>
    </template>
</odoo>
