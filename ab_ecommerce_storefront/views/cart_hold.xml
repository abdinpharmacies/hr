<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="cart_hold_notice" inherit_id="website_sale.cart" name="Cart Hold Notice">
        <xpath expr="//t[@t-call='website_sale.cart_lines']" position="before">
            <div t-if="website_sale_order and website_sale_order.ab_cart_hold_expires_at"
                 class="alert alert-info" role="status" data-ab-cart-hold=""
                 t-att-data-expires-at="website_sale_order.ab_cart_hold_expires_at.isoformat() + 'Z'">
                <span data-ab-cart-hold-active="">Note: These items have been reserved, and the quantity will be available in the store again after</span>
                <strong class="o_force_ltr" dir="ltr" data-ab-cart-hold-countdown=""/>
                <span class="d-none" data-ab-cart-hold-expired="">Your website hold has expired. Items remain in your cart and availability will be checked again at checkout.</span>
            </div>
        </xpath>
    </template>
</odoo>
