    <record id="auth_rate_admin_rule" model="ir.rule">
        <field name="name">Authentication rate limits: administrators</field>
        <field name="model_id" ref="model_ab_storefront_auth_rate"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <record id="auth_event_admin_rule" model="ir.rule">
        <field name="name">Authentication delivery: administrators</field>
        <field name="model_id" ref="model_ab_storefront_auth_event"/>
        <field name="domain_force">[(1, '=', 1)]</field>
