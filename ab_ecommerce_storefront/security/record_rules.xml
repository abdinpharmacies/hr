<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_ab_prescription_order_internal_all" model="ir.rule">
        <field name="name">Prescription orders: internal users</field>
        <field name="model_id" ref="model_ab_prescription_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ab_prescription_order_portal_own" model="ir.rule">
        <field name="name">Prescription orders: portal customers own records</field>
        <field name="model_id" ref="model_ab_prescription_order"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
