<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_legacy_seo_import_company" model="ir.rule">
        <field name="name">Legacy SEO imports by company</field>
        <field name="model_id" ref="model_ab_storefront_legacy_seo_import"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_legacy_seo_import_line_company" model="ir.rule">
        <field name="name">Legacy SEO import lines by company</field>
        <field name="model_id" ref="model_ab_storefront_legacy_seo_import_line"/>
        <field name="domain_force">[('import_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_legacy_seo_import_owner" model="ir.rule">
        <field name="name">Legacy SEO imports by owner</field>
        <field name="model_id" ref="model_ab_storefront_legacy_seo_import"/>
        <field name="groups" eval="[Command.link(ref('ab_website_seo_optimization.group_ab_website_seo_optimization_manager'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_legacy_seo_import_admin" model="ir.rule">
        <field name="name">Legacy SEO imports for administrators</field>
        <field name="model_id" ref="model_ab_storefront_legacy_seo_import"/>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_legacy_seo_import_line_owner" model="ir.rule">
        <field name="name">Legacy SEO import lines by owner</field>
        <field name="model_id" ref="model_ab_storefront_legacy_seo_import_line"/>
        <field name="groups" eval="[Command.link(ref('ab_website_seo_optimization.group_ab_website_seo_optimization_manager'))]"/>
        <field name="domain_force">[('import_id.create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_legacy_seo_import_line_admin" model="ir.rule">
        <field name="name">Legacy SEO import lines for administrators</field>
        <field name="model_id" ref="model_ab_storefront_legacy_seo_import_line"/>
        <field name="groups" eval="[Command.link(ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_staff_account_owner_company" model="ir.rule">
        <field name="name">Website staff accounts: creator and company</field>
        <field name="model_id" ref="model_ab_ecommerce_staff_account"/>
        <field name="domain_force">[('owner_id', '=', user.id), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ab_storefront_offer_company" model="ir.rule">
        <field name="name">Storefront offers: allowed companies</field>
        <field name="model_id" ref="model_ab_storefront_offer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ab_prescription_order_company" model="ir.rule">
        <field name="name">Prescription orders: allowed companies</field>
        <field name="model_id" ref="model_ab_prescription_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_ab_prescription_order_internal_all" model="ir.rule">
        <field name="name">Prescription orders: internal users</field>
        <field name="model_id" ref="model_ab_prescription_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ab_prescription_order_portal_own" model="ir.rule">
        <field name="name">Prescription orders: portal customers own records</field>
        <field name="model_id" ref="model_ab_prescription_order"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_ab_ecommerce_browsing_history_internal_all" model="ir.rule">
        <field name="name">Browsing history: internal users</field>
        <field name="model_id" ref="model_ab_ecommerce_browsing_history"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_ab_ecommerce_browsing_history_portal_own" model="ir.rule">
        <field name="name">Browsing history: portal customers own records</field>
        <field name="model_id" ref="model_ab_ecommerce_browsing_history"/>
        <field name="domain_force">[('partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>

    <record id="rule_ab_ecommerce_customer_testimonial_public_published" model="ir.rule">
        <field name="name">Customer testimonials: public published records</field>
        <field name="model_id" ref="model_ab_ecommerce_customer_testimonial"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public'))]"/>
    </record>

    <record id="rule_ab_ecommerce_customer_testimonial_portal_published" model="ir.rule">
        <field name="name">Customer testimonials: portal published records</field>
        <field name="model_id" ref="model_ab_ecommerce_customer_testimonial"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    </record>
</odoo>
