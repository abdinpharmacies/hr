<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_call_center_website_orders" model="ir.rule">
        <field name="name">Call center: website orders</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="domain_force">[('website_id', '!=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_call_center'))]"/>
    </record>
    <record id="rule_call_center_website_order_lines" model="ir.rule">
        <field name="name">Call center: website order lines</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="domain_force">[('order_id.website_id', '!=', False)]</field>
        <field name="groups" eval="[Command.link(ref('group_call_center'))]"/>
    </record>
    <record id="rule_call_center_carousel_company" model="ir.rule">
        <field name="name">Call center: carousel websites in allowed companies</field>
        <field name="model_id" ref="ab_website_admin_content.model_ab_website_carousel_slide"/>
        <field name="domain_force">['|', ('website_id', '=', False), ('website_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_call_center'))]"/>
    </record>
    <record id="rule_call_center_testimonial_company" model="ir.rule">
        <field name="name">Call center: social comments in allowed companies</field>
        <field name="model_id" ref="model_ab_ecommerce_customer_testimonial"/>
        <field name="domain_force">['|', ('website_id', '=', False), ('website_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_call_center'))]"/>
    </record>
    <record id="rule_call_center_category_company" model="ir.rule">
        <field name="name">Call center: category websites in allowed companies</field>
        <field name="model_id" ref="website_sale.model_product_public_category"/>
        <field name="domain_force">['|', ('website_id', '=', False), ('website_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[Command.link(ref('group_call_center'))]"/>
    </record>
</odoo>
