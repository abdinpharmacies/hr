<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ab_sales_contract.PosActionContractInherit"
       t-inherit="ab_sales.PosAction"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('ab_pos_meta_block_total')]" position="after">
            <div class="o_ab_sales_pos_meta_block ab_sales_contract_total_after_discount">
                <span class="label text-wrap">Total After Discount</span>
                <span class="o_ab_sales_pos_readonly"
                      t-esc="formatMoney2(totalAfterDiscount(currentBill))"/>
            </div>
        </xpath>
        <xpath expr="//div[contains(@class, 'o_ab_sales_pos_customer_group')]" position="before">
            <div class="o_ab_sales_pos_top_group o_ab_sales_pos_contract_group">
                <div class="o_ab_sales_pos_field_row">
                    <ABMany2one
                            relation="'ab_contract'"
                            value="contractValue()"
                            update="(value) => this.onContractM2OUpdate(value)"
                            placeholder.translate="Contract..."
                            domain="() => [['active', '=', true]]"
                            canCreate="false"
                            canCreateEdit="false"
                            canQuickCreate="false"
                            canOpen="false"
                            canWrite="true"
                            string.translate="Contract"
                    />
                    <t t-if="currentBill.header.contract_allow_total_invoice_discount">
                        <input class="form-control form-control-sm o_ab_sales_pos_total_invoice_discount"
                               inputmode="decimal"
                               placeholder="Invoice discount"
                               t-att-value="currentBill.header.total_invoice_discount || 0"
                               t-on-input="(ev) => onTotalInvoiceDiscountInput(ev.target.value)"/>
                        <span class="badge text-bg-secondary o_ab_sales_pos_total_invoice_discount_source"
                              ><t t-if="currentBill.header.contract_total_invoice_discount_source === 'contract_company'">Contract Company</t><t t-else="">Our Company</t></span>
                    </t>
                </div>
            </div>
        </xpath>
    </t>
</templates>
