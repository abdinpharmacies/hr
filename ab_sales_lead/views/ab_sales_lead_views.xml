<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="ab_sales_lead_view_list" model="ir.ui.view">
            <field name="name">ab_sales_lead.list</field>
            <field name="model">ab_sales_lead</field>
            <field name="arch" type="xml">
                <list string="Sales Leads" default_order="create_date desc">
                    <field name="create_date"/>
                    <field name="lead_type"/>
                    <field name="state"/>
                    <field name="product_code"/>
                    <field name="product_name"/>
                    <field name="quantity"/>
                    <field name="store_id"/>
                    <field name="customer_name"/>
                    <field name="customer_phone"/>
                    <field name="lost_reason"/>
                    <field name="needed_date"/>
                    <field name="user_id"/>
                </list>
            </field>
        </record>

        <record id="ab_sales_lead_view_form" model="ir.ui.view">
            <field name="name">ab_sales_lead.form</field>
            <field name="model">ab_sales_lead</field>
            <field name="arch" type="xml">
                <form string="Sales Lead">
                    <header>
                        <button name="action_set_in_review"
                                string="In Review"
                                type="object"
                                class="btn-secondary"
                                groups="ab_sales.group_ab_sales_manager"
                                invisible="state != 'new'"/>
                        <button name="action_set_contacted"
                                string="Contacted"
                                type="object"
                                class="btn-primary"
                                groups="ab_sales.group_ab_sales_manager"
                                invisible="state not in ['new', 'in_review']"/>
                        <button name="action_set_closed"
                                string="Closed"
                                type="object"
                                class="btn-success"
                                groups="ab_sales.group_ab_sales_manager"
                                invisible="state == 'closed'"/>
                        <button name="action_set_cancelled"
                                string="Cancelled"
                                type="object"
                                class="btn-secondary"
                                groups="ab_sales.group_ab_sales_manager"
                                invisible="state == 'cancelled'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="new,in_review,contacted,closed,cancelled"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Lead">
                                <field name="lead_type"/>
                                <field name="source"/>
                                <field name="user_id" readonly="1"/>
                                <field name="store_id"/>
                            </group>
                            <group string="Product">
                                <field name="product_id"/>
                                <field name="product_code"/>
                                <field name="product_name"/>
                                <field name="quantity"/>
                                <field name="default_price"/>
                                <field name="total_balance"/>
                                <field name="pos_balance"/>
                            </group>
                        </group>
                        <group>
                            <group string="Customer">
                                <field name="customer_id"/>
                                <field name="customer_name"/>
                                <field name="customer_phone"/>
                                <field name="customer_address"/>
                                <field name="contact_preference"/>
                            </group>
                            <group string="Scenario Details">
                                <field name="lost_reason" invisible="lead_type != 'lost_sales'"/>
                                <field name="needed_date" invisible="lead_type != 'special_order'"/>
                                <field name="pos_search_query"/>
                                <field name="pos_client_token"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="notes"
                                       placeholder="Customer request, complaint, or missing product details..."/>
                            </page>
                            <page string="Company Action">
                                <field name="company_action_note" placeholder="Follow-up result or action taken..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ab_sales_lead_view_search" model="ir.ui.view">
            <field name="name">ab_sales_lead.search</field>
            <field name="model">ab_sales_lead</field>
            <field name="arch" type="xml">
                <search string="Sales Leads">
                    <field name="product_name"/>
                    <field name="product_code"/>
                    <field name="customer_phone"/>
                    <field name="customer_name"/>
                    <field name="store_id"/>
                    <field name="user_id"/>
                    <filter name="lost_sales" string="Lost Sales" domain="[('lead_type', '=', 'lost_sales')]"/>
                    <filter name="special_orders" string="Special Orders"
                            domain="[('lead_type', '=', 'special_order')]"/>
                    <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                    <filter name="contacted" string="Contacted" domain="[('state', '=', 'contacted')]"/>
                    <group>
                        <filter name="group_lead_type" string="Scenario" context="{'group_by': 'lead_type'}"/>
                        <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                        <filter name="group_store" string="Store" context="{'group_by': 'store_id'}"/>
                        <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                        <filter name="group_user" string="Cashier" context="{'group_by': 'user_id'}"/>
                        <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="ab_sales_lead_action" model="ir.actions.act_window">
            <field name="name">Sales Leads</field>
            <field name="res_model">ab_sales_lead</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_sales_lead_view_search"/>
            <field name="context">{'search_default_new': 1}</field>
        </record>
    </data>
</odoo>
