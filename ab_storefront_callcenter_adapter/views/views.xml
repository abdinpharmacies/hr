<odoo>
  <record id="endpoint_list" model="ir.ui.view">
    <field name="name">Callcenter endpoints</field>
    <field name="model">ab_storefront_callcenter_endpoint</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="source"/>
        <field name="website_id"/>
        <field name="company_id"/>
        <field name="service_user_id"/>
        <field name="cutoff"/>
        <field name="enabled"/>
      </list>
    </field>
  </record>
  <record id="endpoint_form" model="ir.ui.view">
    <field name="name">Callcenter endpoint</field>
    <field name="model">ab_storefront_callcenter_endpoint</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="source" readonly="id"/>
            <field name="website_id" readonly="id" domain="[('company_id', 'in', allowed_company_ids)]" options="{'no_create': True}"/>
            <field name="company_id"/>
            <field name="service_user_id"/>
            <field name="cutoff"/>
            <field name="enabled"/>
            <field name="media_enabled"/><field name="dispatch_lifecycle_enabled"/><field name="lifecycle_enabled"/><field name="guest_metadata_enabled"/><field name="chat_enabled"/>
            <field name="outgoing_enabled"/>
            <field name="livechat_channel_id" options="{'no_create': True}"/>
            <field name="bridge_operator_id" options="{'no_create': True}"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="endpoint_action" model="ir.actions.act_window">
    <field name="name">Callcenter Endpoints</field>
    <field name="res_model">ab_storefront_callcenter_endpoint</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="endpoint_menu" name="Callcenter Endpoints" action="endpoint_action" groups="base.group_system"/>
  <record id="unit_form" model="ir.ui.view">
    <field name="name">Callcenter unit code</field>
    <field name="model">uom.uom</field>
    <field name="inherit_id" ref="uom.product_uom_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="after">
        <field name="ab_callcenter_code" groups="base.group_system"/>
      </xpath>
    </field>
  </record>
  <template id="confirmation_chat" inherit_id="website_sale.confirmation">
    <xpath expr="//div[@id='order_name']" position="after">
      <a t-if="order.ab_callcenter_uuid" t-att-href="'/my/website-chat/' + order.ab_callcenter_uuid" class="btn btn-secondary">Chat about this order</a>
    </xpath>
  </template>
  <template id="portal_chat" inherit_id="sale.sale_order_portal_content">
    <xpath expr="//div[@id='introduction']" position="after">
      <a t-if="sale_order.ab_callcenter_uuid" t-att-href="'/my/website-chat/' + sale_order.ab_callcenter_uuid" class="btn btn-secondary">Chat about this order</a>
    </xpath>
  </template>
  <template id="portal_chat_readiness" inherit_id="sale.sale_order_portal_template">
    <xpath expr="//t[@t-call='portal.message_thread']" position="attributes">
      <attribute name="disable_composer">(disable_composer or sale_order.ab_callcenter_chat_closed or not sale_order.ab_callcenter_chat_ready or not sale_order.ab_callcenter_endpoint_id.sudo().chat_enabled) if sale_order.ab_callcenter_uuid else disable_composer</attribute>
    </xpath>
    <xpath expr="//t[@t-call='portal.message_thread']" position="before">
      <span t-if="sale_order.ab_callcenter_uuid" t-att-data-ab-order-chatter="sale_order.id" t-att-data-closed="'1' if sale_order.ab_callcenter_chat_closed else None"/>
      <p t-if="sale_order.ab_callcenter_uuid and not sale_order.ab_callcenter_chat_closed and not sale_order.ab_callcenter_chat_ready" role="status">Order chat is waiting for Callcenter acknowledgement.</p>
    </xpath>
  </template>
  <template id="chat" name="Website Order Chat">
    <t t-call="website.layout">
      <main class="container py-4 ab_website_chat" t-att-data-chat-identity="chat_identity">
        <h1>Order chat</h1>
        <p t-esc="order.name"/>
        <div data-chat-history="" aria-live="polite"/>
        <p data-chat-status="" role="status"/>
        <button type="button" data-chat-refresh="" class="btn btn-secondary">Refresh</button>
        <form t-att-action="'/storefront-callcenter/chat/' + order.ab_callcenter_uuid" method="post">
          <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
          <label for="ab_chat_body">Message</label>
          <input t-if="order.ab_callcenter_endpoint_id.sudo().media_enabled" type="file" multiple="multiple" data-chat-upload="" aria-label="Attachments"/>
          <div data-chat-uploads=""/>
          <textarea t-att-disabled="order.ab_callcenter_chat_closed or not order.ab_callcenter_chat_ready" id="ab_chat_body" name="body" maxlength="4096" class="form-control"/>
          <button t-att-disabled="order.ab_callcenter_chat_closed or not order.ab_callcenter_chat_ready" type="submit" class="btn btn-primary mt-2">Send</button>
        </form>
      </main>
    </t>
  </template>
  <record id="sale_order_form" model="ir.ui.view">
    <field name="name">Callcenter order update</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//header" position="inside">
        <field name="ab_callcenter_uuid" invisible="True"/>
        <button name="action_ab_callcenter_publish_revision" type="object" string="Send callcenter update" groups="sales_team.group_sale_manager" invisible="not ab_callcenter_uuid"/>
      </xpath>
    </field>
  </record>
</odoo>
