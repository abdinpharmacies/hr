<odoo><record id="category_callcenter" model="ir.module.category"><field name="name">Website Callcenter</field></record><record id="privilege_callcenter" model="res.groups.privilege"><field name="name">Callcenter Exchange</field><field name="category_id" ref="category_callcenter"/></record><record id="group_service" model="res.groups"><field name="name">Callcenter Exchange Service</field><field name="privilege_id" ref="privilege_callcenter"/></record>
<record id="ab_storefront_callcenter_endpoint_company" model="ir.rule"><field name="name">Callcenter company isolation</field><field name="model_id" ref="model_ab_storefront_callcenter_endpoint"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="endpoint_service_scope" model="ir.rule"><field name="name">Assigned callcenter endpoint</field><field name="model_id" ref="model_ab_storefront_callcenter_endpoint"/><field name="domain_force">[('service_user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_service'))]"/></record>
<record id="ab_storefront_callcenter_event_company" model="ir.rule"><field name="name">Callcenter company isolation</field><field name="model_id" ref="model_ab_storefront_callcenter_event"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="ab_storefront_callcenter_reply_company" model="ir.rule"><field name="name">Callcenter company isolation</field><field name="model_id" ref="model_ab_storefront_callcenter_reply"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
</odoo>