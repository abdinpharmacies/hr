<templates xml:space="preserve">
    <t t-name="ab_storefront_callcenter_adapter.WebsiteHistory">
        <section class="ab_website_history px-2" style="max-height: 25%; overflow-y: auto;">
            <p t-if="state.unavailable" role="status">Chat unavailable. Your draft is saved. Please retry.</p>
            <p t-if="state.ended" role="status">This website chat has ended.</p>
            <p t-if="state.pending" role="status">Message pending acknowledgement.</p>
            <button t-if="state.review &amp;&amp; !state.ended" class="btn btn-link" t-on-click="retry">Retry pending message</button>
            <details t-if="state.previous.length"><summary>Previous conversations</summary>
                <Message t-foreach="state.previous" t-as="message" t-key="message.id" message="message" thread="message.thread" hasActions="false" isReadOnly="true"/>
            </details>
        </section>
    </t>
    <t t-inherit="mail.ChatWindow" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-ChatWindow-header')]" position="after">
            <WebsiteHistory t-if="thread?.ab_callcenter_session_uuid" thread="thread" t-key="thread.id"/>
        </xpath>
    </t>
</templates>
