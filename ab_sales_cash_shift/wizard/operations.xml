<odoo>
    <record id="cash_operation_form" model="ir.ui.view">
        <field name="name">ab_sales_cash_operation.form</field><field name="model">ab_sales_cash_operation</field>
        <field name="arch" type="xml">
            <form string="Cashier Wallet Operation"><group><field name="operation"/><field name="drawer_id"/>
                <field name="store_id" invisible="1"/><field name="currency_id" invisible="1"/>
                <field name="shift_id" invisible="not shift_id"/><field name="transfer_id" invisible="not transfer_id"/>
                <field name="sale_id" invisible="not sale_id"/><field name="return_id" invisible="not return_id"/>
                <field name="session_token" invisible="1"/><field name="method_ids" invisible="1"/>
                <field name="employee_id" invisible="session_token or operation in ['prepare', 'review', 'reschedule']"/>
                <field name="pin" password="True" invisible="session_token or operation in ['prepare', 'review', 'reschedule']"/>
                <field name="due_amount" invisible="operation != 'settle'"/>
                <field name="expected_amount" invisible="operation != 'close'"/>
                <field name="handover_amount" invisible="operation != 'accept'"/>
                <field name="opening_amount" invisible="operation != 'prepare'"/>
                <field name="counted_amount" invisible="operation not in ['accept', 'close', 'receive']"/>
                <field name="count_confirmed" invisible="operation not in ['accept', 'close', 'receive']"/>
                <field name="carry_amount" invisible="operation != 'close'"/>
                <field name="next_employee_id" invisible="operation not in ['close', 'prepare', 'reschedule']"/>
                <field name="treasury_id" domain="[('store_id', '=', store_id)]" invisible="operation != 'close'"/>
                <field name="note" invisible="operation not in ['close', 'review', 'reschedule']"/>
            </group>
            <field name="line_ids" invisible="operation != 'settle'">
                <list editable="bottom"><field name="currency_id" column_invisible="True"/><field name="method_id" domain="[('id', 'in', parent.method_ids)]"/>
                    <field name="amount" sum="Total"/><field name="reference"/></list>
            </field>
            <footer><button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                <button string="Cancel" special="cancel"/></footer></form>
        </field>
    </record>
</odoo>
