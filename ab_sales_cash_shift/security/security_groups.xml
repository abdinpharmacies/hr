<odoo>
    <record id="category_cash_shift" model="ir.module.category">
        <field name="name">Cash Shifts</field>
    </record>
    <record id="privilege_cash_shift" model="res.groups.privilege">
        <field name="name">Cash Shift Access</field>
        <field name="category_id" ref="category_cash_shift"/>
    </record>
    <record id="group_cash_manager" model="res.groups">
        <field name="name">Cash Configuration Manager</field>
        <field name="privilege_id" ref="privilege_cash_shift"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_cash_finance" model="res.groups">
        <field name="name">Cash Difference Finance Reviewer</field>
        <field name="privilege_id" ref="privilege_cash_shift"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
