<odoo>
    <record id="rule_document_company" model="ir.rule">
        <field name="name">Editor documents in allowed companies</field>
        <field name="model_id" ref="model_ab_ecommerce_editor_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_revision_company" model="ir.rule">
        <field name="name">Editor versions in allowed companies</field>
        <field name="model_id" ref="model_ab_ecommerce_editor_revision"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_template_company" model="ir.rule">
        <field name="name">Reusable blocks in allowed companies</field>
        <field name="model_id" ref="model_ab_ecommerce_editor_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_editor_layout_user" model="ir.rule">
        <field name="name">Own editor layout</field>
        <field name="model_id" ref="model_ab_ecommerce_editor_layout"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
</odoo>
