<odoo>
    <record id="category_ecommerce_editor" model="ir.module.category">
        <field name="name">eCommerce Editor</field>
    </record>
    <record id="privilege_ecommerce_editor" model="res.groups.privilege">
        <field name="name">Content access</field>
        <field name="category_id" ref="category_ecommerce_editor"/>
    </record>
    <record id="group_editor_editor" model="res.groups">
        <field name="name">Editor</field>
        <field name="privilege_id" ref="privilege_ecommerce_editor"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_editor_reviewer" model="res.groups">
        <field name="name">Reviewer</field>
        <field name="privilege_id" ref="privilege_ecommerce_editor"/>
        <field name="implied_ids" eval="[(4, ref('group_editor_editor'))]"/>
    </record>
    <record id="group_editor_publisher" model="res.groups">
        <field name="name">Publisher</field>
        <field name="privilege_id" ref="privilege_ecommerce_editor"/>
        <field name="implied_ids" eval="[(4, ref('group_editor_reviewer'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('ab_ecommerce_editor.group_editor_publisher'))]"/>
    </record>
</odoo>
