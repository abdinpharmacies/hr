<odoo>
  <record id="ab_sales_promo_report_line_view_list" model="ir.ui.view">
    <field name="name">Recorded Callcenter Promotions</field><field name="model">ab_sales_promo_report_line</field>
    <field name="arch" type="xml"><list create="false" edit="false"><field name="invoice_id"/><field name="invoice_date"/><field name="store_id"/><field name="promo_id"/><field name="promotion_ownership"/><field name="product_id"/><field name="qty"/><field name="price"/><field name="total_price"/><field name="promo_discount"/><field name="total_invoice_after_promo"/></list></field>
  </record>
  <record id="ab_sales_promo_report_line_view_pivot" model="ir.ui.view">
    <field name="name">Recorded promotions pivot</field><field name="model">ab_sales_promo_report_line</field>
    <field name="arch" type="xml"><pivot><field name="promo_id" type="row"/><field name="store_id" type="row"/><field name="total_price" type="measure"/></pivot></field>
  </record>
  <record id="ab_sales_promo_report_line_view_graph" model="ir.ui.view">
    <field name="name">Recorded promotions graph</field><field name="model">ab_sales_promo_report_line</field>
    <field name="arch" type="xml"><graph><field name="promo_id"/><field name="total_price" type="measure"/></graph></field>
  </record>
  <record id="ab_sales_promo_report_line_action" model="ir.actions.act_window">
    <field name="name">Recorded Callcenter Promotions</field><field name="res_model">ab_sales_promo_report_line</field><field name="view_mode">list,pivot,graph</field>
  </record>
  <record id="ab_sales_promo_report_wizard_view_form" model="ir.ui.view">
    <field name="name">Load recorded promotions</field><field name="model">ab_sales_promo_report_wizard</field>
    <field name="arch" type="xml"><form string="Load Recorded Callcenter Promotions"><sheet>
      <p>Saved callcenter invoices and recorded promotions only. This report does not reconcile legacy compensation.</p>
      <group><field name="date_from"/><field name="date_to"/><field name="store_ids" widget="many2many_tags"/><field name="product_ids" widget="many2many_tags"/><field name="promo_ids" widget="many2many_tags"/><field name="replace_existing"/></group>
      </sheet><footer><button name="action_load_report" type="object" string="Load Report" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field>
  </record>
  <record id="ab_sales_promo_report_wizard_action" model="ir.actions.act_window">
    <field name="name">Load Recorded Callcenter Promotions</field><field name="res_model">ab_sales_promo_report_wizard</field><field name="view_mode">form</field><field name="target">new</field>
  </record>
</odoo>
