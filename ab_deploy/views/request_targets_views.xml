<odoo>
    <record id="view_request_targets_form" model="ir.ui.view">
        <field name="name">ab_deploy_request_targets_form</field>
        <field name="model">ab_deploy_request</field>
        <field name="inherit_id" ref="view_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page/field[@name='target_ids']" position="replace">
                <div class="mb-3" invisible="state != 'draft' or queued" groups="ab_deploy.group_developer">
                    <button name="action_add_production_servers" string="Add All Production Servers" type="object" class="btn-secondary"/>
                </div>
                <div class="mb-3" invisible="state != 'approved'" groups="ab_deploy.group_executor">
                    <button name="action_select_all_targets" string="Select All for Deployment" type="object" class="btn-secondary me-2"/>
                    <button name="action_select_all_ssh_failures" string="Select All SSH Failures" type="object" class="btn-secondary me-2"/>
                    <button name="action_clear_target_selection" string="Clear Selection" type="object" class="btn-secondary"/>
                </div>
                <field name="target_ids" nolabel="1" invisible="state != 'draft'" readonly="queued">
                    <list editable="bottom" limit="80">
                        <field name="server_serial"/>
                        <field name="server_id" domain="[('active', '=', True), ('maintenance_mode', '=', False)]" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="server_area"/>
                        <field name="server_odoo_url" widget="url" readonly="1"/>
                        <field name="deployment_status"/>
                    </list>
                </field>
                <field name="target_ids" nolabel="1" invisible="state == 'draft'" readonly="state != 'approved'">
                    <list editable="bottom" create="0" delete="0" limit="80">
                        <field name="server_serial"/>
                        <field name="server_id" readonly="1"/>
                        <field name="server_area"/>
                        <field name="server_odoo_url" widget="url" readonly="1"/>
                        <field name="selection_eligible" column_invisible="True"/>
                        <field name="deploy" groups="ab_deploy.group_executor" readonly="not selection_eligible and not deploy"/>
                        <field name="deployment_status"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
