<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_server_list" model="ir.ui.view">
        <field name="name">ab_deploy_server_list</field><field name="model">ab_deploy_server</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="code"/><field name="ssh_alias"/><field name="environment"/><field name="maintenance_mode"/><field name="active"/></list></field>
    </record>
    <record id="view_server_form" model="ir.ui.view">
        <field name="name">ab_deploy_server_form</field><field name="model">ab_deploy_server</field>
        <field name="arch" type="xml"><form><sheet><group>
            <group><field name="name"/><field name="code"/><field name="ssh_alias"/><field name="environment"/><field name="monitor_timeout_seconds"/><field name="active"/><field name="maintenance_mode"/></group>
            <group><field name="hostname"/><field name="serial"/><field name="db_serial"/><field name="odoo_url" widget="url"/><field name="contact"/><field name="area"/></group>
        </group></sheet></form></field>
    </record>
    <record id="view_request_list" model="ir.ui.view">
        <field name="name">ab_deploy_request_list</field><field name="model">ab_deploy_request</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="title"/><field name="developer_id"/><field name="approver_id"/><field name="state"/><field name="queued"/></list></field>
    </record>
    <record id="view_request_form" model="ir.ui.view">
        <field name="name">ab_deploy_request_form</field><field name="model">ab_deploy_request</field>
        <field name="arch" type="xml"><form><header>
            <button name="action_submit" string="Request Approval" type="object" groups="ab_deploy.group_developer" invisible="state != 'draft'" class="btn-primary"/>
            <button name="action_approve" string="Approve" type="object" groups="ab_deploy.group_approver" invisible="state != 'requested'" class="btn-primary"/>
            <button name="action_reject" string="Reject" type="object" groups="ab_deploy.group_approver" invisible="state != 'requested'"/>
            <button name="action_queue" string="Queue Selected Servers" type="object" groups="ab_deploy.group_executor" invisible="state != 'approved'" class="btn-primary"/>
            <button name="action_withdraw" string="Return to Draft" type="object" groups="ab_deploy.group_developer" invisible="state == 'draft' or queued"/>
            <button name="action_cancel" string="Cancel" type="object" groups="ab_deploy.group_developer" invisible="state == 'cancelled'" confirm="Cancel pending executions? Running commands will continue."/>
            <field name="state" widget="statusbar"/>
        </header><sheet><field name="queued" invisible="1"/><field name="active" invisible="1"/>
            <h1><field name="name"/></h1>
            <group><group><field name="title" readonly="state != 'draft'"/><field name="description" readonly="state != 'draft'"/></group>
                <group><field name="developer_id" readonly="state != 'draft'"/><field name="approver_id" readonly="state != 'draft'"/><field name="decision_note"/></group></group>
            <notebook>
                <page string="Commands"><field name="command_ids" readonly="state != 'draft'"><list editable="bottom"><field name="sequence" widget="handle"/><field name="command_id" options="{'no_create': True}"/><field name="description"/></list></field></page>
                <page string="Target Servers"><field name="target_ids" readonly="state != 'draft'"><list editable="bottom"><field name="server_id" domain="[('active', '=', True), ('maintenance_mode', '=', False)]" options="{'no_create': True}"/></list></field></page>
                <page string="Readiness"><p>Informational only. These fields do not run backups, restart services, upgrade modules, or restrict approval.</p><group><field name="restart_required" readonly="state != 'draft'"/><field name="upgrade_required" readonly="state != 'draft'"/><field name="database_impact" readonly="state != 'draft'"/><field name="backup_policy" readonly="state != 'draft'"/></group></page>
                <page string="Approval History"><group><field name="requested_by"/><field name="requested_at"/><field name="approved_by"/><field name="approved_at"/></group></page>
            </notebook>
        </sheet><chatter/></form></field>
    </record>
    <record id="view_target_form" model="ir.ui.view">
        <field name="name">ab_deploy_target_form</field><field name="model">ab_deploy_target</field>
        <field name="arch" type="xml"><form create="0" delete="0"><sheet><group><field name="request_id" readonly="1"/><field name="server_id" readonly="1"/><field name="job_key"/><field name="script_hash"/></group><field name="script" nolabel="1"/><field name="snapshot"/></sheet></form></field>
    </record>
    <record id="view_audit_list" model="ir.ui.view">
        <field name="name">ab_deploy_audit_list</field><field name="model">ab_deploy_audit_log</field>
        <field name="arch" type="xml"><list create="0" delete="0"><field name="occurred_at"/><field name="user_id"/><field name="record_name"/><field name="record_model"/><field name="action"/></list></field>
    </record>
    <record id="view_audit_form" model="ir.ui.view">
        <field name="name">ab_deploy_audit_form</field><field name="model">ab_deploy_audit_log</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><field name="occurred_at"/><field name="user_id"/><field name="record_name"/><field name="record_model"/><field name="action"/></group><field name="before_values"/><field name="after_values"/></sheet></form></field>
    </record>
    <record id="action_request" model="ir.actions.act_window"><field name="name">Deployment Requests</field><field name="res_model">ab_deploy_request</field><field name="view_mode">list,form</field></record>
    <record id="action_server" model="ir.actions.act_window"><field name="name">Servers</field><field name="res_model">ab_deploy_server</field><field name="view_mode">list,form</field></record>
    <record id="action_audit" model="ir.actions.act_window"><field name="name">Audit Logs</field><field name="res_model">ab_deploy_audit_log</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_request" name="Deployment Requests" parent="menu_deploy_root" action="action_request" sequence="1"/>
    <menuitem id="menu_server" name="Servers" parent="menu_deploy_config" action="action_server" sequence="10"/>
    <menuitem id="menu_audit" name="Audit Logs" parent="menu_deploy_reports" action="action_audit" sequence="20"/>
</odoo>
