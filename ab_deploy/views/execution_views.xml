<odoo>
    <record id="view_command_list" model="ir.ui.view"><field name="name">ab_deploy_command_list</field><field name="model">ab_deploy_command</field><field name="arch" type="xml"><list><field name="name"/><field name="description"/><field name="active"/></list></field></record>
    <record id="view_command_form" model="ir.ui.view"><field name="name">ab_deploy_command_form</field><field name="model">ab_deploy_command</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="description"/><field name="active"/></group><group name="script_editor"><field name="template"/></group></sheet></form></field></record>
    <record id="view_job_list" model="ir.ui.view"><field name="name">ab_deploy_job_list</field><field name="model">ab_deploy_job</field><field name="arch" type="xml"><list create="0" delete="0" decoration-danger="state in ('failed', 'unknown')" decoration-success="state == 'succeeded'"><field name="request_id"/><field name="server_id"/><field name="state"/><field name="started_at"/><field name="finished_at"/><field name="exit_code"/></list></field></record>
    <record id="view_job_form" model="ir.ui.view"><field name="name">ab_deploy_job_form</field><field name="model">ab_deploy_job</field><field name="arch" type="xml"><form create="0" delete="0"><header><button name="action_resolve" string="Resolve Execution" type="object" groups="ab_deploy.group_administrator" invisible="state != 'unknown'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="request_id"/><field name="server_id"/><field name="target_id"/><field name="job_key"/><field name="started_at"/><field name="finished_at"/><field name="exit_code"/><field name="queue_job_id" groups="ab_deploy.group_administrator"/></group><field name="error"/><field name="resolution_note"/><field name="log_tail"/></sheet></form></field></record>
    <record id="view_request_execution_form" model="ir.ui.view"><field name="name">ab_deploy_request_execution_form</field><field name="model">ab_deploy_request</field><field name="inherit_id" ref="view_request_form"/><field name="arch" type="xml"><notebook position="inside"><page string="Execution Jobs"><field name="job_ids" readonly="1"/></page></notebook></field></record>
    <record id="action_command" model="ir.actions.act_window"><field name="name">Command Catalog</field><field name="res_model">ab_deploy_command</field><field name="view_mode">list,form</field></record>
    <record id="action_job" model="ir.actions.act_window"><field name="name">Execution Jobs</field><field name="res_model">ab_deploy_job</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_command" name="Command Catalog" parent="menu_deploy_config" action="action_command" sequence="20"/>
    <menuitem id="menu_job" name="Execution Jobs" parent="menu_deploy_reports" action="action_job" sequence="10"/>
</odoo>
