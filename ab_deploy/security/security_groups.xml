<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <record id="module_category_deploy" model="ir.module.category">
        <field name="name">Deployment Manager</field>
        <field name="sequence">80</field>
    </record>
    <record id="privilege_deploy" model="res.groups.privilege">
        <field name="name">Viewer</field>
        <field name="category_id" ref="module_category_deploy"/>
        <field name="sequence">10</field>
    </record>
    <record id="privilege_developer" model="res.groups.privilege">
        <field name="name">Developer</field>
        <field name="category_id" ref="module_category_deploy"/>
        <field name="sequence">20</field>
    </record>
    <record id="privilege_approver" model="res.groups.privilege">
        <field name="name">Approver</field>
        <field name="category_id" ref="module_category_deploy"/>
        <field name="sequence">30</field>
    </record>
    <record id="privilege_executor" model="res.groups.privilege">
        <field name="name">Executor</field>
        <field name="category_id" ref="module_category_deploy"/>
        <field name="sequence">40</field>
    </record>
    <record id="privilege_administrator" model="res.groups.privilege">
        <field name="name">Deployment Administrator</field>
        <field name="category_id" ref="module_category_deploy"/>
        <field name="sequence">50</field>
    </record>
    <record id="group_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="privilege_id" ref="privilege_deploy"/>
    </record>
    <record id="group_developer" model="res.groups">
        <field name="name">Developer</field>
        <field name="privilege_id" ref="privilege_developer"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_viewer')])]"/>
    </record>
    <record id="group_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="privilege_id" ref="privilege_approver"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_viewer')])]"/>
    </record>
    <record id="group_executor" model="res.groups">
        <field name="name">Executor</field>
        <field name="privilege_id" ref="privilege_executor"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_viewer')])]"/>
    </record>
    <record id="group_administrator" model="res.groups">
        <field name="name">Deployment Administrator</field>
        <field name="privilege_id" ref="privilege_administrator"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_developer'),ref('group_approver'),ref('group_executor')])]"/>
    </record>
</odoo>
