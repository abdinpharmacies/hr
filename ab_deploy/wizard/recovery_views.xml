<odoo>
    <record id="view_recovery_form" model="ir.ui.view">
        <field name="name">ab_deploy_recovery_form</field><field name="model">ab_deploy_recovery</field>
        <field name="arch" type="xml"><form string="Recover Deployment Jobs">
            <field name="summary" nolabel="1"/>
            <p>Check unfinished deployments and restore missing monitoring tasks. Completed commands are never replayed. Uncertain executions require remote inspection. Other modules are not affected.</p>
            <footer><button name="action_recover" string="Recover Deployment Jobs" type="object" class="btn-primary"/><button string="Cancel" special="cancel"/></footer>
        </form></field>
    </record>
    <record id="action_recovery" model="ir.actions.act_window"><field name="name">Recover Deployment Jobs</field><field name="res_model">ab_deploy_recovery</field><field name="view_mode">form</field><field name="target">new</field></record>
    <menuitem id="menu_recovery" name="Recover Deployment Jobs" parent="menu_deploy_tools" action="action_recovery" groups="group_administrator" sequence="20"/>
</odoo>
