<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_server_import_form" model="ir.ui.view">
        <field name="name">ab_deploy_server_import_form</field><field name="model">ab_deploy_server_import</field>
        <field name="arch" type="xml"><form string="Import Deployment Servers">
            <group><field name="filename" invisible="1"/><field name="csv_file" filename="filename"/><field name="environment"/></group>
            <p>The environment applies to new servers only. Existing servers are matched by SSH alias. Preview additions and updates before importing. Legacy CSV timeout values are ignored: new servers use 600 seconds for monitoring; existing server timeouts are preserved.</p>
            <field name="preview_hash" invisible="1"/><field name="preview" nolabel="1"/>
            <footer><button name="action_preview" string="Preview Import" type="object" class="btn-primary"/>
                <button name="action_apply" string="Apply Import" type="object" invisible="not preview_hash"/>
                <button string="Close" special="cancel"/>
            </footer>
        </form></field>
    </record>
    <record id="action_server_import" model="ir.actions.act_window">
        <field name="name">Import Servers CSV</field><field name="res_model">ab_deploy_server_import</field><field name="view_mode">form</field><field name="target">new</field>
    </record>
    <menuitem id="menu_server_import" name="Import Servers CSV" parent="menu_deploy_tools" action="action_server_import" groups="group_administrator" sequence="10"/>
</odoo>
