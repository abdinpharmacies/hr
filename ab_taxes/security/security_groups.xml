<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record model="ir.module.category" id="ab_taxes_category">
            <field name="name">Taxes</field>
            <field name="sequence">5</field>
        </record>
        <record id="privilege_ab_taxes" model="res.groups.privilege">
            <field name="name">Taxes</field>
            <field name="category_id" ref="ab_taxes.ab_taxes_category"/>
            <field name="sequence">5</field>
        </record>
        <record id="group_ab_taxes_user" model="res.groups">
            <field name="name">Taxes</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="privilege_id" ref="ab_taxes.privilege_ab_taxes"/>
        </record>
        <record id="group_ab_taxes_super" model="res.groups">
            <field name="name">Taxes Super</field>
            <field name="implied_ids" eval="[(4, ref('ab_taxes.group_ab_taxes_user'))]"/>
            <field name="privilege_id" ref="ab_taxes.privilege_ab_taxes"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[
            (4, ref('ab_taxes.group_ab_taxes_user')),
            (4, ref('ab_taxes.group_ab_taxes_super'))
            ,]"/>
        </record>


    </data>
</odoo>
