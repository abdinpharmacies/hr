<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="ab_taxes_view_tree" model="ir.ui.view">
            <field name="name">ab_taxes_view_tree</field>
            <field name="model">ab_taxes</field>
            <field name="arch" type="xml">
                <tree string="ab_taxes_view_tree">
                    <field name="name" />
                    <field name="percentage" />
                    <field name="status" />
                    <field name="active" />
                </tree>
            </field>
        </record>
        <record id="ab_taxes_view_form" model="ir.ui.view">
            <field name="name">ab_taxes_view_form</field>
            <field name="model">ab_taxes</field>
            <field name="arch" type="xml">
                <form string="ab_taxes_view_form">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Tax Name" />
                            <h1>
                                <div class="d-flex">
                                    <field class="text-break" name="name" placeholder="e.g. Val-14%" />
                                </div>
                            </h1>
                        </div>
                        <group col="4">
                            <field name="percentage" />
                            <field name="status" />
                            <field name="active" />
                            <field name="apply_on_total" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_taxes_action" model="ir.actions.act_window">
            <field name="name">ab_taxes</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_taxes</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>