<odoo>
  <record id="rule_account_company" model="ir.rule">
    <field name="name">Messaging account: company</field>
    <field name="model_id" ref="model_ab_crm_messaging_account"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
  </record>
  <record id="rule_account_branch" model="ir.rule">
    <field name="name">Messaging account: branch</field>
    <field name="model_id" ref="model_ab_crm_messaging_account"/>
    <field name="domain_force">[('service_user_id', '=', user.id), ('branch_id.user_ids', 'in', [user.id])] if user.has_group('ab_crm_messaging.group_service') else ([] if user.has_group('ab_crm_core.group_manager') or user.has_group('base.group_system') else [('branch_id.user_ids', 'in', [user.id])])</field>
  </record>
