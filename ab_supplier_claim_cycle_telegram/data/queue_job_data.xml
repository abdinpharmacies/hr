<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="channel_supplier_claim_cycle_telegram" model="queue.job.channel">
        <field name="name">supplier_claim_cycle_telegram</field>
        <field name="parent_id" ref="queue_job.channel_root"/>
    </record>
    <record id="job_function_deliver_cycle_telegram_notification" model="queue.job.function">
        <field name="model_id" ref="ab_supplier_claim_cycle.model_ab_supplier_claim_cycle"/>
        <field name="method">_deliver_cycle_telegram_notification</field>
        <field name="channel_id" ref="channel_supplier_claim_cycle_telegram"/>
        <field name="retry_pattern" eval="{1: 60, 3: 300, 5: 900, 10: 3600}"/>
    </record>
</odoo>
