<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--User Groups, Access Rights and Security Mechanism in Detail-->
    <!-- https://www.youtube.com/watch?v=mzg3EGD_6Gw&list=PLqRRLx0cl0hoJhjFWkFYowveq2Zn55dhM&index=53  -->
    <record model="ir.module.category" id="module_category_abdin_eplus">
        <field name="name">Abdin EPlus</field>
        <field name="description">Category For Eplus</field>
        <field name="sequence">46</field>
    </record>
        <record id="privilege_module_category_abdin_eplus" model="res.groups.privilege">
            <field name="name">Abdin EPlus</field>
            <field name="category_id" ref="module_category_abdin_eplus"/>
        </record>


    <record id="group_abdin_eplus_user" model="res.groups">
        <field name="name">abdin_eplus User</field>
        <field name="privilege_id" ref="privilege_module_category_abdin_eplus"/>
    </record>

    <record id="group_abdin_eplus_manager" model="res.groups">
        <field name="name">abdin_eplus Manager</field>
        <field name="privilege_id" ref="privilege_module_category_abdin_eplus"/>
        <field name="implied_ids" eval="[(4, ref('group_abdin_eplus_user'))]"/>
    </record>

    <record id="group_abdin_eplus_admin" model="res.groups">
        <field name="name">abdin_eplus Administrator</field>
        <field name="privilege_id" ref="privilege_module_category_abdin_eplus"/>
        <field name="implied_ids" eval="[(4, ref('group_abdin_eplus_manager'))]"/>
    </record>

    <!--    ################## abdin_eplus_data User Rule ##################   -->
    <!--  ############### بوجود هذا الشرط يستطيع فقط رؤية القيود الخاصة بخزائنه فقط #############   -->
    <record model="ir.rule" id="see_his_own_abdin_eplus_data">
        <field name="name">See His abdin_eplus_data Only</field>
        <field name="model_id" ref="model_abdin_eplus_r_sales_trans_h"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_abdin_eplus_user'))]"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_unlink" eval="0"/>
        <field name="perm_read" eval="1"/>
    </record>
    <!--    ################## abdin_eplus_data Manager Rule ##################   -->
    <record model="ir.rule" id="see_all_abdin_eplus_data_manger">
        <field name="name">See His abdin_eplus_data Only</field>
        <field name="model_id" ref="model_abdin_eplus_r_sales_trans_h"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_abdin_eplus_manager'))]"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="1"/>
        <field name="perm_read" eval="1"/>
    </record>
    <!--    ################## abdin_eplus_data Admin Rule ##################   -->
    <record model="ir.rule" id="see_all_abdin_eplus_data_admin">
        <field name="name">See All abdin_eplus_data Admin</field>
        <field name="model_id" ref="model_abdin_eplus_r_sales_trans_h"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_abdin_eplus_admin'))]"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="1"/>
        <field name="perm_read" eval="1"/>
    </record>


    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('abdin_eplus.group_abdin_eplus_admin'))]"/>
    </record>

</odoo>
