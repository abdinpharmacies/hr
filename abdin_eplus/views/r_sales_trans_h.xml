<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- explicit list view definition -->
        <record model="ir.ui.view" id="abdin_eplus.r_sales_trans_h_list_view">
            <field name="name">r_sales_trans_h list</field>
            <field name="model">abdin_eplus.r_sales_trans_h</field>
            <field name="arch" type="xml">
                <list limit="100">
                    <field name="sth_id" optional="show"/>
                    <field name="bill_day" optional="show"/>
                    <field name="sec_insert_date_h" string="Bill Time" optional="show"/>
                    <field name="sto_id" optional="show"/>
                    <field name="cust_parent" optional="show"/>
                    <field name="bill_type" optional="show"/>
                    <field name="total_sales_h" optional="hide"/>
                    <field name="total_bill_after_disc_h" optional="show"/>
                    <field name="employee" optional="show"/>
                    <field name="cost_d" optional="hide"/>
                    <field name="is_delivery" optional="hide"/>
                    <field name="deliv_emp_id" optional="hide"/>
                    <field name="deliv_points" optional="hide"/>
                    <field name="paid_points" optional="hide"/>
                    <field name="is_visa" optional="hide"/>
                    <field name="cust_id" optional="show"/>
                    <field name="items_count" optional="hide"/>
                    <field name="total_sales_d" optional="hide"/>
                    <field name="total_exchange_h" optional="hide"/>
                    <field name="total_disc_percent_h" optional="hide"/>
                    <field name="total_disc_money_h" optional="hide"/>
                    <field name="extra_expenses_h" optional="hide"/>
                    <field name="total_bill_after_disc_d" optional="hide"/>
                    <field name="cash_h" optional="hide"/>
                    <field name="loaded_value_contract" optional="hide"/>
                    <field name="credit_value_contract" optional="hide"/>
                    <field name="total_local_d" optional="hide"/>
                    <field name="total_imported_d" optional="hide"/>
                    <field name="tup" optional="hide"/>

                </list>
            </field>
        </record>

        <!-- R_SALES_TRANS_H_PIVOT_VIEW -->
        <record model="ir.ui.view" id="abdin_eplus.r_sales_trans_h_pivot_view">
            <field name="name">r_sales_trans_h pivot</field>
            <field name="model">abdin_eplus.r_sales_trans_h</field>
            <field name="arch" type="xml">
                <pivot string="Abdin Sales Pivot">
                    <field name="sto_id" type="row"/>
                    <field name="sec_insert_date_h" interval="month" type="col"/>
                    <field name="total_bill_after_disc_h" type="measure"/>
                </pivot>
            </field>
        </record>

        <!--  R_SALES_TRANS_H_GRAPH_VIEW -->
        <record model="ir.ui.view" id="abdin_eplus.r_sales_trans_h_graph_view">
            <field name="name">r_sales_trans_h graph</field>
            <field name="model">abdin_eplus.r_sales_trans_h</field>
            <field name="arch" type="xml">
                <graph string="Abdin Sales Graph">
                    <field name="sto_id"/>
                    <field name="total_bill_after_disc_h" type="measure"/>
                </graph>
            </field>
        </record>


        <!--  R_SALES_TRANS_H_SEARCH_VIEW -->
        <record model="ir.ui.view" id="abdin_eplus.r_sales_trans_h_search_view">
            <field name="name">r_sales_trans_h search</field>
            <field name="model">abdin_eplus.r_sales_trans_h</field>
            <field name="arch" type="xml">
                <search string="Abdin Sales Graph">
                    <filter string="Bill Day" name="group_bill_day" context="{'group_by':'bill_day'}"/>
                    <filter string="Store" name="group_sto_id" context="{'group_by':'sto_id'}"/>
                    <filter string="Customer" name="group_cust_id" context="{'group_by':'cust_id'}"/>
                    <filter string="Customer Parent" name="group_cust_parent" context="{'group_by':'cust_parent'}"/>
                    <filter string="Bill Type" name="group_bill_type" context="{'group_by':'bill_type'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by':'employee'}"/>
                    <field name="sto_id"/>
                    <field name="employee"/>
                    <field name="cust_id"/>
                    <field name="cust_parent"/>
                </search>
            </field>
        </record>


        <!-- R_SALES_TRANS_H_ACTION_WINDOW -->
        <record model="ir.actions.act_window" id="r_sales_trans_h_action_window">
            <field name="name">r_sales_trans_h window</field>
            <field name="res_model">abdin_eplus.r_sales_trans_h</field>
            <field name="view_id" ref="abdin_eplus.r_sales_trans_h_list_view"/>
            <field name="view_mode">list,form,pivot,graph</field>
        </record>


        <menuitem name="Sales from ePlus" id="abdin_eplus.r_sales_trans_h_menu" parent="abdin_eplus.sales_menu"
                  action="r_sales_trans_h_action_window" sequence="10"/>


    </data>
</odoo>