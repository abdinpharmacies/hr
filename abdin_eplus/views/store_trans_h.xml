<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="abdin_eplus.store_trans_h_view_tree" model="ir.ui.view">
            <field name="name">abdin_eplus.store_trans_h_view_tree</field>
            <field name="model">abdin_eplus.store_trans_h</field>
            <field name="arch" type="xml">
                <list string="abdin_eplus.store_trans_h_tree">
                    <field name="stnh_id" optional="show"/>
                    <field name="stnh_f_sto_id" optional="show"/>
                    <field name="stnh_t_sto_id" optional="show"/>
                    <field name="stnh_tot_sell_value" optional="show"/>
                    <field name="stnh_tot_cost_value" optional="show"/>
                    <field name="stnh_no_items" optional="show"/>
                    <field name="stnh_notes" optional="show"/>
                    <field name="stnh_flag" optional="show"/>
                    <field name="sec_insert_uid" optional="show"/>
                    <field name="sec_insert_date" optional="show"/>
                    <field name="sec_update_uid" optional="show"/>
                    <field name="sec_update_date" optional="show"/>
                    <field name="delivery_emp" optional="show"/>
                </list>
            </field>
        </record>

        <record id="abdin_eplus.store_trans_h_view_form" model="ir.ui.view">
            <field name="name">abdin_eplus.store_trans_h_view_form</field>
            <field name="model">abdin_eplus.store_trans_h</field>
            <field name="arch" type="xml">
                <form string="abdin_eplus.store_trans_h_form">
                    <sheet>
                        <group col="4">
                            <field name="stnh_id"/>
                            <field name="stnh_f_sto_id"/>
                            <field name="stnh_t_sto_id"/>
                            <field name="stnh_tot_sell_value"/>
                            <field name="stnh_tot_cost_value"/>
                            <field name="stnh_no_items"/>
                            <field name="stnh_notes"/>
                            <field name="stnh_flag"/>
                            <field name="sec_insert_uid"/>
                            <field name="sec_insert_date"/>
                            <field name="sec_update_uid"/>
                            <field name="sec_update_date"/>
                            <field name="delivery_emp"/>

                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="abdin_eplus.store_trans_h_view_pivot" model="ir.ui.view">
            <field name="name">abdin_eplus.store_trans_h_view_pivot</field>
            <field name="model">abdin_eplus.store_trans_h</field>
            <field name="arch" type="xml">
                <pivot string="abdin_eplus.store_trans_h_pivot">
                </pivot>
            </field>
        </record>


        <record id="abdin_eplus.store_trans_h_action" model="ir.actions.act_window">
            <field name="name">Abdin eplus.store trans h</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">abdin_eplus.store_trans_h</field>
            <field name="view_mode">list,form,pivot</field>
        </record>

        <menuitem id="abdin_eplus.store_trans_h_menu"
                  name="Transfers"
                  parent="menu_root"
                  action="abdin_eplus.store_trans_h_action"
                  sequence="100"/>

    </data>
</odoo>