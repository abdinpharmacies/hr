            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=0, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>


            <field name="model_id" ref="model_abdin_eplus_replication"/>
            <field name="state">code</field>
            <field name="code">model.replicate_tables()</field>
        </record>
        <record id="eplus_repl_purchase_cron" model="ir.cron" forcecreate="True">
            <field name="name">ePlus Purchase Replication Cron</field>
            <field name="active">False</field>
            <!--            <field name="user_id" ref="base.user_root"/>-->
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=0, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>


            <field name="model_id" ref="model_abdin_eplus_replication"/>
            <field name="state">code</field>
            <field name="code">model.replicate_purchase()</field>
        </record>

