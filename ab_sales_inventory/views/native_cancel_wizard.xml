<odoo>
    <record id="native_cancel_wizard_form" model="ir.ui.view">
        <field name="name">ab_sales_native_cancel_wizard.form</field>
        <field name="model">ab_sales_native_cancel_wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Pending Native Invoice">
                <group>
                    <field name="sale_id"/>
                    <field name="reason" required="1" placeholder="Explain why this pending invoice must be cancelled..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Cancel Invoice" class="btn-danger"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
