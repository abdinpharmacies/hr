<odoo>
    <record id="group_native_sales_user" model="res.groups">
        <field name="name">Native Sales Operator</field>
        <field name="privilege_id" ref="ab_sales.privilege_ab_sales"/>
        <field name="implied_ids" eval="[(6, 0, [ref('ab_inventory.group_inventory_user'), ref('ab_sales.group_ab_sales_pharmacist')])]"/>
    </record>
    <record id="group_native_sales_shortage_report" model="res.groups">
        <field name="name">Sold Without Stock Report</field>
        <field name="privilege_id" ref="ab_sales.privilege_ab_sales"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('ab_sales_inventory.group_native_sales_shortage_report'))]"/>
    </record>
</odoo>
