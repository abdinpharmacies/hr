<templates xml:space="preserve">
<t t-name="ab_crm_sales_workspace.SavedReplies"><Dialog title="title" size="'lg'"><p>Saved replies are inserted into the composer. Review them and explicitly send.</p><div t-if="state.error" class="alert alert-danger" t-esc="state.error"/><fieldset t-att-disabled="state.busy"><label>Saved reply<select class="form-select" t-model="state.selected" t-on-change="select"><option value="">New saved reply</option><option t-foreach="state.items" t-as="item" t-key="item.id" t-att-value="item.id" t-esc="item.name"/></select></label><div t-if="state.can_manage"><label>Name<input class="form-control" t-model="state.name"/></label><label>Message template<textarea class="form-control" t-model="state.body" placeholder="Use {{customer}} and {{phone}} placeholders"/></label><button class="btn btn-outline-primary" t-on-click="() => this.save()">Save template</button><button t-if="state.selected" class="btn btn-outline-danger" t-on-click="() => this.save(false)">Archive template</button></div><label t-foreach="placeholders" t-as="key" t-key="key"><t t-esc="key"/><input class="form-control" t-model="state.variables[key]"/></label><h4>Preview</h4><p class="text-break" t-esc="preview"/></fieldset><t t-set-slot="footer"><button class="btn btn-primary" t-on-click="insert" t-att-disabled="state.busy || !preview.trim() || placeholders.some(key => !state.variables[key])">Insert into composer</button><button class="btn btn-light" t-on-click="refresh" t-att-disabled="state.busy">Refresh</button><button class="btn btn-light" t-on-click="props.close">Close</button></t></Dialog></t>
</templates>
