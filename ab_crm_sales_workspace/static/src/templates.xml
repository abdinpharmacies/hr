<templates xml:space="preserve">
    <t t-name="ab_crm_sales_workspace.SavedReplies">
        <Dialog title="title" size="'lg'" contentClass="'ab_template_dialog channel-' + theme" requestClose.bind="close">
            <p>Saved replies are inserted into the composer. Review them and explicitly send.</p>

            <p t-if="state.busy" role="status">Loading templates…</p>
            <fieldset class="ab_template_layout" t-att-disabled="state.busy">
                <section class="ab_template_list" aria-label="Saved replies">
                    <label class="d-block">Search templates<input class="form-control" type="search" t-model="state.query"/></label>
                    <button t-if="state.can_manage" class="btn ab_template_primary my-2" t-on-click="() => this.select(false)">New saved reply</button>
                    <p t-if="!filteredItems.length" role="status">No templates found.</p>
                    <button t-foreach="filteredItems" t-as="item" t-key="item.id" class="ab_template_item" t-att-class="{'active': state.selected === item.id}" t-att-aria-pressed="state.selected === item.id ? 'true' : 'false'" t-on-click="() => this.select(item.id)"><strong dir="auto" t-esc="item.name"/><span dir="auto" t-esc="item.body"/></button>
                </section>
                <section class="ab_template_editor">
                    <t t-if="state.can_manage"><label class="d-block">Name<input class="form-control" dir="auto" t-model="state.name"/></label><label class="d-block">Message template<textarea class="form-control" dir="auto" rows="5" t-model="state.body" maxlength="4096" placeholder="Use {{customer}} and {{phone}} placeholders"/></label>
                        <div class="d-flex gap-2 my-2"><button class="btn ab_template_primary" t-on-click="() => this.save()" t-att-disabled="!state.name.trim() || !state.body.trim()">Save template</button><button t-if="state.selected" class="btn btn-outline-danger" t-on-click="() => this.save(false)">Archive template</button></div>
                    </t>
                    <h4 t-else="" dir="auto" t-esc="state.name"/>
                    <label t-foreach="placeholders" t-as="key" t-key="key" class="d-block"><t t-esc="key"/><input class="form-control" dir="auto" t-model="state.variables[key]" required="required"/></label>
                    <h4 class="mt-3">Preview</h4><p class="ab_template_preview" dir="auto" t-esc="preview"/>
                </section>
            </fieldset>
            <t t-set-slot="footer"><button class="btn ab_template_primary" t-on-click="insert" t-att-disabled="state.busy || !preview.trim() || missingValues">Insert into composer</button><button class="btn btn-light" t-on-click="refresh" t-att-disabled="state.busy">Refresh</button><button class="btn btn-light" t-on-click="close">Close</button></t>
        </Dialog>
    </t>
</templates>
