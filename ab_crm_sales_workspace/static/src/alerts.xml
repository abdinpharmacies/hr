<templates xml:space="preserve">
<t t-name="ab_crm_sales_workspace.Alerts">
    <div t-if="items.length" class="ab_chatter_alert_stack" aria-label="Customer message alerts" aria-live="polite">
        <article t-foreach="items" t-as="item" t-key="item.key" t-att-data-alert-key="item.key" class="ab_chatter_customer_alert" role="status">
            <div class="ab_alert_title"><strong t-esc="item.title"/><button class="btn btn-sm btn-light" aria-label="Dismiss alert" t-on-click="item.dismiss"><i class="fa fa-times"/></button></div>
            <p t-esc="item.text"/>
            <button class="btn btn-sm btn-primary" t-on-click="item.open">Open conversation</button>
        </article>
    </div>
</t>
</templates>
