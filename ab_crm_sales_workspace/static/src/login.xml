<templates xml:space="preserve">
    <t t-name="ab_crm_sales_workspace.Login">
        <Dialog title="title" size="'md'" header="false" footer="false" contentClass="'ab_chatter_login_modal'">
            <form t-att-dir="direction" class="ab_chatter_login" t-on-submit.prevent="submit">
                <button class="btn btn-light ab_chatter_login_close" type="button" title="Close" t-on-click="props.close"><i class="fa fa-times" aria-hidden="true"/></button>
                <h3>Employee Login</h3>
                <p class="ab_chatter_login_subtitle mb-3">Select employee and enter PIN on the branch service user session.</p>
                <div class="d-flex flex-column gap-3">
                    <div class="ab_chatter_login_row">
                        <label class="form-label">Employee</label>
                        <ABMany2one relation="'ab_employee_access'" value="state.employee" update.bind="updateEmployee" domain.bind="employeeDomain" placeholder.translate="Select employee..." string.translate="Employee" canCreate="false" canCreateEdit="false" canQuickCreate="false" canOpen="false" canWrite="true"/>
                    </div>
                    <div class="ab_chatter_login_row">
                        <label class="form-label" for="ab_chatter_pin">PIN</label>
                        <input id="ab_chatter_pin" name="ab_chatter_pin" class="form-control" type="password" inputmode="numeric" maxlength="4" autocomplete="off" placeholder="Enter PIN" t-model="state.pin" t-att-disabled="state.busy"/>
                    </div>

                    <div class="d-flex justify-content-end"><button class="btn btn-primary" type="submit" t-att-disabled="state.busy"><t t-if="state.busy">Signing in...</t><t t-else="">Employee Login</t></button></div>
                </div>
            </form>
        </Dialog>
    </t>
</templates>
