<templates xml:space="preserve">
    <t t-name="ab_crm_sales_workspace.LocationDialog">
        <Dialog title="title" size="'md'">
            <div class="ab_branch_picker">

                <fieldset t-att-disabled="state.busy">
                    <div class="ab_branch_search_header">
                        <label t-att-for="searchId">Search branches</label>
                        <label class="ab_branch_details_toggle"><input type="checkbox" class="form-check-input" t-model="state.includeDetails"/><span>Send branch details</span></label>
                    </div>
                    <div class="ab_branch_search" t-on-input="searchInput">
                        <AutoComplete id="searchId" value="state.query" sources="sources" placeholder="searchPlaceholder" autofocus="true" searchOnInputClick="false" menuPositionOptions="{position: 'bottom-fit'}"/>
                    </div>
                    <t t-if="state.preview">
                        <LocationCard location="state.preview" provider="'telegram'"/>
                        <pre t-if="state.includeDetails" class="ab_branch_details" dir="auto" t-esc="state.preview.details"/>
                        <p t-if="state.preview.public_phones"><span>Verified public phones</span>: <bdi dir="ltr" t-esc="state.preview.public_phones"/></p>
                        <p t-if="state.preview.hotline"><span>Shared hotline</span>: <bdi dir="ltr" t-esc="state.preview.hotline"/></p>
                    </t>
                </fieldset>
            </div>
            <t t-set-slot="footer"><button class="btn btn-primary" t-att-disabled="state.busy || !state.preview" t-on-click="send">Send location</button><button class="btn btn-secondary" t-on-click="props.close" t-att-disabled="state.busy">Cancel</button></t>
        </Dialog>
    </t>
</templates>
