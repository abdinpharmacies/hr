<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_ab_sales_sync" model="ir.module.category">
            <field name="name">Abdin Sales Sync</field>
            <field name="sequence">92</field>
        </record>

        <record id="privilege_ab_sales_sync_access" model="res.groups.privilege">
            <field name="name">Sales Sync Access</field>
            <field name="category_id" ref="module_category_ab_sales_sync"/>
        </record>

        <record id="group_ab_sales_sync_manager" model="res.groups">
            <field name="name">Sales Sync Manager</field>
            <field name="privilege_id" ref="privilege_ab_sales_sync_access"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_ab_sales_sync_manager'))]"/>
        </record>
    </data>
</odoo>
