<odoo>
    <record id="config_list" model="ir.ui.view"><field name="name">ab_accounting_cash_config.list</field><field name="model">ab_accounting_cash_config</field><field name="arch" type="xml"><list delete="0"><field name="store_id"/><field name="company_id"/><field name="enabled"/><field name="currency_id" column_invisible="True"/><field name="drawer_balance"/><field name="treasury_balance"/><field name="transit_balance"/></list></field></record>
    <record id="config_form" model="ir.ui.view"><field name="name">ab_accounting_cash_config.form</field><field name="model">ab_accounting_cash_config</field><field name="arch" type="xml"><form delete="0"><sheet>
        <group><field name="store_id"/><field name="branch_code"/><field name="replica_db_id"/><field name="db_serial"/><field name="company_id"/><field name="active"/><field name="enabled"/><field name="posting_user_id"/><field name="doctype_id"/><field name="currency_id" invisible="1"/></group>
        <group string="Posted Balances"><field name="drawer_balance"/><field name="treasury_balance"/><field name="transit_balance"/></group>
        <group string="Cash and Payment Accounts"><field name="drawer_account_id"/><field name="treasury_account_id"/><field name="transit_account_id"/><field name="card_account_id"/><field name="wallet_account_id"/><field name="other_account_id"/></group>
        <group string="Sales and Stock Accounts"><field name="sales_account_id"/><field name="sales_return_account_id"/><field name="inventory_account_id"/><field name="cost_account_id"/><field name="tax_account_id"/></group>
        <group string="Cash Difference Accounts"><field name="difference_account_id"/><field name="shortage_account_id"/><field name="surplus_account_id"/></group>
    </sheet></form></field></record>
    <record id="entry_list" model="ir.ui.view"><field name="name">ab_accounting_cash_entry.list</field><field name="model">ab_accounting_cash_entry</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="create_date"/><field name="store_id"/><field name="reference"/><field name="journal_id"/><field name="operation_key"/></list></field></record>
    <record id="entry_form" model="ir.ui.view"><field name="name">ab_accounting_cash_entry.form</field><field name="model">ab_accounting_cash_entry</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><field name="reference"/><field name="store_id"/><field name="company_id"/><field name="config_id"/><field name="operation_key"/><field name="journal_id"/><field name="source_model"/><field name="source_id"/><field name="create_date"/><field name="create_uid"/></group><field name="lines_snapshot" widget="json"/></sheet></form></field></record>
    <record id="config_action" model="ir.actions.act_window"><field name="name">Branch Cash Accounts</field><field name="res_model">ab_accounting_cash_config</field><field name="view_mode">list,form</field></record>
    <record id="entry_action" model="ir.actions.act_window"><field name="name">Cash Accounting Entries</field><field name="res_model">ab_accounting_cash_entry</field><field name="view_mode">list,form</field></record>
    <menuitem id="cash_management_menu" name="Cash Management" parent="ab_accounting.root_menu" sequence="4"/>
    <menuitem id="config_menu" name="Branch Cash Accounts" parent="cash_management_menu" action="config_action" sequence="10" groups="ab_accounting.group_ab_accounting_accountant"/>
    <menuitem id="entry_menu" name="Cash Accounting Entries" parent="cash_management_menu" action="entry_action" sequence="20" groups="ab_accounting.group_ab_accounting_accountant"/>
</odoo>
