            </field>
        </record>

        <record id="ab_transfer_smart_line_view_search" model="ir.ui.view">
            <field name="name">ab_transfer_smart_line_view_search</field>
            <field name="model">ab_transfer_smart_line</field>
            <field name="arch" type="xml">
                <search string="Smart Transfer Lines">
                    <field name="header_id"/>
                    <field name="product_id"/>
                    <field name="from_store_id"/>
                    <field name="to_store_id"/>
                    <field name="source_type"/>
                    <field name="create_day"/>
                    <field name="exclusion_reason"/>
                    <filter name="filter_included"
                            string="Included"
                            domain="[('exclusion_reason', '=', False)]"/>
                    <filter name="filter_excluded"
                            string="Excluded"
                            domain="[('exclusion_reason', '!=', False)]"/>
                    <separator/>
                    <filter name="group_by_header" string="Transfer" context="{'group_by': 'header_id'}"/>
                    <filter name="group_by_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_source_type" string="Source Type" context="{'group_by': 'source_type'}"/>
                    <filter name="group_by_create_day" string="Create Day" context="{'group_by': 'create_day'}"/>
                    <filter name="group_by_exclusion_reason"
                            string="Exclusion Reason"
                            context="{'group_by': 'exclusion_reason'}"/>
                </search>
            </field>
        </record>

