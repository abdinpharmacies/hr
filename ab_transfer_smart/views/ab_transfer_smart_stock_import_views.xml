<odoo>
    <record id="ab_transfer_smart_stock_import_view_form" model="ir.ui.view">
        <field name="name">Import destination stock</field>
        <field name="model">ab_transfer_smart_stock_import</field>
        <field name="arch" type="xml">
            <form string="Import Destination Stock">
                <group>
                    <field name="store_id" options="{'no_create': True}"/>
                    <field name="filename" invisible="1"/>
                    <field name="file_data" filename="filename"/>
                    <field name="confirm_replace"/>
                    <field name="validation_summary" readonly="1"/>
                </group>
                <div class="alert alert-warning" role="alert">This replaces the entire branch snapshot. Omitted products count as zero. Quantities use the existing cache unit. The import expires at the next Cairo midnight.</div>
                <footer>
                    <button name="action_download_template" type="object" string="Download Template"/>
                    <button name="action_validate_file" type="object" string="Validate File"/>
                    <button name="action_import" type="object" string="Import Stock" class="btn-primary"/>
                    <button name="action_refresh_sales" type="object" string="Refresh Destination Sales"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="ab_transfer_smart_stock_import_action" model="ir.actions.act_window">
        <field name="name">Import Destination Stock</field>
        <field name="res_model">ab_transfer_smart_stock_import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="ab_transfer_smart_cache_state_view_list" model="ir.ui.view">
        <field name="name">Smart snapshot state</field>
        <field name="model">ab_transfer_smart_cache_state</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="store_id"/>
                <field name="stock_revision"/>
                <field name="stock_date"/>
                <field name="origin"/>
                <field name="imported_workflow"/>
                <field name="import_user_id"/>
                <field name="import_time"/>
                <field name="import_filename"/>
                <field name="sales_date"/>
                <field name="sales_refreshed_at"/>
            </list>
        </field>
    </record>
    <record id="ab_transfer_smart_cache_state_action" model="ir.actions.act_window">
        <field name="name">Snapshot Status</field>
        <field name="res_model">ab_transfer_smart_cache_state</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
