<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_product_view_list_smart_transfer" model="ir.ui.view">
            <field name="name">ab_product_view_list_smart_transfer</field>
            <field name="model">ab_product</field>
            <field name="inherit_id" ref="ab_product.ab_product_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list/field[@name='location']" position="attributes">
                    <attribute name="string">Location</attribute>
                </xpath>
                <xpath expr="//list/field[@name='is_priced']" position="attributes">
                    <attribute name="string">Is Priced</attribute>
                </xpath>
                <xpath expr="//list/field[@name='tag_ids']" position="attributes">
                    <attribute name="string">Tag</attribute>
                </xpath>
                <xpath expr="//list/field[@name='barcode_ids']" position="attributes">
                    <attribute name="string">Barcode</attribute>
                </xpath>
                <xpath expr="//list/field[@name='product_card_id']" position="attributes">
                    <attribute name="string">Product Card</attribute>
                </xpath>
                <xpath expr="//list/field[@name='uom_id']" position="after">
                    <field name="min_sale_purchase_qty" string="Min Sale/Purchase Qty"/>
                </xpath>
            </field>
        </record>

        <record id="ab_product_view_form_smart_transfer" model="ir.ui.view">
            <field name="name">ab_product_view_form_smart_transfer</field>
            <field name="model">ab_product</field>
            <field name="inherit_id" ref="ab_product.ab_product_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='location']" position="attributes">
                    <attribute name="string">Location</attribute>
                </xpath>
                <xpath expr="//field[@name='is_priced']" position="attributes">
                    <attribute name="string">Is Priced</attribute>
                </xpath>
                <xpath expr="//field[@name='tag_ids']" position="attributes">
                    <attribute name="string">Tag</attribute>
                </xpath>
                <xpath expr="//field[@name='barcode_ids']" position="attributes">
                    <attribute name="string">Barcode</attribute>
                </xpath>
                <xpath expr="//field[@name='uom_id']" position="after">
                    <field name="min_sale_purchase_qty" string="Min Sale/Purchase Qty"/>
                </xpath>
            </field>
        </record>

        <record id="ab_product_view_form_button_titles_smart_transfer" model="ir.ui.view">
            <field name="name">ab_product_view_form_button_titles_smart_transfer</field>
            <field name="model">ab_product</field>
            <field name="inherit_id" ref="ab_product.ab_product_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='btn_edit_product_main_data']" position="attributes">
                    <attribute name="title">Edit Product Main Data</attribute>
                </xpath>
            </field>
        </record>

        <record id="ab_product_view_list_balance_button_titles_smart_transfer" model="ir.ui.view">
            <field name="name">ab_product_view_list_balance_button_titles_smart_transfer</field>
            <field name="model">ab_product</field>
            <field name="inherit_id" ref="ab_sales.ab_product_tree_view_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='btn_get_stores_balance']" position="attributes">
                    <attribute name="title">Show Balance</attribute>
                </xpath>
            </field>
        </record>

        <record id="ab_product_card_view_form_smart_transfer" model="ir.ui.view">
            <field name="name">ab_product_card_view_form_smart_transfer</field>
            <field name="model">ab_product_card</field>
            <field name="inherit_id" ref="ab_product.ab_product_card_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_ids']/list/field[@name='tag_ids']" position="attributes">
                    <attribute name="string">Tag</attribute>
                </xpath>
                <xpath expr="//field[@name='product_ids']/list/field[@name='barcode_ids']" position="attributes">
                    <attribute name="string">Barcode</attribute>
                </xpath>
                <xpath expr="//field[@name='product_ids']/list/field[@name='code']" position="after">
                    <field name="min_sale_purchase_qty" string="Min Sale/Purchase Qty"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
