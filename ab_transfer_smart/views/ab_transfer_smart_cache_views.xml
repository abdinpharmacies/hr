            <field name="name">ab_transfer_smart_stock_cache_view_list</field>
            <field name="model">ab_transfer_smart_stock_cache</field>
            <field name="arch" type="xml">
                <list string="Smart Stock Cache" create="0" edit="0" delete="0">
                    <field name="cache_date"/>
                    <field name="store_id"/>
                    <field name="product_code"/>
                    <field name="product_id"/>
                    <field name="product_eplus_serial" optional="hide"/>
                    <field name="stock_qty" sum="Stock Quantity"/>
                    <field name="stock_pending_qty" sum="Pending Stock Quantity"/>
                    <field name="create_date" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                </list>
            </field>
        </record>

