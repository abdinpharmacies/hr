            <field name="model">ab_transfer_smart_stock_cache</field>
            <field name="arch" type="xml">
                <form string="Smart Stock Cache" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="cache_date"/>
                                <field name="store_id"/>
                            </group>
                            <group>
                                <field name="product_code"/>
                                <field name="product_id"/>
                                <field name="product_eplus_serial"/>
                                <field name="stock_qty"/>
                                <field name="stock_pending_qty"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

