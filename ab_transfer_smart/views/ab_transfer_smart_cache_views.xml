<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_transfer_smart_stock_cache_view_search" model="ir.ui.view">
            <field name="name">ab_transfer_smart_stock_cache_view_search</field>
            <field name="model">ab_transfer_smart_stock_cache</field>
            <field name="arch" type="xml">
                <search string="Smart Stock Cache">
                    <field name="cache_date"/>
                    <field name="store_id"/>
                    <field name="product_code"/>
                    <field name="product_id"/>
                    <field name="product_eplus_serial"/>
                    <separator/>
                    <filter name="group_by_cache_date" string="Cache Date" context="{'group_by': 'cache_date'}"/>
                    <filter name="group_by_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="group_by_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_product_code" string="Product Code" context="{'group_by': 'product_code'}"/>
                    <filter name="group_by_product_serial" string="Product Serial"
                            context="{'group_by': 'product_eplus_serial'}"/>
                </search>
            </field>
        </record>

