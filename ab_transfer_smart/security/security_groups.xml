<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_transfer_smart" model="ir.module.category">
            <field name="name">Smart Transfer</field>
            <field name="sequence" eval="20"/>
        </record>

        <record id="privilege_transfer_smart" model="res.groups.privilege">
            <field name="name">Smart Transfer</field>
            <field name="category_id" ref="module_category_transfer_smart"/>
            <field name="sequence" eval="10"/>
        </record>

        <record id="group_transfer_smart_purchase" model="res.groups">
            <field name="name">Purchase Preparation</field>
            <field name="privilege_id" ref="privilege_transfer_smart"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_trnasfer_smart_store_preparation" model="res.groups">
            <field name="name">Store Preparation</field>
            <field name="privilege_id" ref="privilege_transfer_smart"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_trnasfer_smart_store_revision" model="res.groups">
            <field name="name">Store Revision</field>
            <field name="privilege_id" ref="privilege_transfer_smart"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_trnasfer_smart_store_manager" model="res.groups">
            <field name="name">Store Manager</field>
            <field name="privilege_id" ref="privilege_transfer_smart"/>
            <field name="implied_ids" eval="[
            (4, ref('group_trnasfer_smart_store_preparation')),
            (4, ref('group_trnasfer_smart_store_revision')),
            ]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids"
                   eval="[
                       (4, ref('group_transfer_smart_purchase')),
                       (4, ref('group_trnasfer_smart_store_preparation')),
                       (4, ref('group_trnasfer_smart_store_revision'))
                   ]"/>
        </record>
    </data>
</odoo>
