<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ab_transfer_smart.BinaryFieldUploadLabel"
       t-inherit="web.BinaryField"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='toggler'][text()[contains(., 'Upload your file')]]" position="replace">
            <t t-set-slot="toggler">
                <t t-if="props.name === 'product_import_file'">Upload your Excel File</t>
                <t t-else="">Upload your file</t>
            </t>
        </xpath>
    </t>
</templates>
