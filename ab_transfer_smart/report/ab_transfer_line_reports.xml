        <record id="action_report_ab_transfer_smart_lines" model="ir.actions.report">
            <field name="name">Smart Transfer Lines</field>
            <field name="model">ab_transfer_header</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ab_transfer_smart.report_ab_transfer_smart_lines</field>
            <field name="report_file">ab_transfer_smart.report_ab_transfer_smart_lines</field>
            <field name="paperformat_id" ref="ab_transfer_smart.paperformat_ab_transfer_smart_line_reports"/>
            <field name="print_report_name">'Smart Transfer Lines - %s' % (object.display_name or '')</field>
            <field name="binding_model_id" ref="ab_transfer.model_ab_transfer_header"/>
            <field name="binding_type">report</field>
            <field name="binding_view_types">list</field>
            <field name="multi" eval="True"/>
        </record>

