<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="paperformat_ab_transfer_line_reports" model="report.paperformat">
            <field name="name">AB Transfer Line Reports</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">4</field>
            <field name="margin_right">4</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">3</field>
            <field name="dpi">90</field>
        </record>

        <record id="paperformat_ab_transfer_smart_line_reports" model="report.paperformat">
            <field name="name">AB Transfer Smart Line Reports</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">3</field>
            <field name="margin_bottom">3</field>
            <field name="margin_left">2</field>
            <field name="margin_right">2</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">3</field>
            <field name="dpi">90</field>
        </record>

        <template id="report_ab_transfer_smart_lines">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.basic_layout">
                        <div class="page ab-smart-report-page">
                            <style>
                                .ab-smart-report-page {
                                    margin: 0;
                                    padding: 0;
                                }

                                .ab-smart-title {
                                    margin: 0;
                                    font-weight: 700;
                                    line-height: 1.1;
                                }

                                .ab-smart-lines-report {
                                    table-layout: fixed;
                                    width: 98%;
                                    margin-left: auto;
                                    margin-right: auto;
                                    font-size: 9px;
                                    line-height: 1.15;
                                    border-collapse: collapse;
                                }

                                .ab-smart-lines-report thead {
                                    display: table-header-group;
                                }

                                .ab-smart-lines-report th,
                                .ab-smart-lines-report td {
                                    border: 1px solid #000;
                                    padding: 2px 4px;
                                    overflow: hidden;
                                    text-overflow: clip;
                                    white-space: nowrap;
                                }

                                .ab-smart-lines-report span {
                                    display: block;
                                    overflow: hidden;
                                    text-overflow: clip;
                                    white-space: nowrap;
                                }

                                .ab-smart-lines-report .ab-smart-spacer {
                                    border: 0;
                                    padding: 3px 0;
                                }

                                .ab-smart-lines-report .ab-smart-header-cell {
                                    border: 0;
                                    padding: 0;
                                }

                                .ab-smart-header-split {
                                    width: 100%;
                                    table-layout: fixed;
                                    border-collapse: collapse;
                                }

                                .ab-smart-lines-report .ab-smart-info-row th,
                                .ab-smart-lines-report .ab-smart-info-row td {
                                    font-size: 125%;
                                    line-height: 1.1;
                                    padding-top: 4px;
                                    padding-bottom: 4px;
                                    text-align: left;
                                }

                                .ab-smart-lines-report .ab-smart-info-row span {
                                    display: inline;
                                }

                                .ab-smart-lines-report .ab-smart-column-header th {
                                    font-size: 100%;
                                    line-height: 1.1;
                                    padding-top: 3px;
                                    padding-bottom: 3px;
                                }

                                .ab-smart-lines-report .ab-smart-code-text,
                                .ab-smart-lines-report .ab-smart-qty-text {
                                    font-size: 125%;
                                    line-height: 1.1;
                                }

                                .ab-smart-lines-report td.ab-smart-product-cell,
                                .ab-smart-lines-report td.ab-smart-product-cell span {
                                    overflow: visible;
                                    text-align: left;
                                    direction: ltr;
                                    white-space: normal;
                                }

                                .ab-smart-lines-report .ab-smart-product-text {
                                    display: inline;
                                    font-size: 115%;
                                    line-height: 1.05;
                                    overflow-wrap: break-word;
                                    word-break: break-word;
                                    word-wrap: break-word;
                                }

                                .ab-smart-report-footer {
                                    width: 98%;
                                    margin: 4px auto 0;
                                    font-size: 12px;
                                    line-height: 1.2;
                                    text-align: right;
                                }
                            </style>
                            <table class="table table-sm table-bordered table-striped align-middle ab-smart-lines-report">
                                <colgroup>
                                    <col style="width: 6%;"/>
                                    <col style="width: 18%;"/>
                                    <col style="width: 7%;"/>
                                    <col style="width: 7%;"/>
                                    <col style="width: 7%;"/>
                                    <col style="width: 5%;"/>
                                    <col style="width: 7%;"/>
                                    <col style="width: 6%;"/>
                                    <col style="width: 8%;"/>
                                    <col style="width: 6%;"/>
                                    <col style="width: 6%;"/>
                                    <col style="width: 6%;"/>
                                    <col style="width: 5%;"/>
                                    <col style="width: 6%;"/>
                                </colgroup>
                                <thead class="table-light">
                                    <tr>
                                        <td colspan="14" class="ab-smart-header-cell">
                                            <table class="ab-smart-header-split">
                                                <colgroup>
                                                    <col style="width: 12%;"/>
                                                    <col style="width: 38%;"/>
                                                    <col style="width: 12%;"/>
                                                    <col style="width: 38%;"/>
                                                </colgroup>
                                                <tr class="ab-smart-info-row">
                                                    <th>Transfer</th>
                                                    <td><span class="ab-smart-title" t-field="o.display_name"/></td>
                                                    <th>Transfer Date</th>
                                                    <td><span t-esc="o.get_smart_report_transfer_date_text()"/></td>
                                                </tr>
                                                <tr class="ab-smart-info-row">
                                                    <th>From Store</th>
                                                    <td><span t-field="o.from_store_id"/></td>
                                                    <th>To Store</th>
                                                    <td><span t-field="o.to_store_id"/></td>
                                                </tr>
                                                <tr class="ab-smart-info-row">
                                                    <th>Company</th>
                                                    <td><span t-field="o.company_id"/></td>
                                                    <th>User</th>
                                                    <td><span t-field="o.user_id"/></td>
                                                </tr>
                                                <tr class="ab-smart-info-row">
                                                    <th>Notes</th>
                                                    <td colspan="3"><span t-field="o.notes"/></td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th colspan="14" class="ab-smart-spacer"></th>
                                    </tr>
                                    <tr class="ab-smart-column-header">
                                        <th class="text-nowrap">Code</th>
                                        <th class="text-nowrap">Product</th>
                                        <th class="text-nowrap">Source Type</th>
                                        <th class="text-nowrap">Create Day</th>
                                        <th class="text-nowrap">Location</th>
                                        <th class="text-end text-nowrap">Qty</th>
                                        <th class="text-nowrap">Expiry Date</th>
                                        <th class="text-nowrap">UOM</th>
                                        <th class="text-nowrap">Exclusion Reason</th>
                                        <th class="text-end text-nowrap">Source Stock</th>
                                        <th class="text-end text-nowrap">Expected Stock</th>
                                        <th class="text-end text-nowrap">Destination Stock</th>
                                        <th class="text-end text-nowrap">Total Need</th>
                                        <th class="text-end text-nowrap">Over Need</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="sorted_smart_lines"
                                       t-value="o.get_smart_lines_for_report()"/>
                                    <tr t-if="not sorted_smart_lines">
                                        <td colspan="14" class="text-center">No smart transfer lines found.</td>
                                    </tr>
                                    <tr t-foreach="sorted_smart_lines" t-as="line">
                                        <td class="text-nowrap"><span class="ab-smart-code-text"
                                                                      t-field="line.product_id.code"/></td>
                                        <td class="text-uppercase ab-smart-product-cell">
                                            <span class="ab-smart-product-text" t-field="line.product_id.name"/>
                                        </td>
                                        <td class="text-nowrap"><span t-field="line.source_type"/></td>
                                        <td class="text-nowrap"><span t-field="line.create_day"/></td>
                                        <td class="text-nowrap"><span t-field="line.smart_product_location"/></td>
                                        <td class="text-end text-nowrap">
                                            <span class="ab-smart-qty-text"
                                                  t-esc="('%.3f' % (line.qty or 0.0)).rstrip('0').rstrip('.')"/>
                                        </td>
                                        <td class="text-nowrap"><span t-field="line.expiry_date"/></td>
                                        <td class="text-nowrap"><span t-esc="o.get_smart_report_uom_text(line)"/></td>
                                        <td class="text-nowrap">
                                            <span t-field="line.exclusion_reason"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-esc="('%.3f' % (line.smart_source_stock_qty or 0.0)).rstrip('0').rstrip('.')"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-esc="('%.3f' % (line.smart_expected_source_stock_qty or 0.0)).rstrip('0').rstrip('.')"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-esc="('%.3f' % (line.smart_destination_stock_qty or 0.0)).rstrip('0').rstrip('.')"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-esc="('%.3f' % (line.smart_total_need or 0.0)).rstrip('0').rstrip('.')"/>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <span t-esc="('%.3f' % (line.smart_over_need_qty or 0.0)).rstrip('0').rstrip('.')"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div class="ab-smart-report-footer">
                                Printing Date:
                                <span t-esc="o.get_smart_report_printing_date_text()"/>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

