<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="balance_dist">
            <t t-call="web.html_container">
                <div class="header"/>

                <div class="article">
                    <div class="text-center h1 bg-light">
                        <t t-esc="description"/>

                        <h1 class="h4 text-center">
                            <span class='mr-4 text-danger'>
                                From
                            </span>
                            <t t-esc="start_date"/>
                            <span class='m-4 text-danger'>
                                To
                            </span>
                            <t t-esc="end_date"/>
                        </h1>
                    </div>
                    <div class="h1 bg-light float-left">
                        Start Balance:
                        <t t-esc="'{0:,.2f}'.format(start_balance)"/>
                    </div>
                    <div class="h1 bg-light float-right">
                        End Balance:
                        <t t-esc="'{0:,.2f}'.format(end_balance)"/>
                    </div>


                    <div>
                        <table class="table abdin-table table-hover table-striped ">
                            <thead class="thead-light border border-dark text-center">
                                <tr>
                                    <th class="text-info" style='border: 1px solid'>#</th>

                                    <t t-foreach="headers" t-as="header">
                                        <th style='border: 1px solid'>
                                            <t t-esc="str(header)"/>
                                        </th>
                                    </t>
                                    <th/>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-foreach="rows" t-as="row">
                                    <tr>
                                        <td class="text-info border border-light">
                                            <t t-esc="1+row_index"/>
                                        </td>

                                        <t t-foreach="row" t-as="value">
                                            <td class="border border-light text-right">
                                                <t t-esc="isinstance(value, float) and '{0:,.2f}'.format(value) or value"/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                </div>

                <div class="footer">
                    <div class="h6 text-danger bg-light float-center">
                        <t t-esc="rows_count_warning"/>
                    </div>

                </div>
            </t>
        </template>

    </data>
</odoo>