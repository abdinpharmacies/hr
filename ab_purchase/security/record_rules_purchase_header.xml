<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="rule_purchase_store_scope" model="ir.rule">
            <field name="name">Purchases: assigned stores</field>
            <field name="model_id" ref="model_ab_purchase_header"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') or user.has_group('ab_purchase.group_ab_purchase_manager') else [('store_id', 'in', user.inventory_store_ids.ids)]</field>
        </record>
        <record id="rule_purchase_line_store_scope" model="ir.rule">
            <field name="name">Purchase lines: assigned stores</field>
            <field name="model_id" ref="model_ab_purchase_line"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') or user.has_group('ab_purchase.group_ab_purchase_manager') else [('header_id.store_id', 'in', user.inventory_store_ids.ids)]</field>
        </record>

        <record id="rule_ab_purchase_header_prevent_all" model="ir.rule">
            <field name="name">rule_ab_purchase_header_prevent_all</field>
            <field name="model_id" ref="model_ab_purchase_header"/>
            <field name="groups" eval="[(4, ref('group_ab_purchase_branch_user'))]"/>
            <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') or user.has_group('ab_purchase.group_ab_purchase_manager') else [(0, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>


        <record id="rule_ab_purchase_header_data_entry_rw_all" model="ir.rule">
            <field name="name">rule_ab_purchase_header_data_entry_rw_all</field>
            <field name="model_id" ref="model_ab_purchase_header"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ab_purchase_branch_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>


        <record id="rule_ab_purchase_header_read_user_ro_all" model="ir.rule">
            <field name="name">rule_ab_purchase_header_read_user_ro_all</field>
            <field name="model_id" ref="model_ab_purchase_header"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ab_purchase_branch_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>


    </data>
</odoo>
