<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="rule_ab_purchase_claim_prevent_all" model="ir.rule">
            <field name="name">rule_ab_purchase_claim_prevent_all</field>
            <field name="model_id" ref="model_ab_purchase_claim"/>
            <field name="groups" eval="[(4, ref('group_ab_purchase_accounting_cash'))]"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_ab_purchase_claim_cash_own_crud" model="ir.rule">
            <field name="name">rule_ab_purchase_claim_cash_own_crud</field>
            <field name="model_id" ref="model_ab_purchase_claim"/>
            <field name="domain_force">[
                ('instant_cash', '=', True),
                ('user_id', '=', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('ab_purchase.group_ab_purchase_accounting_cash'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_ab_purchase_claim_any_own_crud" model="ir.rule">
            <field name="name">rule_ab_purchase_claim_any_own_crud</field>
            <field name="model_id" ref="model_ab_purchase_claim"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_ab_purchase_accounting_cash'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_ab_purchase_claim_all" model="ir.rule">
            <field name="name">rule_ab_purchase_claim_any_own_crud</field>
            <field name="model_id" ref="model_ab_purchase_claim"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_ab_purchase_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>


    </data>
</odoo>