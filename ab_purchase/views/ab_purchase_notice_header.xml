<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_purchase_notice_header_view_tree"
                model="ir.ui.view">
            <field name="name">ab_purchase_notice_header_view_tree</field>
            <field name="model">ab_purchase_notice_header</field>
            <field name="arch"
                   type="xml">
                <list string="ab_purchase_notice_header_tree">
                    <field name="supplier_id" optional="show"/>
                    <field name="invoice_number" optional="show"/>
                    <field name="eplus_serial_calc" optional="hide"/>
                    <field name="pur_eplus_serial" optional="hide"/>
                    <field name="eplus_g_header_serial" optional="hide"/>
                    <field name="je_header_id" optional="hide"/>
                    <field name="purchase_header_id" optional="show"/>
                    <field name="notice_type" optional="show"/>
                    <field name="doc_code" optional="show"/>
                    <field name="doc_date" optional="show"/>
                    <field name="total_cost" optional="show"/>
                    <field name="lines_count" optional="show"/>
                    <field name="status"
                           widget="badge" decoration-success="status=='saved'" optional="show"/>
                    <field name="description" optional="show"/>
                    <field name="create_uid" optional="hide"/>
                    <field name="create_date" optional="hide"/>
                    <field name="write_uid" optional="hide"/>
                    <field name="write_date" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="ab_purchase_notice_header_view_form"
                model="ir.ui.view">
            <field name="name">ab_purchase_notice_header_view_form</field>
            <field name="model">ab_purchase_notice_header</field>
            <field name="arch"
                   type="xml">
                <form string="ab_purchase_notice_header_form">
                    <header class="w-100">
                        <button string="Submit"
                                type="object"
                                name="btn_submit_inventory"
                                class="btn-info"
                                invisible="status == 'saved'"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box"
                             name="button_box">
                            <button name="compute_totals"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-truck"
                                    width="200px">
                                <div class="o_field_widget o_stat_info mr4">
                                    <span class="o_stat_text">∑ Cost:</span>
                                </div>
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="total_cost"/>
                                    </span>
                                </div>
                            </button>
                            <button name="compute_totals"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-truck"
                                    width="200px">
                                <div class="o_field_widget o_stat_info mr4">
                                    <span class="o_stat_text">∑ Taxes:</span>
                                </div>
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="total_taxes_value"/>
                                    </span>
                                </div>
                            </button>
                            <button name="compute_totals"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-list-ol"
                                    width="200px">
                                <div class="o_field_widget o_stat_info mr4">
                                    <span class="o_stat_text">Lines Count:</span>
                                </div>
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="lines_count"/>
                                    </span>
                                </div>
                            </button>
                        </div>
                        <field name="status"
                               invisible="1"/>
                        <widget name="web_ribbon"
                                title="Saved"
                                bg_color="bg-success"
                                invisible="status != 'saved'"/>
                        <group col="4">
                            <field name="supplier_id" readonly="status == 'saved'"/>
                            <field name="purchase_header_id"
                                   force_save="1"
                                   domain="[('status', 'in', ['rejected','pending'])]"
                                   readonly="(status == 'saved' or lines_count != 0)"/>
                            <field name="doc_code"/>
                            <field name="doc_date"/>
                            <field name="je_header_id" readonly="1" force_save="1"/>

                            <field name="notice_type"
                                   readonly="status == 'saved'"/>
                            <button name="btn_get_all_line_ids"
                                    type="object"
                                    string="Get All Lines"
                                    class="btn-warning"
                                    invisible="status == 'saved'"/>
                        </group>
                        <notebook>
                            <page string="Purchase Notice Lines">
                                <field name="line_ids"
                                       readonly="status == 'saved'">
                                    <list editable="bottom">
                                        <field name="source_id_domain" invisible="1"/>
                                        <field name="source_id"
                                               domain="source_id_domain"
                                               optional="show"/>
                                        <field name="product_id" optional="hide"/>
                                        <field name="qty"/>
                                        <field name="bonus"/>
                                        <field name="uom_id" context="{'uom_only_type': 1}"/>
                                        <field name="available_qty"/>
                                        <field name="available_bonus"/>
                                        <field name="price"/>
                                        <field name="line_cost" sum="Total Cost"/>
                                        <field name="last_update_date" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Description">
                                <group>
                                    <field name="description"
                                           nolabel="1"
                                           placeholder="Write your feedback here"
                                           readonly="status == 'saved'"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_purchase_notice_header_action"
                model="ir.actions.act_window">
            <field name="name">Notices</field>
            <field name="type">ir.actions.act_window</field>
            <field name="context">{'uom_only_type': 1}</field>
            <field name="res_model">ab_purchase_notice_header</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="ab_purchase_notice_header_view_search" model="ir.ui.view">
            <field name="name">ab_purchase_notice_header_view_search</field>
            <field name="model">ab_purchase_notice_header</field>
            <field name="arch" type="xml">
                <search string="ab_purchase_notice_header_search">
                    <field name="supplier_id"/>
                    <field name="invoice_number"/>
                    <field name="eplus_serial_calc"/>
                    <field name="pur_eplus_serial"/>
                    <field name="eplus_g_header_serial"/>
                    <field name="je_header_id"/>
                    <field name="purchase_header_id"/>
                    <field name="notice_type"/>
                    <field name="doc_code"/>
                    <field name="doc_date"/>
                    <field name="total_cost"/>
                    <field name="lines_count"/>
                    <field name="status"/>
                    <field name="description"/>
                    <field name="create_uid"/>
                    <field name="create_date"/>
                    <field name="write_uid"/>
                    <field name="write_date"/>
                </search>
            </field>
        </record>

        <menuitem id="ab_purchase_notice_header_menu" name="Notices" parent="ab_purchase_notices_menu"
                  action="ab_purchase_notice_header_action" sequence="2"/>

        <record id="ab_purchase_notice_header_view_form_layout" model="ir.ui.view">
            <field name="name">ab_purchase_notice_header_view_form.layout</field>
            <field name="model">ab_purchase_notice_header</field>
            <field name="inherit_id" ref="ab_purchase_notice_header_view_form"/>
            <field name="priority">90</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="after">
                    <div name="ab_purchase_notice_header_view_form_totals" class="row g-3 mb-4">
                        <div class="col-12 col-md-6 col-xl-4" name="ab_purchase_notice_header_view_form_layout_1"/>
                        <div class="col-12 col-md-6 col-xl-4" name="ab_purchase_notice_header_view_form_layout_2"/>
                        <div class="col-12 col-md-6 col-xl-4" name="ab_purchase_notice_header_view_form_layout_3"/>
                    </div>
                </xpath>
                <xpath expr="//*[@name=&quot;ab_purchase_notice_header_view_form_layout_1&quot;]" position="inside">
                    <xpath expr="//div[@name=&quot;button_box&quot;]/button[@name=&quot;compute_totals&quot;][.//field[@name=&quot;total_cost&quot;]]" position="move"/>
                </xpath>
                <xpath expr="//*[@name=&quot;ab_purchase_notice_header_view_form_layout_2&quot;]" position="inside">
                    <xpath expr="//div[@name=&quot;button_box&quot;]/button[@name=&quot;compute_totals&quot;][.//field[@name=&quot;total_taxes_value&quot;]]" position="move"/>
                </xpath>
                <xpath expr="//*[@name=&quot;ab_purchase_notice_header_view_form_layout_3&quot;]" position="inside">
                    <xpath expr="//div[@name=&quot;button_box&quot;]/button[@name=&quot;compute_totals&quot;][.//field[@name=&quot;lines_count&quot;]]" position="move"/>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//button)[not(@class=&quot;btn btn-light border rounded d-flex align-items-center gap-3 text-start w-100 h-100 p-3&quot;)]" position="attributes">
                    <attribute name="width"/>
                    <attribute name="class">btn btn-light border rounded d-flex align-items-center gap-3 text-start w-100 h-100 p-3</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//button)[not(@class=&quot;btn btn-light border rounded d-flex align-items-center gap-3 text-start w-100 h-100 p-3&quot;)]" position="attributes">
                    <attribute name="width"/>
                    <attribute name="class">btn btn-light border rounded d-flex align-items-center gap-3 text-start w-100 h-100 p-3</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//button)[not(@class=&quot;btn btn-light border rounded d-flex align-items-center gap-3 text-start w-100 h-100 p-3&quot;)]" position="attributes">
                    <attribute name="width"/>
                    <attribute name="class">btn btn-light border rounded d-flex align-items-center gap-3 text-start w-100 h-100 p-3</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//button/div[span[@class=&quot;o_stat_text&quot;]])[not(@class=&quot;d-flex flex-column text-muted small&quot;)]" position="attributes">
                    <attribute name="class">d-flex flex-column text-muted small</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//button/div[span[@class=&quot;o_stat_text&quot;]])[not(@class=&quot;d-flex flex-column text-muted small&quot;)]" position="attributes">
                    <attribute name="class">d-flex flex-column text-muted small</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//button/div[span[@class=&quot;o_stat_text&quot;]])[not(@class=&quot;d-flex flex-column text-muted small&quot;)]" position="attributes">
                    <attribute name="class">d-flex flex-column text-muted small</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//button/div[span[@class=&quot;o_stat_value&quot;]])[not(@class=&quot;d-flex flex-column ms-auto text-end fw-semibold&quot;)]" position="attributes">
                    <attribute name="class">d-flex flex-column ms-auto text-end fw-semibold</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//button/div[span[@class=&quot;o_stat_value&quot;]])[not(@class=&quot;d-flex flex-column ms-auto text-end fw-semibold&quot;)]" position="attributes">
                    <attribute name="class">d-flex flex-column ms-auto text-end fw-semibold</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//button/div[span[@class=&quot;o_stat_value&quot;]])[not(@class=&quot;d-flex flex-column ms-auto text-end fw-semibold&quot;)]" position="attributes">
                    <attribute name="class">d-flex flex-column ms-auto text-end fw-semibold</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//span[@class=&quot;o_stat_text&quot;])[not(@class=&quot;d-block text-wrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-wrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//span[@class=&quot;o_stat_text&quot;])[not(@class=&quot;d-block text-wrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-wrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//span[@class=&quot;o_stat_text&quot;])[not(@class=&quot;d-block text-wrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-wrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//span[@class=&quot;o_stat_value&quot;])[not(@class=&quot;d-block text-nowrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-nowrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//span[@class=&quot;o_stat_value&quot;])[not(@class=&quot;d-block text-nowrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-nowrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_notice_header_view_form_totals&quot;]//span[@class=&quot;o_stat_value&quot;])[not(@class=&quot;d-block text-nowrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-nowrap</attribute>
                </xpath>
                <xpath expr="(//widget[@name=&quot;web_ribbon&quot;])[not(@class=&quot;position-relative&quot;)]" position="attributes">
                    <attribute name="class">position-relative</attribute>
                    <attribute name="style">height: 6rem; --Ribbon-wrapper-width: 6rem; --Ribbon-font-size: .75rem; --Ribbon-height: 1.75rem;</attribute>
                </xpath>
                <xpath expr="//div[@name='ab_purchase_notice_header_view_form_totals']" position="before">
                    <xpath expr="//widget[@name=&quot;web_ribbon&quot;][@bg_color=&quot;bg-success&quot;]" position="move"/>
                </xpath>
                <xpath expr="(//sheet/notebook)[not(@class=&quot;w-100 mw-100&quot;)]" position="attributes">
                    <attribute name="class">w-100 mw-100</attribute>
                </xpath>
                <xpath expr="(//sheet/notebook/page/field[list])[not(@class=&quot;w-100 mw-100&quot;)]" position="attributes">
                    <attribute name="nolabel">1</attribute>
                    <attribute name="class">w-100 mw-100</attribute>
                </xpath>
                <xpath expr="(//list/field[@invisible=&quot;1&quot;])[not(@column_invisible=&quot;True&quot;)]" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>
                <xpath expr="(//sheet/group/button[@name=&quot;btn_get_all_line_ids&quot;])[not(@class=&quot;btn-warning align-self-start&quot;)]" position="attributes">
                    <attribute name="class">btn-warning align-self-start</attribute>
                </xpath>
                <xpath expr="//form" position="attributes">
                    <attribute name="class" add="ab_purchase_notice_header_view_layout" separator=" "/>
                </xpath>
                <xpath expr="//form" position="inside">
                    <style>
                            .ab_purchase_notice_header_view_layout .o_notebook,
                            .ab_purchase_notice_header_view_layout .o_notebook_content,
                            .ab_purchase_notice_header_view_layout .tab-pane,
                            .ab_purchase_notice_header_view_layout .o_field_widget.o_field_one2many,
                            .ab_purchase_notice_header_view_layout .o_field_widget.o_field_many2many,
                            .ab_purchase_notice_header_view_layout .o_field_x2many {
                                min-width: 0;
                                max-width: 100%;
                                overflow: visible !important;
                            }
                            .ab_purchase_notice_header_view_layout .o_field_x2many .o_list_renderer.table-responsive {
                                width: 100%;
                                max-width: 100%;
                                margin-inline: 0 !important;
                                overflow-x: auto !important;
                                overflow-y: auto !important;
                            }
                        </style>
                </xpath>
            </field>
        </record>

    </data>
</odoo>