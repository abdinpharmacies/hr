<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_purchase_header_view_form" model="ir.ui.view">
            <field name="name">ab_purchase_header_view_form</field>
            <field name="model">ab_purchase_header</field>
            <field name="arch" type="xml">
                <form string="ab_purchase_header_form">
                    <header class="w-100">
                        <button string="Submit" type="object" name="btn_submit_inventory" class="btn-info"

                                groups="base.group_system" invisible="status in ['pending', 'saved']"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="compute_totals" type="object" class="oe_stat_button" icon="fa-dollar"
                                    width="300px">
                                <div class="o_field_widget o_stat_info mr4">
                                    <span class="o_stat_text">∑ Selling Price:</span>
                                    <span class="o_stat_text">∑ Purchase Price:</span>
                                </div>
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="total_price"/>
                                    </span>
                                    <span class="o_stat_value">
                                        <field name="total_purchase_price"/>
                                    </span>
                                </div>

                            </button>
                            <button name="compute_totals" type="object" class="oe_stat_button" icon="fa-truck"
                                    width="200px">
                                <div class="o_field_widget o_stat_info mr4">
                                    <span class="o_stat_text">∑ Cost:</span>
                                    <span class="o_stat_text">∑ Taxes:</span>
                                </div>
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="total_cost"/>
                                    </span>
                                    <span class="o_stat_value">
                                        <field name="total_tax"/>
                                    </span>
                                </div>
                            </button>
                            <button name="compute_totals" type="object" class="oe_stat_button" icon="fa-list-ol"
                                    width="200px">
                                <div class="o_field_widget o_stat_info mr4">
                                    <span class="o_stat_text">Product:</span>
                                    <span class="o_stat_text">Lines:</span>
                                </div>
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="number_of_products"/>
                                    </span>
                                    <span class="o_stat_value">
                                        <field name="lines_count"/>
                                    </span>
                                </div>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Rejected" bg_color="bg-danger"
                                invisible="status != 'rejected'"/>
                        <widget name="web_ribbon" title="Saved" bg_color="bg-success"
                                invisible="status != 'saved'"/>
                        <widget name="web_ribbon" title="Pending" bg_color="bg-info"
                                invisible="status != 'pending'"/>
                        <field name="status" invisible="1"/>
                        <field name="total_price" invisible="1"/>
                        <field name="total_cost" string="Total Cost" invisible="1"/>
                        <field name="total_tax" invisible="1"/>
                        <field name="number_of_products" invisible="1"/>
                        <group>
                            <group string="Basic Data">
                                <field name="store_id"
                                       domain="[('allow_purchase', '=', True)]"/>
                                <field name="supplier_id"/>
                                <field name="doc_code"/>
                                <field name="doc_date"/>
                                <field name="invoice_type"/>
                            </group>
                            <group string="Accounting Data">
                                <field name="je_header_id" readonly="1" force_save="1"/>
                                <field name="res_header_id" invisible="1" force_save="1"/>
                                <field name="res_header_ref" invisible="1" force_save="1"/>
                                <field name="net_invoice" readonly="(not (status == 'prepending'))"/>
                                <field name="net_tax" readonly="(not (status == 'prepending'))"/>
                                <field name="eplus_total_disc_on_inv"/>
                                <label for="total_extra_discount"/>
                                <div class="oe_inline d-flex justify-content-around">
                                    <div>
                                        <field name="total_extra_discount"
                                               readonly="(not (status == 'prepending'))"/>
                                    </div>
                                    <div>
                                        <field name="total_extra_discount_percentage"

                                               widget="percentage" string="Extra Discount %" readonly="(not (status == 'prepending'))"/>
                                    </div>
                                    <!--
                                        <div>
                                            <button string="Distribute discount" class="btn-info" type="object"
                                                    confirm="Are You Sure?"
                                                    name="distribution_extra_discount"
                                                    attrs="{'invisible':['|',('status','not in',['prepending']),('total_extra_discount','=',0)]}"/>
                                        </div>
                                    -->
                                </div>
                            </group>

                        </group>
                        <notebook>
                            <page string="Purchase Detail">
                                <field name="line_ids"

                                       readonly="(not (status == 'prepending'))" invisible="((((net_invoice == 0 and invoice_type != 'bonus') or store_id == False) or supplier_id == False) or doc_code in ['', False])">
                                    <list editable="bottom">
                                        <field name="header_status" invisible="1"/>
                                        <field name="product_code" width="75px"/>
                                        <field name="product_id" width="120px"/>
                                        <field name="exp_date"
                                               optional="hide"/>
                                        <field name="qty" string="Quantity" width="75px"/>
                                        <field name="bonus" width="65px"/>
                                        <field name="product_uom_ids" invisible="1"/>
                                        <field name="uom_id" domain="[('id','in',product_uom_ids)]"
                                               context="{'uom_only_type': 1}"
                                               options="{&quot;always_reload&quot;: True}" string="Unit" width="65px"/>
                                        <field name="price" string="Price" width="75px"/>
                                        <field name="purchase_price"/>
                                        <field name="line_purchase_price" string="∑ Purchase Price"
                                               sum="∑ Purchase"/>
                                        <field name="extra_discount_percentage" string="Extra Discount %"/>
                                        <field name="taxes_ids" widget="many2many_tags" width="65px"/>
                                        <field name="unit_taxes_value"/>
                                        <field name="line_taxes_value" sum="∑ Taxes"/>
                                        <field name="line_cost" width="75px" string="∑ Cost" sum="∑ Cost"/>
                                        <field name="notice_qty" width="75px" optional="hide"/>
                                        <field name="net_qty" width="60px" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Description">
                                <group>
                                    <field name="description" nolabel="1" placeholder="Write your feedback here"/>
                                </group>
                            </page>
                        </notebook>
                        <field name="net_invoice" invisible="1"/>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="ab_purchase_header_view_tree" model="ir.ui.view">
            <field name="name">ab_purchase_header_view_tree</field>
            <field name="model">ab_purchase_header</field>
            <field name="arch" type="xml">
                <list string="ab_purchase_header_tree">
                    <field name="store_id"/>
                    <field name="supplier_id"/>
                    <field name="doc_code"/>
                    <field name="doc_date"/>
                    <field name="lines_count"/>
                    <field name="number_of_products"/>
                    <field name="total_price"/>
                    <field name="total_cost"/>
                    <field name="total_tax"/>
                    <field name="total_extra_discount"/>
                    <field name="net_invoice"/>
                    <field name="invoice_type"/>
                    <field name="status" widget="badge" decoration-info="status=='pending'"
                           decoration-danger="status=='rejected'" decoration-warning="status=='prepending'"
                           decoration-success="status=='saved'"/>
                    <field name="description"/>
                    <field name="create_uid" widget="many2one_avatar_user"/>
                    <field name="create_date"/>
                </list>
            </field>
        </record>

        <record id="ab_purchase_header_view_search" model="ir.ui.view">
            <field name="name">ab_purchase_header_view_search</field>
            <field name="model">ab_purchase_header</field>
            <field name="arch" type="xml">
                <search string="ab_purchase_header_search">
                    <field name="doc_code"/>
                    <field name="store_id"/>
                    <field name="supplier_id"/>
                    <field name="id"/>
                    <field name="doc_date"/>
                    <field name="net_invoice"/>
                    <field name="net_tax"/>
                    <field name="description"/>
                    <field name="status"/>
                    <field name="invoice_type"/>
                </search>
            </field>
        </record>


        <record id="ab_purchase_header_action" model="ir.actions.act_window">
            <field name="name">Purchase Invoices</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_purchase_header</field>
            <field name="view_mode">list,form,graph,pivot</field>
            <field name="context">{'uom_only_type': True}</field>
            <field name="view_id" ref="ab_purchase_header_view_tree"/>
        </record>
        <menuitem id="ab_purchase_header_menu" name="Purchase Invoices" parent="purchase_sub_menu"
                  action="ab_purchase_header_action" sequence="1"/>

        <record id="ab_purchase_header_view_form_layout" model="ir.ui.view">
            <field name="name">ab_purchase_header_view_form.layout</field>
            <field name="model">ab_purchase_header</field>
            <field name="inherit_id" ref="ab_purchase_header_view_form"/>
            <field name="priority">90</field>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="after">
                    <div name="ab_purchase_header_view_form_totals" class="row g-3 mb-4">
                        <div class="col-12 col-md-6 col-xl-4" name="ab_purchase_header_view_form_layout_1"/>
                        <div class="col-12 col-md-6 col-xl-4" name="ab_purchase_header_view_form_layout_2"/>
                        <div class="col-12 col-md-6 col-xl-4" name="ab_purchase_header_view_form_layout_3"/>
                    </div>
                </xpath>
                <xpath expr="//*[@name=&quot;ab_purchase_header_view_form_layout_1&quot;]" position="inside">
                    <xpath expr="//div[@name=&quot;button_box&quot;]/button[@name=&quot;compute_totals&quot;][.//field[@name=&quot;total_price&quot;]]" position="move"/>
                </xpath>
                <xpath expr="//*[@name=&quot;ab_purchase_header_view_form_layout_2&quot;]" position="inside">
                    <xpath expr="//div[@name=&quot;button_box&quot;]/button[@name=&quot;compute_totals&quot;][.//field[@name=&quot;total_cost&quot;]]" position="move"/>
                </xpath>
                <xpath expr="//*[@name=&quot;ab_purchase_header_view_form_layout_3&quot;]" position="inside">
                    <xpath expr="//div[@name=&quot;button_box&quot;]/button[@name=&quot;compute_totals&quot;][.//field[@name=&quot;number_of_products&quot;]]" position="move"/>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//button)[not(@class=&quot;btn btn-light border rounded d-flex align-items-center gap-3 text-start w-100 h-100 p-3&quot;)]" position="attributes">
                    <attribute name="width"/>
                    <attribute name="class">btn btn-light border rounded d-flex align-items-center gap-3 text-start w-100 h-100 p-3</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//button)[not(@class=&quot;btn btn-light border rounded d-flex align-items-center gap-3 text-start w-100 h-100 p-3&quot;)]" position="attributes">
                    <attribute name="width"/>
                    <attribute name="class">btn btn-light border rounded d-flex align-items-center gap-3 text-start w-100 h-100 p-3</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//button)[not(@class=&quot;btn btn-light border rounded d-flex align-items-center gap-3 text-start w-100 h-100 p-3&quot;)]" position="attributes">
                    <attribute name="width"/>
                    <attribute name="class">btn btn-light border rounded d-flex align-items-center gap-3 text-start w-100 h-100 p-3</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//button/div[span[@class=&quot;o_stat_text&quot;]])[not(@class=&quot;d-flex flex-column text-muted small&quot;)]" position="attributes">
                    <attribute name="class">d-flex flex-column text-muted small</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//button/div[span[@class=&quot;o_stat_text&quot;]])[not(@class=&quot;d-flex flex-column text-muted small&quot;)]" position="attributes">
                    <attribute name="class">d-flex flex-column text-muted small</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//button/div[span[@class=&quot;o_stat_text&quot;]])[not(@class=&quot;d-flex flex-column text-muted small&quot;)]" position="attributes">
                    <attribute name="class">d-flex flex-column text-muted small</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//button/div[span[@class=&quot;o_stat_value&quot;]])[not(@class=&quot;d-flex flex-column ms-auto text-end fw-semibold&quot;)]" position="attributes">
                    <attribute name="class">d-flex flex-column ms-auto text-end fw-semibold</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//button/div[span[@class=&quot;o_stat_value&quot;]])[not(@class=&quot;d-flex flex-column ms-auto text-end fw-semibold&quot;)]" position="attributes">
                    <attribute name="class">d-flex flex-column ms-auto text-end fw-semibold</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//button/div[span[@class=&quot;o_stat_value&quot;]])[not(@class=&quot;d-flex flex-column ms-auto text-end fw-semibold&quot;)]" position="attributes">
                    <attribute name="class">d-flex flex-column ms-auto text-end fw-semibold</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//span[@class=&quot;o_stat_text&quot;])[not(@class=&quot;d-block text-wrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-wrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//span[@class=&quot;o_stat_text&quot;])[not(@class=&quot;d-block text-wrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-wrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//span[@class=&quot;o_stat_text&quot;])[not(@class=&quot;d-block text-wrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-wrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//span[@class=&quot;o_stat_text&quot;])[not(@class=&quot;d-block text-wrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-wrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//span[@class=&quot;o_stat_text&quot;])[not(@class=&quot;d-block text-wrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-wrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//span[@class=&quot;o_stat_text&quot;])[not(@class=&quot;d-block text-wrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-wrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//span[@class=&quot;o_stat_value&quot;])[not(@class=&quot;d-block text-nowrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-nowrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//span[@class=&quot;o_stat_value&quot;])[not(@class=&quot;d-block text-nowrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-nowrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//span[@class=&quot;o_stat_value&quot;])[not(@class=&quot;d-block text-nowrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-nowrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//span[@class=&quot;o_stat_value&quot;])[not(@class=&quot;d-block text-nowrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-nowrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//span[@class=&quot;o_stat_value&quot;])[not(@class=&quot;d-block text-nowrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-nowrap</attribute>
                </xpath>
                <xpath expr="(//div[@name=&quot;ab_purchase_header_view_form_totals&quot;]//span[@class=&quot;o_stat_value&quot;])[not(@class=&quot;d-block text-nowrap&quot;)]" position="attributes">
                    <attribute name="class">d-block text-nowrap</attribute>
                </xpath>
                <xpath expr="(//widget[@name=&quot;web_ribbon&quot;])[not(@class=&quot;position-relative&quot;)]" position="attributes">
                    <attribute name="class">position-relative</attribute>
                    <attribute name="style">height: 6rem; --Ribbon-wrapper-width: 6rem; --Ribbon-font-size: .75rem; --Ribbon-height: 1.75rem;</attribute>
                </xpath>
                <xpath expr="(//widget[@name=&quot;web_ribbon&quot;])[not(@class=&quot;position-relative&quot;)]" position="attributes">
                    <attribute name="class">position-relative</attribute>
                    <attribute name="style">height: 6rem; --Ribbon-wrapper-width: 6rem; --Ribbon-font-size: .75rem; --Ribbon-height: 1.75rem;</attribute>
                </xpath>
                <xpath expr="(//widget[@name=&quot;web_ribbon&quot;])[not(@class=&quot;position-relative&quot;)]" position="attributes">
                    <attribute name="class">position-relative</attribute>
                    <attribute name="style">height: 6rem; --Ribbon-wrapper-width: 6rem; --Ribbon-font-size: .75rem; --Ribbon-height: 1.75rem;</attribute>
                </xpath>
                <xpath expr="//div[@name='ab_purchase_header_view_form_totals']" position="before">
                    <xpath expr="//widget[@name=&quot;web_ribbon&quot;][@bg_color=&quot;bg-danger&quot;]" position="move"/>
                    <xpath expr="//widget[@name=&quot;web_ribbon&quot;][@bg_color=&quot;bg-success&quot;]" position="move"/>
                    <xpath expr="//widget[@name=&quot;web_ribbon&quot;][@bg_color=&quot;bg-info&quot;]" position="move"/>
                </xpath>
                <xpath expr="//div[@class='oe_chatter']" position="replace">
                    <chatter/>
                </xpath>
                <xpath expr="(//sheet/notebook)[not(@class=&quot;w-100 mw-100&quot;)]" position="attributes">
                    <attribute name="class">w-100 mw-100</attribute>
                </xpath>
                <xpath expr="(//sheet/notebook/page/field[list])[not(@class=&quot;w-100 mw-100&quot;)]" position="attributes">
                    <attribute name="nolabel">1</attribute>
                    <attribute name="class">w-100 mw-100</attribute>
                </xpath>
                <xpath expr="(//list/field[@invisible=&quot;1&quot;])[not(@column_invisible=&quot;True&quot;)]" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>
                <xpath expr="(//list/field[@invisible=&quot;1&quot;])[not(@column_invisible=&quot;True&quot;)]" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>
                <xpath expr="(//group/div[field or div/field[@name=&quot;total_extra_discount&quot;]])[not(@class=&quot;d-flex flex-wrap align-items-center gap-3&quot;)]" position="attributes">
                    <attribute name="class">d-flex flex-wrap align-items-center gap-3</attribute>
                </xpath>
                <xpath expr="//form" position="attributes">
                    <attribute name="class" add="ab_purchase_header_view_layout" separator=" "/>
                </xpath>
                <xpath expr="//form" position="inside">
                    <style>
                            .ab_purchase_header_view_layout .o_notebook,
                            .ab_purchase_header_view_layout .o_notebook_content,
                            .ab_purchase_header_view_layout .tab-pane,
                            .ab_purchase_header_view_layout .o_field_widget.o_field_one2many,
                            .ab_purchase_header_view_layout .o_field_widget.o_field_many2many,
                            .ab_purchase_header_view_layout .o_field_x2many {
                                min-width: 0;
                                max-width: 100%;
                                overflow: visible !important;
                            }
                            .ab_purchase_header_view_layout .o_field_x2many .o_list_renderer.table-responsive {
                                width: 100%;
                                max-width: 100%;
                                margin-inline: 0 !important;
                                overflow-x: auto !important;
                                overflow-y: auto !important;
                            }
                        </style>
                </xpath>
                <xpath expr="//field[@name=&quot;line_ids&quot;]" position="attributes">
                    <attribute name="invisible">False</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
