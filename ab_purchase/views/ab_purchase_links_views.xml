<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ab_purchase_header_menu" model="ir.ui.menu">
        <field name="action" ref="ab_purchase_header_action"/>
    </record>
    <record id="ab_purchase_notice_header_menu" model="ir.ui.menu">
        <field name="name">Returns</field>
        <field name="action" ref="ab_purchase_notice_header_action"/>
    </record>
    <record id="ab_purchase_notices_menu" model="ir.ui.menu">
        <field name="name">Returns</field>
    </record>
    <record id="ab_purchase_notice_header_action" model="ir.actions.act_window">
        <field name="name">Returns</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['&amp;', '|', ('notice_effect', '=', False), ('notice_effect', '=', 'physical'), ('notice_type', '=', 'credit_notice')]</field>
        <field name="context">{'uom_only_type': 1, 'default_notice_effect': 'physical', 'default_notice_type': 'credit_notice'}</field>
    </record>
    <record id="ab_purchase_financial_notice_action" model="ir.actions.act_window">
        <field name="name">Financial Notices</field>
        <field name="res_model">ab_purchase_notice_header</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('notice_effect', '=', 'financial')]</field>
        <field name="context">{'uom_only_type': 1, 'default_notice_effect': 'financial', 'default_notice_type': 'debit_notice'}</field>
    </record>
    <menuitem id="ab_purchase_financial_notice_menu" name="Financial Notices"
              parent="ab_purchase_notices_menu"
              action="ab_purchase_financial_notice_action"
              sequence="3"/>
    <record id="purchase_list_links" model="ir.ui.view">
        <field name="name">purchase_list_links</field>
        <field name="model">ab_purchase_header</field>
        <field name="inherit_id" ref="ab_purchase_header_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="return_count" optional="show"/>
                <field name="returned_value" optional="show" sum="Returned Value"/>
                <field name="retained_value" optional="hide" sum="Retained Value"/>
            </xpath>
        </field>
    </record>
    <record id="return_list_links" model="ir.ui.view">
        <field name="name">return_list_links</field>
        <field name="model">ab_purchase_notice_header</field>
        <field name="inherit_id" ref="ab_purchase_notice_header_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='purchase_header_id']" position="after">
                <field name="store_id" optional="show"/>
            </xpath>
        </field>
    </record>
    <record id="purchase_form_links" model="ir.ui.view">
        <field name="name">purchase_form_links</field>
        <field name="model">ab_purchase_header</field>
        <field name="inherit_id" ref="ab_purchase_header_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes"><attribute name="string">Purchase Invoice</attribute></xpath>
            <xpath expr="//header/button[@name='btn_submit_inventory']" position="attributes">
                <attribute name="invisible">status != 'prepending'</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_returns" type="object" class="oe_stat_button" icon="fa-undo">
                    <field name="return_count" widget="statinfo"/>
                </button>
                <button name="action_view_inventory" type="object" class="oe_stat_button" icon="fa-cubes" string="Inventory Movements"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_return" type="object" string="Create Return"
                        invisible="status != 'saved'" groups="ab_purchase.group_ab_purchase_manager,base.group_system"/>
                <button name="action_create_financial_notice" type="object" string="Create Financial Notice"
                        invisible="status != 'saved'" groups="ab_purchase.group_ab_purchase_manager,base.group_system"/>
            </xpath>
            <xpath expr="//group/field[@name='supplier_id']" position="attributes">
                <attribute name="readonly">status != 'prepending'</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list" position="inside">
                <field name="returned_qty" optional="hide"/>
                <field name="returned_bonus" optional="hide"/>
                <field name="returnable_qty" optional="hide"/>
                <field name="returnable_bonus" optional="hide"/>
            </xpath>
            <xpath expr="//group/field[@name='net_tax']" position="after">
                <field name="returned_value" readonly="1"/>
                <field name="retained_value" readonly="1"/>
            </xpath>
        </field>
    </record>
    <record id="return_form_links" model="ir.ui.view">
        <field name="name">return_form_links</field>
        <field name="model">ab_purchase_notice_header</field>
        <field name="inherit_id" ref="ab_purchase_notice_header_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes"><attribute name="string">Purchase Notice</attribute></xpath>
            <xpath expr="//page[field[@name='line_ids']]" position="attributes"><attribute name="string">Notice Lines</attribute></xpath>
            <xpath expr="//group/field[@name='purchase_header_id']" position="after">
                <field name="store_id" readonly="1"/>
            </xpath>
            <xpath expr="//group/field[@name='supplier_id']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>
            <xpath expr="//group/field[@name='doc_code']" position="attributes">
                <attribute name="readonly">status == 'saved'</attribute>
            </xpath>
            <xpath expr="//group/field[@name='doc_date']" position="attributes">
                <attribute name="readonly">status == 'saved'</attribute>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='source_id']" position="replace">
                <field name="purchase_line_id" domain="[('header_id', '=', parent.purchase_header_id)]"
                       options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='source_id_domain']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_inventory" type="object" class="oe_stat_button" icon="fa-cubes"
                        string="Inventory Movements" invisible="notice_effect == 'financial'"/>
            </xpath>
            <xpath expr="//form" position="inside"><chatter/></xpath>
        </field>
    </record>
    <record id="return_line_form_link" model="ir.ui.view">
        <field name="name">return_line_form_link</field>
        <field name="model">ab_purchase_notice_line</field>
        <field name="inherit_id" ref="ab_purchase_notice_line_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_id']" position="replace">
                <field name="header_id"/>
                <field name="purchase_header_id" invisible="1"/>
                <field name="purchase_line_id" domain="[('header_id', '=', purchase_header_id)]" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
