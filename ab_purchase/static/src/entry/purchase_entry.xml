<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ab_purchase.DataEntry">
        <div class="o_ab_entry_window">
            <header class="o_ab_entry_top"><div><span class="o_ab_entry_mark"><i class="fa fa-keyboard-o"/></span><div><h1>Data Entry</h1><span>Purchases and supplier returns</span></div></div><span class="o_ab_entry_badge" t-if="state.dirty">Unsaved changes</span><span class="o_ab_entry_badge is-clean" t-else="">Draft workspace</span></header>
            <div t-if="state.loading" class="o_ab_entry_empty"><i class="fa fa-spinner fa-spin"/> Loading</div>
            <div t-elif="state.error" class="o_ab_entry_empty"><p>Could not load Data Entry.</p><button class="btn btn-primary" t-on-click="start">Retry</button></div>
            <div t-else="" class="o_ab_entry_body">
                <aside class="o_ab_entry_sidebar">
                    <h2>Entry type</h2><button t-att-class="state.kind === 'purchase' ? 'is-active' : ''" t-on-click="() => this.newDocument('purchase')" t-att-disabled="state.saving"><i class="fa fa-shopping-cart"/> Purchase</button><button t-att-class="state.kind === 'return' ? 'is-active' : ''" t-on-click="() => this.newDocument('return')" t-att-disabled="state.saving"><i class="fa fa-undo"/> Return</button>
                    <div class="o_ab_entry_queue_title"><h2>Recent drafts</h2><button t-on-click="() => this.newDocument()" t-att-disabled="state.saving" title="New document"><i class="fa fa-plus"/></button></div>
                    <p t-if="!state.config.drafts.length" class="o_ab_entry_muted">No drafts yet</p>
                    <div class="o_ab_entry_queue"><button t-foreach="state.config.drafts" t-as="draft" t-key="draft.kind + draft.id" t-on-click="() => this.loadDraft(draft)" t-att-disabled="state.saving" t-att-class="draft.id === state.doc.id &amp;&amp; draft.kind === state.kind ? 'is-selected' : ''"><span><i t-att-class="draft.kind === 'return' ? 'fa fa-undo' : 'fa fa-file-text-o'"/> <strong t-esc="draft.code"/></span><small t-esc="draft.supplier"/><small t-esc="draft.store"/></button></div>
                    <div class="o_ab_entry_safety"><i class="fa fa-shield"/><span>Drafts only. Managers review and post stock.</span></div>
                </aside>
                <form class="o_ab_entry_form" t-on-submit.prevent="() => this.save()">
                    <fieldset t-att-disabled="state.saving" class="o_ab_entry_fields">
                        <section class="o_ab_entry_document">
                            <div class="o_ab_entry_section_head"><div><span class="o_ab_entry_kicker">Document details</span><h2 t-if="state.kind === 'purchase'">Purchase invoice</h2><h2 t-else="">Supplier return</h2></div><span class="o_ab_entry_doc_ref" t-esc="state.doc.id ? '#' + state.doc.id : '—'"/></div>
                            <div class="o_ab_entry_header_grid">
                                <label><span>Store</span><select class="form-select" required="required" t-att-value="state.doc.store_id" t-att-disabled="state.kind === 'return' &amp;&amp; !!state.doc.id" t-on-change="(event) => this.setHeader('store_id', event)"><option value="">Select store</option><option t-foreach="state.config.stores" t-as="store" t-key="store.id" t-att-value="store.id" t-att-selected="store.id === state.doc.store_id" t-esc="store.name"/></select></label>
                                <label class="o_ab_entry_lookup o_ab_entry_supplier" t-if="state.kind === 'purchase'"><span>Supplier</span><AutoComplete t-props="supplierAutocompleteProps"/></label>
                                <label class="o_ab_entry_lookup" t-else=""><span>Original invoice</span><input class="form-control" required="required" autocomplete="off" placeholder="Search saved invoices" t-att-value="state.invoiceQuery" t-att-disabled="!!state.doc.id" t-on-input="(event) => this.lookup('invoice', event)"/><div t-if="state.invoices.length" class="o_ab_entry_results"><button type="button" t-foreach="state.invoices" t-as="invoice" t-key="invoice.id" t-on-click="() => this.selectInvoice(invoice)"><strong t-esc="invoice.name"/><small t-esc="invoice.supplier"/></button></div></label>
                                <label><span>Document number</span><input class="form-control" required="required" t-ref="documentNumber" t-att-value="state.doc.doc_code" t-on-keydown="documentKeydown" t-on-input="(event) => this.setHeader('doc_code', event)"/></label>
                                <label><span>Date</span><input class="form-control" required="required" type="date" t-att-value="state.doc.doc_date" t-on-change="(event) => this.setHeader('doc_date', event)"/></label>
                                <label t-if="state.kind === 'purchase'"><span>Invoice type</span><select class="form-select" t-att-value="state.doc.invoice_type" t-on-change="(event) => this.setHeader('invoice_type', event)"><option value="medical">Medical</option><option value="cosmetics">Cosmetics</option><option value="bonus">Bonus</option></select></label>
                                <label t-if="state.kind === 'purchase'"><span>Supplier invoice total</span><input type="number" min="0" step="0.001" class="form-control" t-att-value="state.doc.net_invoice" t-on-input="(event) => this.setHeader('net_invoice', event)"/></label>
                                <label t-if="state.kind === 'purchase'"><span>Supplier tax total</span><input type="number" min="0" step="0.001" class="form-control" t-att-value="state.doc.net_tax" t-on-input="(event) => this.setHeader('net_tax', event)"/></label>
                                <label t-if="state.kind === 'purchase'"><span>Invoice discount</span><input type="number" min="0" step="0.001" class="form-control" t-att-value="state.doc.total_extra_discount" t-on-input="(event) => this.setHeader('total_extra_discount', event)"/></label>
                                <label t-else=""><span>Supplier</span><input class="form-control" readonly="readonly" t-att-value="state.doc.supplier"/></label>
                            </div>
                        </section>
                        <section class="o_ab_entry_lines">
                            <div class="o_ab_entry_section_head"><div><h2>Product lines</h2><span class="o_ab_entry_muted"><t t-esc="state.doc.lines.length"/> lines</span></div></div>
                            <div t-if="state.kind === 'purchase'" class="o_ab_entry_catalog">
                                <div class="o_ab_entry_catalog_search">
                                    <i class="fa fa-search" aria-hidden="true"/>
                                    <input class="form-control" t-ref="productSearch" autocomplete="off" aria-label="Search product name or code" placeholder="Search product name or code" t-att-value="state.productQuery" t-on-keydown="productKeydown" t-on-input="searchProducts"/>
                                    <span t-if="state.productLoading" class="o_ab_entry_catalog_spinner"><i class="fa fa-spinner fa-spin" aria-hidden="true"/></span>
                                </div>
                                <div t-if="state.productQuery.trim()" class="o_ab_entry_catalog_label"><span>Search results</span><strong t-if="state.productSearched" t-esc="state.products.length"/></div>
                                <div t-if="state.products.length" class="o_ab_entry_catalog_results" t-ref="catalogResults">
                                    <button type="button" t-foreach="state.products" t-as="product" t-key="product.id" t-att-class="product_index === state.productIndex ? 'is-active' : ''" t-on-click="() => this.chooseProduct(product)">
                                        <span class="o_ab_entry_catalog_product"><strong t-esc="product.name"/><small t-esc="product.code"/></span>
                                        <span class="o_ab_entry_catalog_prices"><small>Purchase price <strong t-esc="money(product.purchase_price)"/></small><small>Sale price <strong t-esc="money(product.price)"/></small></span>
                                        <i class="fa fa-plus" aria-hidden="true"/>
                                    </button>
                                </div>
                                <div t-elif="state.productLoading" class="o_ab_entry_catalog_empty">Searching products...</div>
                                <div t-elif="state.productSearched" class="o_ab_entry_catalog_empty">No products found.</div>
                            </div>
                            <div t-if="state.kind === 'purchase'" class="o_ab_entry_keyboard_hint">Enter: quantity → sale price → purchase price → add. Ctrl+Enter: add with current values.</div>
                            <div t-if="state.quick" class="o_ab_entry_quick">
                                <div class="o_ab_entry_quick_product"><strong t-esc="state.quick.name"/><small t-esc="state.quick.code"/></div>
                                <label><span>Unit</span><select class="form-select" aria-label="Entry unit" t-on-change="(event) => this.setLine(state.quick, 'uom_id', event)"><option t-foreach="state.quick.units" t-as="unit" t-key="unit.id" t-att-value="unit.id" t-att-selected="unit.id === state.quick.uom_id" t-esc="unit.name"/></select></label>
                                <label><span>Quantity</span><input class="form-control" type="number" min="0" step="0.01" aria-label="Entry quantity" t-ref="quickQty" t-att-value="state.quick.qty" t-on-input="(event) => this.setLine(state.quick, 'qty', event)" t-on-keydown="(event) => this.quickKeydown(event, 'quickSale')"/></label>
                                <div class="o_ab_entry_quick_price"><label for="o_ab_entry_quick_sale"><span>Sale price</span></label><div class="o_ab_entry_price_cell"><input id="o_ab_entry_quick_sale" class="form-control" type="number" min="0" step="0.001" aria-label="Entry sale price" t-ref="quickSale" t-att-value="state.quick.price" t-on-input="(event) => this.setLine(state.quick, 'price', event)" t-on-keydown="(event) => this.quickKeydown(event, 'quickPurchase')"/><button type="button" class="o_ab_entry_reverse_btn" title="Sale price calculator" aria-label="Sale price calculator" t-on-click="() => this.openSaleCalculator(state.quick, true)"><i class="fa fa-calculator" aria-hidden="true"/></button></div></div>
                                <div class="o_ab_entry_quick_price"><label for="o_ab_entry_quick_purchase"><span>Purchase price</span></label><div class="o_ab_entry_price_cell"><input id="o_ab_entry_quick_purchase" class="form-control" type="number" min="0" step="0.001" aria-label="Entry purchase price" t-ref="quickPurchase" t-att-value="state.quick.purchase_price" t-on-input="(event) => this.setLine(state.quick, 'purchase_price', event)" t-on-keydown="(event) => this.quickKeydown(event)"/><button type="button" class="o_ab_entry_reverse_btn" title="Cost calculator" aria-label="Cost calculator" t-on-click="() => this.openReverseCalculator(state.quick, true)"><i class="fa fa-calculator" aria-hidden="true"/></button></div></div>
                                <label><span>Bonus</span><input class="form-control" type="number" min="0" step="1" aria-label="Entry bonus" t-att-value="state.quick.bonus" t-on-input="(event) => this.setLine(state.quick, 'bonus', event)" t-on-keydown="(event) => this.quickKeydown(event)"/></label>
                                <div class="o_ab_entry_quick_taxes"><span>Taxes</span><t t-call="ab_purchase.EntryTaxes"><t t-set="line" t-value="state.quick"/></t></div>
                                <button type="button" class="btn btn-primary o_ab_entry_add_btn" title="Add line" aria-label="Add line" t-on-click="commitProduct"><i class="fa fa-plus" aria-hidden="true"/></button>
                            </div>
                            <div t-if="!state.doc.lines.length" class="o_ab_entry_empty"><i class="fa fa-list-alt"/><h3>Add your first product</h3><p t-if="state.kind === 'purchase'">Search for a product above to begin entering the invoice.</p><p t-else="">Select a saved purchase invoice to load its returnable products.</p></div>
                            <div t-else="" class="o_ab_entry_grid_wrap"><table class="o_ab_entry_grid" t-on-keydown="gridKeydown"><thead><tr><th>Product</th><th>Unit</th><th>Quantity</th><th t-if="state.kind === 'purchase'">Sale price</th><th t-if="state.kind === 'purchase'">Purchase price</th><th>Bonus</th><th t-if="state.kind === 'purchase'">Discount %</th><th t-if="state.kind === 'purchase'">Taxes</th><th t-if="state.kind === 'purchase'">Expiry</th><th t-if="state.kind === 'return'">Available</th><th>Line cost</th><th/></tr></thead><tbody>
                                <tr t-foreach="state.doc.lines" t-as="line" t-key="line.key"><td class="o_ab_entry_product"><strong t-esc="line.name"/><small t-esc="line.code"/></td><td><select t-if="state.kind === 'purchase'" class="form-select" aria-label="Unit" t-on-change="(event) => this.setLine(line, 'uom_id', event)"><option t-foreach="line.units" t-as="unit" t-key="unit.id" t-att-value="unit.id" t-att-selected="unit.id === line.uom_id" t-esc="unit.name"/></select><span t-else="" t-esc="line.unit"/></td><td><input type="number" min="0" step="0.01" class="form-control" aria-label="Quantity" t-att-max="state.kind === 'return' ? line.available_qty : undefined" t-att-value="line.qty" t-on-input="(event) => this.setLine(line, 'qty', event)"/></td>
                                <td t-if="state.kind === 'purchase'"><div class="o_ab_entry_price_cell"><input type="number" min="0" step="0.001" aria-label="Sale price" class="form-control" t-att-value="line.price" t-on-input="(event) => this.setLine(line, 'price', event)"/><button type="button" class="o_ab_entry_reverse_btn" title="Sale price calculator" aria-label="Sale price calculator" t-on-click="() => this.openSaleCalculator(line)"><i class="fa fa-calculator" aria-hidden="true"/></button></div></td><td t-if="state.kind === 'purchase'"><div class="o_ab_entry_price_cell"><input type="number" min="0" step="0.001" aria-label="Purchase price" class="form-control" t-att-value="line.purchase_price" t-on-input="(event) => this.setLine(line, 'purchase_price', event)"/><button type="button" class="o_ab_entry_reverse_btn" title="Cost calculator" aria-label="Cost calculator" t-on-click="() => this.openReverseCalculator(line)"><i class="fa fa-calculator" aria-hidden="true"/></button></div></td><td><input type="number" min="0" step="1" class="form-control" aria-label="Bonus" t-att-max="state.kind === 'return' ? line.available_bonus : undefined" t-att-value="line.bonus" t-on-input="(event) => this.setLine(line, 'bonus', event)"/></td><td t-if="state.kind === 'purchase'"><input type="number" min="0" max="100" step="0.001" aria-label="Discount percent" class="form-control" t-att-value="line.extra_discount_percentage" t-on-input="(event) => this.setLine(line, 'extra_discount_percentage', event)"/></td><td t-if="state.kind === 'purchase'"><t t-call="ab_purchase.EntryTaxes"/></td><td t-if="state.kind === 'purchase'"><input type="date" class="form-control" aria-label="Expiry" t-att-value="line.exp_date" t-on-change="(event) => this.setLine(line, 'exp_date', event)"/></td><td t-if="state.kind === 'return'"><strong t-esc="line.available_qty"/><small><t t-esc="line.available_bonus"/> bonus</small></td><td class="o_ab_entry_amount" t-esc="money(lineTotals(line).cost)"/><td><button type="button" class="o_ab_entry_remove" title="Remove line" t-on-click="() => this.removeLine(line)"><i class="fa fa-times"/></button></td></tr>
                            </tbody></table></div>
                        </section>
                        <section class="o_ab_entry_notes"><label><span>Notes</span><textarea class="form-control" rows="2" t-att-value="state.doc.description" t-on-input="(event) => this.setHeader('description', event)"/></label></section>
                    </fieldset>
                    <footer class="o_ab_entry_footer"><div class="o_ab_entry_totals"><div><span>Total cost</span><strong t-esc="money(totals.cost)"/></div><div><span>Total taxes</span><strong t-esc="money(totals.tax)"/></div><div t-if="state.kind === 'purchase'"><span>Invoice difference</span><strong t-att-class="Math.abs(state.doc.net_invoice - totals.cost) &gt; 0.5 ? 'text-danger' : 'text-success'" t-esc="money(state.doc.net_invoice - totals.cost)"/></div><div t-if="state.kind === 'purchase'"><span>Tax difference</span><strong t-att-class="Math.abs(state.doc.net_tax - totals.tax) &gt; 0.5 ? 'text-danger' : 'text-success'" t-esc="money(state.doc.net_tax - totals.tax)"/></div></div><div class="o_ab_entry_save"><button type="button" class="btn btn-outline-secondary" t-on-click="() => this.newDocument()" t-att-disabled="state.saving">New</button><button type="submit" class="btn btn-primary" t-att-disabled="state.saving || (!state.doc.lines.length &amp;&amp; !state.quick)"><i t-att-class="state.saving ? 'fa fa-spinner fa-spin me-2' : 'fa fa-save me-2'"/>Save draft</button><span t-if="!state.config.can_submit" class="o_ab_entry_muted">Manager only</span><button type="button" class="btn btn-success" t-on-click="submit" t-att-disabled="!state.config.can_submit || state.saving || (!state.doc.lines.length &amp;&amp; !state.quick)"><i class="fa fa-check me-2"/><t t-if="state.kind === 'purchase'">Submit invoice</t><t t-else="">Post return</t></button></div></footer>
                    <div t-if="state.calculator" class="o_ab_entry_calculator_overlay" t-on-keydown="calculatorKeydown">
                        <div class="o_ab_entry_calculator" role="dialog" aria-modal="true" aria-labelledby="o_ab_entry_calculator_title">
                            <div class="o_ab_entry_calculator_head"><div><h2 t-if="state.calculator.kind === 'cost'" id="o_ab_entry_calculator_title">Cost calculator</h2><h2 t-else="" id="o_ab_entry_calculator_title">Sale price calculator</h2><small t-esc="calculatorLine() ? calculatorLine().name : ''"/></div><button type="button" class="o_ab_entry_remove" aria-label="Close" t-on-click="closeReverseCalculator"><i class="fa fa-times"/></button></div>
                            <p t-if="state.calculator.kind === 'cost'" class="o_ab_entry_muted">Enter the line total including tax, before the invoice discount. Discounts apply in sequence.</p>
                            <p t-else="" class="o_ab_entry_muted">Enter the total sale amount for the paid quantity. Bonus units are excluded.</p>
                            <label><span t-if="state.calculator.kind === 'cost'">Line total cost</span><span t-else="">Line sale total</span><input class="form-control" type="number" min="0.001" step="0.001" t-ref="reverseTotal" t-att-value="state.calculator.total" t-on-input="setCalculatorTotal"/></label>
                            <t t-if="state.calculator.kind === 'cost'">
                                <div class="o_ab_entry_calculator_discounts"><strong>Discounts</strong><button type="button" class="btn btn-outline-secondary btn-sm" t-on-click="addCalculatorDiscount">Add discount</button></div>
                                <div class="o_ab_entry_calculator_rates"><div t-foreach="state.calculator.discounts" t-as="discount" t-key="discount_index" class="o_ab_entry_calculator_rate"><label><span>Discount <t t-esc="discount_index + 1"/> %</span><input class="form-control" type="number" min="0" max="99.999" step="0.001" t-att-value="discount" t-on-input="(event) => this.setCalculatorDiscount(discount_index, event)"/></label><button type="button" class="o_ab_entry_remove" aria-label="Remove discount" t-att-disabled="state.calculator.discounts.length === 1" t-on-click="() => this.removeCalculatorDiscount(discount_index)"><i class="fa fa-times"/></button></div></div>
                                <div t-if="calculatorPreview" class="o_ab_entry_calculator_preview"><div><span>Unit purchase price</span><strong t-esc="money(calculatorPreview.purchasePrice)"/></div><div><span>Unit cost including tax</span><strong t-esc="money(calculatorPreview.unitCost)"/></div><div><span>Effective discount</span><strong><t t-esc="calculatorPreview.effectiveDiscount"/>%</strong></div><div><span>Calculated line total</span><strong t-esc="money(calculatorPreview.calculatedTotal)"/></div><div><span>Difference after rounding</span><strong t-att-class="Math.abs(calculatorPreview.difference) &gt; 0.005 ? 'text-danger' : ''" t-esc="money(calculatorPreview.difference)"/></div></div>
                                <p t-else="" class="o_ab_entry_calculator_error">Enter a positive line total and paid quantity. Each discount must be below 100%.</p>
                            </t>
                            <t t-else="">
                                <div t-if="saleCalculatorPreview" class="o_ab_entry_calculator_preview"><div><span>Unit sale price</span><strong t-esc="money(saleCalculatorPreview.salePrice)"/></div><div><span>Calculated line sale total</span><strong t-esc="money(saleCalculatorPreview.calculatedTotal)"/></div><div><span>Difference after rounding</span><strong t-att-class="Math.abs(saleCalculatorPreview.difference) &gt; 0.005 ? 'text-danger' : ''" t-esc="money(saleCalculatorPreview.difference)"/></div></div>
                                <p t-else="" class="o_ab_entry_calculator_error">Enter a positive sale total and paid quantity.</p>
                            </t>
                            <div class="o_ab_entry_calculator_actions"><button type="button" class="btn btn-outline-secondary" t-on-click="closeReverseCalculator">Cancel</button><button t-if="state.calculator.kind === 'cost'" type="button" class="btn btn-primary" t-att-disabled="!calculatorPreview" t-on-click="applyReverseCost">Apply unit price</button><button t-else="" type="button" class="btn btn-primary" t-att-disabled="!saleCalculatorPreview" t-on-click="applySalePrice">Apply sale price</button></div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </t>
    <t t-name="ab_purchase.EntryTaxes">
        <details class="o_ab_entry_tax_picker">
            <summary aria-label="Select taxes"><span t-if="!line.taxes_ids.length" class="o_ab_entry_muted">Select taxes</span><span t-foreach="selectedTaxes(line)" t-as="tax" t-key="tax.id" class="o_ab_entry_tax_tag" t-esc="tax.name"/><i class="fa fa-angle-down"/></summary>
            <div class="o_ab_entry_tax_options"><span t-if="!state.config.taxes.length" class="o_ab_entry_muted">No purchase taxes available</span><label t-foreach="state.config.taxes" t-as="tax" t-key="tax.id"><input type="checkbox" t-att-checked="line.taxes_ids.includes(tax.id)" t-on-change="(event) => this.toggleTax(line, tax, event)"/><span t-esc="tax.name"/></label></div>
        </details>
    </t>
</templates>
