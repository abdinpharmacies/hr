<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="ab_purchase.DataEntry">
        <div class="o_ab_entry_window">
            <header class="o_ab_entry_top"><div><span class="o_ab_entry_mark"><i class="fa fa-keyboard-o"/></span><div><h1>Data Entry</h1><span>Purchases and supplier returns</span></div></div><span class="o_ab_entry_badge" t-if="state.dirty">Unsaved changes</span><span class="o_ab_entry_badge is-clean" t-else="">Draft workspace</span></header>
            <div t-if="state.loading" class="o_ab_entry_empty"><i class="fa fa-spinner fa-spin"/> Loading</div>
            <div t-elif="state.error" class="o_ab_entry_empty"><p>Could not load Data Entry.</p><button class="btn btn-primary" t-on-click="start">Retry</button></div>
            <div t-else="" class="o_ab_entry_body">
                <aside class="o_ab_entry_sidebar">
                    <h2>Entry type</h2><button t-att-class="state.kind === 'purchase' ? 'is-active' : ''" t-on-click="() => this.newDocument('purchase')" t-att-disabled="state.saving"><i class="fa fa-shopping-cart"/> Purchase</button><button t-att-class="state.kind === 'return' ? 'is-active' : ''" t-on-click="() => this.newDocument('return')" t-att-disabled="state.saving"><i class="fa fa-undo"/> Return</button>
                    <div class="o_ab_entry_queue_title"><h2>Recent drafts</h2><button t-on-click="() => this.newDocument()" t-att-disabled="state.saving" title="New document"><i class="fa fa-plus"/></button></div>
                    <p t-if="!state.config.drafts.length" class="o_ab_entry_muted">No drafts yet</p>
                    <div class="o_ab_entry_queue"><button t-foreach="state.config.drafts" t-as="draft" t-key="draft.kind + draft.id" t-on-click="() => this.loadDraft(draft)" t-att-disabled="state.saving" t-att-class="draft.id === state.doc.id &amp;&amp; draft.kind === state.kind ? 'is-selected' : ''"><span><i t-att-class="draft.kind === 'return' ? 'fa fa-undo' : 'fa fa-file-text-o'"/> <strong t-esc="draft.code"/></span><small t-esc="draft.supplier"/><small t-esc="draft.store"/></button></div>
                    <div class="o_ab_entry_safety"><i class="fa fa-shield"/><span>Drafts only. Managers review and post stock.</span></div>
                </aside>
                <form class="o_ab_entry_form" t-on-submit.prevent="() => this.save()">
                    <fieldset t-att-disabled="state.saving" class="o_ab_entry_fields">
                        <section class="o_ab_entry_document">
                            <div class="o_ab_entry_section_head"><div><span class="o_ab_entry_kicker">Document details</span><h2 t-if="state.kind === 'purchase'">Purchase invoice</h2><h2 t-else="">Supplier return</h2></div><span class="o_ab_entry_doc_ref" t-esc="state.doc.id ? '#' + state.doc.id : '—'"/></div>
                            <div class="o_ab_entry_header_grid">
                                <label class="o_ab_entry_lookup o_ab_entry_store" t-on-keydown.capture="storeKeydown"><span>Store</span><input t-if="state.kind === 'return' &amp;&amp; !!state.doc.id" class="form-control" readonly="readonly" t-att-value="storeLabel(currentStore())"/><AutoComplete t-else="" t-props="storeAutocompleteProps"/></label>
                                <label class="o_ab_entry_lookup o_ab_entry_supplier" t-if="state.kind === 'purchase'"><span>Supplier</span><AutoComplete t-props="supplierAutocompleteProps"/></label>
                                <label class="o_ab_entry_lookup" t-else=""><span>Original invoice</span><input class="form-control" required="required" autocomplete="off" placeholder="Search saved invoices" t-att-value="state.invoiceQuery" t-att-disabled="!!state.doc.id" t-on-input="(event) => this.lookup('invoice', event)"/><div t-if="state.invoices.length" class="o_ab_entry_results"><button type="button" t-foreach="state.invoices" t-as="invoice" t-key="invoice.id" t-on-click="() => this.selectInvoice(invoice)"><strong t-esc="invoice.name"/><small t-esc="invoice.supplier"/></button></div></label>
                                <label><span>Document number</span><input class="form-control" required="required" t-ref="documentNumber" t-att-value="state.doc.doc_code" t-on-keydown="documentKeydown" t-on-input="(event) => this.setHeader('doc_code', event)"/></label>
                                <label><span>Date</span><input class="form-control" required="required" type="date" t-att-value="state.doc.doc_date" t-on-change="(event) => this.setHeader('doc_date', event)"/></label>
                                <label t-if="state.kind === 'purchase'"><span>Invoice type</span><select class="form-select" t-att-value="state.doc.invoice_type" t-on-change="(event) => this.setHeader('invoice_type', event)"><option value="medical">Medical</option><option value="cosmetics">Cosmetics</option><option value="bonus">Bonus</option></select></label>
                                <label t-if="state.kind === 'purchase'"><span>Supplier invoice total</span><input type="number" min="0" step="0.001" class="form-control" t-att-value="state.doc.net_invoice" t-on-input="(event) => this.setHeader('net_invoice', event)"/></label>
                                <label t-if="state.kind === 'purchase'"><span>Supplier tax total</span><input type="number" min="0" step="0.001" class="form-control" t-att-value="state.doc.net_tax" t-on-input="(event) => this.setHeader('net_tax', event)"/></label>
                                <label t-if="state.kind === 'purchase'"><span>Invoice discount</span><input type="number" min="0" step="0.001" class="form-control" t-att-value="state.doc.total_extra_discount" t-on-input="(event) => this.setHeader('total_extra_discount', event)"/></label>
                                <label t-else=""><span>Supplier</span><input class="form-control" readonly="readonly" t-att-value="state.doc.supplier"/></label>
                            </div>
                        </section>
                        <section class="o_ab_entry_lines">
                            <div class="o_ab_entry_section_head"><div><h2>Product lines</h2><span class="o_ab_entry_muted"><t t-esc="state.doc.lines.length"/> lines</span></div><div t-if="state.kind === 'purchase'" class="o_ab_entry_lookup o_ab_entry_product_search"><i class="fa fa-search"/><input class="form-control" t-ref="productSearch" autocomplete="off" placeholder="Search product name or code" t-att-value="state.productQuery" t-on-keydown="productKeydown" t-on-input="(event) => this.lookup('product', event)"/><div t-if="state.products.length" class="o_ab_entry_results"><button type="button" t-foreach="state.products" t-as="product" t-key="product.id" t-att-class="product_index === state.productIndex ? 'is-active' : ''" t-on-click="() => this.chooseProduct(product)"><strong t-esc="product.name"/><small t-esc="product.code"/></button></div></div></div>
                            <div t-if="state.kind === 'purchase'" class="o_ab_entry_keyboard_hint">Enter: quantity → purchase price → selling price → add. Ctrl+Enter: add with current values.</div>
                            <div t-if="state.quick" class="o_ab_entry_quick">
                                <div class="o_ab_entry_quick_product"><strong t-esc="state.quick.name"/><small t-esc="state.quick.code"/></div>
                                <label><span>Quantity</span><input class="form-control" type="number" min="0" step="0.01" aria-label="Entry quantity" t-ref="quickQty" t-att-value="state.quick.qty" t-on-input="(event) => this.setLine(state.quick, 'qty', event)" t-on-keydown="(event) => this.quickKeydown(event, 'quickPurchase')"/></label>
                                <label><span>Purchase price</span><input class="form-control" type="number" min="0" step="0.001" aria-label="Entry purchase price" t-ref="quickPurchase" t-att-value="state.quick.purchase_price" t-on-input="(event) => this.setLine(state.quick, 'purchase_price', event)" t-on-keydown="(event) => this.quickKeydown(event, 'quickSelling')"/></label>
                                <label><span>Selling price</span><input class="form-control" type="number" min="0" step="0.001" aria-label="Entry selling price" t-ref="quickSelling" t-att-value="state.quick.price" t-on-input="(event) => this.setLine(state.quick, 'price', event)" t-on-keydown="(event) => this.quickKeydown(event)"/></label>
                                <label><span>Bonus</span><input class="form-control" type="number" min="0" step="1" aria-label="Entry bonus" t-att-value="state.quick.bonus" t-on-input="(event) => this.setLine(state.quick, 'bonus', event)" t-on-keydown="(event) => this.quickKeydown(event)"/></label>
                                <label><span>Unit</span><select class="form-select" aria-label="Entry unit" t-on-change="(event) => this.setLine(state.quick, 'uom_id', event)"><option t-foreach="state.quick.units" t-as="unit" t-key="unit.id" t-att-value="unit.id" t-att-selected="unit.id === state.quick.uom_id" t-esc="unit.name"/></select></label>
                                <div class="o_ab_entry_quick_taxes"><span>Taxes</span><t t-call="ab_purchase.EntryTaxes"><t t-set="line" t-value="state.quick"/></t></div>
                                <button type="button" class="btn btn-primary" t-on-click="commitProduct">Add line</button>
                            </div>
                            <div t-if="!state.doc.lines.length" class="o_ab_entry_empty"><i class="fa fa-list-alt"/><h3>Add your first product</h3><p t-if="state.kind === 'purchase'">Search for a product above to begin entering the invoice.</p><p t-else="">Select a saved purchase invoice to load its returnable products.</p></div>
                            <div t-else="" class="o_ab_entry_grid_wrap"><table class="o_ab_entry_grid" t-on-keydown="gridKeydown"><thead><tr><th>Product</th><th>Quantity</th><th>Bonus</th><th>Unit</th><th t-if="state.kind === 'purchase'">Selling price</th><th t-if="state.kind === 'purchase'">Purchase price</th><th t-if="state.kind === 'purchase'">Discount %</th><th t-if="state.kind === 'purchase'">Taxes</th><th t-if="state.kind === 'purchase'">Expiry</th><th t-if="state.kind === 'return'">Available</th><th>Line cost</th><th/></tr></thead><tbody>
                                <tr t-foreach="state.doc.lines" t-as="line" t-key="line.key"><td class="o_ab_entry_product"><strong t-esc="line.name"/><small t-esc="line.code"/></td><td><input type="number" min="0" step="0.01" class="form-control" aria-label="Quantity" t-att-max="state.kind === 'return' ? line.available_qty : undefined" t-att-value="line.qty" t-on-input="(event) => this.setLine(line, 'qty', event)"/></td><td><input type="number" min="0" step="1" class="form-control" aria-label="Bonus" t-att-max="state.kind === 'return' ? line.available_bonus : undefined" t-att-value="line.bonus" t-on-input="(event) => this.setLine(line, 'bonus', event)"/></td><td><select t-if="state.kind === 'purchase'" class="form-select" aria-label="Unit" t-on-change="(event) => this.setLine(line, 'uom_id', event)"><option t-foreach="line.units" t-as="unit" t-key="unit.id" t-att-value="unit.id" t-att-selected="unit.id === line.uom_id" t-esc="unit.name"/></select><span t-else="" t-esc="line.unit"/></td>
                                <td t-if="state.kind === 'purchase'"><input type="number" min="0" step="0.001" aria-label="Selling price" class="form-control" t-att-value="line.price" t-on-input="(event) => this.setLine(line, 'price', event)"/></td><td t-if="state.kind === 'purchase'"><input type="number" min="0" step="0.001" aria-label="Purchase price" class="form-control" t-att-value="line.purchase_price" t-on-input="(event) => this.setLine(line, 'purchase_price', event)"/></td><td t-if="state.kind === 'purchase'"><input type="number" min="0" max="100" step="0.001" aria-label="Discount percent" class="form-control" t-att-value="line.extra_discount_percentage" t-on-input="(event) => this.setLine(line, 'extra_discount_percentage', event)"/></td><td t-if="state.kind === 'purchase'"><t t-call="ab_purchase.EntryTaxes"/></td><td t-if="state.kind === 'purchase'"><input type="date" class="form-control" aria-label="Expiry" t-att-value="line.exp_date" t-on-change="(event) => this.setLine(line, 'exp_date', event)"/></td><td t-if="state.kind === 'return'"><strong t-esc="line.available_qty"/><small><t t-esc="line.available_bonus"/> bonus</small></td><td class="o_ab_entry_amount" t-esc="money(lineTotals(line).cost)"/><td><button type="button" class="o_ab_entry_remove" title="Remove line" t-on-click="() => this.removeLine(line)"><i class="fa fa-times"/></button></td></tr>
                            </tbody></table></div>
                        </section>
                        <section class="o_ab_entry_notes"><label><span>Notes</span><textarea class="form-control" rows="2" t-att-value="state.doc.description" t-on-input="(event) => this.setHeader('description', event)"/></label></section>
                    </fieldset>
                    <footer class="o_ab_entry_footer"><div class="o_ab_entry_totals"><div><span>Total cost</span><strong t-esc="money(totals.cost)"/></div><div><span>Total taxes</span><strong t-esc="money(totals.tax)"/></div><div t-if="state.kind === 'purchase'"><span>Invoice difference</span><strong t-att-class="Math.abs(state.doc.net_invoice - totals.cost) &gt; 0.5 ? 'text-danger' : 'text-success'" t-esc="money(state.doc.net_invoice - totals.cost)"/></div><div t-if="state.kind === 'purchase'"><span>Tax difference</span><strong t-att-class="Math.abs(state.doc.net_tax - totals.tax) &gt; 0.5 ? 'text-danger' : 'text-success'" t-esc="money(state.doc.net_tax - totals.tax)"/></div></div><div class="o_ab_entry_save"><button type="button" class="btn btn-outline-secondary" t-on-click="() => this.newDocument()" t-att-disabled="state.saving">New</button><button type="button" class="btn btn-outline-primary" t-on-click="() => this.save(true)" t-att-disabled="state.saving || (!state.doc.lines.length &amp;&amp; !state.quick)">Save and new</button><button type="submit" class="btn btn-primary" t-att-disabled="state.saving || (!state.doc.lines.length &amp;&amp; !state.quick)"><i t-att-class="state.saving ? 'fa fa-spinner fa-spin me-2' : 'fa fa-save me-2'"/>Save draft</button></div></footer>
                </form>
            </div>
        </div>
    </t>
    <t t-name="ab_purchase.EntryTaxes">
        <select class="form-select o_ab_entry_tax_select" aria-label="Taxes" t-on-change="(event) => this.setTax(line, event)">
            <option value="" t-att-selected="!selectedTaxId(line)">No tax</option>
            <option t-foreach="state.config.taxes" t-as="tax" t-key="tax.id" t-att-value="tax.id" t-att-selected="tax.id === selectedTaxId(line)" t-esc="tax.name"/>
        </select>
    </t>
</templates>
