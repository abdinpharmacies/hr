<odoo>
  <record id="orders_list" model="ir.ui.view">
    <field name="name">ab_crm_website_order.list</field>
    <field name="model">ab_crm_website_order</field>
    <field name="arch" type="xml">
      <list create="false" edit="false" delete="false">
        <field name="reference"/>
        <field name="phone"/>
        <field name="account_id"/>
        <field name="revision"/>
        <field name="progress"/>
        <field name="conversation_id"/>
        <field name="handoff_id"/>
        <field name="branch_id"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>
  <record id="orders_form" model="ir.ui.view">
    <field name="name">ab_crm_website_order.form</field>
    <field name="model">ab_crm_website_order</field>
    <field name="arch" type="xml">
      <form create="false" edit="false" delete="false">
        <sheet>
          <group>
            <field name="reference"/>
            <field name="phone"/>
            <field name="account_id"/>
            <field name="revision"/>
            <field name="progress"/>
            <field name="conversation_id"/>
            <field name="handoff_id"/>
            <field name="branch_id"/>
            <field name="company_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="orders_action" model="ir.actions.act_window">
    <field name="name">Website Orders</field>
    <field name="res_model">ab_crm_website_order</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="orders_menu" name="Website Orders" parent="ab_crm_core.menu_root" action="orders_action" groups="ab_crm_core.group_manager"/>
  <record id="mappings_list" model="ir.ui.view">
    <field name="name">ab_crm_website_mapping.list</field>
    <field name="model">ab_crm_website_mapping</field>
    <field name="arch" type="xml">
      <list delete="false">
        <field name="account_id"/>
        <field name="serial"/>
        <field name="unit_code"/>
        <field name="product_id"/>
        <field name="uom_id"/>
        <field name="active"/>
        <field name="branch_id"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>
  <record id="mappings_form" model="ir.ui.view">
    <field name="name">ab_crm_website_mapping.form</field>
    <field name="model">ab_crm_website_mapping</field>
    <field name="arch" type="xml">
      <form delete="false">
        <sheet>
          <group>
            <field name="account_id"/>
            <field name="serial"/>
            <field name="unit_code"/>
            <field name="product_id"/>
            <field name="uom_id"/>
            <field name="active"/>
            <field name="branch_id"/>
            <field name="company_id"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="mappings_action" model="ir.actions.act_window">
    <field name="name">Website Unit Mappings</field>
    <field name="res_model">ab_crm_website_mapping</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="mappings_menu" active="0" name="Website Unit Mappings" action="mappings_action" groups="ab_crm_core.group_manager"/>
</odoo>
