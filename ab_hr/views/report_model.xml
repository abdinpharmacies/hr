<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_hr_report_model_view_tree" model="ir.ui.view">
            <field name="name">ab_hr_report_model_view_tree</field>
            <field name="model">ab_hr_report_model</field>
            <field name="arch" type="xml">
                <list string="ab_hr_report_model_tree">
                    <field name="name"/>
                    <field name="base_action_ids"/>
                    <field name="depend_action_ids"/>
                    <field name="target_field_id"/>
                    <field name="job_has_issue"/>
                </list>
            </field>
        </record>
        <record id="ab_hr_report_model_view_form" model="ir.ui.view">
            <field name="name">ab_hr_report_model_view_form</field>
            <field name="model">ab_hr_report_model</field>
            <field name="arch" type="xml">
                <form string="ab_hr_report_model_form">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="base_action_ids" widget="many2many_tags"/>
                            <field name="depend_action_ids" widget="many2many_tags"/>
                            <field name="target_field_id"/>
                            <field name="job_has_issue" widget="boolean_toggle"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_hr_report_model_action" model="ir.actions.act_window">
            <field name="name">Report Models</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_hr_report_model</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem name="Report Models"
                  parent="config"
                  id="ab_hr_report_model_menu"
                  action="ab_hr_report_model_action"
                  sequence="300"/>

    </data>
</odoo>