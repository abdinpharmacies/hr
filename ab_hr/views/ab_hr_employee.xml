<odoo>
    <record id="ab_hr_employee_view_tree" model="ir.ui.view">
        <field name="name">ab_hr_employee.list</field>
        <field name="model">ab_hr_employee</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="accid"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="parent_id"/>
                <field name="work_email"/>
                <field name="is_working"/>
                <field name="english_name" optional="hide"/>
                <field name="costcenter_id" optional="hide"/>
                <field name="hiring_date" optional="hide"/>
                <field name="termination_date" optional="hide"/>
                <field name="issue_date" optional="hide"/>
                <field name="job_status" optional="hide"/>
                <field name="territory" optional="hide"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="ab_hr_employee_view_form" model="ir.ui.view">
        <field name="name">ab_hr_employee.form</field>
        <field name="model">ab_hr_employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Identity">
                            <field name="name"/>
                            <field name="english_name"/>
                            <field name="accid"/>
                            <field name="costcenter_id"/>
                            <field name="work_email"/>
                        </group>
                        <group string="Assignment">
                            <field name="job_id"/>
                            <field name="department_id"/>
                            <field name="parent_id"/>
                        </group>
                        <group string="Employment">
                            <field name="hiring_date"/>
                            <field name="termination_date"/>
                            <field name="issue_date"/>
                            <field name="job_status"/>
                            <field name="territory"/>
                            <field name="is_working"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Direct Reports">
                        <field name="child_ids" readonly="1" nolabel="1" colspan="2">
                            <list>
                                <field name="name"/>
                                <field name="accid"/>
                                <field name="job_id"/>
                                <field name="department_id"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ab_hr_employee_view_kanban" model="ir.ui.view">
        <field name="name">ab_hr_employee.kanban</field>
        <field name="model">ab_hr_employee</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="is_working"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column justify-content-between w-100" style="min-height: 190px;">
                            <div class="d-flex justify-content-between">
                                <div t-att-class="record.is_working.raw_value ? 'h4 text-success' : 'h4 text-danger'">
                                    <field name="accid"/>
                                </div>
                            </div>
                            <div class="mb-auto">
                                <div class="h4 text-info text-center">
                                    <field name="name"/>
                                </div>
                                <div class="text-dark text-center pt-2">
                                    <field name="job_id"/> - <field name="department_id"/>
                                </div>
                                <div class="h6 text-muted text-center">
                                    <i class="fa fa-user"/>
                                    <field name="parent_id"/>
                                    <i class="fa fa-user"/>
                                </div>
                                <div class="text-dark text-center pt-2">
                                    <field name="work_email"/>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between">
                                <small class="text-success">
                                    <field name="hiring_date"/>
                                </small>
                                <small class="text-warning">
                                    <field name="issue_date"/>
                                </small>
                                <small class="text-danger">
                                    <field name="termination_date"/>
                                </small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="ab_hr_employee_view_search" model="ir.ui.view">
        <field name="name">ab_hr_employee.search</field>
        <field name="model">ab_hr_employee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="accid"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="parent_id"/>
                <field name="work_email"/>
                <filter name="working" string="Working" domain="[('is_working', '=', True)]"/>
                <filter name="not_working" string="Not Working" domain="[('is_working', '=', False)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="by_job_id" string="Job" context="{'group_by': 'job_id'}"/>
                    <filter name="by_department_id" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="by_parent_id" string="Manager" context="{'group_by': 'parent_id'}"/>
                </group>
                <searchpanel view_types="kanban,list">
                    <field name="department_id" select="multi" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>
    <record id="ab_hr_employee_action" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">ab_hr_employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="ab_hr_employee_view_search"/>
    </record>
    <menuitem id="ab_hr_employee_menu" parent="ab_hr_employee_sub_menu" groups="ab_hr.group_ab_hr_basic_data" action="ab_hr_employee_action" sequence="10"/>
</odoo>
