<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="job_wizard_view_form" model="ir.ui.view">
            <field name="name">job_wizard_view_form</field>
            <field name="model">ab_hr_job_wizard</field>
            <field name="arch" type="xml">
                <form string="job_wizard_form">
                    <script>
                        $(document).ready(function(){
                        $('.modal-dialog').css({'width': '97%', 'height': '97%'});
                        $('.modal-content').css({'height': '100%'});
                        $('.modal-body').css({'height': '100%'});
                        });
                    </script>

                    <sheet>
                        <field name="action_date_type" invisible="1"/>
                        <field name="invisible_job_title" invisible="1"/>
                        <field name="invisible_workplace" invisible="1"/>
                        <field name="manpower_effect" invisible="1"/>
                        <field name="invisible_job_id" invisible="1"/>
                        <field name="type_of_action" invisible="1"/>

                        <group class="h2 text-muted text-center">
                            <field name="accid" readonly="1" nolabel="1" class="h1 text-muted"/>
                        </group>
                        <group class="h2 text-info text-center">
                            <field name="employee_id" readonly="1" nolabel="1"/>
                        </group>
                        <group
                               class="h2 text-info text-center" invisible="type_of_action in ['3', '4']">
                            <field name="job_id"
                                   readonly="1" nolabel="1"/>
                        </group>
                        <group
                               class="h2 text-info text-center" invisible="type_of_action in ['1', '2']">
                            <field name="manpower_id"
                                   readonly="1" nolabel="1"/>
                        </group>
                        <group class="h2 text-info text-center"
                               invisible="type_of_action in ['1', '2']">
                            <field name="workplace"
                                   class="h2 text-info text-center"
                                   readonly="1"
                                   nolabel="1"/>
                        </group>
                        <group invisible="1">
                            <field name="employee_id"/>
                            <field name="job_id"/>
                            <field name="manpower_id"/>
                            <field name="workplace"/>
                            <field name="job_title"/>
                        </group>
                        <div class="text-center pt-5">
                            <div class="h2 d-flex justify-content-center align-items-center">
                                <div>
                                    <field name="action_type"
                                           options="{'no_create': True, 'no_create_edit':True, 'no_open':True}"
                                           domain="[('type','=', type_of_action)]"
                                           nolabel="1" placeholder="Action Type"/>
                                </div>
                                <div>
                                    <field name="action_date" nolabel="1" placeholder="Action Date"/>
                                </div>
                                <div>
                                    <field name="alt_job_id" nolabel="1"
                                           domain="[
                                           ('action_type.action_date_type','in',['pending_issue','direct_issue']),
                                           ('alt_job_id','=',False)
                                           ]"

                                           placeholder="Alternative For" invisible="manpower_effect == False" readonly="(type_of_action in ['3', '4'] or action_type == False)"/>
                                </div>
                            </div>
                        </div>

                        <group class="h2 text-center" col="3">
                            <group string="Job Title"
                                   invisible="type_of_action in ['4']">
                                <field name="job_title" nolabel="1"
                                       invisible="(action_type == False or invisible_job_title == True)" required="(action_type != False) and (invisible_job_title == False)"/>
                            </group>
                            <group string="Workplace"
                                   invisible="type_of_action in ['3', '4']">
                                <field name="workplace"
                                       nolabel="1"
                                       invisible="(action_type == False or invisible_workplace == True)" required="(action_type != False) and (type_of_action in ['1', '2']) and (invisible_workplace == False)"/>
                            </group>
                            <group string="Territory"
                                   invisible="type_of_action in ['4']">
                                <field name="territory" nolabel="1"
                                       invisible="(action_type == False or invisible_workplace == True)" required="(action_type != False) and (invisible_workplace == False)"/>
                            </group>
                        </group>

                        <div>
                            <field name="attached_file"/>
                        </div>
                        <div>
                            <field name="notes" nolabel="1" class="h6" placeholder="Write Notes"/>
                        </div>
                    </sheet>
                    <footer>
                        <button name="action_save" string="Save and Close" type="object" class="btn btn-primary"/>
                        <button string="Cancel" type="object" special="cancel"
                                class="btn btn-outline-danger pull-right"/>
                    </footer>
                </form>
            </field>
        </record>


        <record id="job_wizard_view_form_layout" model="ir.ui.view">
            <field name="name">job_wizard_view_form.layout</field>
            <field name="model">ab_hr_job_wizard</field>
            <field name="inherit_id" ref="ab_hr.job_wizard_view_form"/>
            <field name="priority">90</field>
            <field name="arch" type="xml">
                <xpath expr="//form" position="attributes">
                    <attribute name="class" add="job_wizard_view_form_layout" separator=" "/>
                </xpath>
                <xpath expr="//form" position="inside">
                    <style>
        .job_wizard_view_form_layout .o_group, .job_wizard_view_form_layout .o_inner_group, .job_wizard_view_form_layout .o_wrap_field,
        .job_wizard_view_form_layout .o_notebook, .job_wizard_view_form_layout .o_notebook_content, .job_wizard_view_form_layout .tab-pane,
        .job_wizard_view_form_layout .o_field_widget, .job_wizard_view_form_layout .o_field_x2many { min-width: 0; max-width: 100%; }
        .job_wizard_view_form_layout .o_notebook, .job_wizard_view_form_layout .o_notebook_content, .job_wizard_view_form_layout .tab-pane,
        .job_wizard_view_form_layout .o_field_one2many, .job_wizard_view_form_layout .o_field_many2many, .job_wizard_view_form_layout .o_field_x2many { overflow: visible !important; }
        .job_wizard_view_form_layout .o_field_x2many .o_list_renderer.table-responsive {
            width: 100%; max-width: 100%; margin-inline: 0 !important; overflow-x: auto !important; overflow-y: auto !important;
        }
        .job_wizard_view_form_layout .o_field_html { width: 100%; overflow-x: auto; }
        .job_wizard_view_form_layout .o_field_html .abdin-query-html { height: auto !important; overflow: visible !important; }
        </style>
                </xpath>
                <xpath expr="//form/script" position="replace"/>
                <xpath expr="//form" position="inside">
                    <style>.modal-dialog:has(.job_wizard_view_form_layout) { width: calc(100% - 2rem); max-width: 960px; }</style>
                </xpath>
                <xpath expr="(//sheet/group[contains(@class,&quot;h2&quot;)])[not(@class=&quot;mb-3&quot;)]" position="attributes">
                    <attribute name="class">mb-3</attribute>
                    <attribute name="col">2</attribute>
                </xpath>
                <xpath expr="(//sheet/group[contains(@class,&quot;h2&quot;)])[not(@class=&quot;mb-3&quot;)]" position="attributes">
                    <attribute name="class">mb-3</attribute>
                    <attribute name="col">2</attribute>
                </xpath>
                <xpath expr="(//sheet/group[contains(@class,&quot;h2&quot;)])[not(@class=&quot;mb-3&quot;)]" position="attributes">
                    <attribute name="class">mb-3</attribute>
                    <attribute name="col">2</attribute>
                </xpath>
                <xpath expr="(//sheet/group[contains(@class,&quot;h2&quot;)])[not(@class=&quot;mb-3&quot;)]" position="attributes">
                    <attribute name="class">mb-3</attribute>
                    <attribute name="col">2</attribute>
                </xpath>
                <xpath expr="(//sheet/group[contains(@class,&quot;h2&quot;)])[not(@class=&quot;mb-3&quot;)]" position="attributes">
                    <attribute name="class">mb-3</attribute>
                    <attribute name="col">2</attribute>
                </xpath>
                <xpath expr="(//sheet/group[contains(@class,&quot;h2&quot;)])[not(@class=&quot;mb-3&quot;)]" position="attributes">
                    <attribute name="class">mb-3</attribute>
                    <attribute name="col">2</attribute>
                </xpath>
                <xpath expr="(//group/field[@name=&quot;accid&quot;])[not(@class=&quot;h4 text-muted w-100&quot;)]" position="attributes">
                    <attribute name="class">h4 text-muted w-100</attribute>
                    <attribute name="colspan">2</attribute>
                </xpath>
                <xpath expr="(//div[div/field[@name=&quot;action_type&quot;]])[not(@class=&quot;row g-3 mx-0 mb-4&quot;)]" position="attributes">
                    <attribute name="class">row g-3 mx-0 mb-4</attribute>
                </xpath>
                <xpath expr="(//div[div/field[@name=&quot;action_type&quot;]]/div)[not(@class=&quot;col-12 col-md-4&quot;)]" position="attributes">
                    <attribute name="class">col-12 col-md-4</attribute>
                </xpath>
                <xpath expr="(//div[div/field[@name=&quot;action_type&quot;]]/div)[not(@class=&quot;col-12 col-md-4&quot;)]" position="attributes">
                    <attribute name="class">col-12 col-md-4</attribute>
                </xpath>
                <xpath expr="(//div[div/field[@name=&quot;action_type&quot;]]/div)[not(@class=&quot;col-12 col-md-4&quot;)]" position="attributes">
                    <attribute name="class">col-12 col-md-4</attribute>
                </xpath>
                <xpath expr="(//div[@class=&quot;text-center pt-5&quot;])[not(@class=&quot;mb-3&quot;)]" position="attributes">
                    <attribute name="class">mb-3</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>