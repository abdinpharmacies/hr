<odoo>
    <record id="ab_hr_department_view_tree" model="ir.ui.view">
        <field name="name">ab_hr_department.list</field>
        <field name="model">ab_hr_department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="manager_id"/>
                <field name="parent_id"/>
                <field name="store_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="ab_hr_department_view_form" model="ir.ui.view">
        <field name="name">ab_hr_department.form</field>
        <field name="model">ab_hr_department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="manager_id"/>
                            <field name="parent_id"/>
                            <field name="store_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Child Departments">
                        <field name="child_ids" readonly="1" nolabel="1" colspan="2">
                            <list>
                                <field name="name"/>
                                <field name="manager_id"/>
                                <field name="store_id"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ab_hr_department_view_search" model="ir.ui.view">
        <field name="name">ab_hr_department.search</field>
        <field name="model">ab_hr_department</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="manager_id"/>
                <field name="parent_id"/>
                <field name="store_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="ab_hr_department_action" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">ab_hr_department</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ab_hr_department_view_search"/>
    </record>
    <menuitem id="ab_hr_department_config_menu" parent="config" groups="ab_hr.group_ab_hr_manager" action="ab_hr_department_action" sequence="10"/>
</odoo>
