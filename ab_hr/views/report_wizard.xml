<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_hr_report_wizard_view_form" model="ir.ui.view">
            <field name="name">ab_hr_report_wizard_view_form</field>
            <field name="model">ab_hr_report_wizard</field>
            <field name="arch" type="xml">
                <form string="ab_hr_report_wizard_form">
                    <sheet>
                        <notebook>

                            <page string="History Report">
                                <group>
                                    <field name="action_date"/>
                                    <field name="report_model_id"/>
                                </group>
                                <group col="4">
                                    <field name="job_title_ids" widget="many2many_tags"/>
                                    <field name="parent_department_ids" widget="many2many_tags"/>
                                    <field name="workplace_ids" widget="many2many_tags"/>
                                    <field name="territory"/>
                                </group>
                                <button name="btn_termination_feedback" type="object"
                                        string="Browse Report"
                                        class="btn-warning"/>
                                <button name="btn_export_excel_termination_feedback" type="object"
                                        string="Export Excel"
                                        class="btn-success"/>

                                <field name="html"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_hr_report_wizard_view_form_layout" model="ir.ui.view">
            <field name="name">ab_hr_report_wizard_view_form.layout</field>
            <field name="model">ab_hr_report_wizard</field>
            <field name="inherit_id" ref="ab_hr.ab_hr_report_wizard_view_form"/>
            <field name="priority">90</field>
            <field name="arch" type="xml">
                <xpath expr="//form" position="attributes">
                    <attribute name="class" add="ab_hr_report_wizard_view_form_layout" separator=" "/>
                </xpath>
                <xpath expr="//form" position="inside">
                    <style>
        .ab_hr_report_wizard_view_form_layout .o_group, .ab_hr_report_wizard_view_form_layout .o_inner_group, .ab_hr_report_wizard_view_form_layout .o_wrap_field,
        .ab_hr_report_wizard_view_form_layout .o_notebook, .ab_hr_report_wizard_view_form_layout .o_notebook_content, .ab_hr_report_wizard_view_form_layout .tab-pane,
        .ab_hr_report_wizard_view_form_layout .o_field_widget, .ab_hr_report_wizard_view_form_layout .o_field_x2many { min-width: 0; max-width: 100%; }
        .ab_hr_report_wizard_view_form_layout .o_notebook, .ab_hr_report_wizard_view_form_layout .o_notebook_content, .ab_hr_report_wizard_view_form_layout .tab-pane,
        .ab_hr_report_wizard_view_form_layout .o_field_one2many, .ab_hr_report_wizard_view_form_layout .o_field_many2many, .ab_hr_report_wizard_view_form_layout .o_field_x2many { overflow: visible !important; }
        .ab_hr_report_wizard_view_form_layout .o_field_x2many .o_list_renderer.table-responsive {
            width: 100%; max-width: 100%; margin-inline: 0 !important; overflow-x: auto !important; overflow-y: auto !important;
        }
        .ab_hr_report_wizard_view_form_layout .o_field_html { width: 100%; overflow-x: auto; }
        .ab_hr_report_wizard_view_form_layout .o_field_html .abdin-query-html { height: auto !important; overflow: visible !important; }
        </style>
                </xpath>
            </field>
        </record>
    </data>

    <record id="ab_hr_report_wizard_action" model="ir.actions.act_window">
        <field name="name">Report Wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">ab_hr_report_wizard</field>
        <field name="view_mode">form</field>
    </record>

    <menuitem name="Report Wizard"
              parent="history_and_history_reports_sub_menu"
              id="ab_hr_report_wizard_menu"
              action="ab_hr_report_wizard_action"
              sequence="100"/>

</odoo>