<odoo>
    <record id="ab_hr_job_view_tree" model="ir.ui.view">
        <field name="name">ab_hr_job.list</field>
        <field name="model">ab_hr_job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="internal_job"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="ab_hr_job_view_form" model="ir.ui.view">
        <field name="name">ab_hr_job.form</field>
        <field name="model">ab_hr_job</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="internal_job"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="ab_hr_job_view_search" model="ir.ui.view">
        <field name="name">ab_hr_job.search</field>
        <field name="model">ab_hr_job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="internal_job"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="ab_hr_job_action" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">ab_hr_job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ab_hr_job_view_search"/>
    </record>
    <menuitem id="ab_hr_job_config_menu" parent="config" groups="ab_hr.group_ab_hr_manager" action="ab_hr_job_action" sequence="20"/>
</odoo>
