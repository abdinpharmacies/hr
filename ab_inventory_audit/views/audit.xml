<odoo>
    <record id="audit_list" model="ir.ui.view"><field name="name">ab_inventory_audit.list</field><field name="model">ab_inventory_audit</field><field name="arch" type="xml">
        <list><field name="name"/><field name="store_id"/><field name="scope"/><field name="manager_id"/><field name="state"/><field name="progress" widget="progressbar"/><field name="coverage_complete"/><field name="opened_at"/></list>
    </field></record>
    <record id="audit_form" model="ir.ui.view"><field name="name">ab_inventory_audit.form</field><field name="model">ab_inventory_audit</field><field name="arch" type="xml">
        <form><header>
            <button name="action_prepare" type="object" string="Prepare and Open" invisible="state != 'draft'" groups="ab_inventory_audit.group_manager" class="oe_highlight"/>
            <button name="action_fast_count" type="object" string="Fast Count" invisible="state not in ('counting', 'review')" groups="ab_inventory_audit.group_counter"/>
            <button name="action_count_sheet" type="object" string="Export Count Sheet" invisible="state not in ('counting', 'review')" groups="ab_inventory_audit.group_counter"/>
            <button name="action_refresh" type="object" string="Refresh Coverage" invisible="state not in ('counting', 'review', 'approved')" groups="ab_inventory_audit.group_manager"/>
            <button name="action_review" type="object" string="Review" invisible="state != 'counting'" groups="ab_inventory_audit.group_manager"/>
            <button name="action_approve" type="object" string="Approve" invisible="state != 'review'" groups="ab_inventory_audit.group_manager"/>
            <button name="action_post_wizard" type="object" string="Post Approved Audit" invisible="state != 'approved'" groups="ab_inventory_audit.group_manager" class="oe_highlight"/><button name="action_workflow" type="object" string="Workflow"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,counting,review,approved,posted"/>
        </header><sheet>
            <div class="alert alert-info" role="alert">Only movements available in the central ledger are monitored. Exclusions reduce audit coverage.</div>
            <group><group><field name="name" readonly="state != 'draft'"/><field name="store_id" readonly="state != 'draft'"/><field name="company_id"/><field name="scope" readonly="state != 'draft'"/><field name="product_ids" widget="many2many_tags" invisible="scope != 'partial'" readonly="state != 'draft'"/></group>
            <group><field name="manager_id" readonly="state != 'draft'"/><field name="revision"/><field name="progress" widget="progressbar"/><field name="coverage_complete"/><field name="correction_of_id" readonly="state != 'draft'"/><field name="active" invisible="1"/></group></group>
            <notebook>
                <page string="Count Groups"><field name="line_ids"><list create="0" delete="0"><field name="id"/><field name="product_code"/><field name="barcodes"/><field name="product_id"/><field name="exp_date"/><field name="expired"/><field name="comparison_price"/><field name="state"/><field name="posted_qty"/><field name="reserved_qty"/><field name="available_qty"/><field name="physical_quantity"/><field name="latest_attempt_id"/><field name="discrepancy"/><button name="action_start" type="object" string="Start Count" invisible="state in ('new', 'accepted', 'excluded')" groups="ab_inventory_audit.group_counter"/></list></field></page>
                <page string="Product Coverage"><field name="coverage_ids"><list create="0" delete="0"><field name="product_id"/><field name="origin"/><field name="decision"/><field name="state"/><field name="decision_reason"/></list></field></page>
                <page string="Stock Observations"><field name="observation_ids"><list create="0" delete="0"><field name="id"/><field name="product_id"/><field name="counter_id"/><field name="quantity"/><field name="uom_id"/><field name="exp_date"/><field name="notes"/><field name="state"/><field name="decision_reason"/><field name="line_id"/></list></field></page>
                <page string="Allocation Review"><field name="line_ids"><list create="0" delete="0"><field name="id"/><field name="product_id"/><field name="accepted_count_id"/><field name="allocation_unresolved"/><field name="allocation_issue"/><field name="allocation_resolution"/></list></field></page>
                <page string="Team"><field name="team_ids" widget="many2many_tags" readonly="state != 'draft'"/></page>
                <page string="Movements After Accepted Count"><field name="movement_history" nolabel="1"/></page>
                <page string="Attachments"><field name="attachment_ids" widget="many2many_binary" readonly="1"/><p>Add evidence using the attachment button in the chatter.</p></page>
                <page string="Count Attempts"><field name="count_ids"><list><field name="id"/><field name="line_id"/><field name="counter_id"/><field name="input_method"/><field name="state"/><field name="started_at"/><field name="ended_at"/><field name="quantity"/><field name="reference_qty"/><field name="reason"/></list></field></page>
                <page string="Adjustments" groups="ab_inventory_audit.group_financial"><field name="adjustment_ids"><list><field name="source_id"/><field name="qty"/><field name="frozen_cost"/><field name="value"/><field name="balance_before"/><field name="movement_id"/></list></field></page>
                <page string="Approval and Accounting" groups="ab_inventory_audit.group_financial"><group><field name="surplus_value"/><field name="shortage_value"/><field name="config_id"/><field name="approved_by"/><field name="approved_at"/><field name="approval_revision"/><field name="posted_by"/><field name="posted_at"/><field name="surplus_journal_id"/><field name="shortage_journal_id"/></group><p>Source costs include the source model's tax components. No separate tax journal is generated.</p></page>
                <page string="History"><field name="event_ids"><list><field name="occurred_at"/><field name="actor_id"/><field name="action"/><field name="revision"/><field name="reason"/></list></field></page>
            </notebook>
        </sheet><chatter/></form>
    </field></record>
    <record id="line_list" model="ir.ui.view"><field name="name">ab_inventory_audit_line.list</field><field name="model">ab_inventory_audit_line</field><field name="arch" type="xml">
        <list><field name="audit_id"/><field name="store_id"/><field name="id"/><field name="product_code"/><field name="barcodes"/><field name="product_id"/><field name="exp_date"/><field name="comparison_price"/><field name="assigned_ids" widget="many2many_tags"/><field name="state"/><field name="reference_qty"/><field name="physical_quantity"/><field name="latest_attempt_id"/><field name="discrepancy"/><button name="action_start" type="object" string="Start Count" invisible="state in ('new', 'accepted', 'excluded')" groups="ab_inventory_audit.group_counter"/></list></field></record>
    <record id="line_form" model="ir.ui.view"><field name="name">ab_inventory_audit_line.form</field><field name="model">ab_inventory_audit_line</field><field name="arch" type="xml">
        <form create="0" edit="0" delete="0"><header><button name="action_review_wizard" type="object" string="Review / Assign" groups="ab_inventory_audit.group_manager"/></header><sheet><group><field name="audit_id"/><field name="id"/><field name="product_code"/><field name="barcodes"/><field name="product_id"/><field name="large_unit_id"/><field name="medium_unit_id"/><field name="small_unit_id"/><field name="posted_qty"/><field name="reserved_qty"/><field name="available_qty"/><field name="expired"/><field name="physical_absence"/><field name="exp_date"/><field name="no_expiry"/><field name="comparison_price"/><field name="assigned_ids" widget="many2many_tags"/><field name="state"/><field name="accepted_count_id"/><field name="reference_qty"/><field name="physical_quantity"/><field name="latest_attempt_id"/><field name="discrepancy"/><field name="review_reason"/><field name="exclusion_reason"/><field name="allocation_unresolved"/><field name="allocation_issue"/><field name="allocation_resolution"/></group><field name="source_ids" groups="ab_inventory_audit.group_financial"><list><field name="source_id"/><field name="reference_qty"/><field name="allocation_qty"/><field name="allocation_reason"/><field name="preview_cost"/><field name="preview_value"/><field name="frozen_cost"/><field name="frozen_value"/><field name="zero_cost_reason"/><field name="new_source_approved"/></list></field></sheet></form></field></record>
    <record id="config_list" model="ir.ui.view"><field name="name">ab_inventory_audit_config.list</field><field name="model">ab_inventory_audit_config</field><field name="arch" type="xml">
        <list><field name="store_id"/><field name="company_id"/><field name="date_from"/><field name="date_to"/><field name="inventory_account_id"/><field name="shortage_account_id"/><field name="surplus_account_id"/><field name="doctype_id"/><field name="costcenter_id"/></list></field></record>
    <record id="config_form" model="ir.ui.view"><field name="name">ab_inventory_audit_config.form</field><field name="model">ab_inventory_audit_config</field><field name="arch" type="xml">
        <form delete="0"><sheet><group><field name="store_id"/><field name="company_id"/><field name="date_from"/><field name="date_to"/><field name="inventory_account_id"/><field name="shortage_account_id"/><field name="surplus_account_id"/><field name="doctype_id"/><field name="costcenter_id"/></group></sheet></form></field></record>
</odoo>
