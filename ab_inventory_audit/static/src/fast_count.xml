<templates xml:space="preserve">
    <t t-name="ab_inventory_audit.FastCount">
        <div class="o_ab_inventory_audit_fast_count p-4 overflow-auto h-100" t-att-dir="direction">
            <h2>Inventory Audit: Fast Count</h2>
            <p>Scan to select a product, then choose its expiry and price group. Scanning never increments quantities.</p>
            <div class="d-flex gap-2 mb-3"><input class="form-control" t-model="state.barcode" placeholder="Barcode" t-on-keydown="onKeydown"/><button class="btn btn-primary" t-on-click="scan" t-att-disabled="state.busy">Select Product</button><button class="btn btn-secondary" t-on-click="() => this.load()">Show All</button></div>
            <p>Up to 200 groups are shown. Use a barcode to narrow the selection.</p>
            <table class="table table-striped"><thead><tr><th>Group ID</th><th>Code</th><th>Barcode</th><th>Product</th><th>Units</th><th>Selected Attempt</th><th>Expiry</th><th>Price</th><th>Posted</th><th>Reserved</th><th>Available</th><th>State</th><th>Physical</th><th>Count</th></tr></thead><tbody>
                <tr t-foreach="state.lines" t-as="line" t-key="line.id"><td t-esc="line.id"/><td t-esc="line.product_code"/><td t-esc="line.barcodes"/><td t-esc="line.product_id[1] || line.product_code"/><td><span t-esc="line.large_unit_id[1]"/> / <span t-esc="line.medium_unit_id[1]"/> / <span t-esc="line.small_unit_id[1]"/></td><td t-esc="(line.accepted_count_id || line.latest_attempt_id)[1] || ''"/><td><span t-esc="line.exp_date || ''"/><span t-if="line.expired" class="text-danger"> Expired</span></td><td t-esc="line.comparison_price"/><td t-esc="line.posted_qty"/><td t-esc="line.reserved_qty"/><td t-esc="line.available_qty"/><td t-esc="state.labels[line.state]"/><td t-esc="line.physical_quantity || ''"/><td><button t-if="!['new', 'accepted', 'excluded'].includes(line.state)" class="btn btn-primary" t-on-click="() => this.start(line)">Start Count</button></td></tr>
            </tbody></table>
        </div>
    </t>
</templates>
