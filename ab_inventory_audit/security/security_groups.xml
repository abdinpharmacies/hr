<odoo>
    <record id="category_audit" model="ir.module.category"><field name="name">Inventory Audit</field></record>
    <record id="privilege_audit" model="res.groups.privilege"><field name="name">Inventory Audit</field><field name="category_id" ref="category_audit"/></record>
    <record id="group_counter" model="res.groups"><field name="name">Audit Counter</field><field name="privilege_id" ref="privilege_audit"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
    <record id="group_reviewer" model="res.groups"><field name="name">Audit Read-only Reviewer</field><field name="privilege_id" ref="privilege_audit"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
    <record id="group_financial" model="res.groups"><field name="name">Audit Financial Reader</field><field name="privilege_id" ref="privilege_audit"/><field name="implied_ids" eval="[(4, ref('group_reviewer'))]"/></record>
    <record id="group_manager" model="res.groups"><field name="name">Audit Manager</field><field name="privilege_id" ref="privilege_audit"/><field name="implied_ids" eval="[(4, ref('group_counter')), (4, ref('group_financial'))]"/></record>
    <record id="group_config" model="res.groups"><field name="name">Audit Financial Configuration Administrator</field><field name="privilege_id" ref="privilege_audit"/><field name="implied_ids" eval="[(4, ref('group_financial'))]"/></record>
    <record id="base.group_system" model="res.groups"><field name="implied_ids" eval="[(4, ref('group_manager')), (4, ref('group_config'))]"/></record>
</odoo>
