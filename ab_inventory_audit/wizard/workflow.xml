<odoo>
    <record id="wizard_form" model="ir.ui.view"><field name="name">ab_inventory_audit_wizard.form</field><field name="model">ab_inventory_audit_wizard</field><field name="arch" type="xml">
        <form string="Audit Workflow"><group><field name="audit_id"/><field name="operation"/>
            <field name="line_id" domain="[('audit_id', '=', audit_id)]" invisible="operation in ('cancel', 'reopen', 'export', 'download', 'import', 'products', 'unidentified', 'post', 'absence', 'include_observation', 'exclude_observation')"/>
            <field name="group_ids" widget="many2many_tags" domain="[('audit_id', '=', audit_id), ('state', 'in', ['uncounted', 'invalid', 'counted'])]" invisible="operation != 'export'"/>
            <field name="count_id" domain="[('line_id', '=', line_id)]" invisible="operation not in ('count', 'cancel_attempt', 'review')"/>
            <field name="counter_ids" widget="many2many_tags" invisible="operation != 'assign'"/>
            <field name="category_id" invisible="operation != 'products'"/>
            <field name="product_id" invisible="operation not in ('unidentified', 'absence')"/><field name="observation_id" domain="[('audit_id', '=', audit_id), ('state', '=', 'pending')]" invisible="operation not in ('include_observation', 'exclude_observation')"/><field name="observed_qty" invisible="operation != 'unidentified'"/>
            <field name="reason" invisible="operation in ('export', 'download', 'import', 'count', 'post')"/>
        </group><group string="Count Quantities" invisible="operation != 'count'"><field name="large_unit_id"/><field name="large_qty"/><field name="medium_unit_id"/><field name="medium_qty"/><field name="small_unit_id"/><field name="small_qty"/><field name="count_notes"/><field name="attachment_ids" widget="many2many_binary" readonly="1"/></group>
        <group string="Source and Allocation" invisible="operation not in ('allocate', 'source', 'unidentified', 'include_observation')">
            <field name="audit_source_id" domain="[('line_id', '=', line_id)]" groups="ab_inventory_audit.group_financial" invisible="operation != 'allocate'"/>
            <field name="allocation_qty" invisible="operation in ('unidentified', 'include_observation')"/>
            <field name="source_id" groups="ab_inventory_audit.group_financial" invisible="operation != 'source'"/>
            <field name="uom_id" invisible="operation == 'allocate'"/>
            <field name="selling_price" invisible="operation == 'allocate'"/>
            <field name="exp_date" invisible="operation not in ('unidentified', 'include_observation')"/><field name="no_expiry" invisible="operation not in ('unidentified', 'include_observation')"/>
            <field name="purchase_price" groups="ab_inventory_audit.group_financial" invisible="operation != 'source'"/>
            <field name="cost_supplied" groups="ab_inventory_audit.group_financial" invisible="operation != 'source'"/>
            <field name="discount" groups="ab_inventory_audit.group_financial" invisible="operation != 'source'"/>
            <field name="tax_ids" widget="many2many_tags" groups="ab_inventory_audit.group_financial" invisible="operation != 'source'"/>
            <field name="zero_cost_reason" groups="ab_inventory_audit.group_financial" invisible="operation in ('unidentified', 'include_observation')"/>
        </group><group invisible="operation not in ('import', 'download')"><field name="file" filename="filename"/><field name="filename" invisible="1"/><field name="preview"/></group>
        <group invisible="operation != 'post'" groups="ab_inventory_audit.group_financial"><field name="surplus_value"/><field name="shortage_value"/></group><footer><button name="action_preview" type="object" string="Preview Workbook" invisible="operation != 'import'"/><button name="action_apply" type="object" string="Confirm" class="btn-primary" invisible="operation == 'download'"/><button string="Close" special="cancel"/></footer></form>
    </field></record>
</odoo>
