  },
  "preconditions": [
    "Validate every fixed ID and its stable code/external reference before testing.",
    "Selected products must retain local origin and unit prices 100.00 and 280.00. Price drift blocks fixed-value assertions; do not silently recalculate expectations.",
    "Contracts must match fixture values; no product-card discount overrides for the selected products.",
    "Store 104 must be permitted for the user, employee, contract and promotion.",
    "The current backend uses the configured E-Plus connection; no fake E-Plus environment is installed.",
    "Preview must stop before the final Submit (F10); live submission requires an explicit dev-E-Plus opt-in.",
    "Runtime must expose ab_contract.allow_promotions. Combined UI behavior is under test; missing promotion controls must fail rather than silently substitute exclusion behavior."
  ],
  "setup_steps": [
    {
      "action": "login_odoo",
      "user_id": 2452
    },
    {
      "action": "open_pos",
      "action_xmlid": "ab_sales.ab_sales_pos_action"
    },
    {
      "action": "employee_pin_login",
      "employee_access_id": 1,
      "store_id": 104
    },
    {
      "action": "assert_session",
      "employee_id": 668,
      "store_id": 104
    },
    {
      "action": "set_product_search_filters",
      "has_balance": false,
      "has_pos_balance": false,
      "item_type": "all"
    }
  ],
  "out_of_stock": {
    "when": "requested quantity exceeds displayed branch balance and the reason selector is visible",
    "action": "select_unavailable_reason",
    "value": "other",
    "explanation": "Development UI test",
    "assert": "Reason and explanation appear on the submitted line; do not modify inventory to bypass shortages."
  },
  "submission": {
    "action": "open_submit_dialog",
    "customer_id": 19934,
    "actual_salesperson_id": 668,
    "is_delivery": false,
    "insurance_name": "TEST CUSTOMER",
    "insurance_number": "TEST-{case_id}-{run_id}",
    "description": "PLAYWRIGHT-TEST-{case_id}-{run_id}",
    "preview_action": "Back; do not click final Submit (F10)",
    "live_action": "Click Submit (F10) once; capture returned invoice ID and wait for final status. Never retry blindly after a timeout.",
    "backend_checks": [
      "Saved header uses store 104, customer 19934, employee 668 and the expected contract.",
      "Saved lines contain exactly the expected product IDs, quantities, unit prices and UoM.",
      "Stored totals match this case and the displayed totals.",
      "Applied promotion IDs match this case.",
      "For unavailable lines, saved reason and explanation match the test input.",
      "Fail on unexpected Odoo RPC error, visible error dialog, page exception or network failure.",
      "Record pending separately from saved; pending is not proof of successful E-Plus posting."
    ]
  },
  "cleanup": {
    "policy": "Close the run-owned POS session; discard only drafts created by this run. Preserve submitted invoices and report their IDs. Never delete pre-existing drafts or business records."
  },
