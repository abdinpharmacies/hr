<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ab_project_sprint_company_rule" model="ir.rule">
            <field name="name">Development Sprint: multi-company</field>
            <field name="model_id" ref="model_ab_project_sprint"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        </record>

        <record id="ab_project_release_company_rule" model="ir.rule">
            <field name="name">Development Release: multi-company</field>
            <field name="model_id" ref="model_ab_project_release"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
        </record>

        <record id="ab_project_sprint_user_visibility_rule" model="ir.rule">
            <field name="name">Development Sprint: project visibility</field>
            <field name="model_id" ref="model_ab_project_sprint"/>
            <field name="domain_force">[
                '|',
                    ('project_id.privacy_visibility', 'in', ['employees', 'portal']),
                    '|',
                        ('project_id.message_partner_ids', 'in', [user.partner_id.id]),
                        '|',
                            ('project_id.user_id', '=', user.id),
                            ('task_ids.user_ids', 'in', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('ab_projects.group_ab_project_user')), (4, ref('project.group_project_user'))]"/>
        </record>

        <record id="ab_project_release_user_visibility_rule" model="ir.rule">
            <field name="name">Development Release: project visibility</field>
            <field name="model_id" ref="model_ab_project_release"/>
            <field name="domain_force">[
                '|',
                    ('project_id.privacy_visibility', 'in', ['employees', 'portal']),
                    '|',
                        ('project_id.message_partner_ids', 'in', [user.partner_id.id]),
                        '|',
                            ('project_id.user_id', '=', user.id),
                            ('task_ids.user_ids', 'in', user.id),
            ]</field>
            <field name="groups" eval="[(4, ref('ab_projects.group_ab_project_user')), (4, ref('project.group_project_user'))]"/>
        </record>

        <record id="ab_project_sprint_admin_visibility_rule" model="ir.rule">
            <field name="name">Development Sprint: administrators see all</field>
            <field name="model_id" ref="model_ab_project_sprint"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ab_projects.group_ab_project_admin')), (4, ref('project.group_project_manager'))]"/>
        </record>

        <record id="ab_project_release_admin_visibility_rule" model="ir.rule">
            <field name="name">Development Release: administrators see all</field>
            <field name="model_id" ref="model_ab_project_release"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('ab_projects.group_ab_project_admin')), (4, ref('project.group_project_manager'))]"/>
        </record>
    </data>
</odoo>
