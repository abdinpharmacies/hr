<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_ab_project_user" model="res.groups">
        <field name="name">Project User</field>
        <field name="sequence">11</field>
        <field name="privilege_id" ref="project.res_groups_privilege_project"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_ab_project_lead" model="res.groups">
        <field name="name">Project Lead</field>
        <field name="sequence">15</field>
        <field name="privilege_id" ref="project.res_groups_privilege_project"/>
        <field name="implied_ids" eval="[(4, ref('ab_projects.group_ab_project_user')), (4, ref('project.group_project_task_dependencies')), (4, ref('project.group_project_milestone'))]"/>
    </record>

    <record id="group_ab_project_admin" model="res.groups">
        <field name="name">Project Administrator</field>
        <field name="sequence">25</field>
        <field name="privilege_id" ref="project.res_groups_privilege_project"/>
        <field name="implied_ids" eval="[(4, ref('ab_projects.group_ab_project_lead')), (4, ref('project.group_project_manager'))]"/>
    </record>
</odoo>
