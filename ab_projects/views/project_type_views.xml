<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ab_project_type_view_list" model="ir.ui.view">
        <field name="name">ab.project.type.list</field>
        <field name="model">ab.project.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ab_project_type_view_form" model="ir.ui.view">
        <field name="name">ab.project.type.form</field>
        <field name="model">ab.project.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ab_project_type_action" model="ir.actions.act_window">
        <field name="name">Project Types</field>
        <field name="res_model">ab.project.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
