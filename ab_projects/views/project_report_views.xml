<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ab_project_task_report_view_pivot" model="ir.ui.view">
        <field name="name">project.task.report.pivot.ab.projects</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <pivot string="Development Task Report">
                <field name="project_id" type="row"/>
                <field name="ab_task_type" type="col"/>
                <field name="allocated_hours" type="measure"/>
                <field name="total_hours_spent" type="measure"/>
                <field name="ab_story_points" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="ab_project_task_report_view_graph" model="ir.ui.view">
        <field name="name">project.task.report.graph.ab.projects</field>
        <field name="model">project.task</field>
        <field name="arch" type="xml">
            <graph string="Development Task Report" type="bar" stacked="True">
                <field name="project_id"/>
                <field name="ab_task_type"/>
                <field name="ab_story_points" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="ab_project_task_report_action" model="ir.actions.act_window">
        <field name="name">Development Tasks</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('is_template', '=', False)]</field>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

    <record id="ab_project_bug_report_action" model="ir.actions.act_window">
        <field name="name">Bug Report</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">pivot,graph,list,kanban,form</field>
        <field name="domain">[('is_template', '=', False), ('ab_task_type', '=', 'bug')]</field>
        <field name="context">{'search_default_ab_bugs': 1, 'search_default_ab_group_task_type': 1}</field>
        <field name="search_view_id" ref="project.view_task_search_form"/>
    </record>

    <record id="ab_project_sprint_report_action" model="ir.actions.act_window">
        <field name="name">Sprint Report</field>
        <field name="res_model">ab.project.sprint</field>
        <field name="view_mode">graph,list,form</field>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>
</odoo>
