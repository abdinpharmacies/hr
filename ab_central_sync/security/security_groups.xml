<odoo>
    <record id="category" model="ir.module.category"><field name="name">Central Synchronization</field></record>
    <record id="privilege" model="res.groups.privilege"><field name="name">Central Synchronization</field><field name="category_id" ref="category"/></record>
    <record id="group_manager" model="res.groups"><field name="name">Synchronization Manager</field><field name="privilege_id" ref="privilege"/><field name="implied_ids" eval="[(4, ref('base.group_user'))]"/></record>
    <record id="base.group_system" model="res.groups"><field name="implied_ids" eval="[(4, ref('group_manager'))]"/></record>
</odoo>
