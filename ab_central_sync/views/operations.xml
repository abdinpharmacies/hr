<odoo>
    <record id="operation_list" model="ir.ui.view"><field name="name">Central operations</field><field name="model">ab_central_sync_operation</field><field name="arch" type="xml">
            <list create="0" delete="0" edit="0"><field name="store_id"/><field name="direction"/><field name="serial"/><field name="kind"/><field name="state"/><field name="accepted_at"/><field name="attempts"/><field name="next_retry"/><field name="error"/></list></field></record>
    <record id="operation_form" model="ir.ui.view"><field name="name">Central operation</field><field name="model">ab_central_sync_operation</field><field name="arch" type="xml">
            <form create="0" delete="0" edit="0"><header><button name="action_retry" type="object" string="Retry" invisible="state == 'accepted'" groups="ab_central_sync.group_manager"/><button name="action_reconcile" type="object" string="Check Missing Serials" invisible="direction != 'out'" groups="ab_central_sync.group_manager"/><field name="state" widget="statusbar"/></header><sheet><group><field name="origin"/><field name="token"/><field name="store_id"/><field name="serial"/><field name="kind"/><field name="direction"/><field name="accepted_at"/><field name="attempts"/><field name="next_retry"/><field name="error"/></group><notebook><page string="Payload"><field name="payload"/></page><page string="Result"><field name="result"/></page><page string="Reconciliation"><field name="reconciliation"/></page><page string="History"><field name="history"/></page></notebook></sheet></form></field></record>
    <record id="operation_action" model="ir.actions.act_window"><field name="name">Central Synchronization</field><field name="res_model">ab_central_sync_operation</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_root" name="Central Synchronization" groups="group_manager"/>
    <menuitem id="menu_operations" name="Operations" parent="menu_root" action="operation_action"/>
</odoo>
