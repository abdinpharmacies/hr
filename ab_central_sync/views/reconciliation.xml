<odoo>
    <record id="sale_reconciliation_form" model="ir.ui.view">
        <field name="name">Central sale reconciliation</field>
        <field name="model">ab_central_sync_sale_reconciliation</field>
        <field name="arch" type="xml">
            <form string="Reconcile Rejected Sale">
                <p>Review and post the matching sale on central first. Leave it pending for the branch settlement or cancellation. This action links existing stock movements; it does not post stock again.</p>
                <p>Products, line order, quantities, prices, discounts, customer and promotions must match the branch operation. Explain any batch or cost differences in the reason.</p>
                <group>
                    <field name="operation_id" options="{'no_open': True}"/>
                    <field name="store_id" invisible="1"/>
                    <field name="sale_id" domain="[('store_id', '=', store_id), ('native_backend', '=', True), ('native_posted', '=', True), ('status', '=', 'pending')]" options="{'no_create': True}"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_reconcile" type="object" string="Accept Reconciled Sale" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
