<odoo>
    <record id="replica_enrollment_form" model="ir.ui.view">
        <field name="name">Replica central enrollment</field>
        <field name="model">ab_replica_db</field>
        <field name="inherit_id" ref="ab_store.ab_replica_db_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Central Synchronization" groups="base.group_system">
                    <field name="central_last_seen"/>
                    <field name="central_backlog"/>
                    <field name="central_error"/>
                    </group>
            </xpath>
        </field>
    </record>
    <record id="replica_enrollment_list" model="ir.ui.view">
        <field name="name">Replica central status</field><field name="model">ab_replica_db</field>
        <field name="inherit_id" ref="ab_store.ab_replica_db_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
            <field name="central_last_seen" optional="show"/><field name="central_backlog" optional="show"/><field name="central_error" optional="show"/>
        </xpath></field>
    </record>
    <menuitem id="menu_branches" name="Branches" parent="menu_root" action="ab_store.ab_replica_db_action" groups="base.group_system"/>
    </odoo>
