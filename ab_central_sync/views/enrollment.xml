<odoo>
    <record id="replica_enrollment_form" model="ir.ui.view">
        <field name="name">Replica central enrollment</field>
        <field name="model">ab_replica_db</field>
        <field name="inherit_id" ref="ab_store.ab_replica_db_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Central Synchronization" groups="base.group_system">
                    <field name="central_ready"/>
                    <field name="central_origin"/>
                    <field name="central_pair_expires"/>
                    <field name="central_last_seen"/>
                    <field name="central_backlog"/>
                    <field name="central_error"/>
                    <button name="action_pairing_code" type="object" string="Generate Pairing Code"/>
                    <button name="action_revoke_central" type="object" string="Revoke Connection"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="replica_enrollment_list" model="ir.ui.view">
        <field name="name">Replica central status</field><field name="model">ab_replica_db</field>
        <field name="inherit_id" ref="ab_store.ab_replica_db_view_list"/>
        <field name="arch" type="xml"><xpath expr="//list" position="inside">
            <field name="central_last_seen" optional="show"/><field name="central_backlog" optional="show"/><field name="central_error" optional="show"/>
        </xpath></field>
    </record>
    <menuitem id="menu_branches" name="Branches" parent="menu_root" action="ab_store.ab_replica_db_action" groups="base.group_system"/>
    <record id="settings_form" model="ir.ui.view">
        <field name="name">Central synchronization settings</field><field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml"><xpath expr="//form" position="inside">
            <app string="Central Synchronization" name="ab_central_sync" groups="base.group_system">
                <block title="Connection">
                    <setting string="Installation role"><field name="central_role"/></setting>
                    <setting string="Central server" invisible="central_role != 'branch'">
                        <field name="central_url" placeholder="https://central.example.com"/>
                        <field name="central_database"/><field name="central_pairing_code" password="True"/>
                        <field name="central_connection"/>
                        <button name="action_connect_central" type="object" string="Connect to Central" class="btn-primary"/>
                        <button name="action_sync_now" type="object" string="Sync Now"/>
                        <div class="text-muted">Connect once per branch installation. Sessions and restarts reconnect automatically.</div>
                    </setting>
                </block>
            </app>
        </xpath></field>
    </record>
</odoo>
