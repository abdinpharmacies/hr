<odoo>
<record id="view_ab_oms_sync_event_list" model="ir.ui.view"><field name="name">ab_oms_sync_event.list</field><field name="model">ab_oms_sync_event</field><field name="arch" type="xml">
    <list><field name="event_id"/><field name="source"/><field name="reference"/><field name="revision"/><field name="state"/><field name="request_id"/><field name="last_error"/></list></field></record>
<record id="view_ab_oms_sync_event_form" model="ir.ui.view"><field name="name">ab_oms_sync_event.form</field><field name="model">ab_oms_sync_event</field><field name="arch" type="xml">
    <form><header><button name="action_review" type="object" string="Confirm Snapshot Review"/><button name="action_retry" string="Retry Import" type="object"/></header><sheet><group><field name="event_id"/><field name="source"/><field name="reference"/><field name="revision"/><field name="state"/><field name="request_id"/><field name="last_error"/><field name="review_note"/><field name="payload"/><field name="branch_id"/><field name="company_id"/></group></sheet></form></field></record>
<record id="action_ab_oms_sync_event" model="ir.actions.act_window"><field name="name">Website Events</field><field name="res_model">ab_oms_sync_event</field><field name="view_mode">list,form</field></record>
<record id="view_ab_oms_sync_update_list" model="ir.ui.view"><field name="name">ab_oms_sync_update.list</field><field name="model">ab_oms_sync_update</field><field name="arch" type="xml">
    <list><field name="request_id"/><field name="source"/><field name="reference"/><field name="state"/><field name="last_success"/><field name="branch_id"/><field name="company_id"/></list></field></record>
<record id="view_ab_oms_sync_update_form" model="ir.ui.view"><field name="name">ab_oms_sync_update.form</field><field name="model">ab_oms_sync_update</field><field name="arch" type="xml">
    <form><header><button name="action_approve" string="Approve Status Update" type="object"/></header><sheet><group><field name="request_id"/><field name="source"/><field name="reference"/><field name="state"/><field name="payload"/><field name="last_success"/><field name="branch_id"/><field name="company_id"/></group></sheet></form></field></record>
<record id="action_ab_oms_sync_update" model="ir.actions.act_window"><field name="name">Website Updates</field><field name="res_model">ab_oms_sync_update</field><field name="view_mode">list,form</field></record>
</odoo>
