<odoo>
<record id="rule_ab_oms_sync_event_company" model="ir.rule"><field name="name">Website Events: company</field><field name="model_id" ref="model_ab_oms_sync_event"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_ab_oms_sync_event_branch" model="ir.rule"><field name="name">Website Events: branch</field><field name="model_id" ref="model_ab_oms_sync_event"/><field name="domain_force">[] if user.has_group('ab_crm_core.group_manager') or user.has_group('base.group_system') else [('branch_id.user_ids', 'in', [user.id])]</field></record>
<record id="rule_ab_oms_sync_update_company" model="ir.rule"><field name="name">Website Updates: company</field><field name="model_id" ref="model_ab_oms_sync_update"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_ab_oms_sync_update_branch" model="ir.rule"><field name="name">Website Updates: branch</field><field name="model_id" ref="model_ab_oms_sync_update"/><field name="domain_force">[] if user.has_group('ab_crm_core.group_manager') or user.has_group('base.group_system') else [('branch_id.user_ids', 'in', [user.id])]</field></record>
</odoo>
