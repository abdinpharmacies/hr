<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="supplier_type_setup_wizard_form" model="ir.ui.view">
        <field name="name">ab_supplier_type_setup_wizard.form.workflow</field>
        <field name="model">ab_supplier_type_setup_wizard</field>
        <field name="arch" type="xml">
            <form string="Supplier Setup">
                <group>
                    <field name="supplier_id"/>
                    <field name="claim_id"/>
                    <field name="supplier_section"/>
                    <field name="supplier_type"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
