<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_supplier_claim_skip_wizard" model="ir.ui.view">
        <field name="name">ab_supplier_claim_skip_wizard_form</field>
        <field name="model">ab_supplier_claim_skip_wizard</field>
        <field name="arch" type="xml">
            <form string="Skip Inventory &amp; Purchase">
                <group>
                    <field name="claim_id"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Skip" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
