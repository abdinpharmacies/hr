            <field name="model_id" ref="ab_supplier_claim_cycle.model_ab_supplier_claim_cycle"/>
            <field name="groups" eval="[(4, ref('ab_supplier_claim_cycle.supplier_claim_group_reviewer'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Department-specific write rules -->
        <record id="rule_supplier_claim_inventory_write_current_stage" model="ir.rule">
            <field name="name">Supplier Claim Inventory pending department records</field>
            <field name="model_id" ref="ab_supplier_claim_cycle.model_ab_supplier_claim_cycle"/>
            <field name="groups" eval="[(4, ref('ab_supplier_claim_workflow.supplier_claim_group_inventory'))]"/>
            <field name="domain_force">['&amp;', ('status', 'in', ('inventory', 'purchase')), '|', ('inv_decision', 'in', ('pending', 'deferred')), '&amp;', ('inv_decision', 'in', ('accepted', 'rejected')), ('inv_finished', '=', False)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_supplier_claim_purchase_write_current_stage" model="ir.rule">
