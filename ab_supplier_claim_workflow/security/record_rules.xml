            <field name="name">Stage History department read</field>
            <field name="model_id" ref="model_ab_supplier_claim_stage_history"/>
            <field name="groups" eval="[(4, ref('ab_supplier_claim_workflow.supplier_claim_group_inventory')),(4, ref('ab_supplier_claim_workflow.supplier_claim_group_purchase')),(4, ref('ab_supplier_claim_workflow.supplier_claim_group_suppliers')),(4, ref('ab_supplier_claim_workflow.supplier_claim_group_tax_accounts')),(4, ref('ab_supplier_claim_workflow.supplier_claim_group_bank_acc'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="active" eval="0"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_stage_history_inventory_read" model="ir.rule">
            <field name="name">Stage History inventory read</field>
            <field name="model_id" ref="model_ab_supplier_claim_stage_history"/>
            <field name="groups" eval="[(4, ref('ab_supplier_claim_workflow.supplier_claim_group_inventory'))]"/>
            <field name="domain_force">['&amp;', ('claim_id.status', 'in', ('inventory', 'purchase')), '|', ('claim_id.inv_decision', 'in', ('pending', 'deferred')), '&amp;', ('claim_id.inv_decision', 'in', ('accepted', 'rejected')), ('claim_id.inv_finished', '=', False)]</field>
