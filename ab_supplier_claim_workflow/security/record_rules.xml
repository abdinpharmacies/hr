            <field name="name">Stage History Secretarial all</field>
            <field name="model_id" ref="model_ab_supplier_claim_stage_history"/>
            <field name="groups" eval="[(4, ref('ab_supplier_claim_cycle.supplier_claim_group_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
