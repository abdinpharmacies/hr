<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Deactivate old base rules -->
        <record id="ab_supplier_claim_cycle.rule_suppliers_pervent" model="ir.rule">
            <field name="active" eval="0"/>
        </record>
        <record id="ab_supplier_claim_cycle.rule_closed_allow" model="ir.rule">
            <field name="active" eval="0"/>
        </record>
        <record id="ab_supplier_claim_cycle.rule_closed_status" model="ir.rule">
            <field name="active" eval="0"/>
        </record>

        <!-- New replacement rules -->
        <record id="rule_supplier_claim_secretarial_all" model="ir.rule">
            <field name="name">Supplier Claim Secretarial all records</field>
            <field name="model_id" ref="ab_supplier_claim_cycle.model_ab_supplier_claim_cycle"/>
            <field name="groups" eval="[(4, ref('ab_supplier_claim_cycle.supplier_claim_group_user'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_supplier_claim_admin_all" model="ir.rule">
            <field name="name">Supplier Claim Admin all records</field>
            <field name="model_id" ref="ab_supplier_claim_cycle.model_ab_supplier_claim_cycle"/>
