<odoo>
<record id="view_ab_oms_connection_list" model="ir.ui.view"><field name="name">ab_oms_connection.list</field><field name="model">ab_oms_connection</field><field name="arch" type="xml">
    <list><field name="name"/><field name="branch_id"/><field name="company_id"/><field name="endpoint"/><field name="database"/><field name="db_serial"/><field name="store_serial"/></list></field></record>
<record id="view_ab_oms_connection_form" model="ir.ui.view"><field name="name">ab_oms_connection.form</field><field name="model">ab_oms_connection</field><field name="arch" type="xml">
    <form><header><button name="action_verify" string="Verify Connection" type="object"/></header><sheet><group><field name="name"/><field name="branch_id"/><field name="company_id"/><field name="endpoint"/><field name="database"/><field name="db_serial"/><field name="store_serial"/><field name="api_key" password="True" groups="ab_crm_core.group_manager"/><field name="verified"/><field name="active"/></group></sheet></form></field></record>
<record id="action_ab_oms_connection" model="ir.actions.act_window"><field name="name">Branch Connections</field><field name="res_model">ab_oms_connection</field><field name="view_mode">list,form</field></record>
<record id="view_attempt_branch_actions" model="ir.ui.view"><field name="name">oms.submission.branch.actions</field><field name="model">ab_oms_attempt</field><field name="inherit_id" ref="ab_oms_core.view_ab_oms_attempt_form"/><field name="arch" type="xml">
    <xpath expr="//header" position="inside"><button name="action_check_status" type="object" string="Check Branch Status"/></xpath></field></record><record id="mapping_list" model="ir.ui.view"><field name="name">oms.reference.mapping.list</field><field name="model">ab_oms_reference_map</field><field name="arch" type="xml">
    <list><field name="name"/><field name="branch_id"/><field name="source"/><field name="product_reference"/><field name="unit_reference"/><field name="branch_product_reference"/><field name="unit_factor"/></list></field></record>
<record id="mapping_form" model="ir.ui.view"><field name="name">oms.reference.mapping.form</field><field name="model">ab_oms_reference_map</field><field name="arch" type="xml">
    <form><sheet><group><field name="name"/><field name="branch_id"/><field name="company_id"/><field name="source"/><field name="product_reference"/><field name="unit_reference"/><field name="branch_product_reference"/><field name="unit_factor"/><field name="active"/></group></sheet></form></field></record>
<record id="action_mapping" model="ir.actions.act_window"><field name="name">Product and Unit Mappings</field><field name="res_model">ab_oms_reference_map</field><field name="view_mode">list,form</field></record>
<record id="line_mapping" model="ir.ui.view"><field name="name">oms.line.mapping.form</field><field name="model">ab_oms_line</field><field name="inherit_id" ref="ab_oms_core.view_ab_oms_line_form"/><field name="arch" type="xml">
    <xpath expr="//header" position="inside"><button name="action_apply_mapping" type="object" string="Apply Product Mapping"/></xpath><field name="branch_product_reference" position="before"><field name="mapping_id" domain="[('branch_id', '=', branch_id)]"/></field></field></record>
</odoo>
