<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_due_salaries_qry_view_tree" model="ir.ui.view">
            <field name="name">ab_due_salaries_qry_view_tree</field>
            <field name="model">ab_due_salaries_qry</field>
            <field name="arch" type="xml">
                <list string="ab_due_salaries_qry_tree" decoration-danger="not internal_working_employee">
                    <field name="costcenter_code" optional="show"/>
                    <field name="costcenter_id" optional="show"/>
                    <field name="account_id" optional="show"/>
                    <field name="balance" optional="show"/>
                    <field name="internal_working_employee" optional="show"/>
                    <field name="redirected_to_ids" widget="many2many_tags" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="ab_due_salaries_qry_view_form" model="ir.ui.view">
            <field name="name">ab_due_salaries_qry_view_form</field>
            <field name="model">ab_due_salaries_qry</field>
            <field name="arch" type="xml">
                <form string="ab_due_salaries_qry_form">
                    <sheet>
                        <group>
                            <field name="costcenter_code"/>
                            <field name="costcenter_id"/>
                            <field name="account_id"/>
                            <field name="balance"/>
                            <field name="redirected_to_ids" widget="many2many_tags"/>
                        </group>
                        <notebook>
                            <page string="Due Salaries Details">
                                <field name="due_salary_details_html"/>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_due_salaries_qry_view_search" model="ir.ui.view">
            <field name="name">ab_due_salaries_qry_view_search</field>
            <field name="model">ab_due_salaries_qry</field>
            <field name="arch" type="xml">
                <search string="Due Salaries Search">
                    <field name="costcenter_id"/>
                    <field name="account_id"/>
                    <field name="balance"/>
                    <field name="internal_working_employee"/>
                    <field name="redirected_to_ids" widget="many2many_tags"/>
                </search>
            </field>
        </record>
        <record id="ab_due_salaries_qry_action" model="ir.actions.act_window">
            <field name="name">Due Salaries Report</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_due_salaries_qry</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="ab_due_salaries_qry_menu" name="Due Salaries Enquiry" parent="ab_accounting.reports"
                  action="ab_due_salaries_qry_action" sequence="3"/>


    </data>
</odoo>