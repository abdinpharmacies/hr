<odoo>
    <record id="category_monitor" model="ir.module.category"><field name="name">Queue Monitor</field><field name="sequence">80</field></record>
    <record id="privilege_monitor" model="res.groups.privilege"><field name="name">Queue Monitor</field><field name="category_id" ref="category_monitor"/></record>
    <record id="group_user" model="res.groups"><field name="name">Monitor User</field><field name="privilege_id" ref="privilege_monitor"/></record>
    <record id="group_admin" model="res.groups"><field name="name">Monitor Administrator</field><field name="privilege_id" ref="privilege_monitor"/><field name="implied_ids" eval="[(4, ref('group_user'))]"/></record>
    <record id="base.group_system" model="res.groups"><field name="implied_ids" eval="[(4, ref('group_admin'))]"/></record>
</odoo>
