<odoo>
    <record id="definition_list" model="ir.ui.view">
        <field name="name">ab.queue.monitor.definition.list</field><field name="model">ab_queue_monitor_definition</field>
        <field name="arch" type="xml">
        <list create="0" edit="0" delete="0" decoration-muted="not active">
            <field name="module_name"/><field name="method_name"/><field name="model_name"/><field name="backend"/>
            <field name="discovery_type" widget="badge"/><field name="last_seen_at"/><field name="active" optional="hide"/>
        </list></field>
    </record>
    <record id="definition_form" model="ir.ui.view">
        <field name="name">ab.queue.monitor.definition.form</field><field name="model">ab_queue_monitor_definition</field>
        <field name="arch" type="xml">
        <form create="0" edit="0" delete="0">
            <header><button name="action_executions" type="object" string="Executions" class="btn-primary" icon="fa-list" invisible="not runtime_support"/></header>
            <sheet><div class="oe_title"><h1><field name="method_name"/></h1></div>
                <group string="Overview"><group><field name="module_name"/><field name="module_label"/><field name="model_name"/><field name="backend"/></group><group><field name="discovery_type" widget="badge"/><field name="runtime_support"/><field name="active"/></group></group>
                <group string="Source"><group><field name="source_file"/><field name="source_class"/><field name="source_line"/></group><group><field name="signature"/><field name="discovered_at"/><field name="last_seen_at"/><field name="session_id" options="{'no_open': False}"/></group></group>
                <group string="Runtime"><group><field name="latest_state"/><field name="channel"/><field name="execution_count"/><field name="failure_count"/></group><group><field name="latest_uuid"/><field name="latest_at"/></group></group>
                <group string="Documentation" groups="ab_queue_monitor.group_admin"><field name="documentation" nolabel="1"/></group>
            </sheet>
        </form></field>
    </record>
    <record id="definition_search" model="ir.ui.view">
        <field name="name">ab.queue.monitor.definition.search</field><field name="model">ab_queue_monitor_definition</field>
        <field name="arch" type="xml">
        <search><field name="method_name"/><field name="module_name"/><field name="model_name"/>
            <filter name="active" string="Active" domain="[('active','=',True)]"/>
            <filter name="archived" string="Removed" domain="[('active','=',False)]"/>
            <filter name="static" string="Static" domain="[('discovery_type','=','static')]"/>
            <filter name="runtime" string="Runtime" domain="[('discovery_type','=','runtime')]"/>
            <filter name="module" string="Module" context="{'group_by':'module_name'}"/>
        </search></field>
    </record>
    <record id="definitions_action" model="ir.actions.act_window"><field name="name">Job Definitions</field><field name="res_model">ab_queue_monitor_definition</field><field name="view_mode">list,form</field><field name="context">{'active_test': False, 'search_default_active': 1, 'search_default_module': 1}</field></record>
    <record id="session_list" model="ir.ui.view">
        <field name="name">ab.queue.monitor.session.list</field>
        <field name="model">ab_queue_monitor_session</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="started_at"/><field name="state" widget="badge"/><field name="duration"/>
                <field name="modules_scanned"/><field name="files_scanned"/><field name="definitions_count"/>
                <field name="new_count"/><field name="removed_count"/>
            </list>
        </field>
    </record>
    <record id="session_form" model="ir.ui.view">
        <field name="name">ab.queue.monitor.session.form</field>
        <field name="model">ab_queue_monitor_session</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group string="Job Discovery">
                        <group><field name="started_at"/><field name="finished_at"/><field name="duration"/><field name="state"/></group>
                        <group><field name="modules_scanned"/><field name="files_scanned"/><field name="definitions_count"/><field name="modules_count"/><field name="runtime_count"/></group>
                    </group>
                    <group string="Changes"><field name="new_count"/><field name="removed_count"/><field name="unchanged_count"/><field name="changes"/></group>
                    <group string="Scan Warnings"><field name="warnings" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="sessions_action" model="ir.actions.act_window"><field name="name">Discovery History</field><field name="res_model">ab_queue_monitor_session</field><field name="view_mode">list,form</field></record>
    <record id="dashboard_action" model="ir.actions.client"><field name="name">Background Job Monitor</field><field name="tag">ab_queue_monitor.dashboard</field><field name="path">queue-monitor</field></record>
    <menuitem id="menu_root" name="Queue Monitor" sequence="85" groups="ab_queue_monitor.group_user" web_icon="ab_queue_monitor,static/description/icon.png"/>
    <menuitem id="menu_dashboard" name="Monitor" parent="menu_root" action="dashboard_action" sequence="10"/>
    <menuitem id="menu_definitions" name="Job Definitions" parent="menu_root" action="definitions_action" sequence="20"/>
    <menuitem id="menu_sessions" name="Discovery History" parent="menu_root" action="sessions_action" sequence="30"/>
</odoo>
