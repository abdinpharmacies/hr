<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ab_queue_monitor.Dashboard">
        <div class="abqm" t-att-aria-busy="state.loading || state.busy">
            <header class="abqm-header">
                <div><div class="abqm-heading"><i class="fa fa-tasks" aria-hidden="true"/><h1>Background Job Monitor</h1></div>
                    <div class="abqm-muted" t-if="state.data?.session">Last discovery: <span t-esc="state.data.session.started_at"/> <span class="abqm-divider">/</span> <t t-esc="state.data.session.definitions_count"/> <span>Job Definitions</span></div>
                </div>
                <div class="abqm-actions">
                    <button class="btn btn-light" t-on-click="history" title="Discovery History" aria-label="Discovery History"><i class="fa fa-history"/></button>
                    <button class="btn btn-light" t-on-click="refresh" t-att-disabled="state.loading" title="Runtime Refresh"><i class="fa fa-refresh"/> <span>Runtime Refresh</span></button>
                    <button t-if="state.data?.can_discover" class="btn abqm-primary" t-on-click="discover" t-att-disabled="state.busy"><i class="fa fa-search"/> <span t-if="state.data?.session?.state === 'scanning'">Resume Discovery</span><span t-else="">Discover Jobs</span></button>
                </div>
            </header>
            <div t-if="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/>
            <section class="abqm-progress" t-if="state.scan || state.data?.session?.state === 'scanning'" aria-live="polite">
                <t t-set="scan" t-value="state.scan || state.data.session"/>
                <div class="abqm-section-title"><h2 t-if="scan.state === 'done'">Discovery Complete</h2><h2 t-elif="state.busy">Discovering Jobs</h2><h2 t-else="">Discovery Paused</h2><span><t t-esc="scan.modules_scanned"/> / <t t-esc="scan.modules_total"/> <span>Modules</span></span></div>
                <progress t-att-value="scan.modules_scanned" t-att-max="scan.modules_total || 1"/>
                <div class="abqm-progress-meta"><span><t t-esc="scan.files_scanned"/> / <t t-esc="scan.files_total"/> <span>Python Files</span></span><span><t t-esc="scan.definitions_count"/> <span>Job Definitions</span></span><span><t t-esc="scan.elapsed || 0"/> s</span><span t-if="scan.state === 'done'"><t t-esc="scan.new_count"/> <span>New</span> · <t t-esc="scan.removed_count"/> <span>Removed</span></span>
                    <button t-if="state.busy" class="btn btn-sm btn-light" t-on-click="pause"><i class="fa fa-pause"/> <span>Pause</span></button>
                    <button t-if="!state.busy &amp;&amp; scan.state === 'scanning' &amp;&amp; state.data?.can_discover" class="btn btn-sm btn-light" t-on-click="cancel"><i class="fa fa-times"/> <span>Cancel Discovery</span></button>
                </div><div t-if="scan.warnings" class="alert alert-warning mt-2 mb-0">Discovery contains warnings. <button class="btn btn-link p-0" t-on-click="history">View History</button></div>
            </section>
            <div t-if="!state.data" class="abqm-skeleton"><div/><div/><div/></div>
            <t t-if="state.data">
                <section class="abqm-kpis"><div t-foreach="kpis" t-as="kpi" t-key="kpi.key" t-att-class="'abqm-kpi ' + kpi.tone"><i t-att-class="'fa ' + kpi.icon"/><span t-esc="kpi.label"/><strong t-esc="kpi.value.toLocaleString()"/></div></section>
                <section class="abqm-runner"><div><i class="fa fa-heartbeat"/><h2>Runner Health</h2><span t-att-class="'abqm-pill ' + (state.data.runner.status === 'online' ? 'completed' : 'unknown')"><t t-if="state.data.runner.status === 'online'">ONLINE</t><t t-else="">UNKNOWN</t></span></div>
                    <div><span>Database</span><code t-esc="state.data.runner.database"/></div><div><span>Last Activity</span><b t-esc="state.data.runner.last_activity || '—'"/></div><p t-esc="state.data.runner.evidence"/>
                </section>
                <div class="abqm-workspace">
                    <aside class="abqm-modules"><h2>Modules with Jobs</h2><button t-att-class="!state.filters.module ? 'selected' : ''" t-on-click="() => this.module('')"><span>All Modules</span><b t-esc="state.data.kpis.modules"/></button>
                        <button t-foreach="state.data.modules" t-as="module" t-key="module.name" t-att-class="state.filters.module === module.name ? 'selected' : ''" t-on-click="() => this.module(module.name)"><span><code t-esc="module.name"/><small t-esc="module.label"/><small class="abqm-module-counts"><span><t t-esc="module.running"/> <t>Running</t></span> · <span><t t-esc="module.pending"/> <t>Pending</t></span> · <span><t t-esc="module.failed"/> <t>Failed</t></span></small></span><b t-esc="module.count"/></button>
                    </aside>
                    <main class="abqm-results">
                        <div class="abqm-tabs" role="tablist"><button role="tab" t-att-aria-selected="state.tab === 'definitions'" t-att-class="state.tab === 'definitions' ? 'selected' : ''" t-on-click="() => this.setTab('definitions')">Job Definitions</button><button role="tab" t-att-aria-selected="state.tab === 'executions'" t-att-class="state.tab === 'executions' ? 'selected' : ''" t-on-click="() => this.setTab('executions')">Executions</button></div>
                        <form class="abqm-filters" t-on-submit.prevent="filter">
                            <div class="abqm-search"><i class="fa fa-search"/><input type="search" t-model="state.filters.search" placeholder="Search jobs" aria-label="Search jobs"/><button type="submit" class="btn btn-sm" title="Search" aria-label="Search"><i class="fa fa-arrow-right"/></button></div>
                            <select t-model="state.filters.status" t-on-change="filter" aria-label="State"><option value="">All States</option><option t-foreach="state.data.statuses" t-as="status" t-key="status.value" t-att-value="status.value" t-esc="status.label"/></select>
                            <select t-if="state.tab === 'executions'" t-model="state.filters.runtime_state" t-on-change="filter" aria-label="Queue State"><option value="">Queue State</option><option t-foreach="runtimeStates" t-as="status" t-key="status[0]" t-att-value="status[0]" t-esc="status[1]"/></select>
                            <select t-model="state.filters.channel" t-on-change="filter" aria-label="Channel"><option value="">All Channels</option><option t-foreach="state.data.channels" t-as="channel" t-key="channel" t-att-value="channel" t-esc="channel"/></select>
                            <select t-model="state.filters.discovery" t-on-change="filter" aria-label="Discovery Type"><option value="">All Discovery Types</option><option value="static">Static</option><option value="runtime">Runtime</option><option value="both">Both</option></select>
                            <input type="date" t-model="state.filters.date" t-on-change="filter" aria-label="Created Since" title="Created Since"/>
                            <label><input type="checkbox" t-model="state.filters.error" t-on-change="filter"/> Errors Only</label><label><input type="checkbox" t-model="state.filters.active" t-on-change="filter"/> Active Only</label>
                            <button type="button" class="btn btn-sm btn-light" t-on-click="clear" title="Clear Filters" aria-label="Clear Filters"><i class="fa fa-filter"/> <i class="fa fa-times"/></button>
                        </form>
                        <div class="abqm-table-wrap" t-att-class="{ 'abqm-loading': state.loading }">
                            <table class="abqm-table"><thead><tr><th>Job</th><th>Status</th><th>Channel</th><th t-if="state.tab === 'definitions'">Discovery Type</th><th t-if="state.tab === 'definitions'">Executions</th><th t-if="state.tab === 'executions'">Created</th><th t-if="state.tab === 'executions'">Duration</th><th/></tr></thead>
                                <tbody><tr t-foreach="state.data.rows" t-as="row" t-key="(row.backend || '') + row.id"><td><button class="abqm-job-link" t-on-click="() => this.open(row)"><code t-esc="row.method_name || row.method"/></button><small><code t-esc="row.module_name"/></small><small t-if="row.uuid"><code t-esc="row.uuid"/></small></td><td><span t-att-class="'abqm-pill ' + row.status" t-esc="label(row.status)"/><small t-if="row.state" t-esc="row.state"/></td><td><code t-esc="row.channel || '—'"/></td><td t-if="state.tab === 'definitions'"><span t-if="row.discovery_type === 'both'">Both</span><span t-elif="row.discovery_type === 'static'">Static</span><span t-else="">Runtime</span></td><td t-if="state.tab === 'definitions'" t-esc="row.count"/><td t-if="state.tab === 'executions'" t-esc="row.created"/><td t-if="state.tab === 'executions'"><t t-esc="row.duration"/> s</td><td><button class="btn btn-sm btn-light" t-on-click="() => this.open(row)" title="Job Details" aria-label="Job Details"><i class="fa fa-external-link"/></button></td></tr></tbody>
                            </table>
                            <div class="abqm-empty" t-if="!state.data.rows.length"><i class="fa fa-tasks"/><h3>No matching jobs</h3></div>
                        </div>
                        <footer class="abqm-pagination"><span><t t-esc="state.data.total ? state.offset + 1 : 0"/>–<t t-esc="Math.min(state.offset + 40, state.data.total)"/> / <t t-esc="state.data.total"/></span><button class="btn btn-light" t-on-click="() => this.page(-1)" t-att-disabled="state.offset === 0 || state.loading" title="Previous" aria-label="Previous"><i class="fa fa-chevron-left"/></button><button class="btn btn-light" t-on-click="() => this.page(1)" t-att-disabled="state.offset + 40 >= state.data.total || state.loading" title="Next" aria-label="Next"><i class="fa fa-chevron-right"/></button></footer>
                    </main>
                </div>
            </t>
        </div>
    </t>
    <t t-name="ab_queue_monitor.ExecutionDetails">
        <Dialog title="title" size="'lg'">
            <div class="abqm-detail"><h3><code t-esc="props.data.method"/></h3><div class="abqm-detail-grid"><div><span>UUID</span><code t-esc="props.data.uuid || '—'"/></div><div><span>State</span><code t-esc="props.data.state"/></div><div><span>Channel</span><code t-esc="props.data.channel || '—'"/></div><div><span>Database</span><code t-esc="props.data.database"/></div><div><span>Created</span><b t-esc="props.data.created || '—'"/></div><div><span>Started</span><b t-esc="props.data.started || '—'"/></div><div><span>Finished</span><b t-esc="props.data.finished || '—'"/></div><div><span>Duration</span><b><t t-esc="props.data.duration"/> s</b></div><div><span>Priority</span><b t-esc="props.data.priority"/></div><div><span>Retries</span><b t-esc="props.data.retry"/></div><div><span>Worker</span><b t-esc="props.data.worker || '—'"/></div></div>
            <section t-if="props.data.context"><h4 t-esc="props.data.context.name"/><div class="abqm-context"><div t-foreach="metrics" t-as="metric" t-key="metric.key"><span t-esc="metric.label"/><strong t-esc="metric.value.toLocaleString()"/></div></div><button class="btn btn-light mt-2" t-on-click="openContext"><i class="fa fa-external-link"/> Open Related Record</button></section>
            <section><h4>Arguments and Result</h4><p t-esc="props.data.arguments"/></section>
            <section t-if="props.data.definition"><h4>Source</h4><p><code t-esc="props.data.definition.source_file"/>:<code t-esc="props.data.definition.source_line"/></p><p><code t-esc="props.data.definition.source_class"/></p><button class="btn btn-light" t-on-click="openDefinition"><i class="fa fa-code"/> Job Definition</button></section>
            <details t-if="props.data.error.trim()"><summary>Error</summary><pre t-esc="props.data.error"/></details>
            <section t-if="props.data.dependencies.depends_on?.length || props.data.dependencies.reverse_depends_on?.length"><h4>Dependencies</h4><div><span>Parent Jobs</span><pre t-esc="(props.data.dependencies.depends_on || []).join('\n')"/></div><div><span>Child Jobs</span><pre t-esc="(props.data.dependencies.reverse_depends_on || []).join('\n')"/></div></section></div>
            <t t-set-slot="footer"><button class="btn btn-secondary" t-on-click="props.close">Close</button></t>
        </Dialog>
    </t>
</templates>
