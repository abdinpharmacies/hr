<odoo>
<record id="view_ab_oms_request_list" model="ir.ui.view"><field name="name">ab_oms_request.list</field><field name="model">ab_oms_request</field><field name="arch" type="xml">
    <list><field name="name"/><field name="state"/><field name="branch_id"/><field name="company_id"/><field name="assigned_id"/><field name="customer_id"/><field name="conversation_id"/></list></field></record>
