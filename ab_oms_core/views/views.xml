<record id="action_ab_oms_request" model="ir.actions.act_window"><field name="name">Requests</field><field name="res_model">ab_oms_request</field><field name="view_mode">list,form</field></record>
<record id="view_ab_oms_line_list" model="ir.ui.view"><field name="name">ab_oms_line.list</field><field name="model">ab_oms_line</field><field name="arch" type="xml">
    <list><field name="request_id"/><field name="name"/><field name="branch_product_reference"/><field name="unit_factor"/><field name="quantity"/><field name="price_unit"/><field name="source_product_reference"/></list></field></record>
<record id="view_ab_oms_line_form" model="ir.ui.view"><field name="name">ab_oms_line.form</field><field name="model">ab_oms_line</field><field name="arch" type="xml">
    <form><header></header><sheet><group><field name="request_id"/><field name="name"/><field name="branch_product_reference"/><field name="unit_factor"/><field name="quantity"/><field name="price_unit"/><field name="source_product_reference"/><field name="source_unit_reference"/><field name="shortage_reason"/><field name="shortage_detail"/><field name="shortage_authorization"/><field name="branch_id"/><field name="company_id"/></group></sheet></form></field></record>
<record id="action_ab_oms_line" model="ir.actions.act_window"><field name="name">Request Lines</field><field name="res_model">ab_oms_line</field><field name="view_mode">list,form</field></record>
<record id="view_ab_oms_attempt_list" model="ir.ui.view"><field name="name">ab_oms_attempt.list</field><field name="model">ab_oms_attempt</field><field name="arch" type="xml">
    <list><field name="request_id"/><field name="token"/><field name="revision"/><field name="state"/><field name="queued"/><field name="retired"/><field name="can_edit"/></list></field></record>
<record id="view_ab_oms_attempt_form" model="ir.ui.view"><field name="name">ab_oms_attempt.form</field><field name="model">ab_oms_attempt</field><field name="arch" type="xml">
    <form><header><button name="action_correct" string="Correct Rejected Submission" type="object"/><button name="action_retry" string="Retry Original Operation" type="object"/></header><sheet><group><field name="request_id"/><field name="token"/><field name="revision"/><field name="state"/><field name="queued"/><field name="retired"/><field name="can_edit"/><field name="branch_header_id"/><field name="invoice_reference"/><field name="last_error"/><field name="last_success"/><field name="payload"/><field name="destination"/><field name="history"/><field name="result"/><field name="branch_id"/><field name="company_id"/></group></sheet></form></field></record>
<record id="action_ab_oms_attempt" model="ir.actions.act_window"><field name="name">Submissions</field><field name="res_model">ab_oms_attempt</field><field name="view_mode">list,form</field></record>
<record id="view_ab_oms_note_list" model="ir.ui.view"><field name="name">ab_oms_note.list</field><field name="model">ab_oms_note</field><field name="arch" type="xml">
    <list><field name="request_id"/><field name="branch_id"/><field name="company_id"/></list></field></record>
<record id="view_ab_oms_note_form" model="ir.ui.view"><field name="name">ab_oms_note.form</field><field name="model">ab_oms_note</field><field name="arch" type="xml">
    <form><header></header><sheet><group><field name="request_id"/><field name="body"/><field name="branch_id"/><field name="company_id"/></group></sheet></form></field></record>
<record id="action_ab_oms_note" model="ir.actions.act_window"><field name="name">Follow-up Notes</field><field name="res_model">ab_oms_note</field><field name="view_mode">list,form</field></record>
<record id="view_ab_oms_price_history_list" model="ir.ui.view"><field name="name">ab_oms_price_history.list</field><field name="model">ab_oms_price_history</field><field name="arch" type="xml">
    <list><field name="line_id"/><field name="old_price"/><field name="new_price"/><field name="changed_by"/><field name="change_date"/><field name="branch_id"/><field name="company_id"/></list></field></record>
<record id="view_ab_oms_price_history_form" model="ir.ui.view"><field name="name">ab_oms_price_history.form</field><field name="model">ab_oms_price_history</field><field name="arch" type="xml">
    <form><header></header><sheet><group><field name="line_id"/><field name="old_price"/><field name="new_price"/><field name="changed_by"/><field name="change_date"/><field name="branch_id"/><field name="company_id"/></group></sheet></form></field></record>
<record id="action_ab_oms_price_history" model="ir.actions.act_window"><field name="name">Price History</field><field name="res_model">ab_oms_price_history</field><field name="view_mode">list,form</field></record>
<record id="view_correction_form" model="ir.ui.view"><field name="name">oms.correction.form</field><field name="model">ab_oms_correction</field><field name="arch" type="xml">
    <form><group><field name="attempt_id"/><field name="promotion_reference"/><field name="approval_note" required="1"/><field name="line_ids"><list editable="bottom" create="0" delete="0"><field name="sequence"/><field name="name"/><field name="quantity"/></list></field></group><footer><button name="action_apply" type="object" string="Submit Corrected Revision" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
<record id="view_replacement_form" model="ir.ui.view"><field name="name">oms.replacement.form</field><field name="model">ab_oms_replacement</field><field name="arch" type="xml">
    <form><group><field name="request_id" readonly="1"/><field name="branch_id"/></group><footer><button name="action_create" type="object" string="Create Linked Replacement" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record></odoo>
