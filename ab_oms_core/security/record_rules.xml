<odoo>
<record id="rule_ab_oms_request_company" model="ir.rule"><field name="name">Requests: company</field><field name="model_id" ref="model_ab_oms_request"/><field name="domain_force">[('company_id', 'in', company_ids)]</field></record>
<record id="rule_ab_oms_request_branch" model="ir.rule"><field name="name">Requests: branch</field><field name="model_id" ref="model_ab_oms_request"/><field name="domain_force">[] if user.has_group('ab_crm_core.group_manager') or user.has_group('base.group_system') else [('branch_id.user_ids', 'in', [user.id])]</field></record>
