<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <function model="ir.model.data" name="write">
            <value model="ir.model.data" search="[('module', '=', 'ab_request_management'), ('name', '=', 'ir_cron_auto_close_resolved_complaints')]"/>
            <value eval="{'noupdate': False}"/>
        </function>

        <record id="ir_cron_auto_close_resolved_complaints" model="ir.cron">
            <field name="name">Auto Close Resolved Requests</field>
            <field name="model_id" ref="model_ab_request"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_close_resolved_requests()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="DateTime.now() + relativedelta(days=1)"/>
            <field name="active">True</field>
        </record>

        <function model="ir.model.data" name="write">
            <value model="ir.model.data" search="[('module', '=', 'ab_request_management'), ('name', '=', 'ir_cron_auto_close_resolved_complaints')]"/>
            <value eval="{'noupdate': True}"/>
        </function>
    </data>
</odoo>
