<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ab_request_website_view_search" model="ir.ui.view">
        <field name="name">ab_request_website.search</field>
        <field name="model">ab_request_website</field>
        <field name="arch" type="xml">
            <search string="Complaints Form">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="customer_email"/>
                <field name="requester_type"/>
                <field name="employee_code"/>
                <field name="commercial_register_number"/>
                <field name="national_id"/>
                <field name="subject"/>
                <field name="request_category_id"/>
                <field name="request_type_id"/>
                <filter name="filter_new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="filter_under_review" string="Under Review" domain="[('state', '=', 'reviewed')]"/>
                <filter name="filter_closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_category" string="Category" context="{'group_by': 'request_category_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'request_type_id'}"/>
            </search>
        </field>
    </record>

    <record id="ab_request_website_view_list" model="ir.ui.view">
        <field name="name">ab_request_website.list</field>
        <field name="model">ab_request_website</field>
        <field name="arch" type="xml">
            <list string="Complaints Form" default_order="create_date desc" create="false" delete="false"
                  decoration-info="state == 'new'" decoration-muted="state == 'closed'">
                <field name="active" column_invisible="True"/>
                <field name="name"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state == 'reviewed'"
                       decoration-muted="state == 'closed'"/>
                <field name="customer_name"/>
                <field name="customer_phone"/>
                <field name="customer_email" optional="show"/>
                <field name="requester_type" optional="show"/>
                <field name="employee_code" optional="show"/>
                <field name="commercial_register_number" optional="hide"/>
                <field name="national_id" optional="hide"/>
                <field name="subject"/>
                <field name="request_category_id" optional="show"/>
                <field name="request_type_id"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="ab_request_website_view_form" model="ir.ui.view">
        <field name="name">ab_request_website.form</field>
        <field name="model">ab_request_website</field>
        <field name="arch" type="xml">
            <form string="External Request" create="false" delete="false">
                <header>
                    <button name="action_mark_under_review"
                            string="Start Review"
                            type="object"
                            class="btn-primary"
                            groups="ab_request_management.group_ab_request_management_viewer,ab_request_management.group_ab_request_management_manager,ab_request_management.group_ab_request_management_admin"
                            invisible="state != 'new'"/>
                    <button name="action_close"
                            string="Close"
                            type="object"
                            class="btn-primary"
                            groups="ab_request_management.group_ab_request_management_viewer,ab_request_management.group_ab_request_management_manager,ab_request_management.group_ab_request_management_admin"
                            invisible="state != 'reviewed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,reviewed,closed" readonly="1"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <span class="badge text-bg-info">External</span>
                        <label for="subject"/>
                        <h1>
                            <field name="subject" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="External Requester">
                            <field name="name" readonly="1"/>
                            <field name="customer_name" readonly="1"/>
                            <field name="customer_phone" readonly="1"/>
                            <field name="customer_email" readonly="1"/>
                            <field name="requester_type" readonly="1"/>
                            <field name="employee_code" readonly="1" invisible="requester_type != 'employee'"/>
                            <field name="commercial_register_number" readonly="1" invisible="requester_type != 'supplier'"/>
                            <field name="national_id" readonly="1"/>
                            <field name="source" readonly="1"/>
                        </group>
                        <group string="Classification">
                            <field name="request_category_id"
                                   domain="[('is_public', '=', True)]"
                                   readonly="1"/>
                            <field name="request_type_id"
                                   domain="[('category_id', '=', request_category_id), ('is_public', '=', True)]"
                                   readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="description" nolabel="1" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Follow-ups">
                            <field name="followup_ids" string="Follow-up" mode="list,form" readonly="state == 'closed'">
                                <list>
                                    <field name="create_date" readonly="1"/>
                                    <field name="note"/>
                                    <field name="visible_to_user" widget="boolean_toggle"/>
                                    <field name="attachment_ids" widget="many2many_tags"/>
                                </list>
                                <form string="Follow-up" class="ab_request_website_followup_form">
                                    <sheet class="ab_request_website_followup_sheet">
                                        <div class="ab_request_website_followup_panel">
                                            <div class="ab_request_website_followup_field ab_request_website_followup_note_block">
                                                <label for="note" string="Note"/>
                                                <field name="note"
                                                       nolabel="1"
                                                       placeholder="Write the follow-up note..."/>
                                            </div>
                                            <div class="ab_request_website_followup_meta_row">
                                                <div class="ab_request_website_followup_visibility">
                                                    <field name="visible_to_user" nolabel="1" widget="boolean_toggle"/>
                                                    <label for="visible_to_user" string="Visible to User"/>
                                                </div>
                                                <div class="ab_request_website_followup_attachments">
                                                    <label for="attachment_ids" string="Attachments"/>
                                                    <field name="attachment_ids"
                                                           nolabel="1"
                                                           widget="many2many_binary"/>
                                                </div>
                                            </div>
                                        </div>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ab_request_website_action" model="ir.actions.act_window">
        <field name="name">Complaints Form</field>
        <field name="res_model">ab_request_website</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="ab_request_website_view_search"/>
        <field name="context">{'search_default_filter_new': 1}</field>
    </record>
</odoo>
