<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="claim_costcenter_read" model="ir.rule">
        <field name="name">Supplier cost centers for claims</field>
        <field name="model_id" ref="ab_costcenter.model_ab_costcenter"/>
        <field name="groups" eval="[(4, ref('supplier_claim_group_user')),
                                     (4, ref('supplier_claim_group_inventory')),
                                     (4, ref('supplier_claim_group_purchasing')),
                                     (4, ref('supplier_claim_group_supplier_accounts')),
                                     (4, ref('supplier_claim_group_bank_accounts')),
                                     (4, ref('supplier_claim_group_reviewer')),
                                     (4, ref('supplier_claim_group_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') else [('code', '=like', '1-%')]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
