<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="claim_supplier_bracket_read" model="ir.rule">
    <field name="name">Claim brackets for accessible suppliers</field>
    <field name="model_id" ref="ab_supplier.model_ab_supplier_bracket"/>
    <field name="groups" eval="[(4, ref('supplier_claim_group_user')),(4, ref('supplier_claim_group_inventory')),(4, ref('supplier_claim_group_purchasing')),(4, ref('supplier_claim_group_supplier_accounts')),(4, ref('supplier_claim_group_bank_accounts')),(4, ref('supplier_claim_group_reviewer')),(4, ref('supplier_claim_group_admin'))]"/>
    <field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') or user.has_group('ab_supplier_claim_cycle.supplier_claim_group_admin') else list(user.env['ab_supplier'].with_context(active_test=False).search([])._get_bracket_domain())</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>
</odoo>
