<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_supplier_claim_reviewer_note_form" model="ir.ui.view">
        <field name="name">ab_supplier_claim_reviewer_note.form</field>
        <field name="model">ab_supplier_claim_reviewer_note</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="claim_id" invisible="True" force_save="1"/>
                    <field name="body"/>
                </group>
                <footer>
                    <button name="action_post_note" type="object" string="Log note" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_supplier_claim_reviewer_note" model="ir.actions.act_window">
        <field name="name">Log note</field>
        <field name="res_model">ab_supplier_claim_reviewer_note</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_supplier_claim_reviewer_note_form"/>
        <field name="target">new</field>
    </record>
</odoo>
