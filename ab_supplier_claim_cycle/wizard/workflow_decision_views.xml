<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_supplier_claim_stage_decision_form" model="ir.ui.view">
        <field name="name">supplier.claim.stage.decision.form</field>
        <field name="model">ab_supplier_claim_stage_decision</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="stage_state_id"/>
                    <field name="decision"/>
                    <field name="reason"/>
                    <field name="followup_date" invisible="decision != 'deferred'"
                           required="decision == 'deferred'"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
