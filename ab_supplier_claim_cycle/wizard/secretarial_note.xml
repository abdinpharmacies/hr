<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="secretarial_note_wizard_form" model="ir.ui.view">
    <field name="name">supplier.claim.secretarial.note</field>
    <field name="model">ab_supplier_claim_cycle.note.wizard</field>
    <field name="arch" type="xml">
      <form string="Add Secretarial Note">
        <field name="claim_id" invisible="True"/>
        <group>
          <field name="note" placeholder="Write your note. It will be saved in Stage History."/>
        </group>
        <footer>
          <button name="action_save" string="Save Note" type="object" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
