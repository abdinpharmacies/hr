<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="invoice_view_tree" model="ir.ui.view">
        <field name="name">supplier.claim.list</field>
        <field name="model">ab_supplier_claim_cycle</field>
        <field name="arch" type="xml">
            <list duplicate="false">
                <field name="claim_reference" optional="show"/>
                <field name="supplier_id"/>
                <field name="num_of_invoice"/>
                <field name="claim_amount"/>
                <field name="claim_month"/>
                <field name="payment_nature"/>
                <field name="workflow_id" optional="show"/>
                <field name="current_stage_names" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="user_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="invoice_view_form" model="ir.ui.view">
        <field name="name">supplier.claim.form</field>
        <field name="model">ab_supplier_claim_cycle</field>
        <field name="arch" type="xml">
            <form duplicate="false" class="o_scc_form">
                <header class="o_scc_workflow_header">
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"
                            invisible="state != 'draft' or not active"
                            groups="ab_supplier_claim_cycle.supplier_claim_group_user,ab_supplier_claim_cycle.supplier_claim_group_admin"/>
                    <button name="action_resubmit" string="Resubmit" type="object" class="btn-primary"
                            invisible="state != 'returned' or not active"
                            groups="ab_supplier_claim_cycle.supplier_claim_group_user,ab_supplier_claim_cycle.supplier_claim_group_admin"/>
                    <div class="o_scc_header_actions" invisible="state != 'in_progress'">
                        <field name="stage_state_ids" widget="supplier_claim_workflow_actions"
                               class="o_scc_workflow_actions_field" readonly="True" nolabel="1"/>
                    </div>
                </header>
                <sheet>
                    <field name="state" invisible="True"/>
                    <field name="amounts_mismatch" invisible="True"/>
                    <div class="alert alert-warning o_scc_amount_warning" role="status"
                         invisible="not amounts_mismatch">
                        <strong>Amounts do not match.</strong>
                        Claim Amount minus Tax Discount Amount does not equal Net Claim Amount.
                        Please review the amounts.
                    </div>
                    <div class="oe_title o_scc_title" invisible="not claim_reference">
                        <h1>
                            <field name="claim_reference" readonly="True" nolabel="1"/>
                        </h1>
                    </div>
                    <field name="active" invisible="True"/>
                    <field name="available_workflow_ids" invisible="True"/>
                    <field name="editable_field_names" invisible="True"/>
                    <field name="current_sequence" invisible="True"/>
                    <field name="rejection_stage_state_id" invisible="True"/>
                    <field name="stage_state_ids" widget="supplier_claim_workflow_diagram" readonly="True" nolabel="1"
                           invisible="state == 'draft'"/>
                    <group name="claim_entry" class="o_scc_claim_entry o_scc_entry_grid" col="2">
                        <group name="supplier_info" string="Supplier info" class="o_scc_panel o_scc_classification">
                            <field name="supplier_id" readonly="'supplier_id' not in editable_field_names"
                                   options="{'no_create': True}"/>
                            <field name="area" readonly="'area' not in editable_field_names"/>
                            <field name="delivery_representative_name"
                                   readonly="'delivery_representative_name' not in editable_field_names"/>
                            <field name="delivery_representative_phone"
                                   readonly="'delivery_representative_phone' not in editable_field_names"/>
                            <field name="confirm_contact_info"
                                   readonly="'confirm_contact_info' not in editable_field_names"/>
                        </group>
                        <group name="claim_info" string="Claim info" class="o_scc_panel o_scc_details">
                            <field name="num_of_invoice" readonly="'num_of_invoice' not in editable_field_names"/>
                            <field name="claim_amount" readonly="'claim_amount' not in editable_field_names"/>
                            <field name="claim_month" readonly="'claim_month' not in editable_field_names"
                                   widget="supplier_claim_month"/>
                            <field name="type_of_invoice" readonly="'type_of_invoice' not in editable_field_names"/>
                            <field name="section" readonly="'section' not in editable_field_names"/>
                            <field name="payment_nature" readonly="'payment_nature' not in editable_field_names"/>
                            <field name="tax_classification"
                                   readonly="'tax_classification' not in editable_field_names"/>
                            <field name="workflow_id" readonly="state != 'draft'" invisible="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <div class="o_scc_panel o_scc_workflow_box">
                        <notebook name="claim_workflow_details" class="o_scc_workflow_details">
                            <page name="taxes_amounts" string="Taxes and Amounts">
                                <group>
                                    <field name="tax_discount_decision"
                                           readonly="'tax_discount_decision' not in editable_field_names"/>
                                    <field name="tax_discount_amount"
                                           readonly="'tax_discount_amount' not in editable_field_names"/>
                                    <field name="net_claim_amount"
                                           readonly="'net_claim_amount' not in editable_field_names"/>
                                </group>
                            </page>
                            <page name="claim_documents" string="Documents and Notes">
                                <div class="alert alert-info" role="status"
                                     invisible="not show_participant_attachment_note">Please prefer Chatter for
                                    attachments. Each attachment field accepts one file only; add any additional
                                    attachments in Chatter.</div><group string="Claim Documents and Notes" col="2">
                                <field name="secretarial_notes"
                                       readonly="'secretarial_notes' not in editable_field_names"/>
                                <field name="attachment" filename="attachment_filename" widget="supplier_claim_upload"
                                       readonly="'attachment' not in editable_field_names"/>
                                <field name="attachment_filename" invisible="True"
                                       readonly="'attachment_filename' not in editable_field_names"/>
                                <field name="supplier_cheque_attachment" filename="supplier_cheque_filename"
                                       widget="supplier_claim_upload"
                                       readonly="'supplier_cheque_attachment' not in editable_field_names"/>
                                <field name="supplier_cheque_filename" invisible="True"
                                       readonly="'supplier_cheque_filename' not in editable_field_names"/>
                                <field name="tax_review_attachment" filename="tax_review_filename"
                                       widget="supplier_claim_upload"
                                       readonly="'tax_review_attachment' not in editable_field_names"/>
                                <field name="tax_review_filename" invisible="True"
                                       readonly="'tax_review_filename' not in editable_field_names"/>
                                <field name="payment_request_attachment" filename="payment_request_filename"
                                       widget="supplier_claim_upload"
                                       readonly="'payment_request_attachment' not in editable_field_names"/>
                                <field name="payment_request_filename" invisible="True"
                                       readonly="'payment_request_filename' not in editable_field_names"/>
                                <field name="bank_cheque_attachment" filename="bank_cheque_filename"
                                       widget="supplier_claim_upload"
                                       readonly="'bank_cheque_attachment' not in editable_field_names"/>
                                <field name="bank_cheque_filename" invisible="True"
                                       readonly="'bank_cheque_filename' not in editable_field_names"/>
                            </group>
                                <field name="document_ids" readonly="True" nolabel="1">
                                    <list create="false" edit="false" delete="false">
                                        <field name="filename" column_invisible="True"/>
                                        <field name="kind"/>
                                        <field name="revision"/>
                                        <field name="user_id" string="Uploaded By"/>
                                        <field name="occurred_at" string="Upload Date"/>
                                        <field name="content" filename="filename" widget="binary"/>
                                    </list>
                                </field>
                            </page>
                            <page name="history" string="History">
                                <field name="history_ids" readonly="True" nolabel="1" class="o_scc_history_table">
                                    <list create="false" edit="false" delete="false">
                                        <field name="occurred_at"/>
                                        <field name="user_id"/>
                                        <field name="event" widget="badge"/>
                                        <field name="stage_name" string="Stage" optional="show"/>
                                        <field name="stage_sequence" optional="hide"/>
                                        <field name="decision" widget="badge" optional="show"
                                               decoration-success="decision == 'approved'"
                                               decoration-info="decision == 'deferred'"
                                               decoration-danger="decision == 'rejected'"/>
                                        <field name="display_note" string="Details" optional="show"/>
                                        <field name="followup_date" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </div>
                    <field name="show_participant_attachment_note" invisible="True"/></sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="invoice_view_search" model="ir.ui.view">
        <field name="name">supplier.claim.search</field>
        <field name="model">ab_supplier_claim_cycle</field>
        <field name="arch" type="xml">
            <search>
                <field name="claim_reference"/>
                <field name="supplier_id"/>
                <field name="workflow_id"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="returned" string="Returned" domain="[('state', '=', 'returned')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_workflow" string="Workflow" context="{'group_by': 'workflow_id'}"/>
            </search>
        </field>
    </record>

    <record id="invoice_action" model="ir.actions.act_window">
        <field name="name">All Claims</field>
        <field name="res_model">ab_supplier_claim_cycle</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="invoice_menu" name="All Claims" parent="supplier_claim_cycle_sub_menu" action="invoice_action"
              sequence="10"
              groups="ab_supplier_claim_cycle.supplier_claim_group_user,ab_supplier_claim_cycle.supplier_claim_group_participant,ab_supplier_claim_cycle.supplier_claim_group_reviewer,ab_supplier_claim_cycle.supplier_claim_group_admin"/>
</odoo>
