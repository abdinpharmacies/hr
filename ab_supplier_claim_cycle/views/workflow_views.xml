<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="supplier_claim_workflow_list" model="ir.ui.view">
        <field name="name">supplier.claim.workflow.list</field>
        <field name="model">ab_supplier_claim_workflow</field>
        <field name="arch" type="xml">
            <list duplicate="false">
                <field name="priority" widget="handle"/>
                <field name="name"/>
                <field name="version"/>
                <field name="claim_domain"/>
                <field name="state" widget="badge"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="supplier_claim_workflow_form" model="ir.ui.view">
        <field name="name">supplier.claim.workflow.form</field>
        <field name="model">ab_supplier_claim_workflow</field>
        <field name="arch" type="xml">
            <form duplicate="false">
                <header>
                    <button name="action_publish" string="Publish" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <field name="can_reset_to_draft" invisible="True"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="not can_reset_to_draft"/>
                    <button name="action_new_version" string="New Version" type="object"
                            invisible="state == 'draft'"/>
                    <button name="action_archive_workflow" string="Archive" type="object"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="state != 'draft'"/>
                        <field name="version" readonly="True"/>
                        <field name="priority" readonly="state != 'draft'"/>
                        <field name="active" invisible="True"/>
                    </group>
                    <group string="Claim Matching">
                        <field name="claim_domain" widget="domain"
                               options="{'model': 'ab_supplier_claim_cycle', 'allow_expressions': False}"
                               readonly="state != 'draft'"/>
                    </group>
                    <field name="workflow_stage_ids" invisible="state != 'draft'">
                        <list editable="bottom">
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="approver_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="allowed_field_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </list>
                    </field>
                    <field name="workflow_stage_ids" string="Published Stages"
                           invisible="state != 'published'">
                        <list editable="bottom" create="false" delete="false">
                            <field name="sequence" readonly="True"/>
                            <field name="name"/>
                            <field name="approver_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="allowed_field_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                        </list>
                    </field>
                    <field name="workflow_stage_ids" string="Archived Stages" readonly="True"
                           invisible="state != 'archived'">
                        <list create="false" delete="false">
                            <field name="sequence"/>
                            <field name="name"/>
                            <field name="approver_ids" widget="many2many_tags"/>
                            <field name="allowed_field_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="supplier_claim_workflow_search" model="ir.ui.view">
        <field name="name">supplier.claim.workflow.search</field>
        <field name="model">ab_supplier_claim_workflow</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="archived" string="Archived" domain="[('state', '=', 'archived')]"/>
            </search>
        </field>
    </record>
    <record id="supplier_claim_workflow_action" model="ir.actions.act_window">
        <field name="name">Workflow Configuration</field>
        <field name="res_model">ab_supplier_claim_workflow</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <menuitem id="supplier_claim_workflow_menu" name="Workflow Configuration"
              parent="supplier_claim_cycle_sub_menu" action="supplier_claim_workflow_action"
              sequence="90" groups="ab_supplier_claim_cycle.supplier_claim_group_admin"/>
</odoo>
