[Unit]
Description=CRM messaging durable worker
After=network-online.target
Wants=network-online.target

[Service]
StateDirectory=crm-messaging
StateDirectoryMode=0700
ReadWritePaths=/var/lib/crm-messaging
Type=simple
User=crm-messaging
Group=crm-messaging
WorkingDirectory=/opt/crm-messaging
Environment=CRM_MESSAGING_CONFIG=/etc/crm-messaging/config.json
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/crm-messaging/venv/bin/python -m app.worker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
