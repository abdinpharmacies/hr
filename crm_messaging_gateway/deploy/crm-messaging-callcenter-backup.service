[Unit]
Description=Consistent CRM SQLite backup

[Service]
Type=oneshot
User=abdin_04
Group=abdin_04
WorkingDirectory=/opt/odoo19/worktrees/callcenter19/crm_messaging_gateway
Environment=CRM_MESSAGING_CONFIG=/home/abdin_04/.config/crm-messaging/config.json
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/abdin_04/.config/crm-messaging/venv/bin/python -m app.backup
StateDirectory=crm-messaging-callcenter
StateDirectoryMode=0700
ReadWritePaths=/var/lib/crm-messaging-callcenter
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
