{
  "$schema": "https://opencode.ai/config.json",
  "skills": { "paths": [] },
  "instructions": [
    "{env:OPENCODE_CONFIG_DIR}/../global/rules/no-comments.md",
    "{env:OPENCODE_CONFIG_DIR}/rules/python-odoo-guidelines.md"
  ],
  "permission": {
    "skill": {
      "*": "deny",
      "customize-opencode": "allow",
      "find-skills": "allow",
      "git-commit": "allow",
      "git-interactive-rebase": "allow",
      "trello-workflow": "allow",
      "writing-guidelines": "allow",
      "odoo-*": "allow",
      "odoo19-*": "allow",
      "ab-product-seo-workflow": "allow",
      "bconnect-eplus": "allow",
      "ready-api-enrichment": "allow"
    }
  }
}
