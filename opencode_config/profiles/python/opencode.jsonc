{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      "{env:OPENCODE_CONFIG_DIR}/skills"
    ]
  },
  "instructions": [
    "{env:OPENCODE_CONFIG_DIR}/../global/rules/no-comments.md",
    "{env:OPENCODE_CONFIG_DIR}/rules/python-odoo-guidelines.md",
    "{env:OPENCODE_CONFIG_DIR}/../../../codex_config/profiles/odoo/instructions/rea-evidence.md"
  ],
  "permission": {
    "skill": {
      "*": "deny",
      "apple-design": "allow",
      "software-design": "allow",
      "customize-opencode": "allow",
      "extend-ai-workflow": "allow",
      "find-skills": "allow",
      "git-commit": "allow",
      "git-interactive-rebase": "allow",
      "supabase": "allow",
      "supabase-postgres-best-practices": "allow",
      "tube-scholar": "allow",
      "trello-workflow": "allow",
      "odoo-*": "allow",
      "odoo-development-skill": "allow",
      "odoo19-*": "allow",
      "ab-product-seo-workflow": "allow",
      "bconnect-eplus": "allow",
      "ready-api-enrichment": "allow",
      "ui-ux-pro-max": "allow",
      "sql-optimization-patterns": "allow",
      "postgresql-best-practices": "allow",
      "pg-graph": "allow",
      "reverse-engineer-anything": "allow"
    }
  },
  "mcp": {
    "postgres-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@microsoft/postgres-mcp@0.2.0",
        "run",
        "--no-telemetry"
      ],
      "environment": {
        "POSTGRES_MCP_DISABLE_CWD_ACCESS": "1",
        "POSTGRES_MCP_QUERY_TIMEOUT_MS": "540000"
      },
      "enabled": false
    },
    "rea": {
      "type": "local",
      "command": [
        "npx",
        "--no-install",
        "rea-agents@6.8.0",
        "mcp"
      ],
      "enabled": false
    }
  }
}
