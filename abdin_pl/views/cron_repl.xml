<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <data>
        <record id="pl_reset_cron" model="ir.cron" forcecreate="True">
            <field name="name">P&amp;L Extraction</field>
            <field name="active">True</field>
            <!--            <field name="user_id" ref="base.user_root"/>-->
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>

            <field name="nextcall"
                   eval="(DateTime.now().replace(hour=2, minute=10) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>

            <field name="model_id" ref="model_abdin_pl_pl_temp"/>
            <field name="state">code</field>
            <field name="code">model.reset_pl()</field>
            <!--            <field name="args" eval="'()'"/>-->
        </record>

    </data>
</odoo>