<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_sync_images_wizard_form" model="ir.ui.view">
            <field name="name">ab.website.sale.sync.images.wizard.form</field>
            <field name="model">ab.website.sale.add.many.by.codes.wizard</field>
            <field name="arch" type="xml">
                <form string="Sync Images">
                    <sheet>
                        <group string="Configuration">
                            <field name="directory_path"
                                   required="1"
                                   placeholder="/opt/odoo19/product_images"/>
                        </group>
                        <group string="Results" invisible="not image_sync_summary">
                            <field name="image_sync_summary" nolabel="1" readonly="1"/>
                        </group>
                        <group string="Replacement Confirmation" invisible="not image_sync_confirmation_required">
                            <field name="image_sync_confirmation_message" nolabel="1" readonly="1"/>
                            <field name="image_sync_replacement_count" invisible="1"/>
                            <field name="image_sync_replacement_signature" invisible="1"/>
                        </group>
                        <field name="image_sync_line_ids" nolabel="1" readonly="1" invisible="not image_sync_line_ids">
                            <list string="Image Synchronization Report" create="0" edit="0" delete="0">
                                <field name="product_code"/>
                                <field name="product_name"/>
                                <field name="relative_path"/>
                                <field name="match_method"/>
                                <field name="status"/>
                                <field name="reason"/>
                                <field name="replaces_existing" optional="hide"/>
                                <field name="current_checksum" optional="hide"/>
                                <field name="checksum" optional="hide"/>
                            </list>
                        </field>
                    </sheet>
                    <footer>
                        <button name="action_preview_images" type="object" string="Scan / Preview" class="btn-secondary" groups="base.group_system"/>
                        <button name="action_sync_images" type="object" string="Synchronize Images" class="btn-primary" groups="base.group_system" invisible="image_sync_confirmation_required"/>
                        <button name="action_confirm_replace_images" type="object" string="Replace Existing Images" class="btn-primary" groups="base.group_system" invisible="not image_sync_confirmation_required"/>
                        <button name="action_sync_new_images_only" type="object" string="Keep Existing Images" class="btn-secondary" groups="base.group_system" invisible="not image_sync_confirmation_required"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_add_many_by_codes_wizard_form_require_codes" model="ir.ui.view">
            <field name="name">ab.website.sale.add.many.by.codes.wizard.require.codes</field>
            <field name="model">ab.website.sale.add.many.by.codes.wizard</field>
            <field name="inherit_id" ref="ab_website_sale_product.view_add_many_by_codes_wizard_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='codes_text']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="ab_product_tree_view_sync_images" model="ir.ui.view">
            <field name="name">ab.product.list.sync.images</field>
            <field name="model">ab_product</field>
            <field name="inherit_id" ref="ab_website_sale_product.ab_product_tree_view_add_many_by_codes"/>
            <field name="arch" type="xml">
                <xpath expr="//header/button[@name='action_open_add_many_by_codes_wizard']" position="after">
                    <button name="action_open_sync_images_wizard"
                            type="object"
                            string="Sync Images"
                            class="btn-secondary"
                            groups="base.group_system"
                            display="always"/>
                </xpath>
            </field>
        </record>

        <record id="view_ab_product_kanban_sync_images" model="ir.ui.view">
            <field name="name">ab.product.kanban.sync.images</field>
            <field name="model">ab_product</field>
            <field name="inherit_id" ref="ab_website_sale_product.view_ab_product_kanban_abdin_ecommerce"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban/header/button[@name='action_open_add_many_by_codes_wizard']" position="after">
                    <button name="action_open_sync_images_wizard"
                            type="object"
                            string="Sync Images"
                            class="btn-secondary"
                            groups="base.group_system"
                            display="always"/>
                </xpath>
            </field>
        </record>

        <record id="ab_product_form_view_sync_images" model="ir.ui.view">
            <field name="name">ab.product.form.sync.images</field>
            <field name="model">ab_product</field>
            <field name="inherit_id" ref="ab_website_sale_product.ab_product_form_view_professional"/>
            <field name="arch" type="xml">
                <xpath expr="//group[field[@name='website_product_tmpl_id']]/field[@name='website_product_tmpl_id']" position="after">
                    <field name="website_image_file_found"/>
                    <field name="website_image_file_path" invisible="not website_image_file_found"/>
                </xpath>
                <xpath expr="//div[hasclass('abdin_ecommerce_page_actions')]/button[@name='action_open_website_product_page']" position="after">
                    <button name="action_check_website_product_image" type="object"
                            class="btn abdin_ecommerce_btn_outline btn-block"
                            title="Check Image File">
                        <i class="fa fa-image" title="Image"/>
                        Check Image File
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
