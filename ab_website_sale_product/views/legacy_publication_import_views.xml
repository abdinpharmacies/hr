<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_legacy_publication_import_form" model="ir.ui.view">
        <field name="name">ab_legacy_publication_import.form</field>
        <field name="model">ab_legacy_publication_import</field>
        <field name="arch" type="xml">
            <form string="Match Old Website Publication" delete="false">
                <sheet>
                    <div class="alert alert-info" role="status" invisible="state != 'draft'">
                        Upload the CSV exported from the old product list with the Published filter, then preview all publication changes.
                    </div>
                    <group>
                        <field name="website_id" readonly="state != 'draft'"/>
                        <field name="source_file" filename="source_filename" readonly="state != 'draft'"/>
                        <field name="source_filename" invisible="1"/>
                        <field name="state" invisible="1"/>
                    </group>
                    <group invisible="state == 'draft'">
                        <field name="exported_at" invisible="not exported_at"/>
                        <field name="published_count"/>
                        <field name="missing_count"/>
                        <field name="ineligible_count"/>
                        <field name="create_count"/>
                        <field name="publish_count"/>
                        <field name="unpublish_count"/>
                    </group>
                    <div class="alert alert-warning" role="status"
                         invisible="state == 'draft' or (not missing_count and not ineligible_count)">
                        Products missing from the new catalog or not eligible for sale will not be published.
                    </div>
                    <field name="skipped_code_sample" invisible="not skipped_code_sample"/>
                    <field name="source_digest" invisible="1"/>
                </sheet>
                <footer>
                    <button name="action_preview" type="object" string="Preview Matches" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_apply" type="object" string="Apply Publication Match" class="btn-primary" invisible="state != 'review'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_legacy_publication_import" model="ir.actions.act_window">
        <field name="name">Match Old Website Publication</field>
        <field name="res_model">ab_legacy_publication_import</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_legacy_publication_import_form"/>
        <field name="target">new</field>
    </record>

    <record id="ab_product_list_view_legacy_publication_import" model="ir.ui.view">
        <field name="name">ab.product.list.legacy.publication.import</field>
        <field name="model">ab_product</field>
        <field name="inherit_id" ref="ab_website_sale_product.ab_product_tree_view_add_many_by_codes"/>
        <field name="arch" type="xml">
            <xpath expr="//list/header" position="inside">
                <button name="%(action_legacy_publication_import)d" type="action"
                        string="Match Old Website Publication" class="btn-secondary"
                        display="always" groups="base.group_system"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_legacy_publication_import" name="Match Old Website Publication"
              parent="website_sale.menu_catalog" action="action_legacy_publication_import"
              groups="base.group_system" sequence="7"/>
</odoo>
