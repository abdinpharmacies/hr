<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ab_eplus_stock_snapshot_store_view_list" model="ir.ui.view">
        <field name="name">ab.eplus.stock.snapshot.store.list</field>
        <field name="model">ab_eplus_stock_snapshot_store</field>
        <field name="arch" type="xml">
            <list string="Eplus Branch Stock" create="0" edit="0" delete="0">
                <field name="itm_id"/>
                <field name="itm_code"/>
                <field name="product_id"/>
                <field name="product_code" optional="hide"/>
                <field name="sto_id"/>
                <field name="sto_code"/>
                <field name="store_name_ar" optional="hide"/>
                <field name="store_name_en"/>
                <field name="itm_qty" sum="Total Quantity"/>
                <field name="matched_by"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <record id="ab_eplus_stock_snapshot_store_view_form" model="ir.ui.view">
        <field name="name">ab.eplus.stock.snapshot.store.form</field>
        <field name="model">ab_eplus_stock_snapshot_store</field>
        <field name="arch" type="xml">
            <form string="Eplus Branch Stock" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="itm_id"/>
                            <field name="itm_code"/>
                            <field name="itm_qty"/>
                            <field name="last_sync_date"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="product_code"/>
                            <field name="product_name"/>
                            <field name="matched_by"/>
                            <field name="active"/>
                        </group>
                        <group string="Branch">
                            <field name="sto_id"/>
                            <field name="sto_code"/>
                            <field name="store_name_ar"/>
                            <field name="store_name_en"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ab_eplus_stock_snapshot_store_view_pivot" model="ir.ui.view">
        <field name="name">ab.eplus.stock.snapshot.store.pivot</field>
        <field name="model">ab_eplus_stock_snapshot_store</field>
        <field name="arch" type="xml">
            <pivot string="Eplus Branch Stock">
                <field name="product_id" type="row"/>
                <field name="sto_id" type="col"/>
                <field name="itm_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="ab_eplus_stock_snapshot_store_view_search" model="ir.ui.view">
        <field name="name">ab.eplus.stock.snapshot.store.search</field>
        <field name="model">ab_eplus_stock_snapshot_store</field>
        <field name="arch" type="xml">
            <search string="Eplus Branch Stock">
                <field name="itm_id"/>
                <field name="itm_code"/>
                <field name="product_id"/>
                <field name="sto_id"/>
                <field name="sto_code"/>
                <filter name="filter_matched"
                        string="Matched"
                        domain="[('product_id', '!=', False)]"/>
                <filter name="filter_unmatched"
                        string="Unmatched"
                        domain="[('product_id', '=', False)]"/>
                <separator/>
                <filter name="group_by_product"
                        string="Product"
                        context="{'group_by': 'product_id'}"/>
                <filter name="group_by_store"
                        string="Store"
                        context="{'group_by': 'sto_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_ab_eplus_stock_snapshot_store" model="ir.actions.act_window">
        <field name="name">Eplus Branch Stock</field>
        <field name="res_model">ab_eplus_stock_snapshot_store</field>
        <field name="path">ecommerce-eplus-branch-stock</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="domain">[('active', '=', True)]</field>
        <field name="context">{'search_default_filter_matched': 1}</field>
    </record>
</odoo>
