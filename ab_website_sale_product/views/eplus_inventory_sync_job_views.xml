<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ab_eplus_inventory_sync_job_view_list" model="ir.ui.view">
        <field name="name">ab.eplus.inventory.sync.job.list</field>
        <field name="model">ab_eplus_inventory_sync_job</field>
        <field name="arch" type="xml">
            <list string="Eplus Inventory Sync Jobs" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="state" decoration-success="state == 'done'" decoration-danger="state == 'failed'" decoration-warning="state == 'running'"/>
                <field name="progress" widget="progressbar"/>
                <field name="processed_count"/>
                <field name="total_count"/>
                <field name="updated_count"/>
                <field name="unchanged_count"/>
                <field name="skipped_count"/>
                <field name="failed_count"/>
                <field name="date_start"/>
                <field name="date_done"/>
            </list>
        </field>
    </record>

    <record id="ab_eplus_inventory_sync_job_view_form" model="ir.ui.view">
        <field name="name">ab.eplus.inventory.sync.job.form</field>
        <field name="model">ab_eplus_inventory_sync_job</field>
        <field name="arch" type="xml">
            <form string="Eplus Inventory Sync" create="0" edit="0" delete="0">
                <header>
                    <button name="action_start_full_sync"
                            type="object"
                            string="Start Full Sync"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_process_next_batch"
                            type="object"
                            string="Process Next Batch"
                            class="btn-secondary"
                            invisible="state != 'running'"/>
                    <button name="action_process_to_completion"
                            type="object"
                            string="Process All Remaining"
                            class="btn-primary"
                            invisible="state != 'running'"/>
                    <button name="action_open_eplus_stock"
                            type="object"
                            string="Open Eplus Stock"
                            class="btn-secondary"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"
                            invisible="state != 'running'"
                            confirm="Cancel this sync job?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done,failed,cancelled"/>
                </header>
                <sheet>
                    <field name="progress_style" invisible="1"/>
                    <field name="progress_percent_label" invisible="1"/>
                    <field name="status_title" invisible="1"/>
                    <field name="status_text" invisible="1"/>

                    <div class="core_ui_sync_panel mb-4">
                        <div class="core_ui_sync_panel_meta">
                            <div>
                                <span>Synced products: </span>
                                <field name="processed_count" readonly="1"/>
                                <span> / </span>
                                <field name="total_count" readonly="1"/>
                            </div>
                            <div class="core_ui_sync_panel_percent">
                                <field name="progress_percent_label" readonly="1"/>
                            </div>
                        </div>
                        <field name="progress" widget="progressbar" readonly="1"/>
                        <div class="core_ui_sync_status">
                            <span class="core_ui_sync_status_icon fa fa-check" aria-hidden="true"/>
                            <div>
                                <div class="core_ui_sync_status_title">
                                    <field name="status_title" readonly="1"/>
                                </div>
                                <div class="core_ui_sync_status_text">
                                    <field name="status_text" readonly="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <group>
                        <group>
                            <field name="warehouse_id"/>
                            <field name="location_id"/>
                            <field name="batch_size"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_done"/>
                            <field name="last_message"/>
                        </group>
                    </group>

                    <group string="Totals">
                        <field name="updated_count"/>
                        <field name="unchanged_count"/>
                        <field name="skipped_count"/>
                        <field name="failed_count"/>
                    </group>

                    <notebook>
                        <page string="Sync Lines">
                            <field name="line_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="ab_product_id"/>
                                    <field name="product_product_id"/>
                                    <field name="target_qty"/>
                                    <field name="state" decoration-muted="state == 'pending'" decoration-success="state in ('updated', 'unchanged')" decoration-warning="state == 'skipped'" decoration-danger="state == 'failed'"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ab_eplus_inventory_sync_job_view_search" model="ir.ui.view">
        <field name="name">ab.eplus.inventory.sync.job.search</field>
        <field name="model">ab_eplus_inventory_sync_job</field>
        <field name="arch" type="xml">
            <search string="Eplus Inventory Sync Jobs">
                <field name="name"/>
                <filter name="filter_running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="filter_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <record id="action_ab_eplus_inventory_sync_job" model="ir.actions.act_window">
        <field name="name">Eplus Inventory Sync Jobs</field>
        <field name="res_model">ab_eplus_inventory_sync_job</field>
        <field name="path">ecommerce-eplus-inventory-sync</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
