<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ab_website_product_sync_job_view_list" model="ir.ui.view">
        <field name="name">ab.website.product.sync.job.list</field>
        <field name="model">ab_website_product_sync_job</field>
        <field name="arch" type="xml">
            <list string="Website Product Sync Jobs" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="state" decoration-success="state == 'done'" decoration-danger="state == 'failed'" decoration-warning="state == 'running'"/>
                <field name="progress" widget="progressbar"/>
                <field name="processed_count"/>
                <field name="total_count"/>
                <field name="created_count"/>
                <field name="updated_count"/>
                <field name="unchanged_count"/>
                <field name="skipped_count"/>
                <field name="failed_count"/>
                <field name="date_start"/>
                <field name="date_done"/>
            </list>
        </field>
    </record>

    <record id="ab_website_product_sync_job_view_form" model="ir.ui.view">
        <field name="name">ab.website.product.sync.job.form</field>
        <field name="model">ab_website_product_sync_job</field>
        <field name="arch" type="xml">
            <form string="Website Product Sync" create="0" edit="1" delete="0" js_class="ab_website_product_sync_form">
                <header>
                    <button name="action_start_delta_sync" type="object" string="Sync Changed Products"
                            class="btn-secondary" invisible="state == 'running'"/>
                    <button name="action_retry_failed" type="object" string="Retry Failed Products"
                            class="btn-secondary" invisible="state != 'failed'"/>
                    <button name="action_start_full_sync"
                            type="object"
                            string="Check Remaining"
                            class="btn-secondary"
                            invisible="background_requested"/>
                    <button name="action_process_next_batch"
                            type="object"
                            string="Process Next Batch"
                            class="btn-secondary"
                            invisible="state != 'running' or background_requested"/>
                    <button name="action_process_to_completion"
                            type="object"
                            string="Process All Remaining"
                            class="btn-primary"
                            invisible="background_requested"/>
                    <button name="action_open_abdin_products"
                            type="object"
                            string="Open Abdin Products"
                            class="btn-secondary"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"
                            invisible="state != 'running'"
                            confirm="Cancel this sync job?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done,failed,cancelled"/>
                </header>
                <sheet>
                    <field name="background_requested" invisible="1"/>
                    <field name="processed_count" invisible="1"/>
                    <field name="total_count" invisible="1"/>
                    <field name="already_synced_count" invisible="1"/>
                    <div class="alert alert-danger" role="alert" invisible="not background_error">
                        <field name="background_error" nolabel="1"/>
                    </div>
                    <field name="progress_style" invisible="1"/>
                    <field name="progress_percent_label" invisible="1"/>
                    <field name="status_title" invisible="1"/>
                    <field name="status_text" invisible="1"/>

                    <div class="core_ui_sync_panel mb-4" invisible="state == 'draft' and background_requested">
                        <div class="core_ui_sync_panel_meta">
                            <div>
                                <span>Synced products: </span>
                                <field name="completed_count" readonly="1"/>
                                <span> / </span>
                                <field name="catalog_count" readonly="1"/>
                            </div>
                            <div class="core_ui_sync_panel_percent">
                                <field name="progress_percent_label" readonly="1"/>
                            </div>
                        </div>
                        <field name="progress" widget="progressbar" readonly="1"/>
                        <div class="core_ui_sync_status">
                            <span class="core_ui_sync_status_icon fa fa-check" aria-hidden="true"/>
                            <div>
                                <div class="core_ui_sync_status_title">
                                    <field name="status_title" readonly="1"/>
                                </div>
                                <div class="core_ui_sync_status_text">
                                    <field name="status_text" readonly="1"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info" invisible="state != 'draft' or not background_requested">
                        <span class="fa fa-spinner fa-spin" aria-hidden="true"/>
                        <field name="status_title" readonly="1" nolabel="1"/>
                    </div>
                    <group string="Remaining Work">
                        <field name="missing_count"/>
                        <field name="review_count"/>
                        <field name="remaining_count"/>
                        <button name="action_show_remaining" type="object" string="Show Remaining" icon="fa-list" invisible="not remaining_count"/>
                    </group>

                    <group>
                        <group>
                            <field name="batch_size_option" string="Products Per Batch" widget="selection"/>
                            <field name="batch_size" invisible="1"/>
                            <field name="date_start"/>
                            <field name="date_done"/>
                        </group>
                        <group>
                            <field name="last_message"/>
                        </group>
                    </group>

                    <group string="Totals">
                        <field name="created_count"/>
                        <field name="updated_count"/>
                        <field name="unchanged_count"/>
                        <field name="skipped_count"/>
                        <field name="failed_count"/>
                    </group>

                    <notebook>
                        <page string="Sync Lines">
                            <field name="line_ids" nolabel="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="ab_product_id"/>
                                    <field name="product_template_id"/>
                                    <field name="operation"/>
                                    <field name="state" decoration-muted="state == 'pending'" decoration-success="state in ('created', 'updated', 'unchanged')" decoration-warning="state == 'skipped'" decoration-danger="state == 'failed'"/>
                                    <field name="message"/>
                                    <field name="attempts" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ab_website_product_sync_remaining_view_list" model="ir.ui.view">
        <field name="name">ab.website.product.sync.remaining.list</field>
        <field name="model">ab_website_product_sync_job_line</field>
        <field name="arch" type="xml">
            <list string="Remaining Products" create="0" edit="0" delete="0">
                <field name="ab_product_id"/>
                <field name="product_template_id"/>
                <field name="operation"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="ab_website_product_sync_job_view_search" model="ir.ui.view">
        <field name="name">ab.website.product.sync.job.search</field>
        <field name="model">ab_website_product_sync_job</field>
        <field name="arch" type="xml">
            <search string="Website Product Sync Jobs">
                <field name="name"/>
                <filter name="filter_running" string="Running" domain="[('state', '=', 'running')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="filter_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
            </search>
        </field>
    </record>

    <record id="action_ab_website_product_sync_job" model="ir.actions.act_window">
        <field name="name">Website Product Sync Jobs</field>
        <field name="res_model">ab_website_product_sync_job</field>
        <field name="path">ecommerce-website-product-sync</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_open_website_product_sync_console" model="ir.actions.server">
        <field name="name">Open Product Sync Console</field>
        <field name="model_id" ref="model_ab_website_product_sync_job"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_full_sync_console()</field>
    </record>
</odoo>
