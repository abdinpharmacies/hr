<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="classification_run_company_rule" model="ir.rule">
        <field name="name">Classification runs in allowed companies</field>
        <field name="model_id" ref="model_ab_product_classification_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="classification_result_company_rule" model="ir.rule">
        <field name="name">Classification results in allowed companies</field>
        <field name="model_id" ref="model_ab_product_classification_result"/>
        <field name="domain_force">[('run_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="classification_review_company_rule" model="ir.rule">
        <field name="name">Classification reviews in allowed companies</field>
        <field name="model_id" ref="model_ab_product_classification_review"/>
        <field name="domain_force">[('result_id.run_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="classification_force_wizard_company_rule" model="ir.rule">
        <field name="name">Force categorization in allowed companies</field>
        <field name="model_id" ref="model_ab_classification_force_wizard"/>
        <field name="domain_force">[('run_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
