<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_import_issue_owner_company" model="ir.rule">
        <field name="name">Customer import issues: owner and company</field>
        <field name="model_id" ref="model_ab_ecommerce_legacy_import_issue"/>
        <field name="domain_force">[('company_id', 'in', company_ids)] + ([] if user.has_group('base.group_system') else [('batch_id.owner_id', '=', user.id)])</field>
    </record>
    <record id="rule_batch_owner_company" model="ir.rule">
        <field name="name">Activation batches: owner and company</field>
        <field name="model_id" ref="model_ab_ecommerce_legacy_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)] + ([] if user.has_group('base.group_system') else [('owner_id', '=', user.id)])</field>
    </record>
    <record id="rule_customer_company" model="ir.rule">
        <field name="name">Legacy customers: owner and company</field>
        <field name="model_id" ref="model_ab_ecommerce_legacy_customer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)] + ([] if user.has_group('base.group_system') else [('batch_id.owner_id', '=', user.id)])</field>
    </record>
    <record id="rule_chunk_company" model="ir.rule">
        <field name="name">Activation chunks: company</field>
        <field name="model_id" ref="model_ab_ecommerce_legacy_chunk"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_export_company" model="ir.rule">
        <field name="name">Activation exports: company</field>
        <field name="model_id" ref="model_ab_ecommerce_legacy_export"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
