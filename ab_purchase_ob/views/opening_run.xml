<odoo>
<record id="opening_run_form" model="ir.ui.view"><field name="name">opening.run.form</field><field name="model">ab_purchase_ob_run</field><field name="arch" type="xml">
            <form><header><button name="action_close" type="object" string="Close Opening Run" invisible="state == 'closed'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="store_id"/><field name="cutoff_date"/><field name="active"/><field name="closed_by"/><field name="closed_at"/></group></sheet></form></field></record>
<record id="opening_run_list" model="ir.ui.view"><field name="name">opening.run.list</field><field name="model">ab_purchase_ob_run</field><field name="arch" type="xml">
            <list><field name="name"/><field name="store_id"/><field name="cutoff_date"/><field name="state"/></list></field></record>
<record id="opening_run_action" model="ir.actions.act_window"><field name="name">Opening Runs</field><field name="res_model">ab_purchase_ob_run</field><field name="view_mode">list,form</field></record>
<menuitem id="opening_run_menu" name="Opening Runs" parent="ab_product_source.menu_root" action="opening_run_action" sequence="6"/>
<record id="receipt_run_form" model="ir.ui.view"><field name="name">receipt.run.form</field><field name="model">ab_purchase_ob_header</field><field name="inherit_id" ref="ab_purchase_ob_header_view_form"/><field name="arch" type="xml">
            <xpath expr="//header" position="inside"><button name="action_create_correction" type="object" string="Correct Receipt" invisible="status != 'saved' or correction_of_id"/></xpath><field name="doc_date" position="after"><field name="opening_run_id" domain="[('store_id', '=', store_id)]" invisible="purpose != 'opening'" readonly="status == 'saved'"/><field name="correction_of_id" domain="[('store_id', '=', store_id), ('status', '=', 'saved'), ('correction_of_id', '=', False)]" readonly="status == 'saved'"/><field name="receipt_reason" readonly="status == 'saved'"/></field><xpath expr="//field[@name='line_ids']/list/field[@name='qty']" position="after"><field name="correction_qty" column_invisible="not parent.correction_of_id"/></xpath><xpath expr="//field[@name='line_ids']/list/field[@name='product_id']" position="attributes"><attribute name="readonly">parent.correction_of_id</attribute></xpath><xpath expr="//field[@name='line_ids']/list/field[@name='qty']" position="attributes"><attribute name="readonly">parent.correction_of_id</attribute></xpath><xpath expr="//field[@name='line_ids']/list/field[@name='price']" position="attributes"><attribute name="readonly">parent.correction_of_id</attribute></xpath><xpath expr="//field[@name='line_ids']/list/field[@name='purchase_price']" position="attributes"><attribute name="readonly">parent.correction_of_id</attribute></xpath><xpath expr="//field[@name='line_ids']/list/field[@name='uom_id']" position="attributes"><attribute name="readonly">parent.correction_of_id</attribute></xpath><xpath expr="//field[@name='line_ids']/list/field[@name='taxes_ids']" position="attributes"><attribute name="readonly">parent.correction_of_id</attribute></xpath></field></record>
</odoo>
