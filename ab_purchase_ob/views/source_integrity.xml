<odoo>
    <record id="receipt_source_integrity_form" model="ir.ui.view">
        <field name="name">ab_purchase_ob.source.integrity.form</field>
        <field name="model">ab_purchase_ob_header</field>
        <field name="inherit_id" ref="ab_purchase_ob_header_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='exp_date']" position="after">
                <field name="no_expiry" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='exp_date']" position="attributes">
                <attribute name="readonly">no_expiry</attribute>
            </xpath>
        </field>
    </record>
</odoo>
