<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="ab_purchase_ob_header_view_form" model="ir.ui.view">
            <field name="name">ab_purchase_ob_header_view_form</field>
            <field name="model">ab_purchase_ob_header</field>
            <field name="arch" type="xml">
                <form string="ab_purchase_ob_header_form">
                    <header class="w-100">
                        <button string="Submit" type="object" name="btn_submit_inventory" class="btn-info"
                                invisible="status == 'saved'"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="compute_totals" type="object" class="oe_stat_button" icon="fa-dollar"
                                    width="200px">
                                <div class="o_field_widget o_stat_info mr4">
                                    <span class="o_stat_text">∑ Price:</span>
                                </div>
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="total_price"/>
                                    </span>
                                </div>
                            </button>
                            <button name="compute_totals" type="object" class="oe_stat_button" icon="fa-truck"
                                    width="200px">
                                <div class="o_field_widget o_stat_info mr4">
                                    <span class="o_stat_text">∑ Cost:</span>
                                    <span class="o_stat_text">∑ Taxes:</span>
                                </div>
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="total_cost"/>
                                    </span>
                                    <span class="o_stat_value">
                                        <field name="total_tax"/>
                                    </span>
                                </div>
                            </button>
                            <button name="compute_totals" type="object" class="oe_stat_button" icon="fa-list-ol"
                                    width="200px">
                                <div class="o_field_widget o_stat_info mr4">
                                    <span class="o_stat_text">Product:</span>
                                </div>
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="lines_count"/>
                                    </span>
                                </div>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Rejected" bg_color="bg-danger"
                                invisible="status != 'rejected'"/>
                        <widget name="web_ribbon" title="Saved" bg_color="bg-success"
                                invisible="status != 'saved'"/>
                        <widget name="web_ribbon" title="Pending" bg_color="bg-info"
                                invisible="status != 'pending'"/>
                        <field name="status" invisible="1"/>
                        <field name="total_price" invisible="1"/>
                        <field name="total_cost" string="Total Cost" invisible="1"/>
                        <field name="total_tax" invisible="1"/>
                        <field name="lines_count" invisible="1"/>
                        <group>
                            <field name="purpose" readonly="status == 'saved'"/>
                            <field name="store_id" readonly="status == 'saved'"/>
                            <field name="doc_code" readonly="status == 'saved'"/>
                            <field name="doc_date" readonly="status == 'saved'"/>
                            <field name="receipt_type_id"
                                   invisible="purpose != 'non_purchase_receipt'"
                                   required="purpose == 'non_purchase_receipt'"
                                   readonly="status == 'saved'"/>
                        </group>
                        <notebook>
                            <page string="Receipt Lines">
                                <field name="line_ids" readonly="status == 'saved'">
                                    <list editable="bottom">
                                        <field name="header_status" invisible="1"/>
                                        <field name="product_id" class="text-wrap" width="120px"/>
                                        <field name="exp_date"/>
                                        <field name="qty" string="Quantity" width="75px"/>
                                        <field name="product_uom_ids" invisible="1"/>
                                        <field name="uom_id" domain="[('id','in',product_uom_ids)]"
                                               context="{'uom_only_type': 1}"
                                               options="{&quot;always_reload&quot;: True}" string="Unit" width="65px"/>
                                        <field name="price" string="Price" width="75px"/>
                                        <field name="purchase_price"/>
                                        <field name="taxes_ids" widget="many2many_tags" width="65px"/>
                                        <field name="unit_cost"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Description">
                                <group>
                                    <field name="description" nolabel="1" placeholder="Write your feedback here"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>
        <record id="ab_purchase_ob_header_view_tree" model="ir.ui.view">
            <field name="name">ab_purchase_ob_header_view_tree</field>
            <field name="model">ab_purchase_ob_header</field>
            <field name="arch" type="xml">
                <list string="ab_purchase_ob_header_tree">
                    <field name="purpose"/>
                    <field name="store_id"/>
                    <field name="doc_code"/>
                    <field name="doc_date"/>
                    <field name="receipt_type_id" optional="show"/>
                    <field name="total_price"/>
                    <field name="total_cost"/>
                    <field name="lines_count"/>
                    <field name="status" widget="badge" decoration-info="status=='pending'"
                           decoration-danger="status=='rejected'" decoration-warning="status=='prepending'"
                           decoration-success="status=='saved'"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="ab_purchase_ob_header_action" model="ir.actions.act_window">
            <field name="name">Opening Balance</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_purchase_ob_header</field>
            <field name="domain">[('purpose', '=', 'opening')]</field>
            <field name="context">{'uom_only_type': 1, 'default_purpose': 'opening'}</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="ab_purchase_ob_header_menu" name="Opening Balance" parent="ab_product_source.menu_root"
                  action="ab_purchase_ob_header_action" sequence="3"/>

        <record id="ab_purchase_ob_non_purchase_receipt_action" model="ir.actions.act_window">
            <field name="name">Non-purchase Receipts</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_purchase_ob_header</field>
            <field name="domain">[('purpose', '=', 'non_purchase_receipt')]</field>
            <field name="context">{'uom_only_type': 1, 'default_purpose': 'non_purchase_receipt'}</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="ab_purchase_ob_non_purchase_receipt_menu"
                  name="Non-purchase Receipts"
                  parent="ab_product_source.menu_root"
                  action="ab_purchase_ob_non_purchase_receipt_action"
                  sequence="4"/>

        <record id="ab_purchase_ob_receipt_type_view_list" model="ir.ui.view">
            <field name="name">ab_purchase_ob_receipt_type_view_list</field>
            <field name="model">ab_purchase_ob_receipt_type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="ab_purchase_ob_receipt_type_view_form" model="ir.ui.view">
            <field name="name">ab_purchase_ob_receipt_type_view_form</field>
            <field name="model">ab_purchase_ob_receipt_type</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="description" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ab_purchase_ob_receipt_type_action" model="ir.actions.act_window">
            <field name="name">Receipt Types</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_purchase_ob_receipt_type</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem id="ab_purchase_ob_receipt_type_menu"
                  name="Receipt Types"
                  parent="ab_product_source.menu_root"
                  action="ab_purchase_ob_receipt_type_action"
                  sequence="5"/>

    </data>
</odoo>
