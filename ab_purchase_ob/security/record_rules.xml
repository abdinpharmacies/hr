<odoo>
<record id="opening_header_store_scope" model="ir.rule"><field name="name">Opening receipt store scope</field><field name="model_id" ref="model_ab_purchase_ob_header"/><field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') or user.has_group('ab_inventory.group_inventory_manager') else [('store_id', 'in', user.inventory_store_ids.ids)]</field></record>
<record id="opening_line_store_scope" model="ir.rule"><field name="name">Opening line store scope</field><field name="model_id" ref="model_ab_purchase_ob_line"/><field name="domain_force">[(1, '=', 1)] if user.has_group('base.group_system') or user.has_group('ab_inventory.group_inventory_manager') else [('header_id.store_id', 'in', user.inventory_store_ids.ids)]</field></record>
</odoo>
