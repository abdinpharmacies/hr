<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="category_ab_stock_update" model="ir.module.category">
        <field name="name">Stock Update</field>
        <field name="sequence" eval="90"/>
    </record>

    <record id="privilege_ab_stock_update" model="res.groups.privilege">
        <field name="name">Stock Update</field>
        <field name="sequence" eval="100"/>
        <field name="category_id" ref="category_ab_stock_update"/>
    </record>

    <record id="group_ab_stock_update_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence" eval="10"/>
        <field name="privilege_id" ref="privilege_ab_stock_update"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ab_stock_update_manager'))]"/>
    </record>
</odoo>
