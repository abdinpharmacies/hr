<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ab_store_list_stock_update" model="ir.ui.view">
        <field name="name">ab_store_list_stock_update</field>
        <field name="model">ab_store</field>
        <field name="inherit_id" ref="ab_store.store_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='code']" position="after">
                <field name="eplus_serial" optional="show"/>
                <button name="action_open_stock_update"
                        type="object"
                        string="Update Stock"
                        icon="fa-refresh"
                        groups="ab_stock_update.group_ab_stock_update_manager"
                        invisible="not eplus_serial"/>
            </xpath>
        </field>
    </record>
</odoo>
