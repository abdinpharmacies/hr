<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--Email template -->
        <record id="email_template_custody_request" model="mail.template">
            <field name="name">Request: Send by email</field>
            <field name="model_id" ref="ab_custody_request.model_ab_custody_request_header"/>
            <!--<field name="email_from"></field>-->
            <!-- @formatter:off -->
            <field name="email_to">{{ object.emails_to }}</field>
            <!-- @formatter:on -->
            <field name="subject">Custody Request: {{ object.employee_id.name }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <h3>يرجي اعتماد طلب العهدة</h3> <br/>
                    على الرابط

                    <div><t t-esc="object.custody_link"/></div>
                    ولكم جزيل الشكر,

                    <br/>
                    <div><strong>Employee Name:</strong> <t t-esc="object.employee_id.name"/></div>
                    <div><strong>Employee Code:</strong> <t t-esc="object.employee_code"/></div>
                    <br/><br/>


                    <br/><br/><br/>
                    Best Regards:<br/>
                    <t t-esc="user.name"/>


                </div>
            </field>
        </record>

    </data>
</odoo>