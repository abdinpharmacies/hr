<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="category_ab_custody_request" model="ir.module.category">
            <field name="name">Custody Request</field>
            <field name="sequence" eval="1"/>
        </record>
        <record id="privilege_category_ab_custody_request" model="res.groups.privilege">
            <field name="name">Custody Request</field>
            <field name="category_id" ref="category_ab_custody_request"/>
        </record>


        <record id="group_ab_custody_request_user" model="res.groups">
            <field name="name">Custody User</field>
            <field name="privilege_id" ref="privilege_category_ab_custody_request"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <record id="group_ab_custody_request_payment" model="res.groups">
            <field name="name">Custody Payment</field>
            <field name="privilege_id" ref="privilege_category_ab_custody_request"/>
            <field name="implied_ids" eval="[
                    (4, ref('group_ab_custody_request_user')),
                    ]"/>
        </record>

        <record id="group_ab_custody_request_payment_cash" model="res.groups">
            <field name="name">Custody Payment Cash</field>
            <field name="privilege_id" ref="privilege_category_ab_custody_request"/>
            <field name="implied_ids" eval="[
                    (4, ref('group_ab_custody_request_payment')),
                    ]"/>

        </record>

        <record id="group_ab_custody_request_payment_visa" model="res.groups">
            <field name="name">Custody Payment Visa</field>
            <field name="privilege_id" ref="privilege_category_ab_custody_request"/>
            <field name="implied_ids" eval="[
                    (4, ref('group_ab_custody_request_payment')),
                    ]"/>

        </record>

        <record id="group_ab_custody_request_accounting" model="res.groups">
            <field name="name">Custody Accounting</field>
            <field name="privilege_id" ref="privilege_category_ab_custody_request"/>
            <field name="implied_ids" eval="[
                    (4, ref('group_ab_custody_request_user')),
                    ]"/>
        </record>

        <record id="group_ab_custody_request_report" model="res.groups">
            <field name="name">Custody Request Report</field>
            <field name="privilege_id" ref="privilege_category_ab_custody_request"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        

    </data>
</odoo>