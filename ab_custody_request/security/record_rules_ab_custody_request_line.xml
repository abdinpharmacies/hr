<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="rule_ab_custody_request_line_prevent_all" model="ir.rule">
            <field name="name">rule_ab_custody_request_line_prevent_all</field>
            <field name="model_id" ref="model_ab_custody_request_line"/>
            <field name="groups" eval="[(4, ref('group_ab_custody_request_user'))]"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <!--<field name="global" eval="1"/> -->
        </record>


        <record id="rule_ab_custody_request_line_user" model="ir.rule">
            <field name="name">rule_ab_custody_request_line_user</field>
            <field name="model_id" ref="model_ab_custody_request_line"/>
            <field name="groups" eval="[(4, ref('group_ab_custody_request_user'))]"/>
            <field name="domain_force">[
                ('user_id', '=', user.id),
                ('header_id.status', '=', 'for_entry')]
            </field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <!--<field name="global" eval="1"/> -->
        </record>

        <record id="rule_ab_custody_request_line_user_ro_own" model="ir.rule">
            <field name="name">rule_ab_custody_request_line_user_ro_own</field>
            <field name="model_id" ref="model_ab_custody_request_line"/>
            <field name="groups" eval="[(4, ref('group_ab_custody_request_user'))]"/>
            <field name="domain_force">[
                ('user_id', '=', user.id),
                ('header_id.status', '!=', 'for_entry')]
            </field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <!--<field name="global" eval="1"/> -->
        </record>

        <record id="rule_ab_custody_request_line_manager_ro" model="ir.rule">
            <field name="name">rule_ab_custody_request_line_manager_ro</field>
            <field name="model_id" ref="model_ab_custody_request_line"/>
            <field name="groups" eval="[(4, ref('group_ab_custody_request_user'))]"/>
            <field name="domain_force">[('header_id.manager_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <!--<field name="global" eval="1"/> -->
        </record>


        <record id="rule_ab_custody_request_line_accounting_read_all" model="ir.rule">
            <field name="name">rule_ab_custody_request_line_accounting_read_all</field>
            <field name="model_id" ref="model_ab_custody_request_line"/>
            <field name="groups" eval="[(4, ref('group_ab_custody_request_accounting'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <!--<field name="global" eval="1"/> -->
        </record>

        <record id="rule_ab_custody_request_line_payment_r_all" model="ir.rule">
            <field name="name">rule_ab_custody_request_line_payment_r_all</field>
            <field name="model_id" ref="model_ab_custody_request_line"/>
            <field name="groups" eval="[(4, ref('group_ab_custody_request_payment'))]"/>
            <field name="domain_force">[
                ('header_id.custody_type', 'in', ['cash', 'visa']),
            ]</field>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
            <!--<field name="global" eval="1"/> -->
        </record>


    </data>
</odoo>