<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="ab_delivery_request_view_list" model="ir.ui.view">
            <field name="name">ab.delivery.request.list</field>
            <field name="model">ab_delivery_request</field>
            <field name="arch" type="xml">
                <list string="Delivery Requests" create="0" delete="0">
                    <field name="bill_number"/>
                    <field name="branch_code" optional="hide"/>
                    <field name="branch_name"/>
                    <field name="customer_name"/>
                    <field name="customer_phone"/>
                    <field name="amount_total"/>
                    <field name="state" widget="badge"
                           decoration-warning="state in ('pending', 'queued')"
                           decoration-info="state == 'sent'"
                           decoration-danger="state == 'failed'"/>
                    <field name="sent_date"/>
                    <field name="next_attempt_date" optional="hide"/>
                    <field name="failure_count" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="ab_delivery_request_view_form" model="ir.ui.view">
            <field name="name">ab.delivery.request.form</field>
            <field name="model">ab_delivery_request</field>
            <field name="arch" type="xml">
                <form string="Delivery Request" create="0" delete="0">
                    <header>
                        <button name="action_resend_to_telegram"
                                type="object"
                                string="Resend Telegram Message"
                                class="btn-primary"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="sale_header_id"/>
                                <field name="store_id"/>
                                <field name="branch_code"/>
                                <field name="branch_name"/>
                                <field name="bill_number"/>
                                <field name="amount_total"/>
                            </group>
                            <group>
                                <field name="customer_name"/>
                                <field name="customer_phone"/>
                                <field name="customer_address"/>
                            </group>
                        </group>
                        <group string="Telegram">
                            <field name="telegram_chat_id"/>
                            <field name="telegram_message_id"/>
                            <field name="sent_date"/>
                            <field name="next_attempt_date"/>
                            <field name="failure_count"/>
                            <field name="last_error"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ab_delivery_request_view_search" model="ir.ui.view">
            <field name="name">ab.delivery.request.search</field>
            <field name="model">ab_delivery_request</field>
            <field name="arch" type="xml">
                <search string="Delivery Requests">
                    <field name="bill_number"/>
                    <field name="branch_code"/>
                    <field name="branch_name"/>
                    <field name="customer_name"/>
                    <field name="customer_phone"/>
                    <filter name="pending" string="Open"
                            domain="[('state', 'in', ['pending', 'queued', 'sent', 'failed'])]"/>
                    <group name="group_by">
                        <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                        <filter name="group_by_branch" string="Branch" context="{'group_by': 'store_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="ab_delivery_request_action" model="ir.actions.act_window">
            <field name="name">Delivery Requests</field>
            <field name="res_model">ab_delivery_request</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="ab_delivery_request_view_list"/>
        </record>

        <menuitem id="ab_delivery_request_menu"
                  name="Delivery Requests"
                  parent="ab_sales.sales_menu_root"
                  action="ab_delivery_request_action"
                  sequence="4"
                  groups="ab_sales_delivery_tracking.group_ab_sales_delivery_tracking_manager"/>
    </data>
</odoo>
