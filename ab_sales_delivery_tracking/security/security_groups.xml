<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="module_category_ab_sales_delivery_tracking" model="ir.module.category">
            <field name="name">Sales Delivery Tracking</field>
            <field name="description">Delivery request Telegram notifications</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_ab_sales_delivery_tracking" model="res.groups.privilege">
            <field name="name">Sales Delivery Tracking</field>
            <field name="category_id" ref="module_category_ab_sales_delivery_tracking"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_ab_sales_delivery_tracking_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_ab_sales_delivery_tracking"/>
            <field name="implied_ids" eval="[(4, ref('ab_sales.group_ab_sales_manager'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('ab_sales_delivery_tracking.group_ab_sales_delivery_tracking_manager'))]"/>
        </record>
    </data>
</odoo>
