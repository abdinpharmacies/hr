<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ab_widgets.AbCharAutocompleteField">
        <t t-if="props.readonly">
            <span t-esc="formattedValue"/>
        </t>
        <t t-else="">
            <AutoComplete t-props="autocompleteProps"/>
        </t>
    </t>

    <t t-name="ab_widgets.AbCharAutocompleteSearchMoreDialog">
        <Dialog title.translate="Suggestions"
                size="'md'"
                contentClass="'o_ab_char_autocomplete_modal'">
            <div class="o_ab_char_autocomplete_dialog">
                <p class="o_ab_char_autocomplete_dialog_hint">
                    Search and select from available suggestions
                </p>
                <div class="o_ab_char_autocomplete_search">
                    <div class="o_ab_char_autocomplete_search_input_wrap">
                        <i class="fa fa-search" aria-hidden="true"/>
                        <input class="o_input o_ab_char_autocomplete_search_input"
                               type="text"
                               t-att-value="state.searchTerm"
                               placeholder="Search values..."
                               t-on-input="onSearchInput"
                               t-on-change="onSearchChange"/>
                    </div>
                </div>
                <div class="o_ab_char_autocomplete_values"
                     t-att-class="{
                         'o_ab_char_autocomplete_values--page-next': state.pageTransition === 'next',
                         'o_ab_char_autocomplete_values--page-previous': state.pageTransition === 'previous',
                     }">
                    <t t-if="state.loading &amp;&amp; !state.values.length">
                        <div class="o_ab_char_autocomplete_state o_ab_char_autocomplete_state_loading">
                            <i class="fa fa-spin fa-circle-o-notch" aria-hidden="true"/>
                            <span>Loading...</span>
                        </div>
                    </t>
                    <t t-elif="!state.values.length">
                        <div class="o_ab_char_autocomplete_state o_ab_char_autocomplete_state_empty">
                            <i class="fa fa-search" aria-hidden="true"/>
                            <strong>No suggestions found</strong>
                            <span>Try a different search term.</span>
                        </div>
                    </t>
                    <t t-else="">
                        <button t-foreach="state.values"
                                t-as="row"
                                t-key="row.value"
                                class="o_ab_char_autocomplete_value"
                                type="button"
                                t-on-click="() => this.selectValue(row.value)">
                            <span class="o_ab_char_autocomplete_value_text" t-esc="row.value"/>
                        </button>
                    </t>
                </div>
                <div class="o_ab_char_autocomplete_pager" t-if="showPager">
                    <button class="btn btn-secondary"
                            type="button"
                            t-att-disabled="!canGoPrevious"
                            t-on-click="previousPage">
                        <i class="fa fa-chevron-left" aria-hidden="true"/>
                        <span>Previous</span>
                    </button>
                    <span class="o_ab_char_autocomplete_page">
                        <t t-esc="pageLabel"/>
                    </span>
                    <button class="btn btn-secondary"
                            type="button"
                            t-att-disabled="!canGoNext"
                            t-on-click="nextPage">
                        <span>Next</span>
                        <i class="fa fa-chevron-right" aria-hidden="true"/>
                    </button>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="props.close">Close</button>
            </t>
        </Dialog>
    </t>

    <t t-name="ab_widgets.AbCharAutocompleteInputPopover">
        <div class="o_ab_char_autocomplete_input_options"
             t-att-class="{'o_ab_char_autocomplete_input_options--typing': state.resultsTransition}"
             t-att-id="listId"
             role="listbox">
            <t t-if="state.loading &amp;&amp; !state.values.length">
                <div class="o_ab_char_autocomplete_input_status o_ab_char_autocomplete_input_status_loading">
                    <i class="fa fa-spin fa-circle-o-notch" aria-hidden="true"/>
                    <span>Loading...</span>
                </div>
            </t>
            <t t-elif="!state.values.length">
                <div class="o_ab_char_autocomplete_input_status o_ab_char_autocomplete_input_status_empty">
                    <i class="fa fa-search" aria-hidden="true"/>
                    <strong>No suggestions found</strong>
                    <span>Try a different search term.</span>
                </div>
            </t>
            <t t-else="">
                <button t-foreach="state.values"
                        t-as="row"
                        t-key="row.value"
                        t-att-id="optionId(row_index)"
                        class="o_ab_char_autocomplete_input_option dropdown-item"
                        t-att-class="{'active': state.activeIndex === row_index}"
                        type="button"
                        role="option"
                        t-att-aria-selected="state.activeIndex === row_index ? 'true' : 'false'"
                        t-on-mouseenter="() => this.setActiveIndex(row_index)"
                        t-on-pointerdown.prevent=""
                        t-on-click="() => this.selectValue(row.value)">
                    <span class="o_ab_char_autocomplete_input_option_text" t-esc="row.value"/>
                </button>
                <button t-if="state.hasMore"
                        t-att-id="optionId(state.values.length)"
                        class="o_ab_char_autocomplete_input_option o_ab_char_autocomplete_input_search_more dropdown-item"
                        t-att-class="{'active': state.activeIndex === state.values.length}"
                        type="button"
                        role="option"
                        t-att-aria-selected="state.activeIndex === state.values.length ? 'true' : 'false'"
                        t-on-mouseenter="() => this.setActiveIndex(state.values.length)"
                        t-on-pointerdown.prevent=""
                        t-on-click="openSearchMore">
                    <i class="fa fa-search-plus" aria-hidden="true"/>
                    <span>Search More...</span>
                </button>
            </t>
        </div>
    </t>
</templates>
