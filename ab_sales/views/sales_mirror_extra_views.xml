        <record id="view_ab_product_priced_sync_list" model="ir.ui.view">
            <field name="name">ab_product_priced.list</field>
            <field name="model">ab_product_priced</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0" duplicate="0">
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="product_id"/>
                    <field name="product_code"/>
                    <field name="is_priced"/>
                    <field name="active"/>
                    <field name="synced_at"/>
                </list>
            </field>
        </record>
        <record id="view_ab_product_priced_sync_form" model="ir.ui.view">
            <field name="name">ab_product_priced.form</field>
            <field name="model">ab_product_priced</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0" duplicate="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="db_serial"/>
                                <field name="rec_id"/>
                                <field name="source_revision"/>
                                <field name="event_uuid"/>
                                <field name="synced_at"/>
                            </group>
                            <group>
                                <field name="product_id"/>
                                <field name="product_code"/>
                                <field name="is_priced"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                            <page string="Raw Payload">
                                <field name="payload_json" widget="ab_pretty_json"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_ab_product_priced_sync" model="ir.actions.act_window">
            <field name="name">Synced Product Priced Flags</field>
            <field name="res_model">ab_product_priced</field>
            <field name="view_mode">list,form</field>
        </record>
        <record id="ab_product_metadata_view_list" model="ir.ui.view">
            <field name="name">ab_product_metadata.list</field>
            <field name="model">ab_product_metadata</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0" duplicate="0">
                    <field name="product_code" readonly="1"/>
                    <field name="product_id" readonly="1"/>
                    <field name="is_priced" readonly="1"/>
                    <field name="notes" optional="hide" readonly="1"/>
                    <field name="active" optional="hide" readonly="1"/>
                    <field name="db_serial" optional="hide"/>
                    <field name="rec_id" optional="hide"/>
                    <field name="synced_at" optional="hide"/>
                </list>
            </field>
        </record>
        <record id="ab_product_metadata_view_form" model="ir.ui.view">
            <field name="name">ab_product_metadata.form</field>
            <field name="model">ab_product_metadata</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0" duplicate="0">
                    <sheet>
                        <div class="oe_title">
                            <label for="product_id"/>
                            <h1>
                                <field name="product_id" options="{'no_create_edit': True}" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <field name="product_code" readonly="1"/>
                            <field name="is_priced" readonly="1"/>
                            <field name="active" readonly="1"/>
                        </group>
                        <group>
                            <field name="notes" readonly="1"/>
                        </group>
                        <notebook>
                            <page name="reporting_details" string="Reporting Details">
                                <group>
                                    <field name="db_serial"/>
                                    <field name="rec_id"/>
                                    <field name="source_revision"/>
                                    <field name="event_uuid"/>
                                    <field name="synced_at"/>
                                    <field name="payload_json" widget="ab_pretty_json"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
