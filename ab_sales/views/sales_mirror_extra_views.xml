        <record id="view_ab_sales_per_day_sync_state_sync_list" model="ir.ui.view">
            <field name="name">ab_sales_per_day_sync_state.list</field>
            <field name="model">ab_sales_per_day_sync_state</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0" duplicate="0" decoration-danger="state == 'failed'" decoration-warning="state in ('pending', 'running')" decoration-success="state == 'done'">
                    <field name="sale_date"/>
                    <field name="state" widget="badge"/>
                    <field name="rows_synced"/>
                    <field name="started_at"/>
                    <field name="finished_at"/>
                    <field name="db_serial" optional="hide"/>
                    <field name="rec_id" optional="hide"/>
                    <field name="synced_at" optional="hide"/>
                    <field name="error_message" optional="hide"/>
                </list>
            </field>
        </record>
