<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_sales_branch_rpc_config_view_list" model="ir.ui.view">
            <field name="name">ab_sales_branch_rpc_config.list</field>
            <field name="model">ab_sales_branch_rpc_config</field>
            <field name="arch" type="xml">
                <list string="Branch Connections" decoration-danger="last_test_state == 'error'" decoration-warning="rotation_state == 'review'">
                    <header><button name="action_check_connections" type="object" string="Check Connections"/>
                    <button name="action_rotate_credentials" type="object" string="Rotate Credentials"/></header>
                    <field name="enrollment_state"/><field name="rotation_state"/>
                    <field name="expires_at"/><field name="last_success_at"/>
                    <field name="active" optional="hide"/>
                    <field name="store_id"/>
                    <field name="store_code"/>
                    <field name="store_eplus_serial"/>
                    <field name="rpc_url"/>
                    <field name="rpc_db"/>
                    <field name="rpc_user"/>
                    <field name="last_test_state"/>
                    <field name="last_tested_at"/>
                    <field name="remote_store_id"/>
                </list>
            </field>
        </record>

        <record id="ab_sales_branch_rpc_config_view_form" model="ir.ui.view">
            <field name="name">ab_sales_branch_rpc_config.form</field>
            <field name="model">ab_sales_branch_rpc_config</field>
            <field name="arch" type="xml">
                <form string="Branch Connection">
                    <header>
                        <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary"/>
                    <button name="action_rotate_credentials" string="Rotate Credential" type="object"/>
                        <button name="action_revoke_credential" string="Revoke Credential" type="object" confirm="Revoke this branch credential and disable the connection?"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="active"/>
                                <field name="name"/>
                                <field name="store_id"/>
                                <field name="store_code" readonly="1"/>
                                <field name="store_eplus_serial" readonly="1"/>
                            </group>
                            <group>
                                <field name="rpc_url" placeholder="https://branch.example.com"/>
                                <field name="rpc_db"/>
                                <field name="rpc_user"/>
                                <field name="api_key" password="True" groups="base.group_system"/>
                                <field name="administrator_id"/>
                                <field name="connection_timeout"/>
                                <field name="push_to_eplus_on_submit"/>
                            </group>
                        </group>
                        <group string="Credential Lifecycle">
                            <field name="enrollment_state"/><field name="rotation_state"/>
                            <field name="expires_at"/><field name="retire_at"/><field name="rotation_name"/>
                            <field name="management_message"/><field name="can_post"/>
                        </group>
                        <group string="Last Test"><field name="last_success_at"/>
                            <field name="last_test_state"/>
                            <field name="last_tested_at"/>
                            <field name="remote_store_id"/>
                            <field name="remote_store_name"/>
                            <field name="last_test_message"/>
                        </group>
                    </sheet><chatter/>
                </form>
            </field>
        </record>

        <record id="ab_sales_branch_rpc_config_view_search" model="ir.ui.view">
            <field name="name">ab_sales_branch_rpc_config.search</field>
            <field name="model">ab_sales_branch_rpc_config</field>
            <field name="arch" type="xml">
                <search string="Branch Connections">
                    <field name="store_id"/>
                    <field name="rpc_url"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="success" string="Successful Tests" domain="[('last_test_state', '=', 'success')]"/>
                    <filter name="errors" string="Errors" domain="[('last_test_state', '=', 'error')]"/>
                </search>
            </field>
        </record>

        <record id="ab_sales_branch_rpc_config_action" model="ir.actions.act_window">
            <field name="name">Branch Connections</field>
            <field name="res_model">ab_sales_branch_rpc_config</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_sales_branch_rpc_config_view_search"/>
            <field name="context">{'search_default_active': 1}</field>
        </record>

        <menuitem id="ab_sales_branch_rpc_config_menu"
                  name="Branch Connections"
                  parent="config_sub_menu"
                  action="ab_sales_branch_rpc_config_action"
                  sequence="420"
                  groups="base.group_system"/>
    </data>
</odoo>
