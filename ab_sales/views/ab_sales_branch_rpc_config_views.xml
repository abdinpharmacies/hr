<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_sales_branch_rpc_config_view_list" model="ir.ui.view">
            <field name="name">ab_sales_branch_rpc_config.list</field>
            <field name="model">ab_sales_branch_rpc_config</field>
            <field name="arch" type="xml">
                <list string="Branch Connections" decoration-danger="last_test_state == 'error'">
                    <header>
                        <button name="action_check_connections" type="object" string="Check Connections"/>
                    </header>
                    <field name="store_id" string="Branch"/>
                    <field name="db_serial"/>
                    <field name="rpc_url"/>
                    <field name="enrollment_state" widget="badge"/>
                    <field name="last_test_state"/>
                    <field name="last_tested_at"/>
                    <field name="rpc_db" optional="hide"/>
                    <field name="rpc_user" optional="hide"/>
                    <field name="expires_at" optional="hide"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="ab_sales_branch_rpc_config_view_form" model="ir.ui.view">
            <field name="name">ab_sales_branch_rpc_config.form</field>
            <field name="model">ab_sales_branch_rpc_config</field>
            <field name="arch" type="xml">
                <form string="Branch Connection">
                    <header>
                        <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary" invisible="not active"/>
                        <field name="enrollment_state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="store_id" string="Branch"/>
                                <field name="db_serial"/>
                                <field name="push_to_eplus_on_submit"/>
                            </group>
                            <group>
                                <field name="rpc_url" placeholder="https://branch.example.com"/>
                                <field name="rpc_db"/>
                                <field name="api_key" password="True" groups="base.group_system"/>
                            </group>
                        </group>
                        <group string="Last Test" invisible="last_test_state == 'untested'">
                            <group>
                                <field name="last_test_state"/>
                                <field name="last_tested_at"/>
                                <field name="last_test_message"/>
                            </group>
                            <group invisible="enrollment_state != 'ready'">
                                <field name="remote_store_name" string="Verified Branch"/>
                                <field name="rpc_user"/>
                                <field name="can_post" string="Posting Allowed"/>
                                <field name="expires_at" invisible="not expires_at"/>
                            </group>
                        </group>
                        <details class="mt-3">
                            <summary>Advanced Settings</summary>
                            <group class="mt-3">
                                <field name="active"/>
                                <field name="administrator_id"/>
                                <field name="connection_timeout"/>
                            </group>
                        </details>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="ab_sales_branch_rpc_config_view_search" model="ir.ui.view">
            <field name="name">ab_sales_branch_rpc_config.search</field>
            <field name="model">ab_sales_branch_rpc_config</field>
            <field name="arch" type="xml">
                <search string="Branch Connections">
                    <field name="store_id"/>
                    <field name="rpc_url"/>
                    <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="success" string="Successful Tests" domain="[('last_test_state', '=', 'success')]"/>
                    <filter name="errors" string="Errors" domain="[('last_test_state', '=', 'error')]"/>
                </search>
            </field>
        </record>

        <record id="ab_sales_branch_rpc_config_action" model="ir.actions.act_window">
            <field name="name">Branch Connections</field>
            <field name="res_model">ab_sales_branch_rpc_config</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_sales_branch_rpc_config_view_search"/>
            <field name="context">{'search_default_active': 1}</field>
        </record>

        <menuitem id="ab_sales_branch_rpc_config_menu"
                  name="Branch Connections"
                  parent="config_sub_menu"
                  action="ab_sales_branch_rpc_config_action"
                  sequence="420"
                  groups="base.group_system"/>
    </data>
</odoo>
