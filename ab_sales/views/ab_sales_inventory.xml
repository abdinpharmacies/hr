<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ab_sales_inventory_view_list" model="ir.ui.view">
            <field name="name">ab_sales_inventory_report_view_list</field>
            <field name="model">ab_sales_inventory_report</field>
            <field name="arch" type="xml">
                <list string="Inventory" create="0" edit="0" delete="0">
                    <field name="product_code" optional="show"/>
                    <field name="product_id" optional="show"/>
                    <field name="store_code" optional="show"/>
                    <field name="store_id" optional="show"/>
                    <field name="balance" optional="show"/>
                    <field name="default_price" optional="show"/>
                </list>
            </field>
        </record>

        <record id="ab_sales_inventory_view_form" model="ir.ui.view">
            <field name="name">ab_sales_inventory_report_view_form</field>
            <field name="model">ab_sales_inventory_report</field>
            <field name="arch" type="xml">
                <form string="Inventory" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <field name="product_code"/>
                            <field name="product_id"/>
                            <field name="store_code"/>
                            <field name="store_id"/>
                            <field name="balance"/>
                            <field name="default_price"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_sales_inventory_view_search" model="ir.ui.view">
            <field name="name">ab_sales_inventory_report_view_search</field>
            <field name="model">ab_sales_inventory_report</field>
            <field name="arch" type="xml">
                <search string="Inventory">
                    <field name="product_codes_search"/>
                    <field name="product_code"/>
                    <field name="product_id"/>
                    <field name="store_code"/>
                    <field name="store_id"/>
                    <separator/>
                    <filter name="group_by_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_by_product_code" string="Product Code" context="{'group_by': 'product_code'}"/>
                    <filter name="group_by_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="group_by_store_code" string="Store Code" context="{'group_by': 'store_code'}"/>
                </search>
            </field>
        </record>
        <record id="ab_sales_inventory_action" model="ir.actions.act_window">
            <field name="name">Inventory</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ab_sales_inventory_report</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_sales_inventory_view_search"/>
        </record>

        <record id="ab_sales_inventory_balance_report_filter" model="ir.filters">
            <field name="name">Balance Report</field>
            <field name="model_id">ab_sales_inventory_report</field>
            <field name="domain">[('store_id', '!=', False), ('balance', '&gt;', 0)]</field>
            <field name="context">{'group_by': ['product_id', 'store_id']}</field>
            <field name="user_ids" eval="False"/>
            <field name="is_default" eval="True"/>
            <field name="action_id" ref="ab_sales_inventory_action"/>
        </record>

        <menuitem id="ab_sales_inventory_menu"
                  name="Inventory"
                  parent="ab_sales_reports_menu"
                  action="ab_sales_inventory_action"
                  sequence="100"/>
    </data>
</odoo>
