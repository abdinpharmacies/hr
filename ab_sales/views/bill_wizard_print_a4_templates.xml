<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="bill_wizard_receipt_print_html_a4">
        <html>
            <head>
                <meta charset="utf-8"/>
                <style>
                    html, body {
                        margin: 0;
                        padding: 0;
                        background: #fff;
                        direction: rtl;
                        unicode-bidi: embed;
                    }

                    body {
                        font-family: Arial, sans-serif;
                        font-size: 150%;
                    }

                    .receipt-page {
                        width: 500px;
                        box-sizing: border-box;
                        padding: 4px 4px 2px 4px;
                    }

                    .receipt-block {
                        width: 500px;
                        margin: 0 0 3px 0;
                    }

                    .receipt-row {
                        display: table;
                        width: 100%;
                        table-layout: fixed;
                        border: 1px solid #000000;
                    }

                    .receipt-label {
                        display: table-cell;
                        width: 100px;
                        white-space: nowrap;
                        vertical-align: top;
                        border-right: 1px solid #e6e6e6;
                        padding: 2px 6px 2px 0;
                    }

                    .receipt-label-contract {
                        display: table-cell;
                        width: 175px;
                        white-space: nowrap;
                        vertical-align: top;
                        border-right: 1px solid #e6e6e6;
                        padding: 2px 6px 2px 0;
                    }

                    .receipt-value {
                        display: table-cell;
                        text-align: right;
                        vertical-align: top;
                        unicode-bidi: plaintext;
                        word-break: break-word;
                        overflow-wrap: anywhere;
                        padding: 2px 0 2px 6px;
                    }

                    .receipt-policy {
                        font-size: 20px;
                        margin-bottom: 5px;
                    }

                    .receipt-date-label {
                        display: table-cell;
                        width: 100px;
                        font-size: 18px;
                        white-space: nowrap;
                        vertical-align: top;
                        padding: 2px 6px 2px 0;
                    }

                    .receipt-date-value {
                        display: table-cell;
                        font-size: 20px;
                        text-align: right;
                        vertical-align: top;
                        unicode-bidi: plaintext;
                        word-break: break-word;
                        overflow-wrap: anywhere;
                        padding: 2px 0 2px 6px;
                    }

                    .receipt-20-label {
                        display: table-cell;
                        width: 100px;
                        font-size: 18px;
                        white-space: nowrap;
                        vertical-align: top;
                        padding: 2px 6px 2px 0;
                    }

                    .receipt-20-value {
                        display: table-cell;
                        font-size: 20px;
                        text-align: right;
                        vertical-align: top;
                        unicode-bidi: plaintext;
                        word-break: break-word;
                        overflow-wrap: anywhere;
                        padding: 2px 0 2px 6px;
                    }

                    .receipt-table {
                        width: 500px;
                        border-collapse: collapse;
                        border: 1px solid #000000;
                        padding: 2px 0;
                        margin: 5px 0;
                    }

                    .receipt-sales-line {
                        border-left: 1px solid #000;
                        border-right: 1px solid #000;
                    }

                    .main-line td {
                        border-top: 1px solid #000;
                        border-bottom: none;
                    }


                    .receipt-table th {
                        padding: 2px 0;
                        font-weight: bold;
                    }

                    .contract-title {
                        text-align: center;
                        font-size: 150%;
                    }

                    .receipt-item {
                        width: 284px;
                        text-align: right;
                        vertical-align: top;
                        word-break: break-word;
                        overflow-wrap: anywhere;
                        unicode-bidi: plaintext;
                        padding: 2px 0;
                    }

                    .receipt-qty {
                        width: 50px;
                        text-align: right;
                        vertical-align: top;
                        white-space: nowrap;
                        padding: 2px 0;
                    }

                    .receipt-price {
                        width: 77px;
                        text-align: right;
                        vertical-align: top;
                        white-space: nowrap;
                        padding: 2px 0;
                    }

                    .receipt-total {
                        width: 88px;
                        text-align: right;
                        vertical-align: top;
                        white-space: nowrap;
                        padding: 2px 0;
                    }

                    .receipt-product-code {
                        padding: 0 0 10px 0;
                        font-size: 12px;
                        color: #333;
                    }

                    .code-line td {
                        width: 50px;
                    }

                    .receipt-product-code-row {
                        width: 100%;
                    }

                    .receipt-product-code-value {
                        text-align: right;
                        vertical-align: top;

                    }

                    .receipt-product-uom-value {
                        text-align: right;
                        vertical-align: top;
                        white-space: nowrap;
                    }

                    .receipt-summary {
                        width: 500px;
                        margin-top: 3px;
                    }

                    .receipt-summary-row {
                        display: table;
                        width: 100%;
                        table-layout: fixed;
                        border-bottom: 1px solid #000000;
                    }

                    .receipt-summary-label,
                    .receipt-summary-value {
                        display: table-cell;
                        vertical-align: top;
                    }

                    .receipt-summary-label {
                        border-right: 1px solid #e6e6e6;
                        padding: 2px 6px 2px 0;
                    }

                    .receipt-summary-value {
                        text-align: right;
                        padding: 2px 0 2px 6px;
                    }

                    .receipt-summary-total {
                        font-size: 18px;
                        font-weight: 700;
                    }

                    .receipt-notes-value {
                        white-space: pre-wrap;
                    }
                </style>
            </head>
            <body>
                <div class="receipt-page">

                    <div class="receipt-block"
                         style="text-align:center;font-weight:700;line-height:1.1;margin:0 0 4px 0;">
                        Abdin Pharmacies Pharma
                    </div>
                    <t t-if="receipt_header">
                        <div class="receipt-block"
                             style="text-align:center;font-weight:700;line-height:1.1;margin:0 0 4px 0;"
                             t-esc="receipt_header"/>
                    </t>
                    <div class="receipt-block"
                         style="text-align:center;font-weight:700;line-height:1.1;margin:0 0 4px 0;"
                         t-esc="store_name"
                    />

                    <div class="receipt-block">
                        <div class="receipt-row">
                            <div class="receipt-label">Bill</div>
                            <div class="receipt-value" t-esc="serial_text"/>
                        </div>
                        <t t-if="customer_name">
                            <div class="receipt-row">
                                <div class="receipt-label">Customer</div>
                                <div class="receipt-value" t-esc="customer_name"/>
                            </div>
                            <div class="receipt-row">
                                <div class="receipt-label">Phone</div>
                                <div class="receipt-value" t-esc="customer_phone"/>
                            </div>
                            <div class="receipt-row">
                                <div class="receipt-label">Address</div>
                                <div class="receipt-value" t-esc="customer_address"/>
                            </div>
                        </t>
                        <t t-if="employee_name">
                            <div class="receipt-row">
                                <div class="receipt-label">Employee</div>
                                <div class="receipt-value" t-esc="employee_name"/>
                            </div>
                        </t>
                    </div>
                    <hr/>
                    <table class="receipt-table">
                        <thead>
                            <tr class="receipt-sales-line main-line">
                                <th class="receipt-item">Item</th>
                                <th class="receipt-qty">Qty</th>
                                <th class="receipt-price">Price</th>
                                <th class="receipt-total">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="lines" t-as="line">
                                <!-- Main line -->
                                <tr class="receipt-sales-line main-line">
                                    <td class="receipt-item" t-esc="line['product_name']"/>
                                    <td class="receipt-qty" t-esc="line['qty_text']"/>
                                    <td class="receipt-price" t-esc="line['price_text']"/>
                                    <td class="receipt-total" t-esc="line['line_total_text']"/>
                                </tr>

                                <!-- Product code row -->
                                <t t-if="line['product_code']">
                                    <tr class="receipt-sales-line code-line">
                                        <td class="receipt-item receipt-product-code">
                                            <table class="receipt-product-code-row">
                                                <tr>
                                                    <td class="receipt-product-code-value">
                                                        <t t-esc="line['product_code']"/>
                                                    </td>
                                                    <td class="receipt-product-uom-value">
                                                        <t t-if="line.get('uom_name')" t-esc="line['uom_name']"/>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                        <td class="receipt-qty"/>
                                        <td class="receipt-price"/>
                                        <td class="receipt-total"/>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                    <t t-if="has_contract">
                        <div class="contract-title">Contract Data</div>
                        <div class="receipt-block">
                            <div class="receipt-row">
                                <div class="receipt-label-contract">Contract</div>
                                <div class="receipt-value" t-esc="contract_name"/>
                            </div>
                            <t t-if="customer_insurance_name">
                                <div class="receipt-row">
                                    <div class="receipt-label-contract">Insurance Name</div>
                                    <div class="receipt-value" t-esc="customer_insurance_name"/>
                                </div>
                            </t>
                            <t t-if="customer_insurance_number">
                                <div class="receipt-row">
                                    <div class="receipt-label-contract">Insurance Number</div>
                                    <div class="receipt-value" t-esc="customer_insurance_number"/>
                                </div>
                            </t>
                            <div class="receipt-row">
                                <div class="receipt-label-contract">Company Pay</div>
                                <div class="receipt-value" t-esc="company_pay_text"/>
                            </div>
                            <div class="receipt-row">
                                <div class="receipt-label-contract">Customer Pay</div>
                                <div class="receipt-value" t-esc="cust_pay_text"/>
                            </div>
                            <div class="receipt-row">
                                <div class="receipt-label-contract">Net</div>
                                <div class="receipt-value" t-esc="contract_net"/>
                            </div>
                        </div>
                    </t>

                    <div class="receipt-summary">
                        <t t-if="promo_name">
                            <div class="receipt-summary-row">
                                <div class="receipt-summary-label">Promo</div>
                                <div class="receipt-summary-value" t-esc="promo_name"/>
                            </div>
                        </t>
                        <t t-if="promo_discount_text and not has_contract">
                            <div class="receipt-summary-row">
                                <div class="receipt-summary-label" t-esc="discount_label or 'Discount'"/>
                                <div class="receipt-summary-value" t-esc="'-' + promo_discount_text"/>
                            </div>
                        </t>
                        <div class="receipt-summary-row">
                            <div class="receipt-summary-label receipt-summary-total" t-esc="prompt_label or 'Total'"/>
                            <div class="receipt-summary-value receipt-summary-total" t-esc="prompt_value"/>
                        </div>
                    </div>
                    <t t-if="employee_delivery_name">
                        <div class="receipt-delivery">
                            <div class="receipt-20-label">Delivery</div>
                            <div class="receipt-20-value" t-esc="employee_delivery_name"/>
                        </div>
                    </t>
                    <t t-if="return_notes">
                        <div class="receipt-block">
                            <div class="receipt-row">
                                <div class="receipt-20-label">Notes</div>
                                <div class="receipt-20-value" t-esc="return_notes"/>
                            </div>
                        </div>
                    </t>
                    <div class="receipt-policy">
                        Returns accepted within 14 days; refrigerated medications and cosmetics are not eligible for
                        return or exchange.
                    </div>
                    <div class="receipt-date">
                        <div class="receipt-date-label">Date</div>
                        <div class="receipt-date-value" t-esc="date_value"/>
                    </div>
                </div>
            </body>
        </html>
    </template>
</odoo>
