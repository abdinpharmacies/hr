                    <field name="db_serial" optional="hide"/>
                    <field name="rec_id" optional="hide"/>
                    <field name="sales_return_id" optional="hide"/>
                    <field name="line_count" optional="hide"/>
                    <field name="total_return_qty" optional="hide"/>
                    <field name="active" optional="hide"/>
                    <field name="synced_at" optional="hide"/>
                </list>
            </field>
        </record>
        <record id="ab_sales_return_header_view_search" model="ir.ui.view">
            <field name="name">ab_sales_return_header.search</field>
            <field name="model">ab_sales_return_header</field>
            <field name="arch" type="xml">
                <search>
                    <field name="origin_header_id"/>
                    <field name="store_id"/>
                    <field name="status"/>
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="sales_return_id"/>
                    <filter name="saved" string="Saved" domain="[('status', '=', 'saved')]"/>
                    <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                    <filter name="group_db_serial" string="DB Serial" context="{'group_by': 'db_serial'}"/>
                    <filter name="group_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </search>
            </field>
        </record>
        <record id="ab_sales_return_header_view_form" model="ir.ui.view">
            <field name="name">ab_sales_return_header.form</field>
            <field name="model">ab_sales_return_header</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0" duplicate="0">
                    <sheet>
                        <field name="status" invisible="1" readonly="1"/>
                        <widget name="web_ribbon" title="Pre-Pending" bg_color="bg-info" invisible="status != 'prepending'"/>
                        <widget name="web_ribbon" title="Saved" bg_color="bg-info" invisible="status != 'saved'"/>
                        <group>
                            <group>
                                <field name="store_id" readonly="1"/>
                                <field name="origin_header_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="total_return_qty" readonly="1"/>
                                <field name="total_return_value" readonly="1"/>
                                <field name="total_sales_net" readonly="1"/>
                                <field name="sales_return_id" readonly="1"/>
                                <field name="f_transaction_id" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" colspan="4" readonly="1"/>
                        </group>
                        <notebook>
                            <page name="Lines" string="Lines">
                                <group>
                                    <field name="line_ids" nolabel="1" readonly="1">
                                        <list create="0" delete="0" edit="0" duplicate="0">
                                            <field name="itm_eplus_id" optional="hide" readonly="1"/>
                                            <field name="product_id" readonly="1"/>
                                            <field name="qty_sold" optional="show" readonly="1"/>
                                            <field name="max_returnable_qty" optional="show" readonly="1"/>
                                            <field name="max_returnable_source" optional="hide" readonly="1"/>
                                            <field name="uom_id" readonly="1"/>
                                            <field name="qty_sold_source" optional="hide" readonly="1"/>
                                            <field name="qty_str" readonly="1"/>
                                            <field name="qty" optional="hide" readonly="1"/>
                                            <field name="source_itm_unit" optional="hide" readonly="1"/>
                                            <field name="source_uom_factor" optional="hide" readonly="1"/>
                                            <field name="item_unit1_unit2" optional="hide" readonly="1"/>
                                            <field name="item_unit1_unit3" optional="hide" readonly="1"/>
                                            <field name="sell_price" optional="show" readonly="1"/>
                                            <field name="cost" optional="hide" readonly="1"/>
                                            <field name="c_id" optional="hide" readonly="1"/>
                                            <field name="std_id" optional="hide" readonly="1"/>
                                            <field name="sth_id" optional="hide" readonly="1"/>
                                            <field name="sto_id" optional="hide" readonly="1"/>
                                            <field name="line_value" optional="hide" readonly="1"/>
                                            <field name="itm_nexist" optional="hide" readonly="1"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                        </notebook>
                        <notebook>
                            <page name="reporting_details" string="Reporting Details">
                                <group>
                                    <field name="db_serial"/>
                                    <field name="rec_id"/>
                                    <field name="source_revision"/>
                                    <field name="event_uuid"/>
                                    <field name="source_operation"/>
                                    <field name="source_write_date"/>
                                    <field name="synced_at"/>
                                    <field name="sto_eplus_serial"/>
                                    <field name="active"/>
                                    <field name="line_count"/>
                                    <field name="payload_json" widget="ab_pretty_json"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
