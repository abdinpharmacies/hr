<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_sales_header_view_tree" model="ir.ui.view">
            <field name="name">ab_sales_header.list</field>
            <field name="model">ab_sales_header</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="eplus_serial"/>
                    <field name="store_id"/>
                    <field name="status" widget="badge"/>
                    <field name="push_state" widget="badge"/>
                    <field name="bill_customer_name"/>
                    <field name="bill_customer_phone"/>
                    <field name="line_count"/>
                    <field name="total_qty"/>
                    <field name="total_net_amount"/>
                    <field name="active"/>
                    <field name="synced_at"/>
                </list>
            </field>
        </record>
        <record id="ab_sales_header_view_search" model="ir.ui.view">
            <field name="name">ab_sales_header.search</field>
            <field name="model">ab_sales_header</field>
            <field name="arch" type="xml">
                <search>
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="eplus_serial"/>
                    <field name="store_id"/>
                    <field name="bill_customer_name"/>
                    <field name="bill_customer_phone"/>
                    <filter name="saved" string="Saved" domain="[('status', '=', 'saved')]"/>
                    <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                    <filter name="push_error" string="Push Error" domain="[('push_state', '=', 'error')]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                    <filter name="group_db_serial" string="DB Serial" context="{'group_by': 'db_serial'}"/>
                    <filter name="group_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </search>
            </field>
        </record>
        <record id="ab_sales_header_view_form" model="ir.ui.view">
            <field name="name">ab_sales_header.form</field>
            <field name="model">ab_sales_header</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="db_serial"/>
                                <field name="rec_id"/>
                                <field name="source_revision"/>
                                <field name="event_uuid"/>
                                <field name="source_create_uid"/>
                                <field name="source_write_uid"/>
                                <field name="source_operation"/>
                                <field name="source_write_date"/>
                                <field name="synced_at"/>
                            </group>
                            <group>
                                <field name="store_id"/>
                                <field name="eplus_serial"/>
                                <field name="status"/>
                                <field name="push_state"/>
                                <field name="is_closed"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="bill_customer_name"/>
                                <field name="bill_customer_phone"/>
                                <field name="bill_customer_address"/>
                                <field name="customer_insurance_name"/>
                                <field name="customer_insurance_number"/>
                            </group>
                            <group>
                                <field name="customer_id"/>
                                <field name="employee_id"/>
                                <field name="is_delivery"/>
                                <field name="employee_delivery_id"/>
                                <field name="pos_client_token"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="line_ids" readonly="1">
                                    <list>
                                        <field name="rec_id"/>
                                        <field name="product_id"/>
                                        <field name="qty"/>
                                        <field name="sell_price"/>
                                        <field name="net_amount"/>
                                        <field name="products_not_exist"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                                <group>
                                    <field name="line_count"/>
                                    <field name="total_qty"/>
                                    <field name="total_price"/>
                                    <field name="total_net_amount"/>
                                </group>
                            </page>
                            <page string="Customer Snapshot">
                                <group>
                                    <field name="new_customer_name"/>
                                    <field name="new_customer_phone"/>
                                    <field name="new_customer_address"/>
                                    <field name="invoice_address"/>
                                </group>
                            </page>
                            <page string="Messages">
                                <field name="description"/>
                                <field name="push_message"/>
                            </page>
                            <page string="Raw Payload">
                                <field name="payload_json" widget="ab_pretty_json"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_sales_header_action" model="ir.actions.act_window">
            <field name="name">Synced Sales</field>
            <field name="res_model">ab_sales_header</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_sales_header_view_search"/>
        </record>

        <record id="ab_sales_line_view_tree" model="ir.ui.view">
            <field name="name">ab_sales_line.list</field>
            <field name="model">ab_sales_line</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="header_id"/>
                    <field name="product_id"/>
                    <field name="qty"/>
                    <field name="sell_price"/>
                    <field name="price_subtotal"/>
                    <field name="net_amount"/>
                    <field name="products_not_exist"/>
                    <field name="unavailable_reason"/>
                    <field name="active"/>
                    <field name="synced_at"/>
                </list>
            </field>
        </record>
        <record id="ab_sales_line_view_search" model="ir.ui.view">
            <field name="name">ab_sales_line.search</field>
            <field name="model">ab_sales_line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="header_id"/>
                    <field name="product_id"/>
                    <filter name="missing_stock" string="Missing Stock" domain="[('products_not_exist', '=', True)]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                    <filter name="group_db_serial" string="DB Serial" context="{'group_by': 'db_serial'}"/>
                    <filter name="group_header" string="Header" context="{'group_by': 'header_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </search>
            </field>
        </record>
        <record id="view_ab_sales_line_sync_form" model="ir.ui.view">
            <field name="name">ab_sales_line.form</field>
            <field name="model">ab_sales_line</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="db_serial"/>
                                <field name="rec_id"/>
                                <field name="source_revision"/>
                                <field name="event_uuid"/>
                                <field name="synced_at"/>
                            </group>
                            <group>
                                <field name="header_id"/>
                                <field name="product_id"/>
                                <field name="product_code"/>
                                <field name="uom_id"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="qty_str"/>
                                <field name="qty"/>
                                <field name="sell_price"/>
                                <field name="target_sell_price"/>
                                <field name="cost"/>
                            </group>
                            <group>
                                <field name="balance"/>
                                <field name="price"/>
                                <field name="available_prices"/>
                                <field name="price_subtotal"/>
                                <field name="price_tax"/>
                                <field name="net_amount"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Stock Availability">
                                <group>
                                    <field name="products_not_exist"/>
                                    <field name="unavailable_reason"/>
                                    <field name="unavailable_reason_other"/>
                                </group>
                            </page>
                            <page string="Inventory Snapshot">
                                <field name="inventory_json" widget="ab_pretty_json"/>
                            </page>
                            <page string="Raw Payload">
                                <field name="payload_json" widget="ab_pretty_json"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_sales_line_action" model="ir.actions.act_window">
            <field name="name">Synced Sales Lines</field>
            <field name="res_model">ab_sales_line</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_sales_line_view_search"/>
        </record>

        <record id="ab_sales_return_header_view_tree" model="ir.ui.view">
            <field name="name">ab_sales_return_header.list</field>
            <field name="model">ab_sales_return_header</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="origin_header_id"/>
                    <field name="sales_return_id"/>
                    <field name="store_id"/>
                    <field name="status" widget="badge"/>
                    <field name="line_count"/>
                    <field name="total_return_qty"/>
                    <field name="total_return_value"/>
                    <field name="total_sales_net"/>
                    <field name="active"/>
                    <field name="synced_at"/>
                </list>
            </field>
        </record>
        <record id="ab_sales_return_header_view_search" model="ir.ui.view">
            <field name="name">ab_sales_return_header.search</field>
            <field name="model">ab_sales_return_header</field>
            <field name="arch" type="xml">
                <search>
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="origin_header_id"/>
                    <field name="sales_return_id"/>
                    <field name="store_id"/>
                    <filter name="saved" string="Saved" domain="[('status', '=', 'saved')]"/>
                    <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                    <filter name="group_db_serial" string="DB Serial" context="{'group_by': 'db_serial'}"/>
                    <filter name="group_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </search>
            </field>
        </record>
        <record id="ab_sales_return_header_view_form" model="ir.ui.view">
            <field name="name">ab_sales_return_header.form</field>
            <field name="model">ab_sales_return_header</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="db_serial"/>
                                <field name="rec_id"/>
                                <field name="source_revision"/>
                                <field name="event_uuid"/>
                                <field name="source_operation"/>
                                <field name="source_write_date"/>
                                <field name="synced_at"/>
                            </group>
                            <group>
                                <field name="origin_header_id"/>
                                <field name="sales_return_id"/>
                                <field name="f_transaction_id"/>
                                <field name="store_id"/>
                                <field name="sto_eplus_serial"/>
                                <field name="status"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Return Lines">
                                <field name="line_ids" readonly="1">
                                    <list>
                                        <field name="rec_id"/>
                                        <field name="product_id"/>
                                        <field name="qty"/>
                                        <field name="sell_price"/>
                                        <field name="line_value"/>
                                        <field name="itm_eplus_id"/>
                                        <field name="std_id"/>
                                    </list>
                                </field>
                                <group>
                                    <field name="line_count"/>
                                    <field name="total_return_qty"/>
                                    <field name="total_return_value"/>
                                    <field name="total_sales_net"/>
                                </group>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                            <page string="Raw Payload">
                                <field name="payload_json" widget="ab_pretty_json"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_sales_return_header_action" model="ir.actions.act_window">
            <field name="name">Synced Sales Returns</field>
            <field name="res_model">ab_sales_return_header</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_sales_return_header_view_search"/>
        </record>

        <record id="ab_sales_return_line_view_list" model="ir.ui.view">
            <field name="name">ab_sales_return_line.list</field>
            <field name="model">ab_sales_return_line</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0">
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="header_id"/>
                    <field name="product_id"/>
                    <field name="itm_eplus_id"/>
                    <field name="sth_id"/>
                    <field name="std_id"/>
                    <field name="qty"/>
                    <field name="sell_price"/>
                    <field name="line_value"/>
                    <field name="active"/>
                    <field name="synced_at"/>
                </list>
            </field>
        </record>
        <record id="ab_sales_return_line_view_search" model="ir.ui.view">
            <field name="name">ab_sales_return_line.search</field>
            <field name="model">ab_sales_return_line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="header_id"/>
                    <field name="product_id"/>
                    <field name="itm_eplus_id"/>
                    <field name="sth_id"/>
                    <field name="std_id"/>
                    <filter name="missing_item" string="Missing Item" domain="[('itm_nexist', '=', True)]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                    <filter name="group_db_serial" string="DB Serial" context="{'group_by': 'db_serial'}"/>
                    <filter name="group_header" string="Return Header" context="{'group_by': 'header_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </search>
            </field>
        </record>
        <record id="ab_sales_return_line_view_form" model="ir.ui.view">
            <field name="name">ab_sales_return_line.form</field>
            <field name="model">ab_sales_return_line</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="db_serial"/>
                                <field name="rec_id"/>
                                <field name="source_revision"/>
                                <field name="event_uuid"/>
                                <field name="synced_at"/>
                            </group>
                            <group>
                                <field name="header_id"/>
                                <field name="sale_line_id"/>
                                <field name="product_id"/>
                                <field name="uom_id"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="qty_str"/>
                                <field name="qty"/>
                                <field name="qty_to_return"/>
                                <field name="qty_sold"/>
                                <field name="qty_sold_source"/>
                                <field name="max_returnable_qty"/>
                                <field name="max_returnable_source"/>
                            </group>
                            <group>
                                <field name="sell_price"/>
                                <field name="cost"/>
                                <field name="line_value"/>
                                <field name="itm_nexist"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="itm_eplus_id"/>
                                <field name="sth_id"/>
                                <field name="sto_id"/>
                                <field name="c_id"/>
                                <field name="std_id"/>
                            </group>
                            <group>
                                <field name="source_itm_unit"/>
                                <field name="source_uom_factor"/>
                                <field name="item_unit1_unit2"/>
                                <field name="item_unit1_unit3"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Raw Payload">
                                <field name="payload_json" widget="ab_pretty_json"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_sales_return_line_action" model="ir.actions.act_window">
            <field name="name">Synced Sales Return Lines</field>
            <field name="res_model">ab_sales_return_line</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_sales_return_line_view_search"/>
        </record>

        <menuitem id="sales_menu_root" name="Sales Reporting"
                  sequence="72"
                  web_icon="ab_sales,static/description/icon.png"
                  groups="group_ab_sales_manager"/>
        <menuitem id="ab_sales_header_menu" name="Synced Sales"
                  parent="sales_menu_root" action="ab_sales_header_action" sequence="10"/>
        <menuitem id="menu_ab_sales_line_sync" name="Synced Sales Lines"
                  parent="sales_menu_root" action="ab_sales_line_action" sequence="20"/>
        <menuitem id="ab_sales_return_header_menu" name="Synced Sales Returns"
                  parent="sales_menu_root" action="ab_sales_return_header_action" sequence="30"/>
        <menuitem id="ab_sales_return_line_menu" name="Synced Sales Return Lines"
                  parent="sales_menu_root" action="ab_sales_return_line_action" sequence="40"/>
    </data>
</odoo>
