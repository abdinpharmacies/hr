<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="ab_sales_header_view_tree" model="ir.ui.view">
            <field name="name">ab_sales_header.list</field>
            <field name="model">ab_sales_header</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0" duplicate="0">
                    <field name="id" readonly="1"/>
                    <field name="eplus_serial" readonly="1"/>
                    <field name="store_id" readonly="1"/>
                    <field name="customer_id" readonly="1"/>
                    <field name="line_count" readonly="1"/>
                    <field name="total_price" readonly="1"/>
                    <field name="total_net_amount" readonly="1"/>
                    <field name="status" widget="badge" decoration-info="status=='pending'" decoration-warning="status=='prepending'" decoration-success="status=='saved'" readonly="1"/>
                    <field name="description" readonly="1"/>
                    <field name="db_serial" optional="hide"/>
                    <field name="rec_id" optional="hide"/>
                    <field name="push_state" widget="badge" optional="hide"/>
                    <field name="bill_customer_name" optional="hide"/>
                    <field name="bill_customer_phone" optional="hide"/>
                    <field name="total_qty" optional="hide"/>
                    <field name="active" optional="hide"/>
                    <field name="synced_at" optional="hide"/>
                </list>
            </field>
        </record>
        <record id="ab_sales_header_view_search" model="ir.ui.view">
            <field name="name">ab_sales_header.search</field>
            <field name="model">ab_sales_header</field>
            <field name="arch" type="xml">
                <search>
                    <field name="store_id"/>
                    <field name="eplus_serial"/>
                    <field name="id"/>
                    <field name="line_ids" string="Product" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                    <field name="customer_id"/>
                    <field name="status"/>
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="bill_customer_name"/>
                    <field name="bill_customer_phone"/>
                    <filter name="saved" string="Saved" domain="[('status', '=', 'saved')]"/>
                    <filter name="pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                    <filter name="push_error" string="Push Error" domain="[('push_state', '=', 'error')]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                    <filter name="group_db_serial" string="DB Serial" context="{'group_by': 'db_serial'}"/>
                    <filter name="group_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </search>
            </field>
        </record>
        <record id="ab_sales_header_view_form" model="ir.ui.view">
            <field name="name">ab_sales_header.form</field>
            <field name="model">ab_sales_header</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0" duplicate="0">
                    <sheet>
                        <group string="Totals">
                            <field name="total_price" readonly="1"/>
                            <field name="line_count" readonly="1"/>
                            <field name="total_qty" readonly="1"/>
                            <field name="total_net_amount" readonly="1"/>
                        </group>
                        <widget name="web_ribbon" title="Saved" bg_color="bg-success" invisible="status != 'saved'"/>
                        <widget name="web_ribbon" title="Pending" bg_color="bg-info" invisible="status != 'pending'"/>
                        <group>
                            <group>
                                <field name="store_id" readonly="1"/>
                                <field name="eplus_serial" readonly="1"/>
                                <field name="pos_client_token" readonly="1"/>
                                <field name="description" readonly="1"/>
                            </group>
                            <group>
                                <notebook>
                                    <page name="bill_customer" string="Bill Customer Data">
                                        <group>
                                            <field name="bill_customer_name" string="Name" readonly="1"/>
                                            <field name="bill_customer_phone" string="Phone" readonly="1"/>
                                            <field name="bill_customer_address" string="Address" readonly="1"/>
                                        </group>
                                    </page>
                                    <page name="current_customer" string="Current Customer">
                                        <group>
                                            <field name="customer_id" readonly="1"/>
                                            <field name="invoice_address" readonly="1"/>
                                        </group>
                                    </page>
                                    <page name="new_customer" string="New Customer">
                                        <group>
                                            <field name="new_customer_name" string="Name" readonly="1"/>
                                            <field name="new_customer_phone" string="Phone" readonly="1"/>
                                            <field name="new_customer_address" string="Address" readonly="1"/>
                                        </group>
                                    </page>
                                </notebook>
                            </group>
                        </group>
                        <field name="store_id" invisible="True" readonly="1"/>
                        <field name="status" invisible="True" readonly="1"/>
                        <field name="line_count" invisible="True" readonly="1"/>
                        <notebook>
                            <page string="Sales Detail">
                                <field name="line_ids" readonly="1">
                                    <list create="0" edit="0" delete="0" duplicate="0">
                                        <field name="product_id" decoration-danger="balance==0" width="300px" readonly="1"/>
                                        <field name="product_code" width="50px" optional="show" readonly="1"/>
                                        <field name="qty_str" string="Quantity" width="75px" readonly="1"/>
                                        <field name="uom_id" width="80px" readonly="1"/>
                                        <field name="qty" optional="hide" readonly="1"/>
                                        <field name="inventory_json" string="Source" width="75px" optional="hide" readonly="1"/>
                                        <field name="cost" width="50px" optional="hide" readonly="1"/>
                                        <field name="target_sell_price" optional="hide" width="75px" readonly="1"/>
                                        <field name="sell_price" readonly="1"/>
                                        <field name="balance" decoration-success="balance&gt;0" decoration-danger="balance==0" readonly="1"/>
                                        <field name="net_amount" optional="show" readonly="1"/>
                                        <field name="unavailable_reason" optional="hide" readonly="1"/>
                                        <field name="unavailable_reason_other" optional="hide" readonly="1"/>
                                        <field name="rec_id" optional="hide" readonly="1"/>
                                        <field name="active" optional="hide" readonly="1"/>
                                        <field name="products_not_exist" optional="hide" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                        <notebook>
                            <page name="reporting_details" string="Reporting Details">
                                <group>
                                    <field name="db_serial"/>
                                    <field name="rec_id"/>
                                    <field name="source_revision"/>
                                    <field name="event_uuid"/>
                                    <field name="source_operation"/>
                                    <field name="source_write_date"/>
                                    <field name="synced_at"/>
                                    <field name="push_state"/>
                                    <field name="is_closed"/>
                                    <field name="active"/>
                                    <field name="customer_insurance_name"/>
                                    <field name="customer_insurance_number"/>
                                    <field name="employee_id"/>
                                    <field name="is_delivery"/>
                                    <field name="employee_delivery_id"/>
                                    <field name="push_message"/>
                                    <field name="payload_json" widget="ab_pretty_json"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_sales_header_action" model="ir.actions.act_window">
            <field name="name">Bills</field>
            <field name="res_model">ab_sales_header</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_sales_header_view_search"/>
            <field name="context">{'active_test': False}</field>
        </record>
        <record id="ab_sales_line_view_tree" model="ir.ui.view">
            <field name="name">ab_sales_line.list</field>
            <field name="model">ab_sales_line</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0" duplicate="0">
                    <field name="id" optional="hide" readonly="1"/>
                    <field name="header_id" optional="show" readonly="1"/>
                    <field name="product_id" decoration-danger="balance==0" width="300px" readonly="1"/>
                    <field name="product_code" width="50px" optional="show" readonly="1"/>
                    <field name="uom_id" width="80px" readonly="1"/>
                    <field name="qty" optional="show" readonly="1"/>
                    <field name="sell_price" readonly="1"/>
                    <field name="balance" decoration-success="balance&gt;0" decoration-danger="balance==0" readonly="1"/>
                    <field name="net_amount" optional="show" readonly="1"/>
                    <field name="unavailable_reason" optional="show" readonly="1"/>
                    <field name="unavailable_reason_other" optional="show" readonly="1"/>
                    <field name="db_serial" optional="hide"/>
                    <field name="rec_id" optional="hide"/>
                    <field name="price_subtotal" optional="hide"/>
                    <field name="products_not_exist" optional="hide"/>
                    <field name="active" optional="hide"/>
                    <field name="synced_at" optional="hide"/>
                </list>
            </field>
        </record>
        <record id="ab_sales_line_view_search" model="ir.ui.view">
            <field name="name">ab_sales_line.search</field>
            <field name="model">ab_sales_line</field>
            <field name="arch" type="xml">
                <search>
                    <field name="product_id"/>
                    <field name="unavailable_reason"/>
                    <field name="db_serial"/>
                    <field name="rec_id"/>
                    <field name="header_id"/>
                    <filter name="missing_stock" string="Missing Stock" domain="[('products_not_exist', '=', True)]"/>
                    <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                    <filter name="group_db_serial" string="DB Serial" context="{'group_by': 'db_serial'}"/>
                    <filter name="group_header" string="Header" context="{'group_by': 'header_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </search>
            </field>
        </record>
        <record id="view_ab_sales_line_sync_form" model="ir.ui.view">
            <field name="name">ab_sales_line.form</field>
            <field name="model">ab_sales_line</field>
            <field name="arch" type="xml">
                <form create="0" edit="0" delete="0" duplicate="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="db_serial"/>
                                <field name="rec_id"/>
                                <field name="source_revision"/>
                                <field name="event_uuid"/>
                                <field name="synced_at"/>
                            </group>
                            <group>
                                <field name="header_id"/>
                                <field name="product_id"/>
                                <field name="product_code"/>
                                <field name="uom_id"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="qty_str"/>
                                <field name="qty"/>
                                <field name="sell_price"/>
                                <field name="target_sell_price"/>
                                <field name="cost"/>
                            </group>
                            <group>
                                <field name="balance"/>
                                <field name="price"/>
                                <field name="available_prices"/>
                                <field name="price_subtotal"/>
                                <field name="price_tax"/>
                                <field name="net_amount"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Stock Availability">
                                <group>
                                    <field name="products_not_exist"/>
                                    <field name="unavailable_reason"/>
                                    <field name="unavailable_reason_other"/>
                                </group>
                            </page>
                            <page string="Inventory Snapshot">
                                <field name="inventory_json" widget="ab_pretty_json"/>
                            </page>
                            <page string="Raw Payload">
                                <field name="payload_json" widget="ab_pretty_json"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="ab_sales_line_action" model="ir.actions.act_window">
            <field name="name">Sales Details</field>
            <field name="res_model">ab_sales_line</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_sales_line_view_search"/>
        </record>
        <record id="ab_sales_return_header_view_tree" model="ir.ui.view">
            <field name="name">ab_sales_return_header.list</field>
            <field name="model">ab_sales_return_header</field>
            <field name="arch" type="xml">
                <list create="0" edit="0" delete="0" duplicate="0">
                    <field name="store_id" optional="show" readonly="1"/>
                    <field name="origin_header_id" optional="show" readonly="1"/>
                    <field name="status" optional="show" readonly="1"/>
                    <field name="total_return_value" optional="show" readonly="1"/>
