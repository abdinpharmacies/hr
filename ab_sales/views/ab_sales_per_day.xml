<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_sales_per_day_view_search" model="ir.ui.view">
            <field name="name">ab_sales_per_day_view_search</field>
            <field name="model">ab_sales_per_day</field>
            <field name="arch" type="xml">
                <search string="Sales Per Day">
                    <field name="store_id"/>
                    <field name="product_eplus_serial"/>
                    <field name="product_id"/>
                    <filter name="filter_sale_date" date="sale_date"/>
                    <separator/>
                    <filter name="group_by_store" string="Store" context="{'group_by': 'store_id'}"/>
                    <filter name="group_by_product_serial" string="Product Serial" context="{'group_by': 'product_eplus_serial'}"/>
                    <filter name="group_by_sale_date" string="Sale Date" context="{'group_by': 'sale_date'}"/>
                </search>
            </field>
        </record>

        <record id="ab_sales_per_day_view_list" model="ir.ui.view">
            <field name="name">ab_sales_per_day_view_list</field>
            <field name="model">ab_sales_per_day</field>
            <field name="arch" type="xml">
                <list string="Sales Per Day" create="0" edit="0" delete="0">
                    <field name="sale_date"/>
                    <field name="store_id"/>
                    <field name="product_eplus_serial"/>
                    <field name="product_id"/>
                    <field name="sales_qty" sum="Sales Quantity"/>
                    <field name="sync_at"/>
                </list>
            </field>
        </record>

        <record id="ab_sales_per_day_view_pivot" model="ir.ui.view">
            <field name="name">ab_sales_per_day_view_pivot</field>
            <field name="model">ab_sales_per_day</field>
            <field name="arch" type="xml">
                <pivot string="Sales Per Day">
                    <field name="store_id" type="row"/>
                    <field name="product_eplus_serial" type="row"/>
                    <field name="sale_date" interval="month" type="col"/>
                    <field name="sales_qty" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="ab_sales_per_day_action" model="ir.actions.act_window">
            <field name="name">Sales Per Day</field>
            <field name="res_model">ab_sales_per_day</field>
            <field name="view_mode">list,pivot</field>
            <field name="search_view_id" ref="ab_sales_per_day_view_search"/>
        </record>

        <record id="ab_sales_per_day_sync_state_view_search" model="ir.ui.view">
            <field name="name">ab_sales_per_day_sync_state_view_search</field>
            <field name="model">ab_sales_per_day_sync_state</field>
            <field name="arch" type="xml">
                <search string="Sales Per Day Sync">
                    <field name="sale_date"/>
                    <field name="state"/>
                    <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                    <filter name="filter_running" string="Running" domain="[('state', '=', 'running')]"/>
                    <filter name="filter_failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                    <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                    <separator/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                </search>
            </field>
        </record>

        <record id="ab_sales_per_day_sync_state_view_list" model="ir.ui.view">
            <field name="name">ab_sales_per_day_sync_state_view_list</field>
            <field name="model">ab_sales_per_day_sync_state</field>
            <field name="arch" type="xml">
                <list string="Sales Per Day Sync" create="0" edit="0" delete="0"
                      decoration-danger="state == 'failed'"
                      decoration-warning="state in ('pending', 'running')"
                      decoration-success="state == 'done'">
                    <field name="sale_date"/>
                    <field name="state"/>
                    <field name="rows_synced"/>
                    <field name="started_at"/>
                    <field name="finished_at"/>
                    <field name="error_message" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="ab_sales_per_day_sync_state_view_form" model="ir.ui.view">
            <field name="name">ab_sales_per_day_sync_state_view_form</field>
            <field name="model">ab_sales_per_day_sync_state</field>
            <field name="arch" type="xml">
                <form string="Sales Per Day Sync" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="sale_date"/>
                                <field name="state"/>
                                <field name="rows_synced"/>
                            </group>
                            <group>
                                <field name="started_at"/>
                                <field name="finished_at"/>
                            </group>
                        </group>
                        <group>
                            <field name="error_message"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ab_sales_per_day_sync_state_action" model="ir.actions.act_window">
            <field name="name">Sales Per Day Sync</field>
            <field name="res_model">ab_sales_per_day_sync_state</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="ab_sales_per_day_sync_state_view_search"/>
        </record>

        <record id="ab_sales_per_day_sync_wizard_view_form" model="ir.ui.view">
            <field name="name">ab_sales_per_day_sync_wizard_view_form</field>
            <field name="model">ab_sales_per_day_sync_wizard</field>
            <field name="arch" type="xml">
                <form string="Sync Sales Per Day">
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="force_resync"/>
                    </group>
                    <footer>
                        <button name="action_sync_sales_per_day"
                                type="object"
                                string="Sync"
                                class="btn-primary"/>
                        <button string="Cancel"
                                special="cancel"
                                class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="ab_sales_per_day_sync_wizard_action" model="ir.actions.act_window">
            <field name="name">Sync Sales Per Day</field>
            <field name="res_model">ab_sales_per_day_sync_wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="ab_sales_per_day_menu"
                  name="Sales Per Day"
                  parent="ab_sales_reports_menu"
                  action="ab_sales_per_day_action"
                  sequence="80"
                  groups="base.group_system"/>

        <menuitem id="ab_sales_per_day_sync_state_menu"
                  name="Sales Per Day Sync"
                  parent="ab_sales_reports_menu"
                  action="ab_sales_per_day_sync_state_action"
                  sequence="90"
                  groups="base.group_system"/>

        <menuitem id="ab_sales_per_day_sync_wizard_menu"
                  name="Sync Sales Per Day"
                  parent="ab_sales_reports_menu"
                  action="ab_sales_per_day_sync_wizard_action"
                  sequence="95"
                  groups="base.group_system"/>
    </data>
</odoo>
