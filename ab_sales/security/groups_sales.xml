<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ab_sales_categ" model="ir.module.category">
            <field name="name">Abdin Sales Reporting</field>
            <field name="sequence">92</field>
        </record>

        <record id="privilege_ab_sales" model="res.groups.privilege">
            <field name="name">Sales Reporting Access</field>
            <field name="category_id" ref="ab_sales_categ"/>
        </record>

        <record id="group_ab_sales_manager" model="res.groups">
            <field name="name">Sales Reporting Manager</field>
            <field name="privilege_id" ref="privilege_ab_sales"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_ab_sales_manager'))]"/>
        </record>
    </data>
</odoo>
