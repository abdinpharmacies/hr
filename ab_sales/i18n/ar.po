#: model_terms:ir.ui.view,arch_db:ab_sales.ab_sales_header_view_form
msgid ""
"This invoice is locked until its E-Plus submission is resolved. Use Retry."
msgstr ""
"هذه الفاتورة مقفلة حتى يتم التأكد من نتيجة إرسالها إلى إي بلس. استخدم إعادة "
"المحاولة."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
msgid ""
"Multiple E-Plus invoices match this bill. Contact support; the bill remains "
"locked."
msgstr ""
"توجد عدة فواتير في إي بلس تطابق هذه الفاتورة. تواصل مع الدعم؛ ستظل الفاتورة "
"مقفلة."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
msgid "This invoice cannot be submitted in its current status."
msgstr "لا يمكن إرسال هذه الفاتورة في حالتها الحالية."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
msgid "Recovered E-Plus invoice (sth_id=%s)."
msgstr "تم استرجاع فاتورة إي بلس (sth_id=%s)."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
msgid "Employee has no E-Plus serial. Contact support."
msgstr "الموظف ليس لديه رقم تسلسلي في إي بلس. تواصل مع الدعم."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
msgid "B-Connect did not accept any invoice lines. Contact support."
msgstr "لم يقبل بي كونكت أي بنود للفاتورة. تواصل مع الدعم."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
msgid ""
"This invoice already has an E-Plus serial. Use recovery instead of "
"submitting again."
msgstr ""
"هذه الفاتورة لديها رقم تسلسلي في إي بلس بالفعل. استخدم الاسترجاع بدلًا من "
"إرسالها مجددًا."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
msgid ""
"POS invoices cannot be deleted. Their submission identity must be preserved."
msgstr "لا يمكن حذف فواتير نقطة البيع. يجب الحفاظ على هوية إرسالها."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_pos_api.py:0
msgid "Too many invoice tokens."
msgstr "عدد رموز الفواتير أكبر من المسموح."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_pos_api.py:0
msgid "The invoice token does not match the saved invoice."
msgstr "رمز الفاتورة لا يطابق الفاتورة المحفوظة."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
msgid ""
"This bill is being submitted by another process. Please retry in a moment."
msgstr ""
"يتم إرسال هذه الفاتورة بواسطة عملية أخرى. يرجى إعادة المحاولة بعد قليل."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
#: code:addons/ab_sales/models/ab_sales_unavailable_reason_required.py:0
msgid "Submit is only allowed for bills created from POS."
msgstr "الإرسال مسموح فقط للفواتير التي تم إنشاؤها من نقطة البيع."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
msgid "Connection to E-Plus failed."
msgstr "فشل الاتصال بإي بلس."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
msgid "Header insert failed; header record not found (sth_id=%s)."
msgstr "فشل إدراج رأس الفاتورة؛ لم يتم العثور على السجل (sth_id=%s)."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
msgid "Pushed to E-Plus successfully (sth_id=%s)."
msgstr "تم الإرسال إلى إي بلس بنجاح (sth_id=%s)."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_pos_api.py:0
msgid "Existing invoice not found."
msgstr "لم يتم العثور على الفاتورة الحالية."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
#: code:addons/ab_sales/models/ab_sales_pos_api.py:0
msgid "No lines to send."
msgstr "لا توجد بنود للإرسال."
#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_header.py:0
#: code:addons/ab_sales/models/ab_sales_pos_api.py:0
msgid "Line with missing product E-Plus serial."
msgstr "يوجد بند بدون رقم تسلسلي للمنتج في إي بلس."

#. module: ab_sales
#. odoo-python
#: code:addons/ab_sales/models/ab_sales_pos_api.py:0
msgid ""
"E-Plus submission needs attention. Reload POS and use Retry on the original "
"invoice."
msgstr ""
"إرسال الفاتورة إلى إي بلس يحتاج إلى مراجعة. أعد تحميل نقطة البيع واستخدم "
"إعادة المحاولة على الفاتورة الأصلية."

