<odoo>
    <record id="branch_connection_channel" model="queue.job.channel">
        <field name="name">branch_connections</field><field name="parent_id" ref="integration_queue_job.channel_root"/>
    </record>
    <record id="branch_connection_job" model="queue.job.function">
        <field name="model_id" ref="model_ab_sales_branch_rpc_config"/>
        <field name="method">job_manage_connection</field><field name="channel_id" ref="branch_connection_channel"/>
    </record>
    <data noupdate="1">
        <record id="branch_connection_health_cron" model="ir.cron">
            <field name="name">Branch Connections: Check Health</field>
            <field name="model_id" ref="model_ab_sales_branch_rpc_config"/>
            <field name="state">code</field><field name="code">model._cron_connections('check')</field>
            <field name="interval_number">15</field><field name="interval_type">minutes</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
        <record id="branch_connection_rotation_cron" model="ir.cron">
            <field name="name">Branch Connections: Rotate Credentials</field>
            <field name="model_id" ref="model_ab_sales_branch_rpc_config"/>
            <field name="state">code</field><field name="code">model._cron_connections('rotate')</field>
            <field name="interval_number">1</field><field name="interval_type">days</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
