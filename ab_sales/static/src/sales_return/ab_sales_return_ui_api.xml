<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ab_sales.AbSalesReturnUiApiAction">
        <div class="o_ab_sales_return_ui_action p-3 p-lg-4">
            <div t-if="state.loading" class="d-flex align-items-center justify-content-center py-5">
                <div class="text-center text-muted">
                    <div class="spinner-border mb-3" role="status"/>
                    <div>Loading sales return...</div>
                </div>
            </div>
            <div t-elif="state.record" class="d-flex flex-column gap-3">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                    <div>
                        <h3 class="mb-1">Sales Return</h3>
                        <div class="text-muted small">
                            Invoice #<t t-esc="state.record.origin_header_id"/>
                            <span class="mx-2">|</span>
                            Store: <t t-esc="state.record.store_name"/>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge fs-6" t-att-class="state.record.status_class">
                            <t t-esc="state.record.status_label"/>
                        </span>
                        <button class="btn btn-outline-secondary" type="button" t-on-click="close">
                            Close
                        </button>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-xl-8">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <strong>Return Lines</strong>
                                <div class="d-flex flex-wrap gap-2">
                                    <button class="btn btn-outline-primary btn-sm"
                                            type="button"
                                            t-on-click="reloadLines"
                                            t-att-disabled="state.busy || !state.record.can_reload">
                                        Load Lines
                                    </button>
                                    <button class="btn btn-outline-success btn-sm"
                                            type="button"
                                            t-on-click="totalReturnInvoice"
                                            t-att-disabled="state.busy || !state.record.can_total_return">
                                        Total Return Invoice
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm"
                                            type="button"
                                            t-on-click="clearLines"
                                            t-att-disabled="state.busy || !state.record.can_clear">
                                        Clear Lines
                                    </button>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <div t-if="!lines.length" class="p-4 text-center text-muted">
                                    No lines loaded.
                                </div>
                                <div t-else="" class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th class="ps-3">Product</th>
                                                <th>UoM</th>
                                                <th class="text-end">Sold</th>
                                                <th class="text-end">Max Return</th>
                                                <th class="text-end">Qty</th>
                                                <th class="text-end">Price</th>
                                                <th class="text-end pe-3">Value</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="lines" t-as="line" t-key="line.id">
                                                <td class="ps-3">
                                                    <div class="fw-semibold" t-esc="line.product_name"/>
                                                    <div class="small text-muted">
                                                        Item #<t t-esc="line.item_id"/>
                                                        <t t-if="line.sold_without_balance">
                                                            <span class="ms-2 badge text-bg-warning">Sold Without Balance</span>
                                                        </t>
                                                    </div>
                                                </td>
                                                <td style="min-width: 11rem;">
                                                    <select class="form-select form-select-sm"
                                                            t-att-value="line.uom_id || ''"
                                                            t-att-disabled="state.busy || state.record.status === 'saved'"
                                                            t-on-change="(ev) => this.onUomChange(line.id, ev)">
                                                        <option t-if="!line.uom_options.length" value="">No UoM</option>
                                                        <option t-foreach="line.uom_options" t-as="uom" t-key="uom.id"
                                                                t-att-value="uom.id">
                                                            <t t-esc="uom.name"/>
                                                        </option>
                                                    </select>
                                                </td>
                                                <td class="text-end" t-esc="formatNumber(line.qty_sold, 4)"/>
                                                <td class="text-end" t-esc="formatNumber(line.max_returnable_qty, 4)"/>
                                                <td style="min-width: 8rem;">
                                                    <input class="form-control form-control-sm text-end"
                                                           type="text"
                                                           t-att-value="line.qty_str"
                                                           t-att-disabled="state.busy || state.record.status === 'saved'"
                                                           t-on-input="(ev) => this.onQtyInput(line.id, ev)"
                                                           t-on-blur="() => this.onQtyBlur(line.id)"
                                                           t-on-keydown="(ev) => this.onQtyKeydown(line.id, ev)"/>
                                                </td>
                                                <td class="text-end" t-esc="formatNumber(line.sell_price, 2)"/>
                                                <td class="text-end pe-3" t-esc="formatNumber(line.line_value, 2)"/>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-4">
                        <div class="card shadow-sm mb-3">
                            <div class="card-header bg-white">
                                <strong>Summary</strong>
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Total Qty</span>
                                    <strong t-esc="formatNumber(state.record.total_return_qty, 4)"/>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Return Value</span>
                                    <strong t-esc="formatNumber(state.record.total_return_value, 2)"/>
                                </div>
                                <div class="d-flex justify-content-between mb-0">
                                    <span class="text-muted">Sales Net</span>
                                    <strong t-esc="formatNumber(state.record.total_sales_net, 2)"/>
                                </div>
                                <div t-if="state.record.sales_return_id" class="mt-3 small text-muted">
                                    Return ID: <t t-esc="state.record.sales_return_id"/>
                                </div>
                                <div t-if="state.record.f_transaction_id" class="small text-muted">
                                    F-Transaction ID: <t t-esc="state.record.f_transaction_id"/>
                                </div>
                            </div>
                        </div>

                        <div class="card shadow-sm mb-3">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center gap-2">
                                <strong>Notes</strong>
                                <button class="btn btn-outline-primary btn-sm"
                                        type="button"
                                        t-on-click="saveNotes"
                                        t-att-disabled="state.savingNotes">
                                    Save Notes
                                </button>
                            </div>
                            <div class="card-body">
                                <textarea class="form-control"
                                          rows="6"
                                          placeholder="Add notes"
                                          t-model="state.notesDraft"/>
                            </div>
                        </div>

                        <div class="card shadow-sm">
                            <div class="card-header bg-white">
                                <strong>Actions</strong>
                            </div>
                            <div class="card-body d-grid gap-2">
                            <!--
                                    <button class="btn btn-primary"
                                            type="button"
                                            t-on-click="setPending"
                                            t-att-disabled="state.busy || !state.record.can_set_pending">
                                        Set Pending
                                    </button>
                            -->
                                <button class="btn btn-success"
                                        type="button"
                                        t-on-click="pushToEplus"
                                        t-att-disabled="state.busy || !state.record.can_push">
                                    Push to E-Plus
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div t-else="" class="alert alert-danger mb-0">
                Sales return could not be loaded.
            </div>
        </div>
    </t>
</templates>
