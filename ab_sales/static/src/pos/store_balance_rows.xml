<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ab_sales.StoreBalanceRows">
        <div class="o_ab_sales_store_balance_rows">
            <p class="text-muted small mb-2">Opening loads live balances from main B-Connect. If unavailable, saved balances are shown. Refresh a branch through its API to save its latest balance.</p>
            <div t-if="state.initialError" class="text-warning small mb-2" role="alert"
                 t-esc="state.initialError"/>
            <div class="d-flex align-items-center gap-2 mb-2">
                <input type="search" t-ref="search" class="form-control" t-model="state.search"
                       placeholder="Search branches by name or code..." aria-label="Search branches by name or code"/>
                <button t-if="state.search" type="button" class="btn btn-outline-secondary text-nowrap"
                        t-on-click="() => { this.state.search = ''; }">Clear search</button>
            </div>
            <p class="text-muted small mb-2" t-esc="countLabel"/>
            <div class="o_ab_sales_store_balance_grid">
                <div t-foreach="visibleRows" t-as="row" t-key="row.store_id"
                     class="o_ab_sales_store_balance_entry border rounded p-2">
                    <div class="o_ab_sales_store_balance_name">
                        <div class="fw-semibold" t-esc="row.store_name"/>
                        <small t-if="row.store_code" class="text-muted" t-esc="row.store_code"/>
                    </div>
                    <div class="o_ab_sales_store_balance_value d-flex align-items-center gap-2">
                        <div class="text-end">
                            <small class="text-muted d-block">Balance</small>
                            <span t-esc="formatBalance(row.balance)"/>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                t-att-disabled="row.loading || !row.can_refresh"
                                t-att-aria-busy="row.loading ? 'true' : 'false'"
                                t-on-click="() => this.refreshBranch(row)"
                                t-att-title="refreshLabel(row)"
                                t-att-aria-label="refreshLabel(row)">
                            <i class="fa fa-refresh" t-att-class="{'fa-spin': row.loading}" aria-hidden="true"/>
                        </button>
                    </div>
                    <div class="o_ab_sales_store_balance_feedback small">
                        <div t-if="row.source === 'unavailable'" class="text-warning">Unavailable</div>
                        <div t-if="row.unavailable_reason" class="text-muted" t-esc="row.unavailable_reason"/>
                        <div t-if="row.cached_fallback" class="text-warning">Saved balance (live read unavailable)</div>
                        <div t-if="row.error" class="text-danger mt-1" role="alert">
                            <span>Refresh failed. Previous balance retained.</span>
                            <span class="d-block" t-esc="row.error"/>
                        </div>
                    </div>
                </div>
            </div>
            <div t-if="!visibleRows.length" class="text-muted">
                <span t-if="state.rows.length">No branches match your search.</span>
                <span t-else="">No transfer-enabled branches found.</span>
            </div>
        </div>
    </t>
</templates>
