<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ab_eplus.replicate_employees" model="ir.actions.server">
            <field name="name">Replicate Employees</field>
            <field name="type">ir.actions.server</field>
            <field name="group_ids"
                   eval="[
                       (4, ref('ab_hr.group_ab_hr_co')),
                       (4, ref('ab_accounting.group_ab_accounting_accountant')),
                   ]"/>
            <field name="model_id" ref="ab_eplus.model_ab_eplus_replicate_employees"/>
            <field name="binding_model_id" eval="0"/>
            <field name="state">code</field>
            <field name="code">action = model.env['ab_eplus.replicate_employees'].generate_employees()</field>
        </record>


        <menuitem name="Get Employees From BConnect"
                  id="ab_hr_menu_generate_employees"
                  parent="ab_hr.ab_hr_employee_sub_menu"
                  action="ab_eplus.replicate_employees"
                  sequence="20"/>

        <menuitem name="Get Employees From BConnect"
                  id="ab_accounting_menu_generate_employees"
                  parent="ab_accounting.accounting_menu"
                  action="ab_eplus.replicate_employees"
                  sequence="20"/>


    </data>
</odoo>