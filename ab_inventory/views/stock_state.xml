<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="view_ab_inventory_balance" model="ir.ui.view">
    <field name="name">ab_inventory_balance.list</field>
    <field name="model">ab_inventory_balance</field>
    <field name="arch" type="xml">
      <list string="Stock Layers" create="0" edit="0" delete="0">
        <field name="store_id"/>
        <field name="product_id"/>
        <field name="source_id"/>
        <field name="location"/>
        <field name="on_hand"/>
        <field name="reserved"/>
        <field name="available"/>
        <field name="revision"/>
      </list>
    </field>
  </record>
  <record id="action_ab_inventory_balance" model="ir.actions.act_window">
    <field name="name">Stock Layers</field>
    <field name="res_model">ab_inventory_balance</field>
    <field name="view_mode">list</field>
  </record>
  <record id="view_ab_inventory_reservation" model="ir.ui.view">
    <field name="name">ab_inventory_reservation.list</field>
    <field name="model">ab_inventory_reservation</field>
    <field name="arch" type="xml">
      <list string="Stock Reservations" create="0" edit="0" delete="0">
        <field name="store_id"/>
        <field name="product_id"/>
        <field name="operation_key"/>
        <field name="qty"/>
        <field name="state"/>
        <field name="returned_qty"/>
        <field name="actor_id"/>
      </list>
    </field>
  </record>
  <record id="action_ab_inventory_reservation" model="ir.actions.act_window">
    <field name="name">Stock Reservations</field>
    <field name="res_model">ab_inventory_reservation</field>
    <field name="view_mode">list</field>
  </record>
  <record id="view_ab_inventory_shortage" model="ir.ui.view">
    <field name="name">ab_inventory_shortage.list</field>
    <field name="model">ab_inventory_shortage</field>
    <field name="arch" type="xml">
      <list string="Stock Shortages" create="0" edit="0" delete="0">
        <field name="store_id"/>
        <field name="product_id"/>
        <field name="quantity"/>
        <field name="remaining_qty"/>
        <field name="provisional_unit_cost"/>
        <field name="reason"/>
      </list>
    </field>
  </record>
  <record id="action_ab_inventory_shortage" model="ir.actions.act_window">
    <field name="name">Stock Shortages</field>
    <field name="res_model">ab_inventory_shortage</field>
    <field name="view_mode">list</field>
  </record>
  <record id="view_ab_inventory_cost_correction" model="ir.ui.view">
    <field name="name">ab_inventory_cost_correction.list</field>
    <field name="model">ab_inventory_cost_correction</field>
    <field name="arch" type="xml">
      <list string="Shortage Cost Corrections" create="0" edit="0" delete="0">
        <field name="store_id"/>
        <field name="source_id"/>
        <field name="shortage_id"/>
        <field name="quantity"/>
        <field name="returned_qty"/>
        <field name="provisional_unit_cost"/>
        <field name="actual_unit_cost"/>
        <field name="correction_amount"/>
      </list>
    </field>
  </record>
  <record id="action_ab_inventory_cost_correction" model="ir.actions.act_window">
    <field name="name">Shortage Cost Corrections</field>
    <field name="res_model">ab_inventory_cost_correction</field>
    <field name="view_mode">list</field>
  </record>
  <record id="view_ab_inventory_projection_repair" model="ir.ui.view">
    <field name="name">ab_inventory_projection_repair.list</field>
    <field name="model">ab_inventory_projection_repair</field>
    <field name="arch" type="xml">
      <list string="Inventory Repair Audit" create="0" edit="0" delete="0">
        <field name="store_id"/>
        <field name="actor_id"/>
        <field name="reason"/>
        <field name="create_date"/>
        <field name="changes"/>
      </list>
    </field>
  </record>
  <record id="action_ab_inventory_projection_repair" model="ir.actions.act_window">
    <field name="name">Inventory Repair Audit</field>
    <field name="res_model">ab_inventory_projection_repair</field>
    <field name="view_mode">list</field>
  </record>
  <record id="view_inventory_integrity_review" model="ir.ui.view">
    <field name="name">ab_inventory_integrity_review.form</field>
    <field name="model">ab_inventory_integrity_review</field>
    <field name="arch" type="xml">
      <form string="Inventory Integrity Review">
        <group>
          <field name="store_id"/>
          <field name="reason" placeholder="Reason required for a projection repair"/>
        </group>
        <field name="result"/>
        <footer>
          <button name="action_check" type="object" string="Check Integrity" class="btn-primary"/>
          <button name="action_rebuild" type="object" string="Rebuild Projection" groups="ab_inventory.group_inventory_manager,base.group_system"/>
          <button special="cancel" string="Close"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_inventory_integrity_review" model="ir.actions.act_window">
    <field name="name">Inventory Integrity Review</field>
    <field name="res_model">ab_inventory_integrity_review</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
  <record id="view_inventory_movement_state" model="ir.ui.view">
    <field name="name">ab_inventory.movement.state</field>
    <field name="model">ab_inventory</field>
    <field name="inherit_id" ref="view_inventory_movement_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='saved_at']" position="after">
        <field name="location" readonly="status == 'saved'"/>
        <field name="business_date" readonly="status == 'saved'"/>
        <field name="posting_sequence"/>
        <field name="unit_cost"/>
        <field name="valuation"/>
        <field name="operation_key"/>
      </xpath>
    </field>
  </record>
</odoo>
