<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_inventory_branch" model="ir.rule">
        <field name="name">Inventory: assigned stores</field>
        <field name="model_id" ref="model_ab_inventory"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('store_id', 'in', user.inventory_store_ids.ids)]</field>
    </record>
    <record id="rule_inventory_manager" model="ir.rule">
        <field name="name">Inventory: manager all stores</field>
        <field name="model_id" ref="model_ab_inventory"/>
        <field name="groups" eval="[(4, ref('group_inventory_manager')), (4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
