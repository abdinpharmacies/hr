<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="module_category_inventory" model="ir.module.category">
        <field name="name">Abdin Inventory</field>
    </record>
    <record id="privilege_inventory_access" model="res.groups.privilege">
        <field name="name">Inventory Access</field>
        <field name="category_id" ref="module_category_inventory"/>
    </record>
    <record id="group_inventory_user" model="res.groups">
        <field name="name">Inventory User</field>
        <field name="privilege_id" ref="privilege_inventory_access"/>
        <field name="implied_ids" eval="[(4, ref('ab_taxes.group_ab_taxes_user'))]"/>
    </record>
    <record id="group_inventory_operator" model="res.groups">
        <field name="name">Inventory Operator</field>
        <field name="privilege_id" ref="privilege_inventory_access"/>
        <field name="implied_ids" eval="[(4, ref('group_inventory_user'))]"/>
    </record>
    <record id="group_inventory_shortage" model="res.groups">
        <field name="name">Authorize Stock Shortages</field>
        <field name="privilege_id" ref="privilege_inventory_access"/>
        <field name="implied_ids" eval="[(4, ref('group_inventory_operator'))]"/>
    </record>
    <record id="group_inventory_manager" model="res.groups">
        <field name="name">Inventory Manager</field>
        <field name="privilege_id" ref="privilege_inventory_access"/>
        <field name="implied_ids" eval="[(4, ref('group_inventory_shortage')), (4, ref('ab_product_source.group_source_manager'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_inventory_manager'))]"/>
    </record>
</odoo>
