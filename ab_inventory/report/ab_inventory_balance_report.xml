<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inventory_balance_report_form" model="ir.ui.view">
        <field name="name">ab_inventory.balance.report.form</field>
        <field name="model">ab_inventory_balance_report</field>
        <field name="arch" type="xml">
            <form string="Current Stock Balance">
                <sheet>
                    <group>
                        <field name="store_id"/>
                        <field name="product_id"/>
                        <field name="include_zero"/>
                        <field name="generated_at"/>
                    </group>
                    <button name="action_generate" type="object" string="Refresh Balances"
                            class="btn-primary"/>
                    <field name="line_ids" nolabel="1">
                        <list create="0" edit="0" delete="0">
                            <field name="product_id"/>
                            <field name="source_id"/>
                            <field name="balance_qty" sum="Total Balance"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_inventory_balance_report" model="ir.actions.act_window">
        <field name="name">Current Stock Balance</field>
        <field name="res_model">ab_inventory_balance_report</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>
