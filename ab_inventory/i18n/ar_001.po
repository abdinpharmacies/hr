msgid "Inventory report lines: assigned stores"
msgstr "سطور تقرير المخزون: المتاجر المعيّنة"

#. module: ab_inventory
msgid "Inventory report lines: manager all stores"
msgstr "سطور تقرير المخزون: المدير لجميع المتاجر"

#. module: ab_inventory
msgid "Inventory report movements: assigned stores"
msgstr "حركات تقرير المخزون: المتاجر المعيّنة"

#. module: ab_inventory
msgid "Inventory report movements: manager all stores"
msgstr "حركات تقرير المخزون: المدير لجميع المتاجر"

#. module: ab_inventory
msgid "Movement Schedule"
msgstr "جدول حركة المخزون"

#. module: ab_inventory
msgid "Current Stock Balance"
msgstr "الرصيد الحالي للمخزون"

#. module: ab_inventory
msgid "Current Stock Balance Report"
msgstr "تقرير الرصيد الحالي للمخزون"

#. module: ab_inventory
msgid "Current Stock Balance Line"
msgstr "سطر الرصيد الحالي للمخزون"

#. module: ab_inventory
msgid "Reports"
msgstr "التقارير"

#. module: ab_inventory
msgid "Include Zero Balances"
msgstr "إظهار الأرصدة الصفرية"

#. module: ab_inventory
msgid "Calculated At"
msgstr "وقت احتساب الرصيد"

#. module: ab_inventory
msgid "Refresh Balances"
msgstr "تحديث الأرصدة"

#. module: ab_inventory
msgid "Total Balance"
msgstr "إجمالي الرصيد"

#. module: ab_inventory
msgid "Balance (Smallest Unit)"
msgstr "الرصيد (أصغر وحدة)"

#. module: ab_inventory
msgid "Net"
msgstr "الصافي"

#. module: ab_inventory
msgid "Today"
msgstr "اليوم"

#. module: ab_inventory
msgid "Stock balance: assigned stores"
msgstr "رصيد المخزون: المتاجر المعينة"

#. module: ab_inventory
msgid "Stock balance: manager all stores"
msgstr "رصيد المخزون: جميع المتاجر للمدير"

#. module: ab_inventory
msgid "Stock balance lines: assigned stores"
msgstr "سطور رصيد المخزون: المتاجر المعينة"

#. module: ab_inventory
msgid "Stock balance lines: manager all stores"
msgstr "سطور رصيد المخزون: جميع المتاجر للمدير"

#. module: ab_inventory
msgid "Provide at least one inventory movement."
msgstr "أدخل حركة مخزون واحدة على الأقل."

#. module: ab_inventory
msgid "Invalid inventory movement values."
msgstr "بيانات حركة المخزون غير صالحة."

#. module: ab_inventory
msgid "A linked movement needs a reference, source, quantity, and unique key."
msgstr "تتطلب الحركة المرتبطة مرجعًا ومصدرًا وكمية ومفتاحًا فريدًا."

#. module: ab_inventory
msgid "Each movement must have a unique operation key."
msgstr "يجب أن يكون لكل حركة مفتاح عملية فريد."

#. module: ab_inventory
msgid "Only draft movements can be posted."
msgstr "يمكن ترحيل حركات المخزون المسودة فقط."

#. module: ab_inventory
msgid "Closing Balance"
msgstr "الرصيد الختامي"

#. module: ab_inventory
msgid "Movement #%s"
msgstr "حركة رقم %s"

#. module: ab_inventory
msgid "A linked movement needs a store, source, type, source record, and unique key."
msgstr "تتطلب الحركة المرتبطة متجرًا ومصدرًا ونوعًا وسجل مصدر ومفتاحًا فريدًا."

#. module: ab_inventory
msgid "A linked movement needs a store, source, source type, source record, and unique key."
msgstr "تتطلب الحركة المرتبطة متجرًا ومصدرًا ونوع مصدر وسجل مصدر ومفتاحًا فريدًا."

#. module: ab_inventory
msgid "Incoming and outgoing quantities cannot be negative."
msgstr "لا يمكن أن تكون كميات الوارد أو الصادر سالبة."

#. module: ab_inventory
msgid "Enter either incoming or outgoing quantity, not both."
msgstr "أدخل كمية للوارد أو للصادر فقط، وليس لكليهما."

#. module: ab_inventory
msgid "Saved"
msgstr "محفوظ"

#. module: ab_inventory
msgid "Saved At"
msgstr "وقت الحفظ"

#. module: ab_inventory
msgid "Saved movements are immutable; create a reversal."
msgstr "لا يمكن تعديل الحركات المحفوظة؛ أنشئ حركة عكسية."

#. module: ab_inventory
msgid "Saved movements cannot be edited."
msgstr "لا يمكن تعديل حركات المخزون المحفوظة."

#. module: ab_inventory
msgid "Saved movements cannot be deleted."
msgstr "لا يمكن حذف الحركات المحفوظة."

#. module: ab_inventory
msgid "Only pending movements can be saved."
msgstr "يمكن حفظ الحركات المعلقة فقط."

#. module: ab_inventory
msgid "Only saved movements can be reversed."
msgstr "يمكن عكس الحركات المحفوظة فقط."

#. module: ab_inventory
msgid "Item unit definitions cannot change after stock movements are saved."
msgstr "لا يمكن تغيير تعريفات وحدات الصنف بعد حفظ حركات المخزون."

#. module: ab_inventory
msgid "The item and unit cannot change after stock movements are saved."
msgstr "لا يمكن تغيير الصنف أو الوحدة بعد حفظ حركات المخزون."

#. module: ab_inventory
msgid "This integration uses the previous inventory workflow. Update it to create pending ab_inventory movements and save them explicitly."
msgstr "يستخدم هذا الربط سير عمل المخزون السابق. حدّثه لإنشاء حركات مخزون معلقة وحفظها صراحةً."

#. module: ab_inventory
msgid "Source Record ID must be a positive integer."
msgstr "يجب أن يكون معرّف سجل المصدر عددًا صحيحًا موجبًا."

#. module: ab_inventory
msgid "This source record already has an inventory movement."
msgstr "يوجد بالفعل حركة مخزون لهذا السجل المصدر."

#. module: ab_inventory
msgid "A movement's source record cannot be changed."
msgstr "لا يمكن تغيير السجل المصدر لحركة المخزون."

#. module: ab_inventory
msgid "A linked movement needs a store, source, source type, and source record."
msgstr "تتطلب الحركة المرتبطة متجرًا ومصدرًا ونوع مصدر وسجل مصدر."

#. module: ab_inventory
msgid "This integration uses the previous inventory workflow. Update it to create draft ab_inventory movements and post them explicitly."
msgstr "يستخدم هذا الربط سير عمل المخزون السابق. حدّثه لإنشاء حركات مخزون مسودة وترحيلها صراحةً."

#. module: ab_inventory
msgid "Quantity Change"
msgstr "تغير الكمية"

#. module: ab_inventory
msgid "Quantity change must be a non-zero integer in the smallest unit."
msgstr "يجب أن يكون تغير الكمية عدداً صحيحاً غير صفري بأصغر وحدة للصنف."

#. module: ab_inventory
msgid "Use a signed quantity change instead of incoming or outgoing fields."
msgstr "استخدم تغير كمية موجباً أو سالباً بدلاً من حقلي الوارد والصادر."

#. module: ab_inventory
msgid "Inventory Integration Helper"
msgstr "مساعد ربط المخزون"

#. module: ab_inventory
msgid "Inventory direction must be +1 or -1."
msgstr "يجب أن يكون اتجاه حركة المخزون +1 أو -1."

#. module: ab_inventory
msgid "Inventory quantity must be positive."
msgstr "يجب أن تكون كمية المخزون موجبة."

#. module: ab_inventory
msgid "The source item and unit are required for inventory."
msgstr "يلزم تحديد مصدر الصنف ووحدته للمخزون."

#. module: ab_inventory
msgid "The item unit conversion is not configured."
msgstr "تحويل وحدات الصنف غير مُعدّ."

#. module: ab_inventory
msgid "Quantity cannot be represented exactly in the smallest unit."
msgstr "لا يمكن تمثيل الكمية بدقة بأصغر وحدة للصنف."

#. module: ab_inventory
msgid "Provide one saved business line for inventory."
msgstr "حدد بند عملية محفوظاً واحداً للمخزون."

#. module: ab_inventory
msgid "Inventory status must be Pending or Saved."
msgstr "يجب أن تكون حالة المخزون معلقة أو محفوظة."

#. module: ab_inventory
msgid "The inventory line does not match the business line."
msgstr "بند المخزون لا يطابق بند العملية."

#. module: ab_inventory
msgid "Saved movements cannot return to Pending."
msgstr "لا يمكن إعادة حركة مخزون محفوظة إلى الحالة المعلقة."

#. module: ab_inventory
msgid "Linked movements must be saved through their business document."
msgstr "يجب حفظ حركات المخزون المرتبطة من خلال مستند العملية الخاص بها."
