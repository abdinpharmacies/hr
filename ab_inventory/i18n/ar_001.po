msgstr "وارد آخر"

#. module: ab_inventory
msgid "Other Outgoing"
msgstr "صادر آخر"

#. module: ab_inventory
msgid "Positive for incoming stock; negative for outgoing stock."
msgstr "أدخل رقماً موجباً للوارد ورقماً سالباً للصادر."

#. module: ab_inventory
msgid "Draft"
msgstr "مسودة"

#. module: ab_inventory
msgid "Manual"
msgstr "يدوي"

