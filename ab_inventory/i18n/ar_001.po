#. module: ab_inventory
msgid "From Date cannot be later than To Date."
msgstr "لا يمكن أن يكون تاريخ البداية بعد تاريخ النهاية."

#. module: ab_inventory
msgid "Inventory movement requires a store and item source."
msgstr "تتطلب حركة المخزون متجراً ومصدر صنف."

#. module: ab_inventory
msgid "Inventory movement requires a source document header."
msgstr "تتطلب حركة المخزون رأس مستند مصدر."

#. module: ab_inventory
msgid "Select a valid store."
msgstr "اختر متجراً صالحاً."

#. module: ab_inventory
msgid "You are not allowed to access this store's inventory."
msgstr "ليس لديك صلاحية الوصول إلى مخزون هذا المتجر."

#. module: ab_inventory
msgid "This inventory operation was already recorded."
msgstr "سُجّلت عملية المخزون هذه مسبقاً."

#. module: ab_inventory
msgid "An inventory document for this source and store already exists."
msgstr "يوجد مستند مخزون لهذا المصدر والمتجر مسبقاً."

#. module: ab_inventory
msgid "Posted inventory movements cannot be changed. Create a reversal instead."
msgstr "لا يمكن تعديل حركات المخزون المرحّلة. أنشئ حركة عكسية بدلاً من ذلك."

#. module: ab_inventory
msgid "Only movements pending at the store can be posted."
msgstr "يمكن ترحيل الحركات المعلّقة لدى المتجر فقط."

#. module: ab_inventory
msgid "Posted inventory movements cannot be deleted."
msgstr "لا يمكن حذف حركات المخزون المرحّلة."

