msgid "Inventory"
msgstr "المخزون"

msgid "Abdin Inventory"
msgstr "مخزون العابدين"

msgid "Inventory Access"
msgstr "صلاحيات المخزون"

msgid "Inventory User"
msgstr "مستخدم المخزون"

msgid "Inventory Manager"
msgstr "مدير المخزون"

msgid "Inventory Stores"
msgstr "متاجر المخزون"

msgid "Only administrators can assign inventory stores."
msgstr "يمكن للمسؤولين فقط تعيين متاجر المخزون."

msgid "Inventory Movements"
msgstr "حركات المخزون"

msgid "Inventory Movement"
msgstr "حركة مخزون"

msgid "Legacy Inventory Integration"
msgstr "ربط المخزون السابق"

